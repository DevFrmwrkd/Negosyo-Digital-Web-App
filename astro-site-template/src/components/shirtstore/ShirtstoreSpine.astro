---
/**
 * Shirtstore spine — shared base CSS injected once per page.
 *
 * The 5 Shirtstore variants (PageZ + 4 siblings: Editorial, Streetwear,
 * Artisan, Modern, Kinetic) each set their own palette + font tokens scoped
 * to `html[data-page="<L>"]`, so this spine references those via var(--accent),
 * var(--paper), etc. and works for every variant without bleed.
 *
 * Editorial fashion vocabulary from the source "01 Editorial.html": hairline
 * rules, oversized display serif headings, italic accent runs (.it), thin
 * uppercase eyebrows, and understated outline/fill buttons. Button text routes
 * through --on-accent / --on-ink / --on-paper contrast tokens (playbook
 * §"Contrast guarantee") so extreme schemes never produce invisible buttons.
 *
 * EVERY RULE BELOW IS ANCHORED TO THE FIVE data-pages THAT RENDER THROUGH THIS
 * FILE (Z, AA, AB, AC, AD — the wrappers that import this spine). index.astro
 * imports all 65 Page*.astro wrappers, so Astro bundles every `is:global` block
 * in the project into ONE stylesheet that ships on EVERY generated page: an
 * unanchored `body { background: … }`, `.btn:hover { … }` or `.it { color: … }`
 * here would repaint all 65 templates, not just these five. `:is()` takes the
 * specificity of its most specific argument, so the anchor adds (0,1,1) — never
 * `:where()`, which adds nothing and would make these primitives lose fights
 * inside their own templates. The two universal rules list the anchor twice
 * (`:is(…), :is(…) *`) so the <html> element itself keeps matching, exactly as
 * bare `*` did.
 */
---
<style is:global>
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]), :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) * { box-sizing: border-box; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) { scroll-behavior: smooth; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) h1, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) h2, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) h3 {
    font-family: var(--serif);
    font-weight: 300; line-height: 1; margin: 0;
    letter-spacing: -.01em;
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) img { max-width: 100%; display: block; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) a { color: inherit; text-decoration: none; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) section { position: relative; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .wrap { max-width: var(--maxw, 1340px); margin: 0 auto; padding-inline: var(--pad, clamp(20px, 5vw, 80px)); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .pad-y { padding-block: clamp(56px, 8vw, 120px); }

  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .it { font-style: italic; color: var(--accent); }

  /* Eyebrow / kicker — thin uppercase clay label */
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .kicker, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .eyebrow {
    font-family: var(--sans); text-transform: uppercase;
    letter-spacing: .32em; font-weight: 600; font-size: 11px;
    color: var(--accent);
    display: inline-block;
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .h-sect {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(34px, 4.4vw, 64px); line-height: 1;
    letter-spacing: -.01em; margin: 14px 0 0;
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .lead {
    font-size: clamp(16px, 1.3vw, 18px);
    color: var(--muted, rgba(var(--ink-rgb), .66));
    max-width: 44ch; line-height: 1.6;
  }

  /* Buttons — outline / fill, subtle lift (editorial signature).
     Text colors route through contrast tokens so extreme schemes stay legible. */
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn {
    display: inline-flex; align-items: center; gap: .55em;
    font-family: var(--sans); font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em; font-size: 13px;
    padding: 14px 26px; min-height: 48px; cursor: pointer;
    border: 1px solid var(--ink); background: transparent; color: var(--on-paper, var(--ink));
    transition: transform .35s cubic-bezier(.2,.8,.1,1), background .3s ease, color .3s ease, border-color .3s ease;
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn:hover { transform: translateY(-2px); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--accent, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn-fill {
    background: var(--ink); color: var(--on-ink, var(--paper)); border-color: var(--ink);
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--accent:hover, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn-fill:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent, var(--paper)); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--ghost, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn-out { background: transparent; color: var(--on-paper, var(--ink)); border-color: var(--on-paper, var(--ink)); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--ghost:hover, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn-out:hover { background: var(--ink); color: var(--on-ink, var(--paper)); border-color: var(--ink); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--ghost.on-dark { color: var(--on-ink, var(--paper)); border-color: rgba(var(--paper-rgb), .6); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn--ghost.on-dark:hover { background: var(--paper); color: var(--on-paper, var(--ink)); border-color: var(--paper); }

  /* Section head — flex title left, lead right */
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .sect-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 30px; flex-wrap: wrap; margin-bottom: clamp(34px, 4vw, 56px);
  }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .sect-head .lead { margin: 12px 0 0; }

  /* Ink section helper */
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .ink-sect { background: var(--ink); color: var(--paper); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .ink-sect .h-sect, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .ink-sect h2 { color: var(--paper); }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .ink-sect .kicker, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .ink-sect .eyebrow { color: var(--accent-light, var(--accent)); }

  /* Shared image slot fallback */
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .bg-img { background-size: cover; background-position: center; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .bg-img.placeholder, :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .placeholder {
    background: repeating-linear-gradient(45deg, var(--paper-2) 0 14px, var(--paper) 14px 28px);
  }

  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .reveal { opacity: 0; transform: translateY(20px); transition: opacity .8s ease, transform .8s ease; }
  :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .reveal { opacity: 1; transform: none; transition: none; }
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]), :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) * { animation: none !important; }
  }

  /* ------------------------------------------------------------------ */
  /* Shared mobile-first tuning — Z–AD family.                           */
  /* Desktop rules above are untouched. Each variant's section grids live */
  /* in their own scoped components and already collapse to one column;   */
  /* these rules cover the SHARED spine primitives (type scale, section   */
  /* heads, buttons) so every variant tightens up at once. body already   */
  /* carries overflow-x:hidden, so no rail can push the page sideways.    */
  /* ------------------------------------------------------------------ */
  @media (max-width: 760px) {
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .pad-y { padding-block: clamp(44px, 10vw, 84px); }
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .h-sect { font-size: clamp(30px, 8vw, 52px); }
    /* Section heads stack: title over lead, left-aligned. */
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .sect-head { flex-direction: column; align-items: flex-start; gap: 12px; }
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .sect-head .lead { margin-top: 4px; max-width: none; }
  }
  @media (max-width: 520px) {
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .h-sect { font-size: clamp(27px, 8.5vw, 40px); }
    /* Full-width, centred primary + secondary CTAs on the smallest screens. */
    :is(html[data-page="Z"],html[data-page="AA"],html[data-page="AB"],html[data-page="AC"],html[data-page="AD"]) .btn { width: 100%; justify-content: center; }
  }
</style>
