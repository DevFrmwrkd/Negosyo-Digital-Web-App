---
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const ctaText = (content as any).navCtaText || 'Shop';
const ctaHref = (content as any).navCtaHref || '#services';
const hasMenu = navLinks.length > 0 || !!phone || !!ctaText;
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" data-field="footer.brand">{brand}<b>.</b></a>
    {hasMenu && (
      <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-z-menu">
        <span></span><span></span><span></span>
      </button>
    )}
    <div class="nav-collapse" id="nav-z-menu">
      {navLinks.length > 0 && (
        <nav class="nav-links" aria-label="Primary">
          {navLinks.map((link, i) => (
            <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
          ))}
        </nav>
      )}
      <div class="nav-right">
        {phone && (
          <a href={`tel:${phoneDigits}`} class="nav-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
        )}
        <a href={ctaHref} class="link" data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>
      </div>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-collapse');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping any link inside it.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    transition: background .3s ease, border-color .3s ease;
    border-bottom: 1px solid transparent;
  }
  header.nav.scrolled {
    background: rgba(var(--paper-rgb), .88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; height: 72px;
  }
  .brand {
    font-family: var(--serif); font-size: clamp(21px, 2vw, 25px); font-weight: 500;
    color: var(--ink); letter-spacing: .02em;
  }
  .brand b { font-weight: 600; color: var(--accent); }
  /* display:contents so the two collapsed groups lay out as direct flex
     children of .nav-inner on desktop — the bar is byte-for-byte unchanged. */
  .nav-collapse { display: contents; }
  .nav-links { display: flex; gap: 34px; align-items: center; }
  .nav-links :global(a) {
    font-family: var(--sans); text-transform: uppercase; letter-spacing: .08em;
    font-size: 12px; font-weight: 500; color: var(--ink-2, var(--muted)); transition: color .25s;
  }
  .nav-links :global(a:hover) { color: var(--ink); }
  .nav-right { display: flex; align-items: center; gap: 22px; }
  .nav-phone {
    font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: .06em;
    color: var(--ink);
  }
  .link {
    font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink);
    border-bottom: 1px solid var(--line-2); padding-bottom: 3px; transition: border-color .3s;
  }
  .link:hover { border-color: var(--ink); }

  /* Hamburger — hidden on desktop, the mobile menu trigger below 760px. */
  .nav-burger { display: none; }

  @media (max-width: 760px) {
    /* Trigger: a 44px tap target with three ink bars in the variant's own colour. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -10px;
      background: transparent; border: 0; cursor: pointer;
    }
    .nav-burger span {
      display: block; width: 24px; height: 2px; background: var(--ink);
      border-radius: 2px; transition: transform .3s ease, opacity .3s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Give the bar a solid ground while the drawer is open so the ink
       burger + brand stay legible even at the very top of the page. */
    header.nav.open {
      background: rgba(var(--paper-rgb), .96);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    /* The two collapsed groups become a full-width dropdown beneath the bar,
       painted in the design's own paper + line tokens (auto-themes per variant). */
    .nav-collapse {
      display: flex; flex-direction: column;
      position: absolute; left: 0; right: 0; top: 100%;
      background: rgba(var(--paper-rgb), .98);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -22px rgba(var(--ink-rgb), .5);
      max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-collapse {
      max-height: calc(100vh - 72px); overflow-y: auto; opacity: 1; visibility: visible;
    }
    .nav-links {
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 6px 0 4px;
    }
    .nav-links :global(a) {
      display: flex; align-items: center; min-height: 52px;
      padding: 6px 24px; font-size: 14px; color: var(--ink);
      border-top: 1px solid var(--line);
    }
    .nav-right {
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 8px 24px 16px;
    }
    .nav-phone {
      display: flex; align-items: center; min-height: 48px; font-size: 15px;
      border-top: 1px solid var(--line);
    }
    /* Primary CTA reads as a solid button inside the drawer. */
    .link {
      display: flex; align-items: center; justify-content: center;
      min-height: 50px; margin-top: 12px; padding: 0 20px;
      border: 1px solid var(--ink); background: var(--ink);
      color: var(--on-ink, var(--paper)); font-size: 13px;
    }
    .link:hover { border-color: var(--ink); }
  }
</style>
