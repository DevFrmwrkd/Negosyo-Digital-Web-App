---
/**
 * education / AboutAT — "the studio" split: warm serif copy left (the opening
 * paragraph reads as a serif lead), a rotated taped photograph right. The figure
 * keeps its .scene-tutor duotone as the designed fallback until about.image is
 * set. The headline renders via set:html so the design's inline highlighter
 * markup survives if the admin keeps it.
 *
 * about.imageCaption, about.quote and about.signature are optional extras that
 * stay hidden when unset (mirrors the AM content model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="sec about" id="about">
  <div class="wrap about-grid">
    <div class="about-copy reveal">
      {tag && <span class="eyebrow" style="display:block;margin-bottom:14px;" data-field="about.tag">{tag}</span>}
      {headline && <h2 class="about-h" data-field="about.headline" set:html={headline}></h2>}
      {paragraphs.map((p: string, i: number) => (
        <p data-field={`about.paragraphs.${i}`} set:html={p}></p>
      ))}
      {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
      {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
    </div>
    <div class="about-side reveal d1">
      <figure class="taped">
        <span class="tape" aria-hidden="true" style="transform:translateX(-50%) rotate(2deg);"></span>
        <div class="plate about-plate">
          <div class="ph scene-tutor" role="img" aria-label="Studio photo" data-image-field="about.image" style={image ? `background-image:url('${image}');background-size:cover;background-position:center;` : ''}></div>
        </div>
        {imageCaption && <figcaption data-field="about.imageCaption">{imageCaption}</figcaption>}
      </figure>
    </div>
  </div>
</section>
<style>
  .about { background: var(--paper); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 36px; } }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; gap: 30px; } }
  .about-h { margin-bottom: 20px; font-size: clamp(30px,4.4vw,54px); color: var(--ink); }
  .about-copy p:first-of-type { font-family: var(--serif); font-size: 24px; line-height: 1.5; color: var(--ink); }
  .about-copy p { color: var(--graphite); font-family: var(--sans); }
  .about-quote { font-family: var(--serif); font-size: clamp(20px,2.4vw,26px); line-height: 1.3; color: var(--navy-d); margin: 24px 0 0; padding-left: 18px; border-left: 3px solid var(--coral); }
  .about-sign { margin-top: 18px; font-style: italic; color: var(--muted); }
  .about-side .taped { transform: rotate(-1.6deg); }
  .about-side .about-plate { aspect-ratio: 5/4; }
</style>
