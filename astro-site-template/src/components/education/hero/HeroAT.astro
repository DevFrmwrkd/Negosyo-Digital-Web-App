---
/**
 * education / HeroAT — split hero: a ruled, margin-lined composition-paper card
 * left (eyebrow, serif headline, lede, two CTAs) and a rotated taped photograph
 * right whose .scene-study duotone stands in until hero.image is set. A stuck-on
 * highlighter note ("Small classes ✎") tucks under the photo.
 *
 * Headline lines render via set:html so an admin can keep the design's inline
 * highlighter markup (<span class="hl">…</span>) if they choose — the stroke
 * then draws itself on. hero.cta3 is an optional third CTA (the design ships two).
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const hero = content.hero || {};
const heroImage = hero.image || (hero.photos && hero.photos[0]) || (content.photos && content.photos[0]) || '';
const kicker = hero.kicker || hero.locality || '';
const headlineLines: string[] = Array.isArray(hero.headlineLines) && hero.headlineLines.length > 0
  ? hero.headlineLines
  : (hero.headline ? [hero.headline] : []);
const sub = hero.sub || '';
const cta1Text = hero.cta1?.text || '';
const cta1Href = hero.cta1?.href || '#enrol';
const cta2Text = hero.cta2?.text || '';
const cta2Href = hero.cta2?.href || '#services';
const cta3Text = hero.cta3?.text || '';
const cta3Href = hero.cta3?.href || '#location';
const imageCaption = hero.tag || '';
const note = hero.badgeNote || '';
---
<section class="hero" aria-label="Hero">
  <div class="wrap">
    <div class="hero-paper paperblock ruled">
      {kicker && <span class="eyebrow" data-field="hero.kicker">{kicker}</span>}
      {headlineLines.length > 0 && (
        <h1>
          {headlineLines.map((line: string, i: number) => (
            <span data-field={`hero.headlineLines.${i}`} set:html={line}></span>
          ))}
        </h1>
      )}
      {sub && <p class="lede" data-field="hero.sub">{sub}</p>}
      {(cta1Text || cta2Text || cta3Text) && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost" data-field="hero.cta3.text" data-href-field="hero.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
    <div class="hero-side">
      <figure class="taped">
        <span class="tape" aria-hidden="true"></span>
        <div class="plate hero-plate">
          <div class="ph scene-study" role="img" aria-label="Studio photo" data-image-field="hero.image" style={heroImage ? `background-image:url('${heroImage}');background-size:cover;background-position:center;` : ''}></div>
        </div>
        {imageCaption && <figcaption data-field="hero.tag">{imageCaption}</figcaption>}
      </figure>
      {note && <div class="hero-note" data-field="hero.badgeNote">{note}</div>}
    </div>
  </div>
</section>
<style>
  .hero { padding: 64px 0 30px; position: relative; }
  .hero .wrap { display: grid; grid-template-columns: 1.08fr .92fr; gap: 52px; align-items: center; }
  @media (max-width: 920px) { .hero .wrap { grid-template-columns: 1fr; gap: 40px; } }
  .hero-paper { padding: 44px 44px 40px 74px; opacity: 0; animation: riseIn .9s cubic-bezier(.2,.8,.2,1) .1s forwards; }
  @media (max-width: 600px) { .hero-paper { padding: 32px 24px 30px 44px; } }
  @keyframes riseIn { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-paper, .hero-side { opacity: 1 !important; animation: none !important; } }
  .hero h1 { font-size: clamp(40px,5.6vw,74px); margin: .16em 0 .34em; color: var(--ink); }
  .hero h1 > span { display: block; }
  .hero .lede { color: var(--graphite); font-size: 19px; max-width: 44ch; margin-bottom: 26px; font-family: var(--sans); }
  .hero .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-side { position: relative; padding: 24px 10px; opacity: 0; animation: riseIn 1s cubic-bezier(.2,.8,.2,1) .3s forwards; }
  .hero-side .taped { transform: rotate(2.2deg); }
  .hero-side .hero-plate { aspect-ratio: 4/5; }
  .hero-note { position: absolute; left: -6px; bottom: -6px; background: var(--hi); color: var(--ink); font-family: var(--mono); font-size: 13px; padding: 10px 14px; transform: rotate(-3deg); box-shadow: 0 8px 20px -10px rgba(31,42,68,.5); border: 1px solid rgba(221,160,80,.5); }
</style>
