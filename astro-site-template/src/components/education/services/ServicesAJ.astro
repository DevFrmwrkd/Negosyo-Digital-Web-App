---
/**
 * education / ServicesAJ — "choose your track" programs grid on the warm band.
 * Notebook cards (ink border, offset shadow) with highlighter-swept titles.
 * Anchored #programs for the hero's "See programs" CTA. price / duration render
 * only when present in the data.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
type Item = { title: string; desc?: string; price?: string; duration?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
---
{items.length > 0 && (
  <section class="svc-sect" id="programs">
    <div class="wrap">
      {tag && <span class="note" data-field="services.tag">{tag}</span>}
      {headline && <h2 class="svc-h" data-field="services.headline" set:html={headline}></h2>}
      {sub && <p class="svc-sub" data-field="services.sub">{sub}</p>}
      <div class="svc-grid">
        {items.map((item, i) => (
          <div class="card svc-card reveal">
            <div class="card-head">
              <h3><span class="hl2" data-field={`services.items.${i}.title`}>{item.title}</span></h3>
              {item.price && <span class="card-price" data-field={`services.items.${i}.price`}>{item.price}</span>}
            </div>
            {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
            {item.duration && <div class="card-dur" data-field={`services.items.${i}.duration`}>{item.duration}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .svc-sect { background: var(--band); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .svc-h { font-size: clamp(32px, 5vw, 52px); margin: 14px 0 30px; color: var(--ink); }
  .svc-sub { max-width: 52ch; color: var(--ink-soft); margin: -16px 0 30px; }
  .svc-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .card-price { font-family: var(--sans); font-weight: 700; font-size: 14px; color: var(--red-pen); flex-shrink: 0; }
  .card-dur {
    font-family: var(--sans); text-transform: uppercase; letter-spacing: .1em;
    font-size: 11px; color: var(--ink-soft); margin-top: 10px; opacity: .85;
  }
</style>
