---
/**
 * education / PageAT — "Ruled" (scholarly notebook editorial).
 *
 * Ported from Local Business Landing Pages v4 / lp-08-education.html. An exam
 * bluebook / ruled composition-paper look: warm bone paper ground, a navy ink
 * headline serif, a red margin rule down the ruled hero card, taped photographs
 * with masking-tape tabs, and the design's signature SVG highlighter / underline
 * strokes that draw themselves on as each section scrolls into view. Gradient
 * "scene" fields stand in as the designed photo fallback for every image slot.
 *
 * Design isolation: lp-08's palette tokens + base primitives are scoped to
 * `html[data-page="AT"]` in the global block below so sister education variants
 * (e.g. AJ) never inherit AT's tokens or its bespoke `.plate` / `.taped` /
 * `.ruled` / `.hl` / `.scene-*` primitives (and vice-versa).
 *
 * CRITICAL specificity note: the size-bearing `.plate` frame and the `.taped`
 * photo frame are written as `html[data-page="AT"] :where(.plate)` /
 * `:where(.taped)` so per-section height/aspect modifiers (.hero-plate,
 * .about-plate, the gallery grid rows …) at (0,2,0) win over the base instead
 * of being squashed to a base floor. Do not remove the :where().
 *
 * lockVariant: true — only an EXPLICIT admin color/font pick recolors; the
 * hand-tuned "Ruled" palette wins by default.
 */
import HeaderAT from './header/HeaderAT.astro';
import HeroAT from './hero/HeroAT.astro';
import TrustAT from './trust/TrustAT.astro';
import AboutAT from './about/AboutAT.astro';
import ServicesAT from './services/ServicesAT.astro';
import WhyAT from './why/WhyAT.astro';
import HowAT from './how/HowAT.astro';
import TestimonialsAT from './testimonials/TestimonialsAT.astro';
import GalleryAT from './gallery/GalleryAT.astro';
import FaqAT from './faq/FaqAT.astro';
import AreaAT from './area/AreaAT.astro';
import CredentialsAT from './credentials/CredentialsAT.astro';
import LocationAT from './location/LocationAT.astro';
import CtaBandAT from './ctaBand/CtaBandAT.astro';
import FooterAT from './footer/FooterAT.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#1f2a44" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-08 "Ruled" palette tokens + shared base primitives, scoped to
       html[data-page="AT"] so they never leak to sister education variants. -->
  <style is:global>
    html[data-page="AT"] {
      /* lp-08 native palette */
      --paper: #fbf7ec; --paper2: #f5efdf; --card: #fffdf6;
      --ink: #1f2a44; --ink2: #3a4258; --graphite: #4a5169;
      --rule: #cdd9e8; --margin: #dd8a83; --hi: #ffe14d; --coral: #ff8a5c;
      --navy: #1f2a44; --navy-d: #152039; --line: #e3ddca; --muted: #6a6f80;
      --serif: "Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans: system-ui,-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;
      --mono: "Courier New",ui-monospace,Consolas,monospace;
      --maxw: 1180px;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible even though components read the design's own tokens. */
      --paper-2: #f5efdf;
      --accent: #ff8a5c;
      --paper-rgb: 251,247,236; --ink-rgb: 31,42,68; --accent-rgb: 255,138,92;
      --on-accent: #1f2a44; --on-ink: #eaf0f8; --on-paper: #1f2a44;
    }
    html[data-page="AT"] * { box-sizing: border-box; }
    html[data-page="AT"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AT"] { scroll-behavior: auto; } }
    html[data-page="AT"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 18px; line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    html[data-page="AT"] h1, html[data-page="AT"] h2,
    html[data-page="AT"] h3, html[data-page="AT"] h4 {
      margin: 0; font-family: var(--serif); font-weight: 600; line-height: 1.05;
    }
    html[data-page="AT"] p { margin: 0 0 1em; }
    html[data-page="AT"] a { color: var(--navy-d); text-decoration: none; }
    html[data-page="AT"] a:hover { color: var(--coral); }
    html[data-page="AT"] img { max-width: 100%; display: block; }
    html[data-page="AT"] ::selection { background: var(--hi); color: var(--ink); }

    html[data-page="AT"] .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 30px; }
    html[data-page="AT"] .eyebrow {
      font-family: var(--mono); font-size: 12px; letter-spacing: .16em;
      text-transform: uppercase; color: var(--coral); font-weight: 700;
    }

    /* Composition-book buttons — solid navy fill / hollow ghost. */
    html[data-page="AT"] .btn {
      font-family: var(--sans); font-weight: 600; font-size: 15px; display: inline-flex;
      align-items: center; gap: .5em; padding: 15px 28px; cursor: pointer;
      border: 2px solid var(--navy); border-radius: 10px;
      transition: transform .25s, background .25s, color .25s, box-shadow .25s;
    }
    html[data-page="AT"] .btn--fill { background: var(--navy); color: var(--card); }
    html[data-page="AT"] .btn--fill:hover { background: var(--navy-d); border-color: var(--navy-d); transform: translateY(-2px); box-shadow: 0 10px 0 -3px var(--coral); color: var(--card); }
    html[data-page="AT"] .btn--ghost { background: transparent; color: var(--navy); }
    html[data-page="AT"] .btn--ghost:hover { background: var(--hi); border-color: var(--navy); transform: translateY(-2px); color: var(--navy); }

    /* scroll reveal */
    html[data-page="AT"] .reveal { opacity: 0; transform: translateY(20px); transition: opacity .8s ease, transform .8s ease; }
    html[data-page="AT"] .reveal.in { opacity: 1; transform: none; }
    html[data-page="AT"] .reveal.d1 { transition-delay: .09s; }
    html[data-page="AT"] .reveal.d2 { transition-delay: .18s; }
    html[data-page="AT"] .reveal.d3 { transition-delay: .27s; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AT"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* highlighter / underline draw-on (design signature) */
    html[data-page="AT"] .hl { position: relative; white-space: nowrap; z-index: 0; }
    html[data-page="AT"] .hl svg { position: absolute; left: -6px; right: -6px; bottom: .02em; width: calc(100% + 12px); height: .62em; z-index: -1; overflow: visible; }
    html[data-page="AT"] .hl svg path { fill: none; stroke: var(--hi); stroke-width: 16; stroke-linecap: round; stroke-dasharray: 640; stroke-dashoffset: 640; transition: stroke-dashoffset 1.1s cubic-bezier(.6,0,.2,1) .15s; }
    html[data-page="AT"] .hl.u svg { bottom: -.16em; height: .5em; }
    html[data-page="AT"] .hl.u svg path { stroke: var(--coral); stroke-width: 7; }
    html[data-page="AT"] .hl.in svg path { stroke-dashoffset: 0; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AT"] .hl svg path { stroke-dashoffset: 0 !important; transition: none; } }

    /* ruled paper + margin-ruled paper block */
    html[data-page="AT"] .ruled { background-image: linear-gradient(var(--rule) 1px, transparent 1px); background-size: 100% 34px; background-position: 0 6px; }
    html[data-page="AT"] .paperblock { background: var(--card); border: 1px solid var(--line); border-radius: 6px; position: relative; box-shadow: 0 20px 50px -34px rgba(31,42,68,.5); }
    html[data-page="AT"] .paperblock::before { content: ""; position: absolute; top: 0; bottom: 0; left: 44px; width: 2px; background: var(--margin); opacity: .6; }
    @media (max-width: 600px) { html[data-page="AT"] .paperblock::before { left: 22px; } }

    /* Taped photograph frame — :where() so per-figure transform/pad modifiers win. */
    html[data-page="AT"] :where(.taped) { position: relative; background: var(--card); padding: 12px 12px 44px; border: 1px solid var(--line); box-shadow: 0 24px 50px -30px rgba(31,42,68,.55); }
    html[data-page="AT"] :where(.taped) .tape { position: absolute; width: 96px; height: 26px; background: rgba(255,225,77,.55); border: 1px solid rgba(221,160,80,.4); top: -12px; left: 50%; transform: translateX(-50%) rotate(-3deg); }
    html[data-page="AT"] :where(.taped) figcaption { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; font-family: var(--mono); font-size: 12px; color: var(--muted); letter-spacing: .03em; }

    /* Designed photo frame — :where() so per-section height modifiers win. */
    html[data-page="AT"] :where(.plate) { position: relative; overflow: hidden; background: var(--paper2); isolation: isolate; }
    html[data-page="AT"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; }

    /* Duotone "scene" fields — the designed fallback painted behind each photo. */
    html[data-page="AT"] .scene-study { background: radial-gradient(60% 70% at 46% 40%,rgba(255,225,77,.4),transparent 60%), radial-gradient(50% 40% at 72% 66%,rgba(31,42,68,.16),transparent 60%), linear-gradient(160deg,#efe7cf,#dccfae); }
    html[data-page="AT"] .scene-tutor { background: radial-gradient(60% 60% at 42% 42%,rgba(255,138,92,.32),transparent 60%), linear-gradient(160deg,#efe6cd,#dbceac); }
    html[data-page="AT"] .scene-books { background: repeating-linear-gradient(90deg,rgba(31,42,68,.14) 0 8px,rgba(255,138,92,.22) 8px 14px,rgba(255,225,77,.3) 14px 22px,transparent 22px 30px), linear-gradient(160deg,#efe7cf,#ddd0af); }
    html[data-page="AT"] .scene-board { background: radial-gradient(70% 70% at 50% 44%,rgba(31,42,68,.5),transparent 62%), linear-gradient(160deg,#26324f,#151d33); }
    html[data-page="AT"] .scene-desk { background: radial-gradient(60% 60% at 50% 42%,rgba(255,225,77,.34),transparent 60%), linear-gradient(160deg,#efe7cf,#dccfad); }
    html[data-page="AT"] .scene-grad { background: radial-gradient(60% 70% at 52% 40%,rgba(255,138,92,.34),transparent 60%), linear-gradient(160deg,#ece4cb,#d8cbab); }

    /* section scaffolding shared across blocks */
    html[data-page="AT"] section { position: relative; }
    html[data-page="AT"] .sec { padding: 92px 0; }
    html[data-page="AT"] .sec-head { margin-bottom: 48px; }
    html[data-page="AT"] .sec-head .eyebrow { display: block; margin-bottom: 14px; }
    html[data-page="AT"] .sec-head h2 { font-size: clamp(30px,4.4vw,54px); color: var(--ink); }
    html[data-page="AT"] .sec-head p { color: var(--muted); font-size: 18px; margin-top: 14px; max-width: 56ch; font-family: var(--sans); }

    /* CTA-band button recolours for the navy closing band */
    html[data-page="AT"] .cta-band .btn--fill { background: var(--hi); color: var(--ink); border-color: var(--hi); }
    html[data-page="AT"] .cta-band .btn--fill:hover { background: #ffd21a; color: var(--ink); box-shadow: 0 10px 0 -3px var(--coral); }
    html[data-page="AT"] .cta-band .btn--ghost { border-color: rgba(255,255,255,.5); color: var(--card); }
    html[data-page="AT"] .cta-band .btn--ghost:hover { background: rgba(255,255,255,.1); color: var(--card); border-color: rgba(255,255,255,.7); }

    /* skip link */
    html[data-page="AT"] .skip { position: absolute; left: -999px; top: 0; background: var(--navy); color: var(--card); padding: 12px 18px; z-index: 100; border-radius: 0 0 8px 0; }
    html[data-page="AT"] .skip:focus { left: 0; top: 0; }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAT layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAT content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAT content={content} />}
    {visibility.aboutSection !== false && <AboutAT content={content} />}
    {visibility.servicesSection !== false && <ServicesAT content={content} />}
    {visibility.whyUsBlock !== false && <WhyAT content={content} />}
    {visibility.howItWorksBlock !== false && <HowAT content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAT content={content} />}
    {visibility.gallerySection !== false && <GalleryAT content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAT content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAT content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAT content={content} />}
    {visibility.locationBlock !== false && <LocationAT content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAT content={content} layout={layout} />}
  <FooterAT layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        // Signature highlighter / underline strokes draw on when scrolled in.
        var io2 = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io2.unobserve(e.target); } });
        }, { threshold: 0.6 });
        document.querySelectorAll('.hl').forEach(function (el) { io2.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
        document.querySelectorAll('.hl').forEach(function (el) { el.classList.add('in'); });
      }
      // Hide-on-scroll-down header (lp-08 "Ruled" behaviour).
      var hdr = document.querySelector('header.nav');
      if (hdr) {
        var last = 0;
        window.addEventListener('scroll', function () {
          var y = window.pageYOffset;
          if (y > last && y > 360) { hdr.classList.add('hide'); } else { hdr.classList.remove('hide'); }
          last = y;
        }, { passive: true });
      }
      // Education-AT Leaflet boot — accepts (lat, lng, label) from LocationAT.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAT calls this with whatever it resolves).
      window.__educationATInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:16px;height:16px;border-radius:50%;background:#ff8a5c;box-shadow:0 0 0 3px #fffdf6;border:0;"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
