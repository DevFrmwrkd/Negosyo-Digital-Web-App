---
/**
 * education / WhyAT — "why families choose us" reasons on the paper band. A row
 * of .why-cell tiles, each led by a coloured left rule (highlighter / coral /
 * navy), a serif title and a graphite body line. The headline carries the
 * design's underline highlighter (.hl.u) via set:html when the admin keeps it.
 * Reads content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="sec why">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-grid">
        {items.map((item, i) => (
          <div class="why-cell reveal">
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why { background: var(--paper); }
  .why-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 40px; }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; gap: 28px; } }
  .why-cell { padding-left: 22px; border-left: 3px solid var(--hi); }
  .why-cell:nth-child(2) { border-left-color: var(--coral); }
  .why-cell:nth-child(3) { border-left-color: var(--navy); }
  .why-cell h3 { font-size: 23px; color: var(--ink); margin-bottom: 10px; }
  .why-cell p { color: var(--graphite); font-size: 16px; font-family: var(--sans); }
</style>
