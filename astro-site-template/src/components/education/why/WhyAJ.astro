---
/**
 * education / WhyAJ — split grid: big Lora headline left (a highlighter-swept
 * phrase can be carried inline via set:html), a red-pen-checked reason list
 * right. Reads content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <span class="note" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="why-item">
            <span class="why-check" aria-hidden="true">&#10003;</span>
            <span class="why-copy">
              <strong data-field={`why.items.${i}.title`}>{item.title}</strong>
              {(item.body ?? item.desc ?? item.description) && (
                <span class="why-body" data-field={`why.items.${i}.body`}> {item.body ?? item.desc ?? item.description}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-h { font-size: clamp(32px, 5vw, 52px); color: var(--ink); }
  .why-list { list-style: none; display: grid; gap: 20px; }
  .why-item { display: grid; grid-template-columns: 34px 1fr; gap: 12px; }
  .why-check { color: var(--red-pen); font-weight: 700; font-size: 20px; line-height: 1.3; }
  .why-copy strong { color: var(--ink); }
  .why-body { color: var(--ink-soft); }
</style>
