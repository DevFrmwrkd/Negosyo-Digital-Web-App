---
/**
 * education / CredentialsAT — "qualified & safe" row on the paper band: a set of
 * bordered .cred cards, each with a soft-tile badge holding a decorative
 * mortarboard glyph, an ink title and a muted note. Reads
 * content.credentials.items (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="sec creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="eyebrow" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="bdg" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
            </div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--paper); }
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 26px 22px; }
  .cred .bdg { width: 42px; height: 42px; border-radius: 10px; background: var(--paper2); display: flex; align-items: center; justify-content: center; color: var(--navy); margin-bottom: 14px; }
  .cred .bdg svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 1.7; }
  .cred h4 { font-size: 16px; color: var(--ink); margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--muted); margin: 0; font-family: var(--sans); }
</style>
