---
/**
 * education / CredentialsAJ — thin permits/registration row rendered as a
 * dot-separated flowing list (the design's "DTI-registered · business permit ·
 * PRC-licensed teachers · child protection policy"). Each item's `title` is
 * editable; an optional `desc` renders as a muted caption. tag / headline
 * render above only when provided (the design ships a bare row).
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <span class="note" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <span class="cred-item">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 30px 0; border-top: 2px solid var(--line); }
  .cred-head { margin-bottom: 18px; }
  .cred-h { font-size: clamp(28px, 4vw, 46px); color: var(--ink); margin-top: 10px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: baseline; font-size: 14px; color: var(--ink-soft); }
  .cred-item { display: inline-flex; flex-direction: column; }
  .cred-row .sep { color: var(--line); }
  .cred-desc { color: var(--ink-soft); opacity: .72; font-size: 12.5px; margin-top: 2px; }
</style>
