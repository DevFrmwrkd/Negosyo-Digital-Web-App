---
/**
 * education / CtaBandAT — full-width navy closer, centred: "enrol a student".
 * Navy ground with a highlighter eyebrow, oversized serif headline and up to
 * three CTAs (highlighter fill + ghosts, recoloured for the navy band in
 * PageAT's global block). cta3 is the optional third action. The section anchors
 * #enrol for the hero / nav CTA.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#location';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="sec cta-band" id="enrol">
    <div class="wrap">
      {tag && <span class="eyebrow" data-field="ctaBand.tag">{tag}</span>}
      {headline && <h2 class="cta-h" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { background: var(--navy); color: var(--card); text-align: center; }
  .cta-band .eyebrow { display: block; color: var(--hi); margin-bottom: 14px; }
  .cta-h { font-size: clamp(34px,5vw,66px); color: var(--card); margin-bottom: 16px; }
  .cta-sub { color: #c3ccdc; max-width: 52ch; margin: 0 auto 26px; font-family: var(--sans); }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
