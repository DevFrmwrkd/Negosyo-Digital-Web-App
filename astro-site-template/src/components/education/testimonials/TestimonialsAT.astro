---
/**
 * education / TestimonialsAT — "kind words" on the paper band. Bordered .quote
 * cards, each opened by a row of highlighter-yellow stars (decorative), the
 * quote in warm serif, and an attribution line. Reads content.testimonials.items
 * (canonical `who` + `role`, legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="sec quotes" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal">
              <div class="stars" aria-hidden="true">★★★★★</div>
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes { background: var(--paper); }
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .quotes-grid { grid-template-columns: 1fr; } }
  .quote { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 28px 26px; position: relative; }
  .quote .stars { color: var(--hi); letter-spacing: 2px; font-size: 15px; }
  .quote p { font-family: var(--serif); font-size: 19px; line-height: 1.45; color: var(--ink); margin: 12px 0; }
  .quote .who { font-size: 13px; color: var(--muted); font-weight: 600; font-family: var(--sans); }
</style>
