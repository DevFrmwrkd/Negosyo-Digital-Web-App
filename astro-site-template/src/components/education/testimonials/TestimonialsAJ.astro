---
/**
 * education / TestimonialsAJ — "from the guestbook" quote cards on the warm
 * band. Notebook blockquote cards with red-pen attribution. Reads
 * content.testimonials.items (canonical `who` + `role`, legacy
 * `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="test-sect" id="reviews">
    <div class="wrap">
      {tag && <span class="note" data-field="testimonials.tag">{tag}</span>}
      {headline && <h2 class="test-h" data-field="testimonials.headline" set:html={headline}></h2>}
      <div class="test-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <blockquote class="card test-card reveal">
              <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
              {(who || role) && (
                <footer>
                  {who && <span data-field={`testimonials.items.${i}.who`}>{who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </footer>
              )}
            </blockquote>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .test-sect { background: var(--band); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .test-h { font-size: clamp(32px, 5vw, 52px); margin: 14px 0 28px; color: var(--ink); }
  .test-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .test-card p { font-size: 15px; margin-bottom: 12px; color: var(--ink); }
  .test-card footer { font-weight: 700; font-size: 13px; color: var(--red-pen); }
  /* Single-column quote cards on a phone. */
  @media (max-width: 760px) {
    .test-grid { grid-template-columns: 1fr; }
  }
</style>
