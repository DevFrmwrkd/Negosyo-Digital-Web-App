---
/**
 * education / GalleryAT — "a look around" taped-photo mosaic on the paper-2
 * band. Tiles are taped .plate frames (a cycling .scene-* duotone stands in as
 * the designed fallback; a photo layers over it via data-image-field when set),
 * arranged in lp-08's mosaic where the first tile spans 2×2 and two wide tiles
 * span two columns. Alternating tiles tilt left/right. The section auto-hides
 * only when there are no items at all.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-study', 'scene-board', 'scene-books', 'scene-tutor', 'scene-desk', 'scene-grad'];
const spanFor = (i: number) => (i % 6 === 0 ? 'n1' : i % 6 === 3 ? 'n4' : i % 6 === 5 ? 'n6' : '');
---
{items.length > 0 && (
  <section class="sec gallery" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
        {sub && <p class="reveal d1" data-field="gallery.sub">{sub}</p>}
      </div>
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`taped ${spanFor(i)}`.trim()}>
            <span class="tape" aria-hidden="true"></span>
            <div class="plate">
              <div class={`ph ${scenes[i % scenes.length]}`} role="img" aria-label="Studio photo" data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            </div>
            {item.caption && <figcaption data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { background: var(--paper2); }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 180px; gap: 16px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .taped { padding: 8px 8px 30px; position: relative; }
  .g-grid .taped .plate { position: absolute; inset: 8px 8px 30px; }
  .g-grid .taped figcaption { font-size: 11px; bottom: 8px; }
  .g-grid .taped:nth-child(2n) { transform: rotate(1.5deg); }
  .g-grid .taped:nth-child(2n+1) { transform: rotate(-1.5deg); }
  .n1 { grid-column: span 2; grid-row: span 2; }
  .n4 { grid-column: span 2; }
  .n6 { grid-column: span 2; }
  .g-grid .plate .ph { transition: transform .6s; }
  .g-grid .taped:hover .ph { transform: scale(1.06); }
</style>
