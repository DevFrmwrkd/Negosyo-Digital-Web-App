---
/**
 * education / HeaderAJ — the design's top bar: Lora serif brand (left) and a
 * click-to-call phone (right), on an ink-ruled baseline. Gains a solid paper
 * ground once scrolled (toggled by PageAJ's inline scroll handler via
 * header.nav.scrolled). Optional nav links render when layout.navLinks is set.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" data-field="footer.brand">{brand}</a>
    {navLinks.length > 0 && (
      <nav class="nav-links" aria-label="Main">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
      </nav>
    )}
    {phone && (
      <a href={`tel:${phoneDigits}`} class="nav-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
    )}
  </div>
</header>
<style>
  header.nav {
    position: sticky; top: 0; left: 0; right: 0; z-index: 50;
    border-bottom: 2px solid var(--ink);
    transition: background .3s ease, box-shadow .3s ease;
  }
  header.nav.scrolled {
    background: rgba(251,248,241,.94);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 0 var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding-block: 20px;
  }
  .brand {
    font-family: var(--serif); font-weight: 600; font-size: 21px; color: var(--ink);
  }
  .brand:hover { color: var(--ink); }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a {
    font-family: var(--sans); font-weight: 500; font-size: 14px; color: var(--ink-soft);
    transition: color .2s;
  }
  .nav-links a:hover { color: var(--red-pen); }
  .nav-phone { font-family: var(--sans); font-weight: 700; font-size: 14px; color: var(--ink); }
  .nav-phone:hover { color: var(--red-pen); }
  @media (max-width: 720px) { .nav-links { display: none; } }
</style>
