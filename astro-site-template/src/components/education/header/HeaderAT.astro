---
/**
 * education / HeaderAT — sticky bone-paper nav bar with a navy monogram tile
 * beside the serif brand, mono-uppercase links, and a filled "enrol" CTA.
 * Hides on scroll-down / reappears on scroll-up (toggled by PageAT's inline
 * scroll handler via header.nav.hide).
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const monogram = String(brand).trim().charAt(0) || 'T';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
// Reuse the hero's primary CTA as the nav "enrol" action so it stays in sync.
const hero = (content as any).hero || {};
const ctaText = hero.cta1?.text || '';
const ctaHref = hero.cta1?.href || '#enrol';
---
<header class="nav">
  <div class="nav-in">
    <a href="#main" class="brand" data-field="footer.brand"><span class="mk" aria-hidden="true">{monogram}</span><span class="bn">{brand}</span></a>
    {(navLinks.length > 0 || ctaText) && (
      <>
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu-AT">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav-links" id="nav-menu-AT" aria-label="Primary">
          {navLinks.map((link, i) => (
            <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
          ))}
          {ctaText && <a href={ctaHref} class="nave" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{ctaText}</a>}
        </nav>
      </>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('header.nav');
    if (!header) return;
    var burger = header.querySelector('.nav-burger');
    var menu = header.querySelector('.nav-links');
    if (!burger || !menu) return;
    function setOpen(open) {
      header.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!header.classList.contains('open'));
    });
    // Tapping any link closes the drawer.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Esc closes and returns focus to the toggle.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && header.classList.contains('open')) { setOpen(false); burger.focus(); }
    });
  })();
</script>
<style>
  header.nav {
    position: sticky; top: 0; z-index: 60; background: rgba(251,247,236,.9);
    backdrop-filter: blur(8px); border-bottom: 2px solid var(--navy); transition: transform .3s;
  }
  header.nav.hide { transform: translateY(-100%); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding: 14px 30px; }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand .mk { width: 32px; height: 32px; background: var(--navy); color: var(--hi); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-weight: 700; border-radius: 8px; font-size: 18px; flex-shrink: 0; }
  .brand .bn { font-family: var(--serif); font-weight: 600; font-size: 23px; }
  .nav-links { display: flex; gap: 26px; align-items: center; }
  .nav-links a { font-size: 15px; color: var(--graphite); font-weight: 500; }
  .nav-links a:hover { color: var(--coral); }
  .nav-links .nave { background: var(--navy); color: var(--card); padding: 9px 18px; border-radius: 8px; font-weight: 600; font-size: 14px; }
  .nav-links .nave:hover { background: var(--navy-d); color: var(--card); }

  /* Hamburger — hidden on desktop, revealed <=760px. Composition-book navy
     outline so it reads as part of the "Ruled" palette. */
  .nav-burger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 44px; height: 44px; padding: 11px; margin: -4px 0;
    background: transparent; border: 2px solid var(--navy); border-radius: 9px;
    cursor: pointer; flex-shrink: 0;
  }
  .nav-burger span { display: block; width: 100%; height: 2px; background: var(--navy); border-radius: 2px; transition: transform .3s ease, opacity .2s ease; }

  @media (max-width: 760px) {
    .nav-in { padding: 12px 20px; }
    .nav-burger { display: flex; }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Link list collapses into a full-width drawer under the bar, painted in
       the design's own bone-paper + navy-ink tokens so it matches the header. */
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 2px solid var(--navy);
      box-shadow: 0 24px 40px -22px rgba(31,42,68,.55);
      padding: 6px 0 12px;
      max-height: calc(100vh - 64px); overflow-y: auto;
      display: none;
    }
    header.nav.open .nav-links { display: flex; }
    /* Keep the open drawer visible even if the scroll-hide handler fires. */
    header.nav.open { transform: none; }
    .nav-links a { font-size: 17px; min-height: 48px; display: flex; align-items: center; padding: 6px 22px; color: var(--ink); }
    .nav-links a:hover { color: var(--coral); }
    .nav-links .nave { margin: 10px 22px 4px; justify-content: center; min-height: 48px; font-size: 15px; color: var(--card); }
  }
</style>
