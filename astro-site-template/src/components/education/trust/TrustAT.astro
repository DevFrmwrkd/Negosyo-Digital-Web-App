---
/**
 * education / TrustAT — navy credibility strip under the hero: a row of ruled
 * cells, each with an oversized highlighter-yellow serif figure/statement and a
 * small caption (lp-08's "Small · rating · LPT · DepEd" band).
 *
 * Volatile Google rating slots have no dedicated field in the data model, so
 * they are expressed as ordinary trust cells (num renders via set:html so a cell
 * whose num is "★★★★★" still styles correctly — GBP-bound rating maps here).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust">
    <div class="wrap">
      {cells.map((cell, i) => (
        <div class="c reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust { background: var(--navy); color: #eaf0f8; }
  .trust .wrap { display: grid; grid-template-columns: repeat(4,1fr); padding: 0 30px; }
  @media (max-width: 760px) {
    .trust .wrap { grid-template-columns: repeat(2,1fr); }
    /* 2-col mobile grid: clear the stray divider on the right-hand column so the
       strip isn't asymmetric (a faint line hugging the right inner edge). */
    .trust .c:nth-child(2n) { border-right: none; }
  }
  .trust .c { padding: 40px 24px; border-right: 1px solid rgba(234,240,248,.16); }
  .trust .c:last-child { border-right: none; }
  .trust .c .n { font-family: var(--serif); font-size: clamp(30px,3.6vw,44px); color: var(--hi); line-height: 1; }
  .trust .c .t { font-size: 13px; color: #c3ccdc; margin-top: 10px; }
  .trust .c :global(.stars) { color: var(--hi); letter-spacing: 2px; font-size: 22px; }
</style>
