---
/**
 * salonspa / CredentialsAN — "trained & registered" row on the paper band: an
 * outlined 4-up grid of .cred tiles, each led by a Didot mark (decorative, ✦ on
 * the last), an uppercase label and a muted note. Reads
 * content.credentials.items (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="sec creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="eyebrow" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="k" aria-hidden="true">{i === items.length - 1 ? '✦' : '✓'}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--paper); }
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; border: 1px solid var(--line); }
  .cred { padding: 34px 28px; border-right: 1px solid var(--line); }
  .cred:nth-child(4n) { border-right: none; }
  .cred .k { font-family: var(--disp); font-size: 30px; color: var(--nude-deep); margin-bottom: 10px; }
  .cred h4 { font-family: var(--label); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 6px; }
  .cred p { color: var(--muted); font-size: 14px; margin: 0; }
  @media (max-width: 760px) {
    .cred-row { grid-template-columns: repeat(2,1fr); }
    .cred { padding: 26px 22px; }
    .cred:nth-child(2n) { border-right: none; }
    .cred:not(:nth-last-child(-n+2)) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .cred-row { grid-template-columns: 1fr; }
    .cred { border-right: none; border-bottom: 1px solid var(--line); }
    .cred:last-child { border-bottom: none; }
  }
</style>
