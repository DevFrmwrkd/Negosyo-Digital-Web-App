---
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const ctaText = (content as any).navCtaText || 'Book a visit';
const ctaHref = (content as any).navCtaHref || '#visit';
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" data-field="footer.brand">{brand}</a>
    <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-k-menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-menu" id="nav-k-menu">
      {navLinks.length > 0 && (
        <div class="nav-links">
          {navLinks.map((link, i) => (
            <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
          ))}
        </div>
      )}
      <div class="nav-cta">
        {phone && (
          <a href={`tel:${phoneDigits}`} class="nav-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
        )}
        <a href={ctaHref} class="btn btn--accent" data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>
      </div>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-menu');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping any link or the CTA.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    transition: background .3s ease, padding .3s ease, border-color .3s ease;
    border-bottom: 1px solid transparent;
  }
  header.nav.scrolled {
    background: rgba(var(--paper-rgb), .94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding-block: 18px;
  }
  .brand {
    font-family: var(--serif); font-size: clamp(20px, 2vw, 28px);
    color: var(--ink); letter-spacing: .01em;
  }
  .nav-links { display: flex; gap: 28px; align-items: center; }
  .nav-links :global(a) {
    font-family: var(--sans); text-transform: uppercase; letter-spacing: .18em;
    font-size: 11.5px; color: var(--ink); opacity: .72; transition: opacity .2s, color .2s;
  }
  .nav-links :global(a:hover) { opacity: 1; color: var(--accent); }
  .nav-cta { display: flex; align-items: center; gap: 16px; }
  .nav-phone {
    font-family: var(--sans); letter-spacing: .04em; font-size: 13.5px;
    color: var(--ink); display: flex; align-items: center; gap: 8px;
  }
  /* The drawer wrapper is transparent to layout on desktop: `display: contents`
     hoists .nav-links + .nav-cta back to being direct flex children of
     .nav-inner, so the space-between bar looks byte-identical to before. */
  .nav-menu { display: contents; }
  /* Hamburger trigger — hidden on desktop, revealed as the <=760px control. */
  .nav-burger { display: none; }
  @media (max-width: 760px) { .nav-links { display: none; } }

  @media (max-width: 760px) {
    /* 44px tap target with three ink bars that morph to an X when open. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -10px;
      background: transparent; border: 0; cursor: pointer; color: var(--ink);
    }
    .nav-burger span {
      display: block; width: 24px; height: 2px; background: currentColor;
      border-radius: 2px; transition: transform .3s ease, opacity .3s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Give the bar a solid ground while the drawer is open (it can sit over
       the hero at scroll-top where the bar is otherwise transparent). */
    header.nav.open {
      background: rgba(var(--paper-rgb), .97); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    /* Full-width drawer beneath the bar, painted in the variant's own paper +
       line tokens so every K–O palette themes it automatically. */
    .nav-menu {
      display: flex; flex-direction: column; gap: 0;
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--paper); border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(0, 0, 0, .35);
      max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-menu {
      max-height: calc(100vh - 62px); overflow-y: auto; opacity: 1; visibility: visible;
    }
    /* Re-enable the links inside the drawer (the 760px rule above hid them). */
    .nav-links { display: flex; flex-direction: column; gap: 0; }
    .nav-links :global(a) {
      display: flex; align-items: center; min-height: 52px;
      padding: 8px 22px; font-size: 14px; opacity: 1; letter-spacing: .12em;
      border-top: 1px solid var(--line);
    }
    .nav-cta {
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 14px 22px 18px; border-top: 1px solid var(--line);
    }
    .nav-phone { display: flex; justify-content: center; min-height: 48px; }
    .nav-cta .btn { width: 100%; justify-content: center; min-height: 50px; }
  }
</style>
