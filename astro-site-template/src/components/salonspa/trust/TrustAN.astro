---
/**
 * salonspa / TrustAN — dark ink credibility strip under the hero: a row of Didot
 * stat/statement cells ruled with bone hairlines (lp-02's "Small · rating · 1:1
 * · Trained" band).
 *
 * The GBP-bound rating cell has no field in the data model, so it is expressed
 * as an ordinary trust cell — num renders via set:html so a cell whose num is a
 * "★★★★★" run still styles through the .stars class.
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust">
    <div class="wrap">
      {cells.map((cell, i) => (
        <div class="c reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust { background: var(--ink); color: var(--bone); }
  .trust .wrap { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; }
  @media (max-width: 760px) { .trust .wrap { grid-template-columns: repeat(2,1fr); } }
  .trust .c { padding: 52px 30px; border-right: 1px solid rgba(239,233,223,.14); }
  .trust .c:last-child { border-right: none; }
  .trust .c .n { font-family: var(--disp); font-size: clamp(34px,4vw,52px); color: var(--nude); line-height: 1; }
  .trust .c .t { font-family: var(--label); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; opacity: .8; margin-top: 12px; }
  .trust :global(.stars) { color: var(--brass); letter-spacing: 3px; font-size: 22px; }
  @media (max-width: 760px) {
    .trust .c { padding: 36px 20px; }
    .trust .c:nth-child(2n) { border-right: none; }
  }
</style>
