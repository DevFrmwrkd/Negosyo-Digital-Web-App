---
/**
 * salonspa / FooterAN — dark ink footer (Didot brand, nude-warm links) plus
 * lp-02's floating Messenger pill. Every column auto-hides when empty,
 * collapsing to the design's minimal footer.
 *
 * The floating message pill reuses the hero's primary CTA (content.hero.cta1) —
 * the same "message to book" action — so it stays editable and in sync; it
 * renders only when that CTA (or the CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const f = (content as any).footer || {};
const brand = f.brand || layout.businessName || 'Your Business';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const hoursRows: Array<{ day: string; time: string }> = Array.isArray(f.hours) ? f.hours : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating message pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
const msgHref = hero.cta1?.href || cband.cta1?.href || '';
const msgText = hero.cta1?.text || cband.cta1?.text || 'Message us';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="fcol">
        <div class="brand" data-field="footer.brand">{brand}</div>
        {blurb && <p data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="fcol">
          <div class="fh">Visit</div>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <p><a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a></p>
              : <p data-field={`footer.visit.lines.${i}`}>{line}</p>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="fcol">
          <div class="fh">Book</div>
          {explore.map((l, i) => (
            <p><a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a></p>
          ))}
        </div>
      )}
      {hoursRows.length > 0 && (
        <div class="fcol foot-hours">
          <div class="fh">Hours</div>
          {hoursRows.map((row, i) => (
            <div class="hrow">
              <span data-field={`footer.hours.${i}.day`}>{row.day}</span>
              <span data-field={`footer.hours.${i}.time`}>{row.time}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-btm">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && (
  <a class="msgr" href={msgHref} rel="noopener" aria-label="Message us" data-field="hero.cta1.text" data-href-field="hero.cta1.href">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.3 2 2 6.2 2 11.6c0 3 1.4 5.6 3.7 7.3v3.6l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.5S17.7 2 12 2zm1 12.3l-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8z"/></svg>
    {msgText}
  </a>
)}
<style>
  footer { background: var(--ink); color: var(--bone); padding: 80px 0 34px; }
  .foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 44px; padding-bottom: 44px; border-bottom: 1px solid rgba(239,233,223,.16); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 30px; } }
  footer .brand { font-family: var(--disp); color: var(--bone); font-size: 34px; letter-spacing: .06em; margin-bottom: 14px; }
  footer a { color: var(--bone); opacity: .82; }
  footer a:hover { color: var(--nude); opacity: 1; }
  footer .fh { font-family: var(--label); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--nude); margin-bottom: 14px; }
  .fcol p { font-size: 15px; opacity: .82; margin: 0 0 8px; }
  .foot-social { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
  .foot-social a { font-family: var(--label); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: 1; border: 1px solid rgba(239,233,223,.24); padding: 6px 12px; transition: color .2s, border-color .2s; }
  .foot-social a:hover { color: var(--nude); border-color: var(--nude); }
  .foot-hours .hrow { display: flex; justify-content: space-between; gap: 16px; max-width: 260px; font-size: 15px; opacity: .82; padding: 2px 0; }
  .foot-btm { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 24px; font-family: var(--label); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

  .msgr {
    position: fixed; right: 20px; bottom: 20px; z-index: 70; display: inline-flex; align-items: center; gap: 10px;
    background: var(--ink); color: var(--paper); padding: 13px 20px; border-radius: 100px;
    font-family: var(--label); font-weight: 600; font-size: 13px; letter-spacing: .1em; text-transform: uppercase;
    box-shadow: 0 14px 34px -12px rgba(20,18,16,.7); transition: transform .3s;
  }
  .msgr:hover { transform: translateY(-3px); color: var(--paper); }
  .msgr svg { width: 18px; height: 18px; fill: currentColor; }
</style>
