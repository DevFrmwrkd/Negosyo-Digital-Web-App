---
/**
 * salonspa / GalleryAN — "recent chairs" editorial mosaic on the paper band.
 * Tiles are art-directed .plate frames (a cycling .scene-* duotone stands in as
 * the designed fallback; a photo layers over it via data-image-field when set),
 * arranged in lp-02's ragged 6-column grid where the first tile runs tall. The
 * section auto-hides only when there are no items at all.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-portrait', 'scene-color', 'scene-detail', 'scene-hands', 'scene-tools', 'scene-interior'];
const spans = ['ga', 'gb', 'gc', 'gd', 'ge'];
---
{items.length > 0 && (
  <section class="sec gallery" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
      </div>
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate grain ${spans[i % spans.length]}`}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { background: var(--paper); }
  .gal-sub { max-width: 52ch; color: var(--muted); margin: -36px 0 32px; font-size: 16px; }
  .g-grid { display: grid; grid-template-columns: repeat(6,1fr); grid-auto-rows: 150px; gap: 12px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate .ph { transition: transform 1s cubic-bezier(.16,1,.3,1); }
  .g-grid .plate:hover .ph { transform: scale(1.07); }
  .ga { grid-column: span 2; grid-row: span 3; }
  .gb { grid-column: span 2; grid-row: span 2; }
  .gc { grid-column: span 2; grid-row: span 2; }
  .gd { grid-column: span 3; grid-row: span 2; }
  .ge { grid-column: span 3; grid-row: span 2; }
  @media (max-width: 820px) { .ga, .gb, .gc, .gd, .ge { grid-column: span 2; grid-row: span 2; } }
</style>
