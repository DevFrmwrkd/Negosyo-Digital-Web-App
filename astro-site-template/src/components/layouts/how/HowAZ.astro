---
/**
 * layouts / HowAZ — the "from first visit to done" kiosk split: a centred copy
 * column of steps (each led by an oversized italic bone serif numeral, an
 * EB Garamond title and a muted body line) beside a sticky art-directed image
 * column whose .sc4 duotone "scene" stands in until how.image is set. Reads
 * content.how.steps (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
const image = how.image || (Array.isArray(how.images) && how.images[0]) || '';
const imageCaption = how.imageCaption || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="split how">
    <div class="panecopy how-copy">
      {tag && <span class="eyebrow" style="display:block;margin-bottom:14px;" data-field="how.tag">{tag}</span>}
      {headline && <h2 class="how-h" data-field="how.headline" set:html={headline}></h2>}
      <div class="how-list">
        {steps.map((step, i) => (
          <div class="st reveal">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="stick how-stick">
      <div class="ph sc4" role="img" aria-label="Process" data-image-field="how.image" style={image ? `background-image:url('${image}');` : ''}></div>
      {imageCaption && <span class="cap" data-field="how.imageCaption">{imageCaption}</span>}
    </div>
  </section>
)}
<style>
  .how-h { font-size: clamp(30px,4vw,54px); color: var(--ink); margin-bottom: 30px; }
  .how-list .st { padding-left: 50px; position: relative; margin-bottom: 26px; }
  .how-list .st:last-child { margin-bottom: 0; }
  .how-list .k { position: absolute; left: 0; top: -4px; font-family: var(--serif); font-style: italic; font-size: 30px; color: var(--accent); line-height: 1; }
  .how-list h3 { font-size: 18px; color: var(--ink); margin-bottom: 6px; }
  .how-list p { font-size: 14px; color: var(--muted); margin: 0; }
</style>
