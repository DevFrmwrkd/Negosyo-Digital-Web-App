---
/**
 * layouts / HowAX — brutalist "how it works": a sec-bar over a four-cell
 * bordered row of steps, each with a bone mono "STEP N" chip, an uppercase
 * title and a dim body line. Mirrors lp-21's "HOW / brutalist" block.
 *
 * Reads content.how.steps (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const headline = how.headline || 'How it works';
const idx = how.idx || '[ PROCESS ]';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="grid-sec" aria-label="How it works">
    <div class="sec-bar">
      <h2 data-field="how.headline" set:html={headline}></h2>
      <span class="idx" data-field="how.idx">{idx}</span>
    </div>
    <div class="how-cells">
      {steps.map((step, i) => (
        <div class="cell reveal" data-delay={i}>
          <span class="k" aria-hidden="true">STEP {i + 1}</span>
          <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
          {(step.body ?? step.desc ?? step.description) && (
            <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
          )}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .how-cells { display: grid; grid-template-columns: repeat(4,1fr); }
  .how-cells .cell { padding: 30px 22px; border-right: 2px solid var(--line); }
  .how-cells .cell:last-child { border-right: none; }
  .how-cells .k { font-family: var(--mono); font-size: 14px; background: var(--accent); color: var(--on-accent); display: inline-block; padding: 3px 9px; }
  .how-cells h3 { text-transform: uppercase; font-size: 15px; margin: 12px 0 6px; }
  .how-cells p { font-size: 12.5px; color: var(--muted); margin: 0; }
  @media (max-width: 980px) {
    .how-cells { grid-template-columns: repeat(2,1fr); }
    .how-cells .cell { border-bottom: 2px solid var(--line); }
    .how-cells .cell:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 760px) {
    .how-cells { grid-template-columns: 1fr; }
    .how-cells .cell { border-right: none; padding: 30px 18px; }
    .how-cells .cell:last-child { border-bottom: none; }
  }
</style>
