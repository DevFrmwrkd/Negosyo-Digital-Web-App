---
/**
 * layouts / FooterAV — the footer as one wide bento surface card (Spectral
 * brand, muted columns) plus lp-23's floating cobalt "message" pill. Every
 * column auto-hides when empty, collapsing to the design's minimal footer.
 *
 * The floating pill reuses the hero's primary CTA (content.hero.cta1) — the
 * same "message to reserve/order" action — so it stays editable and in sync;
 * it renders only when that CTA (or the CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const f = (content as any).footer || {};
const brand = f.brand || layout.businessName || 'Your Business';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const hoursRows: Array<{ day: string; time: string }> = Array.isArray(f.hours) ? f.hours : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating message pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
const msgHref = hero.cta1?.href || cband.cta1?.href || '';
const msgText = hero.cta1?.text || cband.cta1?.text || 'Message us';
---
<footer>
  <div class="wrap">
    <div class="fg reveal">
      <div class="fcol">
        <div class="bn" data-field="footer.brand">{brand}</div>
        {blurb && <p data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="fcol">
          <div class="fh">Visit</div>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <p><a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a></p>
              : <p data-field={`footer.visit.lines.${i}`}>{line}</p>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="fcol">
          <div class="fh">Say hello</div>
          {explore.map((l, i) => (
            <p><a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a></p>
          ))}
        </div>
      )}
      {hoursRows.length > 0 && (
        <div class="fcol foot-hours">
          <div class="fh">Hours</div>
          {hoursRows.map((row, i) => (
            <div class="hrow">
              <span data-field={`footer.hours.${i}.day`}>{row.day}</span>
              <span data-field={`footer.hours.${i}.time`}>{row.time}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="fbtm">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && (
  <a class="msgr" href={msgHref} rel="noopener" aria-label="Message us" data-field="hero.cta1.text" data-href-field="hero.cta1.href">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.3 2 2 6.2 2 11.6c0 3 1.4 5.6 3.7 7.3v3.6l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.5S17.7 2 12 2zm1 12.3l-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8z"/></svg>
    {msgText}
  </a>
)}
<style>
  footer { padding: 50px 0 60px; }
  .fg {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 36px; display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .fcol { min-width: 0; }
  .fg .bn { font-family: var(--serif); font-size: 22px; color: var(--ink); margin-bottom: 6px; }
  .fg p { font-family: var(--sans); font-size: 13px; color: var(--ink-soft); margin: 6px 0 0; }
  .fg a { color: var(--ink-soft); }
  .fg a:hover { color: var(--accent); }
  .fh { font-family: var(--sans); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .foot-social { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
  .foot-social a {
    font-family: var(--sans); font-size: 9px; letter-spacing: .16em; text-transform: uppercase;
    border: 1px solid var(--line); padding: 6px 12px; border-radius: 100px; transition: color .2s, border-color .2s;
  }
  .foot-social a:hover { color: var(--accent); border-color: var(--accent); }
  .foot-hours .hrow { display: flex; justify-content: space-between; gap: 16px; max-width: 240px; font-size: 13px; color: var(--ink-soft); padding: 2px 0; }
  .fbtm { text-align: center; margin-top: 22px; font-family: var(--sans); font-size: 9px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); display: flex; justify-content: center; gap: 10px 20px; flex-wrap: wrap; }

  .msgr {
    position: fixed; right: 22px; bottom: 22px; z-index: 70; display: inline-flex; align-items: center; gap: 10px;
    background: var(--accent); color: var(--on-accent); padding: 14px 22px; border-radius: 100px;
    font-family: var(--sans); font-weight: 600; font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
    box-shadow: 0 18px 44px -14px rgba(var(--accent-rgb),.5); transition: transform .4s;
  }
  .msgr:hover { transform: translateY(-3px); color: var(--on-accent); }
  .msgr svg { width: 16px; height: 16px; fill: currentColor; }
  @media (max-width: 760px) {
    footer { padding: 40px 0 92px; }  /* extra bottom clears the floating pill */
    .fg { padding: 26px; gap: 22px; flex-direction: column; }
    .fbtm { flex-direction: column; gap: 6px; }
    .msgr { right: 14px; bottom: 14px; padding: 12px 18px; }
  }
</style>
