---
/**
 * layouts / PageAW — "Broadsheet" (editorial newspaper archetype).
 *
 * Ported from Local Business Landing Pages v4 / lp-19-food.html. A printed
 * broadsheet look: a centred paper "page" with generous side margins, a big
 * double-ruled serif masthead, a sticky centred nav row, hairline rules
 * between every section, multi-column newspaper text with drop-caps, a
 * "classified" service list and "letters" testimonials. Cormorant Garamond
 * display + Work Sans body on a warm bone ground.
 *
 * REUSABLE LAYOUT (business-agnostic): unlike the earlier bespoke hero ports,
 * AW is built to RECOLOUR cleanly through the theme engine. The source's baked
 * palette is lifted into the STANDARD token vocabulary the theme engine already
 * overrides (--paper / --paper-2 / --card / --ink / --ink-soft / --muted /
 * --line / --accent / --accent-light / --accent-deep + generic aliases). Those
 * tokens carry the source colours as DEFAULTS, so AW looks like lp-19 out of the
 * box but fully recolours when buildOverrideCss injects an admin scheme. Every
 * section component reads ONLY var(--token) — no baked hex lives in a component.
 *
 * CRITICAL specificity note: the size-bearing `.plate` primitive is written as
 * `html[data-page="AW"] :where(.plate)` so per-section height / aspect modifiers
 * (.hero-plate, .gal spans, .dir-map …) at (0,2,0) win over the base instead of
 * being squashed to a base floor. Do not remove the :where().
 *
 * lockVariant: true — only an EXPLICIT admin colour / font pick recolours; with
 * no pick the broadsheet defaults win (we do NOT fall back to the business-type
 * auto map), keeping the archetype visually distinct by default.
 */
import HeaderAW from './header/HeaderAW.astro';
import HeroAW from './hero/HeroAW.astro';
import TrustAW from './trust/TrustAW.astro';
import AboutAW from './about/AboutAW.astro';
import ServicesAW from './services/ServicesAW.astro';
import WhyAW from './why/WhyAW.astro';
import HowAW from './how/HowAW.astro';
import TestimonialsAW from './testimonials/TestimonialsAW.astro';
import GalleryAW from './gallery/GalleryAW.astro';
import FaqAW from './faq/FaqAW.astro';
import AreaAW from './area/AreaAW.astro';
import CredentialsAW from './credentials/CredentialsAW.astro';
import LocationAW from './location/LocationAW.astro';
import CtaBandAW from './ctaBand/CtaBandAW.astro';
import FooterAW from './footer/FooterAW.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#fbf6ec" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-19 "Broadsheet" palette lifted into the STANDARD token vocabulary +
       shared base primitives, scoped to html[data-page="AW"] so they never leak
       to sister designs. The hex values are DEFAULTS; the theme engine's
       buildOverrideCss (emitted below) overrides these same token names when an
       admin picks a colour scheme, so the design recolours cleanly. -->
  <style is:global>
    html[data-page="AW"] {
      /* --- lp-19 native palette, as overridable STANDARD tokens --- */
      --paper: #fbf6ec;          /* page ground */
      --paper-2: #f4ecdd;        /* warm inset panel (directory) */
      --card: #f6eee0;           /* card / hover ground */
      --ink: #201914;            /* primary text */
      --ink-soft: #5a4c40;       /* secondary text */
      --muted: #8a7a68;          /* dim / caption text */
      --line: #e0d2ba;           /* hairline rules */
      --accent: #b4472b;         /* clay — primary accent */
      --accent-light: #d9663a;   /* ember — accent hover / highlight */
      --accent-deep: #8a3320;    /* darkened clay — pressed / deep accent */
      /* Plate (designed photo-fallback) grounds — art-direction, not theme-driven.
         Coloured glows read var(--accent-rgb) so they still recolour with the scheme. */
      --plate-1: #1e1c1a;
      --plate-2: #0a0a0b;
      --on-plate: #f2eee5;       /* light text pinned on the dark plate */
      /* --- type --- */
      --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
      --sans: "Work Sans", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --label: "Work Sans", system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
      --maxw: 1140px;
      /* --- generic aliases (mirrors PageAM) so inherited + engine rules stay legible --- */
      --paper-rgb: 251,246,236; --ink-rgb: 32,25,20; --accent-rgb: 180,71,43;
      --on-accent: #fbf6ec; --on-ink: #f2e8d7; --on-paper: #201914;
    }

    html[data-page="AW"] * { box-sizing: border-box; }
    html[data-page="AW"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AW"] { scroll-behavior: auto; } }
    html[data-page="AW"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 16px; line-height: 1.7;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    }
    html[data-page="AW"] h1, html[data-page="AW"] h2,
    html[data-page="AW"] h3, html[data-page="AW"] h4 {
      margin: 0; font-family: var(--serif); font-weight: 400; line-height: 1.05;
    }
    html[data-page="AW"] p { margin: 0 0 1em; }
    html[data-page="AW"] a { color: var(--accent); text-decoration: none; }
    html[data-page="AW"] a:hover { color: var(--ink); }
    html[data-page="AW"] img { max-width: 100%; display: block; }
    html[data-page="AW"] ::selection { background: var(--accent); color: var(--paper); }

    /* The centred newspaper "page" — everything lives inside one sheet so the
       side margins + hairline rules read as a printed broadsheet column. */
    html[data-page="AW"] .sheet { max-width: var(--maxw); margin: 0 auto; padding: 0 30px; }

    /* skip link */
    html[data-page="AW"] .skip { position: absolute; left: -999px; top: 0; }
    html[data-page="AW"] .skip:focus { left: 8px; top: 8px; background: var(--accent); color: var(--on-accent); padding: 10px 16px; z-index: 100; }

    /* shared editorial chrome */
    html[data-page="AW"] .eyebrow { font-family: var(--label); font-size: 11px; letter-spacing: .34em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
    html[data-page="AW"] .kicker { font-family: var(--label); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); }

    /* letterpress buttons — filled clay / hairline ghost (design signature) */
    html[data-page="AW"] .btn {
      display: inline-block; font-family: var(--label); font-size: 12px; letter-spacing: .18em;
      text-transform: uppercase; padding: 14px 26px; border: 1px solid var(--accent); transition: .35s; cursor: pointer;
    }
    html[data-page="AW"] .btn.f { background: var(--accent); color: var(--on-accent); }
    html[data-page="AW"] .btn.f:hover { background: var(--accent-light); border-color: var(--accent-light); color: var(--on-accent); }
    html[data-page="AW"] .btn.g { color: var(--ink); border-color: var(--line); background: transparent; }
    html[data-page="AW"] .btn.g:hover { border-color: var(--accent); color: var(--accent); }
    html[data-page="AW"] .btnrow { display: flex; gap: 12px; flex-wrap: wrap; }

    /* scroll reveal */
    html[data-page="AW"] .reveal { opacity: 0; transform: translateY(18px); transition: opacity .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1); }
    html[data-page="AW"] .reveal.in { opacity: 1; transform: none; }
    html[data-page="AW"] .reveal[data-delay="1"] { transition-delay: .08s; }
    html[data-page="AW"] .reveal[data-delay="2"] { transition-delay: .16s; }
    html[data-page="AW"] .reveal[data-delay="3"] { transition-delay: .24s; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AW"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* Designed photo frame — :where() so per-section height / aspect modifiers win. */
    html[data-page="AW"] :where(.plate) { position: relative; overflow: hidden; background: var(--plate-1); isolation: isolate; }
    html[data-page="AW"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
    html[data-page="AW"] :where(.plate):hover .ph { transform: scale(1.05); }
    html[data-page="AW"] :where(.plate) figcaption, html[data-page="AW"] :where(.plate) .cap {
      position: absolute; left: 0; bottom: 0; width: 100%; z-index: 3; padding: 11px 14px;
      font-family: var(--label); font-size: 9px; letter-spacing: .26em; text-transform: uppercase;
      color: var(--on-plate); background: linear-gradient(0deg, var(--plate-2), transparent);
    }
    html[data-page="AW"] :where(.plate) .mark {
      position: absolute; top: 12px; right: 14px; z-index: 3; font-family: var(--label); font-size: 9px;
      letter-spacing: .2em; text-transform: uppercase; color: rgba(242,238,229,.72);
      border: 1px solid rgba(242,238,229,.4); padding: 3px 7px;
    }

    /* Duotone "scene" fields — the designed fallback painted behind each photo.
       Clay glows read var(--accent-rgb) so they recolour; the dark ground is
       art-direction. (neutral white texture stays literal — it is grain, not palette.) */
    html[data-page="AW"] .sc1 { background: radial-gradient(70% 60% at 42% 36%, rgba(var(--accent-rgb),.55), transparent 60%), radial-gradient(60% 60% at 76% 78%, rgba(var(--accent-rgb),.28), transparent 62%), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AW"] .sc2 { background: radial-gradient(55% 65% at 60% 40%, rgba(var(--accent-rgb),.5), transparent 60%), repeating-linear-gradient(30deg, rgba(255,255,255,.05) 0 4px, transparent 4px 20px), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AW"] .sc3 { background: radial-gradient(60% 50% at 50% 60%, rgba(var(--accent-rgb),.36), transparent 62%), repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 44px), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AW"] .sc4 { background: conic-gradient(from 210deg at 42% 44%, rgba(var(--accent-rgb),.52), transparent 42%), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AW"] .sc5 { background: radial-gradient(38% 48% at 50% 36%, rgba(255,255,255,.16), transparent 60%), radial-gradient(55% 45% at 50% 74%, rgba(var(--accent-rgb),.46), transparent 64%), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AW"] .sc6 { background: radial-gradient(66% 66% at 44% 42%, rgba(var(--accent-rgb),.48), transparent 62%), linear-gradient(155deg, var(--plate-1), var(--plate-2)); }

    /* section scaffolding — every block is a hairline-ruled newspaper column */
    html[data-page="AW"] section { position: relative; padding: 60px 0; border-bottom: 1px solid var(--line); }
    html[data-page="AW"] .sec-lbl { font-family: var(--label); font-size: 10px; letter-spacing: .34em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; font-weight: 600; }
    html[data-page="AW"] .sec-h { font-family: var(--serif); font-size: clamp(28px,4.4vw,52px); line-height: 1.05; margin-bottom: 34px; }
    html[data-page="AW"] .sec-h em { font-style: italic; color: var(--accent); }

    /* ------------------------------------------------------------------ */
    /* Mobile-first tuning — shared scaffolding only. Per-section grids     */
    /* live in each *AW component with their own <=760px stacking. Desktop  */
    /* rules above are untouched; these take effect at phone widths.        */
    /* ------------------------------------------------------------------ */
    @media (max-width: 760px) {
      html[data-page="AW"] .sheet { padding: 0 20px; }
      html[data-page="AW"] section { padding: 44px 0; }
      html[data-page="AW"] .sec-h { font-size: clamp(24px,6.4vw,40px); margin-bottom: 24px; }
      html[data-page="AW"] .btn { padding: 12px 20px; }
    }
    @media (max-width: 400px) {
      html[data-page="AW"] .sheet { padding: 0 16px; }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet">
    <HeaderAW layout={layout} content={content} />
    <main id="main">
      {visibility.heroSection !== false && <HeroAW content={content} layout={layout} />}
      {visibility.trustBlock !== false && <TrustAW content={content} />}
      {visibility.servicesSection !== false && <ServicesAW content={content} />}
      {visibility.aboutSection !== false && <AboutAW content={content} />}
      {visibility.whyUsBlock !== false && <WhyAW content={content} />}
      {visibility.howItWorksBlock !== false && <HowAW content={content} />}
      {visibility.testimonialsBlock !== false && <TestimonialsAW content={content} />}
      {visibility.gallerySection !== false && <GalleryAW content={content} layout={layout} />}
      {visibility.faqBlock !== false && <FaqAW content={content} />}
      {visibility.serviceAreaBlock !== false && <AreaAW content={content} />}
      {visibility.credentialsBlock !== false && <CredentialsAW content={content} />}
      {visibility.locationBlock !== false && <LocationAW content={content} layout={layout} />}
    </main>
    {visibility.ctaBandBlock !== false && <CtaBandAW content={content} layout={layout} />}
    <FooterAW layout={layout} content={content} />
  </div>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden && ('IntersectionObserver' in window)) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }

      // Broadsheet Leaflet boot — accepts (lat, lng, label) from LocationAW.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords. Reads --accent at runtime so the pin recolours with
      // the active scheme; light Carto tiles match the warm paper ground.
      window.__layoutsAWInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var accent = (getComputedStyle(document.documentElement).getPropertyValue('--accent') || '').trim() || '#b4472b';
        var paper = (getComputedStyle(document.documentElement).getPropertyValue('--paper') || '').trim() || '#fbf6ec';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:15px;height:15px;border-radius:50%;background:' + accent + ';box-shadow:0 0 0 3px ' + paper + ';border:0;"></div>', iconSize: [15, 15], iconAnchor: [8, 8] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
