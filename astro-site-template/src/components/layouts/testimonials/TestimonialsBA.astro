---
/**
 * layouts / TestimonialsBA — the "what locals say" quotes (lp-22 TESTIMONIALS
 * block). A stack of bordered .quote cards on the raised card surface, each a
 * serif italic quote over a brass uppercase attribution. Reads
 * content.testimonials.items (canonical `who` + `role`, legacy
 * `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="p-sec" id="reviews" data-component="TESTIMONIALS" data-variant="panel">
    <span class="idx" aria-hidden="true">06</span>
    {tag && <span class="eyebrow p-eb" data-field="testimonials.tag">{tag}</span>}
    {headline && <h2 class="p-h" data-field="testimonials.headline" set:html={headline}></h2>}
    <div class="quotes-p">
      {items.map((item, i) => {
        const who = item.who ?? item.author ?? item.name;
        const role = item.role ?? item.context;
        return (
          <figure class="reveal" data-delay={String(i % 3)}>
            <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
            {(who || role) && (
              <figcaption>
                {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
              </figcaption>
            )}
          </figure>
        );
      })}
    </div>
  </section>
)}
<style>
  .quotes-p { display: grid; gap: 24px; }
  .quotes-p figure { margin: 0; padding: 26px 28px; border: 1px solid var(--line); border-radius: 3px; background: var(--card); }
  .quotes-p p { font-family: var(--serif); font-style: italic; font-size: 19px; color: var(--ink); line-height: 1.5; }
  .quotes-p figcaption { font-family: var(--sans); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 760px) {
    .quotes-p figure { padding: 22px 20px; }
    .quotes-p p { font-size: 18px; }
  }
</style>
