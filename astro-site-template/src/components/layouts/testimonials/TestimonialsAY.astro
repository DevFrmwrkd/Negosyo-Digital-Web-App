---
/**
 * layouts / TestimonialsAY — "what locals say" three-column editorial quotes
 * (lp-20's .quotes-ed): centred cards, each opened by a large plum serif quote
 * mark (decorative), the quote in warm serif, and an uppercase attribution line.
 * Reads content.testimonials.items (canonical `who` + `role`, legacy
 * `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="quotes" id="reviews">
    <div class="wrap">
      <div class="q-head">
        {tag && <span class="eyebrow s-eb reveal" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="s-h reveal" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-ed">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="reveal" data-delay={String((i % 3) + 1)}>
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption>
                  {who && <span data-field={`testimonials.items.${i}.who`}>{who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes { background: var(--paper); }
  .q-head { text-align: center; }
  .q-head .s-eb { display: block; }
  .quotes-ed { display: grid; grid-template-columns: repeat(3,1fr); gap: 50px; }
  .quotes-ed figure { margin: 0; text-align: center; }
  .quotes-ed figure::before { content: "\201C"; font-family: var(--serif); color: var(--accent); font-size: 52px; display: block; line-height: .5; margin-bottom: 18px; }
  .quotes-ed p { font-family: var(--serif); font-size: 21px; line-height: 1.5; color: var(--ink); }
  .quotes-ed figcaption { font-family: var(--sans); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 820px) { .quotes-ed { grid-template-columns: 1fr; gap: 40px; } }
</style>
