---
/**
 * layouts / TestimonialsAZ — the "what locals say" kiosk split: a sticky
 * art-directed image column (its .sc5 duotone "scene" stands in until
 * testimonials.image is set) beside a centred copy column of bone-ruled quote
 * figures, each in warm italic EB Garamond with an uppercase attribution. Reads
 * content.testimonials.items (canonical `who` + `role`, legacy `author`/`context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
const image = test.image || (Array.isArray(test.images) && test.images[0]) || '';
const imageCaption = test.imageCaption || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="split testimonials" id="reviews">
    <div class="stick test-stick">
      <div class="ph sc5" role="img" aria-label="Regulars" data-image-field="testimonials.image" style={image ? `background-image:url('${image}');` : ''}></div>
      {imageCaption && <span class="cap" data-field="testimonials.imageCaption">{imageCaption}</span>}
    </div>
    <div class="panecopy test-copy">
      {tag && <span class="eyebrow" style="display:block;margin-bottom:14px;" data-field="testimonials.tag">{tag}</span>}
      {headline && <h2 class="test-h" data-field="testimonials.headline" set:html={headline}></h2>}
      <div class="quotes">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal">
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .test-h { font-size: clamp(30px,4vw,54px); color: var(--ink); margin-bottom: 30px; }
  .quote { margin: 0 0 26px; padding-left: 18px; border-left: 2px solid var(--accent); }
  .quote:last-child { margin-bottom: 0; }
  .quote p { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--ink); line-height: 1.5; margin: 0 0 8px; }
  .quote .who { font-family: var(--sans); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 760px) {
    .quote p { font-size: 18px; }
  }
</style>
