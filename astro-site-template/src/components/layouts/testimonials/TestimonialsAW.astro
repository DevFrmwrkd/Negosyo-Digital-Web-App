---
/**
 * layouts / TestimonialsAW — broadsheet "notices & letters": reader quotes laid
 * out in newspaper columns, each a clay-ruled figure with an italic serif quote
 * and an uppercase attribution. Mirrors lp-19's "TESTIMONIALS / broadsheet".
 *
 * Reads content.testimonials.items (quote + canonical who / role, legacy
 * author / name / context).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="testimonials" id="reviews" aria-label="Testimonials">
    {tag && <div class="sec-lbl" data-field="testimonials.tag">{tag}</div>}
    {headline && <h2 class="sec-h" data-field="testimonials.headline" set:html={headline}></h2>}
    <div class="quotes">
      {items.map((item, i) => {
        const who = item.who ?? item.author ?? item.name;
        const role = item.role ?? item.context;
        return (
          <figure class="reveal">
            <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
            {(who || role) && (
              <figcaption>
                {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
              </figcaption>
            )}
          </figure>
        );
      })}
    </div>
  </section>
)}
<style>
  .quotes { column-count: 3; column-gap: 34px; }
  .quotes figure { break-inside: avoid; margin: 0 0 28px; padding-left: 16px; border-left: 2px solid var(--accent); }
  .quotes p { font-family: var(--serif); font-style: italic; font-size: 19px; line-height: 1.5; color: var(--ink); }
  .quotes figcaption { font-family: var(--label); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 820px) { .quotes { column-count: 2; } }
  @media (max-width: 760px) { .quotes { column-count: 1; } .quotes p { font-size: 18px; } }
</style>
