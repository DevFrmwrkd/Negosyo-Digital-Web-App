---
/**
 * layouts / TestimonialsAV — "what locals say" bento of quote tiles, each
 * opened by a cobalt Spectral quote mark (decorative), the quote in warm italic
 * serif and an uppercase cobalt attribution. Reads content.testimonials.items
 * (canonical `who` + `role`, legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="testimonials" id="reviews">
    <div class="wrap">
      <div class="grid">
        <div class="sec-tag reveal">
          {tag && <span class="n" data-field="testimonials.tag">{tag}</span>}
          {headline && <h2 data-field="testimonials.headline" set:html={headline}></h2>}
        </div>
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="tile q-tile reveal">
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .q-tile { grid-column: span 4; margin: 0; }
  .q-tile::before { content: "\201C"; font-family: var(--serif); font-size: 44px; color: var(--accent); display: block; line-height: .4; margin-bottom: 14px; }
  .q-tile p { font-family: var(--serif); font-style: italic; font-size: 19px; color: var(--ink); line-height: 1.5; }
  .q-tile .who { font-family: var(--sans); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 860px) { .q-tile { grid-column: span 12; } }
</style>
