---
/**
 * layouts / ServicesAV — "what's cooking" bento of service tiles, each a
 * rounded surface with an italic cobalt serif index, a Spectral title, a muted
 * description and an outlined category chip. Reads content.services.items
 * (title / desc / tag). The shared .sec-tag carries the section number + head.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
type Item = { title: string; desc?: string; price?: string; duration?: string; tag?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
---
{items.length > 0 && (
  <section class="services" id="services">
    <div class="wrap">
      <div class="grid">
        <div class="sec-tag reveal">
          {tag && <span class="n" data-field="services.tag">{tag}</span>}
          {headline && <h2 data-field="services.headline" set:html={headline}></h2>}
        </div>
        {items.map((item, i) => (
          <div class="tile svc-tile reveal">
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
            {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
            {(item.tag ?? item.duration ?? item.price) && (
              <span class="tag" data-field={`services.items.${i}.tag`}>{item.tag ?? item.duration ?? item.price}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .svc-tile { grid-column: span 4; }
  .svc-tile .n { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--accent); }
  .svc-tile h3 { font-size: 21px; margin: 8px 0; color: var(--ink); }
  .svc-tile p { font-size: 13px; color: var(--muted); margin: 0; }
  .svc-tile .tag {
    display: inline-block; margin-top: 14px; font-family: var(--sans); font-size: 9px;
    letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
    border: 1px solid var(--line); border-radius: 100px; padding: 5px 12px;
  }
  @media (max-width: 860px) { .svc-tile { grid-column: span 6; } }
  @media (max-width: 560px) { .svc-tile { grid-column: span 12; } }
</style>
