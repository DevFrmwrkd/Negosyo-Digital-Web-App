---
/**
 * layouts / FaqAX — brutalist "often asked": a sec-bar over hairline-ruled
 * question blocks (uppercase question, dim answer). Kept as the source's plain
 * stacked list rather than an accordion, faithful to lp-21's "FAQ" block.
 *
 * Reads content.faq.items (q / a). Auto-hides when empty.
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const headline = faq.headline || 'Often asked';
const idx = faq.idx || '[ FAQ ]';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
---
{items.length > 0 && (
  <section class="grid-sec" id="faq" aria-label="FAQ">
    <div class="sec-bar">
      <h2 data-field="faq.headline" set:html={headline}></h2>
      <span class="idx" data-field="faq.idx">{idx}</span>
    </div>
    <div class="faq-b">
      {items.map((item, i) => (
        <div class="qa reveal">
          <h4 data-field={`faq.items.${i}.q`}>{item.q}</h4>
          <p data-field={`faq.items.${i}.a`} set:html={item.a}></p>
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .faq-b .qa { padding: 24px; border-bottom: 2px solid var(--line); }
  .faq-b .qa:last-child { border-bottom: none; }
  .faq-b h4 { font-size: 17px; text-transform: uppercase; margin-bottom: 8px; }
  .faq-b p { font-size: 14px; color: var(--ink-soft); margin: 0; max-width: 72ch; }
  @media (max-width: 760px) {
    .faq-b .qa { padding: 20px 18px; }
    .faq-b h4 { font-size: 16px; }
  }
</style>
