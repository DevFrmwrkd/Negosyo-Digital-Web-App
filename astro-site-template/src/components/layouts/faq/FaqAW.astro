---
/**
 * layouts / FaqAW — broadsheet "often asked": a two-column set of Q/A entries,
 * each a serif question over a muted answer, ruled with hairlines like a
 * newspaper Q&A column. Mirrors lp-19's "FAQ / broadsheet" block.
 *
 * Reads content.faq.items (q / a). The answer renders via set:html.
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
---
{items.length > 0 && (
  <section class="faq" id="faq" aria-label="FAQ">
    {tag && <div class="sec-lbl" data-field="faq.tag">{tag}</div>}
    {headline && <h2 class="sec-h" data-field="faq.headline" set:html={headline}></h2>}
    <div class="faq-grid">
      {items.map((item, i) => (
        <div class="qa reveal">
          <h4 data-field={`faq.items.${i}.q`}>{item.q}</h4>
          <p data-field={`faq.items.${i}.a`} set:html={item.a}></p>
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 44px; }
  .qa { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .qa h4 { font-family: var(--serif); font-size: 19px; margin-bottom: 8px; color: var(--ink); }
  .qa p { font-size: 14px; color: var(--ink-soft); margin: 0; }
  @media (max-width: 760px) { .faq-grid { grid-template-columns: 1fr; gap: 0; } }
</style>
