---
/**
 * layouts / FaqAV — "often asked" bento: two surface tiles, each holding a
 * column of <details> accordions. Spectral summaries with a cobalt "+" that
 * rotates to "×" on open; muted answer copy. The first item opens by default
 * (lp-23's designed state). Reads content.faq.items (q / a).
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const mid = Math.ceil(items.length / 2);
const col1 = items.slice(0, mid);
const col2 = items.slice(mid);
---
{items.length > 0 && (
  <section class="faq" id="faq">
    <div class="wrap">
      <div class="grid">
        <div class="sec-tag reveal">
          {tag && <span class="n" data-field="faq.tag">{tag}</span>}
          {headline && <h2 data-field="faq.headline" set:html={headline}></h2>}
        </div>
        <div class="tile faq-tile reveal">
          {col1.map((item, i) => (
            <details open={i === 0}>
              <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
        {col2.length > 0 && (
          <div class="tile faq-tile reveal">
            {col2.map((item, j) => (
              <details>
                <summary><span data-field={`faq.items.${mid + j}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
                <div class="a" data-field={`faq.items.${mid + j}.a`} set:html={item.a}></div>
              </details>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}
<style>
  .faq-tile { grid-column: span 6; }
  .faq-tile details { border-bottom: 1px solid var(--line); }
  .faq-tile details:last-child { border-bottom: none; }
  .faq-tile summary {
    list-style: none; cursor: pointer; padding: 18px 0; font-family: var(--serif); font-size: 18px;
    color: var(--ink); display: flex; justify-content: space-between; gap: 14px; align-items: center;
  }
  .faq-tile summary::-webkit-details-marker { display: none; }
  .faq-tile summary .pm { color: var(--accent); transition: transform .4s; line-height: 1; }
  .faq-tile details[open] summary .pm { transform: rotate(45deg); }
  .faq-tile .a { padding: 0 0 18px; color: var(--ink-soft); font-size: 14px; }
  @media (max-width: 860px) { .faq-tile { grid-column: span 12; } }
</style>
