---
/**
 * layouts / FaqAZ — the "often asked" kiosk block: a centred single column of
 * <details> accordions. EB Garamond summaries with a bone "+" that rotates to
 * "×" on open; muted answer copy. The first item opens by default (lp-24's
 * designed state). Reads content.faq.items (q / a).
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
---
{items.length > 0 && (
  <section class="blk faq" id="faq">
    <div class="hold">
      {tag && <span class="eyebrow" data-field="faq.tag">{tag}</span>}
      {headline && <h2 data-field="faq.headline" set:html={headline}></h2>}
      <div class="faq-list">
        {items.map((item, i) => (
          <details class="reveal" open={i === 0}>
            <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
            <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary {
    list-style: none; cursor: pointer; padding: 22px 0; font-family: var(--serif); font-size: 20px;
    color: var(--ink); display: flex; justify-content: space-between; gap: 16px; align-items: center;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary .pm { font-family: var(--sans); color: var(--accent); transition: transform .4s; line-height: 1; }
  .faq-list details[open] summary .pm { transform: rotate(45deg); }
  .faq-list .a { padding: 0 0 22px; color: var(--ink-soft); font-size: 14px; max-width: 62ch; }
  @media (max-width: 760px) { .faq-list summary { font-size: 18px; } }
</style>
