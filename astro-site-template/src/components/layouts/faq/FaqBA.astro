---
/**
 * layouts / FaqBA — the "good to know" accordion (lp-22 FAQ block). Serif
 * summaries with a brass "+" that rotates to "×" on open; soft answer copy.
 * The first item opens by default (lp-22's designed state). Reads
 * content.faq.items (q / a). The lp-22 SERVICE-AREA that sat inside this block
 * is lifted into AreaBA per the AM model.
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
---
{items.length > 0 && (
  <section class="p-sec" id="faq" data-component="FAQ" data-variant="panel">
    <span class="idx" aria-hidden="true">07</span>
    {tag && <span class="eyebrow p-eb" data-field="faq.tag">{tag}</span>}
    {headline && <h2 class="p-h" data-field="faq.headline" set:html={headline}></h2>}
    <div class="faq-p">
      {items.map((item, i) => (
        <details class="reveal" open={i === 0}>
          <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
          <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .faq-p details { border-bottom: 1px solid var(--line); }
  .faq-p summary {
    list-style: none; cursor: pointer; padding: 22px 0; font-family: var(--serif); font-size: 20px; color: var(--ink);
    display: flex; justify-content: space-between; gap: 16px; align-items: center;
  }
  .faq-p summary::-webkit-details-marker { display: none; }
  .faq-p summary .pm { color: var(--accent); transition: transform .4s; line-height: 1; }
  .faq-p details[open] .pm { transform: rotate(45deg); }
  .faq-p .a { padding: 0 0 22px; color: var(--ink-soft); font-size: 14px; max-width: 64ch; }
  @media (max-width: 760px) {
    .faq-p summary { font-size: 18px; padding: 18px 0; }
  }
</style>
