---
/**
 * layouts / AboutAY — "who we are" editorial split: an art-directed .plate
 * figure on the left, warm serif copy on the right where the first paragraph
 * carries the plum drop-cap (lp-20's signature). The figure keeps its .sc6
 * duotone as the designed fallback until about.image is set.
 *
 * The SOURCE's standalone PULLQUOTE block folds in here: when about.quote is
 * set it renders as the centred editorial pull band at the foot of the section
 * (kept editable via about.quote). about.imageCaption + about.signature are
 * optional extras that stay hidden when unset (mirrors the AM content model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const lead = about.lead || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
// The lead sentence renders as the drop-cap opener when present; otherwise the
// first paragraph carries the drop-cap.
const bodyParas = lead ? paragraphs : paragraphs.slice(1);
const leadPara = lead || paragraphs[0] || '';
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="about" id="about">
  <div class="wrap">
    <div class="split">
      <figure class="s-fig plate reveal" data-delay="1">
        <div class="ph sc6" role="img" aria-label="About" data-image-field="about.image" style={image ? `background-image:url('${image}');` : ''}></div>
        {imageCaption && <figcaption data-field="about.imageCaption">{imageCaption}</figcaption>}
      </figure>
      <div class="about-copy reveal">
        {tag && <span class="eyebrow s-eb" data-field="about.tag">{tag}</span>}
        {headline && <h2 class="s-h" data-field="about.headline" set:html={headline}></h2>}
        <div class="about-body">
          {leadPara && <p class="dropcap" data-field={lead ? 'about.lead' : 'about.paragraphs.0'} set:html={leadPara}></p>}
          {bodyParas.map((p: string, i: number) => (
            <p data-field={`about.paragraphs.${lead ? i : i + 1}`} set:html={p}></p>
          ))}
        </div>
        {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
      </div>
    </div>
  </div>
  {quote && (
    <div class="pull reveal">
      <div class="wrap">
        <p data-field="about.quote" set:html={quote}></p>
      </div>
    </div>
  )}
</section>
<style>
  .about { background: var(--paper); }
  .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: 70px; align-items: center; }
  .s-fig { aspect-ratio: 4/5; border: 1px solid var(--line); margin: 0; }
  .about-copy .about-body p:first-of-type {
    font-family: var(--serif); font-size: 26px; line-height: 1.45; color: var(--ink);
  }
  .about-copy .about-body .dropcap::first-letter {
    font-family: var(--serif); font-size: 4em; float: left; line-height: .72; padding: 8px 12px 0 0; color: var(--accent);
  }
  .about-copy .about-body p { color: var(--ink-soft); }
  .about-copy .about-body p :global(em) { font-style: italic; color: var(--accent); }
  .about-sign { margin-top: 18px; font-family: var(--serif); font-style: italic; color: var(--muted); }

  /* Folded PULLQUOTE — centred editorial band. */
  .pull { text-align: center; padding: 120px 0 0; margin-top: 90px; border-top: 1px solid var(--line); }
  .pull p { font-family: var(--serif); font-size: clamp(28px,4.6vw,56px); line-height: 1.25; max-width: 20ch; margin: 0 auto; color: var(--ink); }
  .pull p::before { content: "\201C"; }
  .pull p::after { content: "\201D"; }
  .pull p :global(em) { font-style: italic; color: var(--accent); }

  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 760px) {
    .about-copy .about-body p:first-of-type { font-size: 21px; }
    .about-copy .about-body .dropcap::first-letter { font-size: 3.2em; }
    .s-fig { aspect-ratio: 4/3; }
    .pull { padding-top: 64px; margin-top: 54px; }
  }
</style>
