---
/**
 * layouts / AboutBA — the "who we are" story panel (lp-22 ABOUT block). A brass
 * eyebrow + serif section heading, then the story body where the first
 * paragraph is set in large serif and the rest in soft body copy. Optional
 * pull-quote + signature (folded in here per the AM content model) render only
 * when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="p-sec" id="about" data-component="ABOUT" data-variant="panel">
  <span class="idx" aria-hidden="true">01</span>
  {tag && <span class="eyebrow p-eb" data-field="about.tag">{tag}</span>}
  {headline && <h2 class="p-h" data-field="about.headline" set:html={headline}></h2>}
  <div class="about-body reveal">
    {paragraphs.map((p: string, i: number) => (
      <p data-field={`about.paragraphs.${i}`} set:html={p}></p>
    ))}
    {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
    {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
  </div>
</section>
<style>
  .about-body p:first-of-type { font-family: var(--serif); font-size: 24px; line-height: 1.45; color: var(--ink); }
  .about-body p:first-of-type :global(em) { font-style: italic; color: var(--accent); }
  .about-body p { color: var(--ink-soft); max-width: 64ch; }
  .about-quote { font-family: var(--serif); font-style: italic; font-size: clamp(19px,2.2vw,26px); line-height: 1.35; color: var(--accent); margin: 24px 0 0; padding-left: 18px; border-left: 2px solid var(--accent); }
  .about-sign { margin-top: 16px; font-family: var(--serif); font-style: italic; color: var(--muted); }
  @media (max-width: 760px) {
    .about-body p:first-of-type { font-size: 20px; }
  }
</style>
