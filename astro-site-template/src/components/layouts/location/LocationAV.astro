---
/**
 * layouts / LocationAV — "find us" bento: a 5-column NAP info tile beside a
 * 7-column .plate holding a Leaflet map. Mirrors the AM / reference strategy:
 *
 *   1. Build-time lat/lng  → render Leaflet directly via
 *      window.__layoutsAVInitMap(lat, lng, label).
 *   2. Else any address    → client-side Nominatim (OSM) lookup, then Leaflet.
 *   3. Else                 → lp-23's designed cobalt map-face + pinging pin.
 *
 * The designed map-face/pin lives inside #map and shows until Leaflet mounts
 * (the boot clears #map before drawing tiles), so the slot always looks
 * designed. location.mapCaption is an optional plate caption.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const loc = content.location || {};
const tag = loc.tag || '';
const headline = loc.headline || '';
const brand = (content as any).footer?.brand || layout.businessName || '';
const address = loc.address || layout.contact?.address || '';
const addressLines = address ? address.split('\n') : [];
const phone = loc.phone || layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const hours: Array<{ day: string; time: string }> = Array.isArray(loc.hours)
  ? loc.hours
  : (Array.isArray((content as any).footer?.hours) ? (content as any).footer.hours : []);
const dirText = loc.directions?.text || '';
const dirHref = loc.directions?.href || (address
  ? `https://maps.google.com/?q=${encodeURIComponent(address.replace(/\n/g, ' '))}`
  : '#');
const mapCaption = loc.mapCaption || '';
const lat = loc.lat != null
  ? Number(loc.lat)
  : (layout.contact?.lat != null ? Number(layout.contact.lat) : null);
const lng = loc.lng != null
  ? Number(loc.lng)
  : (layout.contact?.lng != null ? Number(layout.contact.lng) : null);
const label = layout.businessName || 'Our location';
const mapAria = `Map showing ${label}`;
const hasCoords = lat != null && lng != null && !isNaN(lat as number) && !isNaN(lng as number);
const hasAddress = !!address;
---
<section class="location" id="location">
  <div class="wrap">
    <div class="grid">
      <div class="sec-tag reveal">
        {tag && <span class="n" data-field="location.tag">{tag}</span>}
        {headline && <h2 data-field="location.headline" set:html={headline}></h2>}
      </div>
      <div class="tile loc-info-tile reveal">
        {brand && (
          <div class="r"><div class="k">The house</div><div class="v" data-field="footer.brand">{brand}</div></div>
        )}
        {address && (
          <div class="r">
            <div class="k">Address</div>
            <div class="v" data-field="location.address">
              {addressLines.map((line: string, i: number) => (<>{i > 0 && <br />}{line}</>))}
            </div>
          </div>
        )}
        {phone && (
          <div class="r"><div class="k">Phone</div><div class="v"><a href={`tel:${phoneDigits}`} data-field="location.phone">{phone}</a></div></div>
        )}
        {hours.length > 0 && (
          <div class="r">
            <div class="k">Hours</div>
            <div class="v loc-hours">
              {hours.map((row: any, i: number) => (
                <div class="hrow"><span data-field={`location.hours.${i}.day`}>{row.day}</span><span data-field={`location.hours.${i}.time`}>{row.time}</span></div>
              ))}
            </div>
          </div>
        )}
        {dirText && (
          <div class="r loc-cta"><a class="btn btn--fill" href={dirHref} target="_blank" rel="noopener noreferrer" data-field="location.directions.text" data-href-field="location.directions.href">{dirText} <span class="arw" aria-hidden="true">→</span></a></div>
        )}
      </div>
      <figure class="plate loc-map-tile reveal">
        <div id="map" role="img" aria-label={mapAria}>
          <div class="mg" aria-hidden="true"></div>
          <div class="road" style="top:46%;left:0;right:0;height:5px;" aria-hidden="true"></div>
          <div class="road" style="top:0;bottom:0;left:48%;width:4px;" aria-hidden="true"></div>
          <div class="pin" aria-hidden="true"><div class="dot"></div>{label && <div class="lbl">{label}</div>}</div>
        </div>
        {mapCaption && <figcaption data-field="location.mapCaption">{mapCaption}</figcaption>}
      </figure>
    </div>
  </div>
</section>
{/* Render path A: build-time coords ready. */}
{hasCoords && (
  <script is:inline define:vars={{ lat, lng, label }}>
    (function init() {
      if (window.__layoutsAVInitMap) window.__layoutsAVInitMap(lat, lng, label);
      else setTimeout(init, 80);
    })();
  </script>
)}
{/* Render path B: no coords but address present — client-side Nominatim. */}
{!hasCoords && hasAddress && (
  <script is:inline define:vars={{ address, label }}>
    (function geocodeThenInit() {
      var attempt = 0;
      function tryInit(lat, lng) {
        if (window.__layoutsAVInitMap) {
          window.__layoutsAVInitMap(lat, lng, label);
        } else if (attempt++ < 25) {
          setTimeout(function () { tryInit(lat, lng); }, 80);
        }
      }
      try {
        var query = encodeURIComponent(String(address).replace(/\n/g, ', '));
        var url = 'https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + query;
        fetch(url, { headers: { 'Accept-Language': 'en' } })
          .then(function (r) { return r.ok ? r.json() : []; })
          .then(function (results) {
            if (!Array.isArray(results) || results.length === 0) return;
            var lat = parseFloat(results[0].lat);
            var lng = parseFloat(results[0].lon);
            if (isNaN(lat) || isNaN(lng)) return;
            tryInit(lat, lng);
          })
          .catch(function () { /* keep the designed map-face fallback */ });
      } catch (e) { /* never block render */ }
    })();
  </script>
)}
<style>
  .loc-info-tile { grid-column: span 5; }
  .loc-info-tile .r { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .loc-info-tile .r:last-child { border-bottom: none; }
  .loc-info-tile .k { font-family: var(--sans); font-size: 10px; letter-spacing: .26em; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
  .loc-info-tile .v { font-family: var(--serif); font-size: 19px; color: var(--ink); }
  .loc-hours { display: grid; gap: 4px; }
  .loc-hours .hrow { display: flex; justify-content: space-between; gap: 16px; max-width: 320px; font-size: 15px; }
  .loc-cta { border-bottom: none !important; padding-top: 20px !important; }

  .loc-map-tile { grid-column: span 7; min-height: 360px; padding: 0; margin: 0; }
  #map { position: absolute; inset: 0; z-index: 0; }
  .loc-map-tile figcaption { z-index: 3; }
  .mg { position: absolute; inset: 0;
    background:
      repeating-linear-gradient(0deg,rgba(var(--accent-rgb),.07) 0 1px,transparent 1px 42px),
      repeating-linear-gradient(90deg,rgba(var(--accent-rgb),.07) 0 1px,transparent 1px 42px),
      linear-gradient(160deg,var(--card),var(--paper-2)); }
  .road { position: absolute; background: rgba(var(--accent-rgb),.3); }
  .pin { position: absolute; top: 46%; left: 48%; transform: translate(-50%,-100%); z-index: 2; text-align: center; }
  .pin .dot { width: 14px; height: 14px; background: var(--accent); border: 3px solid var(--card); border-radius: 50%; margin: 0 auto; position: relative; }
  .pin .dot::after { content: ""; position: absolute; inset: -9px; border: 1px solid rgba(var(--accent-rgb),.6); border-radius: 50%; animation: pgAV 3s ease-out infinite; }
  @media (prefers-reduced-motion: reduce) { .pin .dot::after { animation: none; } }
  @keyframes pgAV { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(2.6); opacity: 0; } }
  .pin .lbl { margin-top: 7px; font-family: var(--sans); font-size: 9px; letter-spacing: .2em; text-transform: uppercase; background: var(--accent); color: var(--on-accent); padding: 5px 10px; border-radius: 100px; }

  @media (max-width: 860px) {
    .loc-info-tile { grid-column: span 12; }
    .loc-map-tile { grid-column: span 12; min-height: 280px; }
  }
  @media (max-width: 760px) { .loc-hours .hrow { max-width: none; } }
</style>
