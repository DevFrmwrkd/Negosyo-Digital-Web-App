---
/**
 * layouts / PageAY — "Plum Editorial" (magazine editorial archetype).
 *
 * Ported from Local Business Landing Pages v4 / lp-20-food.html (archetype:
 * "editorial"). The signature identity is a magazine layout on a soft plum-paper
 * ground: an "Instrument Serif" display face with an italic plum accent, a
 * "Space Grotesk" label/body face, a two-column hero with a running dish-tape
 * marquee, a numbered editorial service ledger, a 2×2 mosaic gallery, centred
 * pull quote, and art-directed "plate" photo frames whose designed duotone
 * "scene" fields stand in until a photo is set.
 *
 * REUSABLE LAYOUT (business-agnostic): unlike the earlier bespoke hero ports,
 * AY is built to RECOLOUR cleanly through the theme engine. lp-20's baked
 * plum/paper palette is lifted into the STANDARD token vocabulary the theme
 * engine already overrides (--paper / --paper-2 / --card / --ink / --ink-soft /
 * --muted / --line / --accent / --accent-light / --accent-deep + the generic
 * aliases). Those tokens carry the source colours as DEFAULTS, so AY looks like
 * lp-20 out of the box but fully recolours when buildOverrideCss injects an
 * admin scheme. Every section component reads ONLY var(--token) — no baked hex
 * lives in a component; the only literal colours are the dark media stand-in
 * "scene" grounds + caption bone in this global block (they are photo fallbacks,
 * not palette, and intentionally stay dark).
 *
 * Design isolation: all tokens + base primitives are scoped to
 * html[data-page="AY"] so no sister design inherits them.
 *
 * CRITICAL specificity note: the size-bearing .plate primitive is written as
 * html[data-page="AY"] :where(.plate) so per-section height modifiers
 * (.hero-fig, .s-fig aspect ratio, gallery mosaic spans …) at (0,2,0) win over
 * the base instead of being squashed to a base floor. Do not remove :where().
 *
 * MOBILE-FIRST: AY has no single global grid — every multi-column grid lives in
 * its own section component and collapses to one column at <=760px there.
 * HeaderAY ships a hamburger drawer; the display type refits so nothing clips at
 * 360px and no rail overflows horizontally.
 *
 * lockVariant: true — only an EXPLICIT admin colour/font pick recolours; the
 * design's own plum-editorial defaults win otherwise.
 */
import HeaderAY from './header/HeaderAY.astro';
import HeroAY from './hero/HeroAY.astro';
import TrustAY from './trust/TrustAY.astro';
import AboutAY from './about/AboutAY.astro';
import ServicesAY from './services/ServicesAY.astro';
import WhyAY from './why/WhyAY.astro';
import HowAY from './how/HowAY.astro';
import TestimonialsAY from './testimonials/TestimonialsAY.astro';
import GalleryAY from './gallery/GalleryAY.astro';
import FaqAY from './faq/FaqAY.astro';
import AreaAY from './area/AreaAY.astro';
import CredentialsAY from './credentials/CredentialsAY.astro';
import LocationAY from './location/LocationAY.astro';
import CtaBandAY from './ctaBand/CtaBandAY.astro';
import FooterAY from './footer/FooterAY.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AY">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#f6f2f5" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-20 "Plum Editorial" palette + shared base primitives, scoped to
       html[data-page="AY"]. Colours are the SOURCE's defaults, expressed in the
       STANDARD theme vocabulary so buildOverrideCss can recolour cleanly. -->
  <style is:global>
    html[data-page="AY"] {
      /* lp-20 native palette, in standard theme tokens (defaults) */
      --paper: #f6f2f5;        /* page ground */
      --paper-2: #ece2ea;      /* deeper paper — tape / pull / cta / footer bands */
      --card: #ece2ea;         /* raised surface — location info panel */
      --ink: #221a20;          /* primary text */
      --ink-soft: #564a53;     /* secondary text */
      --muted: #8a7d86;        /* dim text / captions */
      --line: #e0d3dd;         /* hairlines / borders */
      --accent: #8e3d6b;       /* plum primary */
      --accent-light: #a95186; /* plum hover */
      --accent-deep: #6f2d53;  /* plum pressed / deep */
      --plate: #16101a;        /* photo-frame ground (media — stays dark) */
      --maxw: 1200px;
      --serif: "Instrument Serif", Georgia, "Times New Roman", serif;
      --sans: "Space Grotesk", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible even though components read the design's own tokens. */
      --paper-rgb: 246,242,245; --ink-rgb: 34,26,32; --accent-rgb: 142,61,107;
      --on-accent: #f6f2f5; --on-ink: #f6f2f5; --on-paper: #221a20;
    }
    html[data-page="AY"] * { box-sizing: border-box; }
    html[data-page="AY"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AY"] { scroll-behavior: auto; } }
    html[data-page="AY"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 16px; line-height: 1.75;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    }
    html[data-page="AY"] h1, html[data-page="AY"] h2,
    html[data-page="AY"] h3, html[data-page="AY"] h4 {
      font-family: var(--serif); font-weight: 400; line-height: 1.02; margin: 0;
    }
    html[data-page="AY"] p { margin: 0 0 1em; }
    html[data-page="AY"] a { color: var(--accent); text-decoration: none; }
    html[data-page="AY"] a:hover { color: var(--ink); }
    html[data-page="AY"] img { max-width: 100%; display: block; }
    html[data-page="AY"] ::selection { background: var(--accent); color: var(--on-accent); }

    html[data-page="AY"] .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
    html[data-page="AY"] .eyebrow {
      font-family: var(--sans); font-size: 10px; letter-spacing: .42em;
      text-transform: uppercase; color: var(--accent); font-weight: 600;
    }

    /* Editorial buttons — solid plum fill / hairline ghost (design signature). */
    html[data-page="AY"] .btn {
      display: inline-flex; align-items: center; gap: .5em; font-family: var(--sans);
      font-size: 12px; letter-spacing: .22em; text-transform: uppercase;
      padding: 16px 32px; border: 1px solid var(--accent); cursor: pointer;
      transition: transform .4s, background .4s, color .4s, border-color .4s;
    }
    html[data-page="AY"] .btn.f { background: var(--accent); color: var(--on-accent); }
    html[data-page="AY"] .btn.f:hover { background: var(--accent-light); border-color: var(--accent-light); color: var(--on-accent); transform: translateY(-2px); }
    html[data-page="AY"] .btn.g { color: var(--ink); border-color: var(--line); }
    html[data-page="AY"] .btn.g:hover { border-color: var(--accent); color: var(--accent); }
    html[data-page="AY"] .btnrow { display: flex; gap: 14px; flex-wrap: wrap; }

    /* Scroll reveal */
    html[data-page="AY"] .reveal { opacity: 0; transform: translateY(26px); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1); }
    html[data-page="AY"] .reveal.in { opacity: 1; transform: none; }
    html[data-page="AY"] .reveal[data-delay="1"] { transition-delay: .1s; }
    html[data-page="AY"] .reveal[data-delay="2"] { transition-delay: .2s; }
    html[data-page="AY"] .reveal[data-delay="3"] { transition-delay: .3s; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AY"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* Section scaffolding shared across blocks */
    html[data-page="AY"] section { padding: 110px 0; }
    html[data-page="AY"] .s-eb { display: block; margin-bottom: 16px; }
    html[data-page="AY"] .s-h { font-size: clamp(32px,5vw,62px); color: var(--ink); margin-bottom: 24px; }
    html[data-page="AY"] .s-h em { font-style: italic; color: var(--accent); }

    /* Designed photo frame — :where() so per-section height modifiers win. */
    html[data-page="AY"] :where(.plate) { position: relative; overflow: hidden; background: var(--plate); isolation: isolate; }
    html[data-page="AY"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 1.4s cubic-bezier(.16,1,.3,1); }
    html[data-page="AY"] :where(.plate):hover .ph { transform: scale(1.06); }
    html[data-page="AY"] :where(.plate) figcaption {
      position: absolute; left: 0; bottom: 0; z-index: 3; width: 100%; padding: 13px 16px;
      font-family: var(--sans); font-size: 9px; letter-spacing: .3em; text-transform: uppercase;
      color: #f2eee5; background: linear-gradient(0deg,rgba(6,6,8,.85),transparent);
    }

    /* Duotone "scene" fields — the designed fallback painted behind each photo.
       Plum highlights read var(--accent-rgb) so they recolour with the theme;
       the neutral charcoal ground is a media stand-in and stays dark. */
    html[data-page="AY"] .sc1 { background:
      radial-gradient(70% 60% at 46% 36%,rgba(var(--accent-rgb),.55),transparent 60%),
      radial-gradient(60% 60% at 76% 78%,rgba(var(--accent-rgb),.28),transparent 62%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AY"] .sc2 { background:
      radial-gradient(55% 65% at 60% 40%,rgba(var(--accent-rgb),.5),transparent 60%),
      repeating-linear-gradient(60deg,rgba(255,255,255,.05) 0 4px,transparent 4px 20px),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AY"] .sc3 { background:
      radial-gradient(60% 50% at 50% 60%,rgba(var(--accent-rgb),.36),transparent 62%),
      repeating-linear-gradient(0deg,rgba(255,255,255,.05) 0 1px,transparent 1px 50px),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AY"] .sc4 { background:
      conic-gradient(from 230deg at 42% 44%,rgba(var(--accent-rgb),.52),transparent 42%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AY"] .sc5 { background:
      radial-gradient(38% 48% at 50% 36%,rgba(255,255,255,.16),transparent 60%),
      radial-gradient(55% 45% at 50% 74%,rgba(var(--accent-rgb),.46),transparent 64%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AY"] .sc6 { background:
      radial-gradient(66% 66% at 44% 42%,rgba(var(--accent-rgb),.48),transparent 62%),
      linear-gradient(175deg,#1c1c20,#090909); }

    /* skip link */
    html[data-page="AY"] .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--on-accent); padding: 10px 16px; z-index: 100; }
    html[data-page="AY"] .skip:focus { left: 8px; top: 8px; }

    /* ------------------------------------------------------------------ */
    /* Mobile-first tuning — shared scaffolding only (each section's own    */
    /* grid collapses inside its component). Desktop rules above stay put;  */
    /* these only take effect at phone / small-tablet widths.              */
    /* ------------------------------------------------------------------ */
    @media (max-width: 760px) {
      html[data-page="AY"] .wrap { padding: 0 22px; }
      html[data-page="AY"] section { padding: 68px 0; }
      html[data-page="AY"] .s-h { font-size: clamp(28px,7.5vw,44px); }
      html[data-page="AY"] .btn { padding: 14px 24px; font-size: 11px; letter-spacing: .18em; }
    }
    @media (max-width: 380px) {
      html[data-page="AY"] .wrap { padding: 0 16px; }
      html[data-page="AY"] section { padding: 56px 0; }
      html[data-page="AY"] .s-h { font-size: clamp(25px,8vw,34px); }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAY layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAY content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAY content={content} />}
    {visibility.aboutSection !== false && <AboutAY content={content} />}
    {visibility.servicesSection !== false && <ServicesAY content={content} />}
    {visibility.whyUsBlock !== false && <WhyAY content={content} />}
    {visibility.howItWorksBlock !== false && <HowAY content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAY content={content} />}
    {visibility.gallerySection !== false && <GalleryAY content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAY content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAY content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAY content={content} />}
    {visibility.locationBlock !== false && <LocationAY content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAY content={content} layout={layout} />}
  <FooterAY layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      // layouts-AY Leaflet boot — accepts (lat, lng, label) from LocationAY.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAY calls this with whatever it resolves).
      window.__layoutsAYInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#8e3d6b';
        var ring = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f6f2f5';
        var icon = L.divIcon({ className: '', html: '<div style="width:14px;height:14px;border-radius:50%;background:' + accent + ';box-shadow:0 0 0 3px ' + ring + ';border:0;"></div>', iconSize: [14, 14], iconAnchor: [7, 7] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
