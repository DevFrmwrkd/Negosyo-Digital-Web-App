---
/**
 * layouts / PageAZ — "Kiosk Split" (night-mode split-screen editorial).
 *
 * Ported from Local Business Landing Pages v4 / lp-24-food.html (archetype:
 * "kiosk"). The signature identity is a full-height SPLIT layout: a sticky
 * art-directed image column beside a centred copy column, the two sides
 * alternating down the page. EB Garamond serif display with an italic bone
 * accent, Outfit sans labels, hairline-outlined uppercase buttons, a fixed
 * mix-blend nav, and "scene" duotone fields that stand in as the designed
 * photo fallback for every image slot.
 *
 * REUSABLE LAYOUT (business-agnostic): unlike the earlier bespoke hero ports
 * this design does NOT bake a locked palette. lp-24's night/bone colours are
 * extracted into the STANDARD theme vocabulary (--paper / --paper-2 / --card /
 * --ink / --ink-soft / --muted / --line / --accent / --accent-light /
 * --accent-deep + the generic aliases) as DEFAULTS, and every component reads
 * them via var(--token). buildOverrideCss() overrides exactly these tokens, so
 * the design ships looking like its source yet fully recolours when an admin
 * picks a scheme.
 *
 * Design isolation: all tokens + base primitives are scoped to
 * html[data-page="AZ"] so no sister design inherits them.
 *
 * CRITICAL specificity note: the size-bearing .stick and .plate primitives are
 * written as html[data-page="AZ"] :where(.stick) / :where(.plate) so per-section
 * height modifiers (.hero-stick, gallery spans, .loc-stick …) win over the base
 * instead of being squashed to a base floor. Do not remove the :where().
 *
 * MOBILE-FIRST: the GLOBAL split grid (html[data-page="AZ"] .split) collapses to
 * a single column at <=860px IN THIS GLOBAL BLOCK, so it wins over any scoped
 * per-section rule and stacks every split section to one column with no
 * horizontal overflow. HeaderAZ ships a hamburger drawer.
 */
import HeaderAZ from './header/HeaderAZ.astro';
import HeroAZ from './hero/HeroAZ.astro';
import TrustAZ from './trust/TrustAZ.astro';
import AboutAZ from './about/AboutAZ.astro';
import ServicesAZ from './services/ServicesAZ.astro';
import WhyAZ from './why/WhyAZ.astro';
import HowAZ from './how/HowAZ.astro';
import TestimonialsAZ from './testimonials/TestimonialsAZ.astro';
import GalleryAZ from './gallery/GalleryAZ.astro';
import FaqAZ from './faq/FaqAZ.astro';
import AreaAZ from './area/AreaAZ.astro';
import CredentialsAZ from './credentials/CredentialsAZ.astro';
import LocationAZ from './location/LocationAZ.astro';
import CtaBandAZ from './ctaBand/CtaBandAZ.astro';
import FooterAZ from './footer/FooterAZ.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#0c0d0f" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-24 "Kiosk Split" palette + shared base primitives, scoped to
       html[data-page="AZ"]. Colours are the SOURCE's defaults, expressed in the
       STANDARD theme vocabulary so buildOverrideCss can recolour cleanly. -->
  <style is:global>
    html[data-page="AZ"] {
      /* lp-24 native palette, in standard theme tokens (defaults) */
      --paper: #0c0d0f;        /* page ground (source body bg) */
      --paper-2: #17161a;      /* warm-dark lift (scene base tail) */
      --card: #101216;         /* cell / panel surface */
      --ink: #eceef1;          /* primary text */
      --ink-soft: #a9adb6;     /* secondary text (lede / answers) */
      --muted: #74787f;        /* dim labels / captions / meta */
      --line: #23262b;         /* hairlines / borders */
      --accent: #e8e6df;       /* bone accent (source #e8e6df) */
      --accent-light: #ffffff; /* brightened accent (hover) */
      --accent-deep: #cfcdc2;  /* muted deep accent */
      --maxw: 1280px;
      --serif: "EB Garamond", Georgia, "Times New Roman", serif;
      --sans: "Outfit", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible even though components read the design's own tokens. */
      --paper-rgb: 12,13,15; --ink-rgb: 236,238,241; --accent-rgb: 232,230,223;
      --on-accent: #0c0d0f; --on-ink: #0c0d0f; --on-paper: #eceef1;
    }
    html[data-page="AZ"] * { box-sizing: border-box; }
    html[data-page="AZ"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AZ"] { scroll-behavior: auto; } }
    html[data-page="AZ"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 16px; line-height: 1.72;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    html[data-page="AZ"] h1, html[data-page="AZ"] h2,
    html[data-page="AZ"] h3, html[data-page="AZ"] h4 {
      font-family: var(--serif); font-weight: 400; line-height: 1.04; margin: 0;
    }
    html[data-page="AZ"] h1 em, html[data-page="AZ"] h2 em { font-style: italic; color: var(--accent); }
    html[data-page="AZ"] p { margin: 0 0 1em; }
    html[data-page="AZ"] a { color: var(--ink); text-decoration: none; }
    html[data-page="AZ"] a:hover { color: var(--accent); }
    html[data-page="AZ"] img { max-width: 100%; display: block; }
    html[data-page="AZ"] ::selection { background: var(--accent); color: var(--on-accent); }

    html[data-page="AZ"] .eyebrow {
      font-family: var(--sans); font-size: 10px; letter-spacing: .4em;
      text-transform: uppercase; color: var(--accent); font-weight: 600;
    }

    /* Hairline-outlined uppercase buttons — bone fill / ghost (design signature). */
    html[data-page="AZ"] .btn {
      display: inline-flex; align-items: center; gap: .5em; font-family: var(--sans);
      font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-weight: 500;
      padding: 16px 30px; border: 1px solid var(--accent); background: transparent; color: var(--ink);
      cursor: pointer; transition: transform .4s, background .4s, color .4s, border-color .4s;
    }
    html[data-page="AZ"] .btn--fill { background: var(--accent); color: var(--on-accent); }
    html[data-page="AZ"] .btn--fill:hover { background: var(--accent-light); border-color: var(--accent-light); color: var(--on-accent); transform: translateY(-2px); }
    html[data-page="AZ"] .btn--ghost { color: var(--ink); border-color: var(--line); }
    html[data-page="AZ"] .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }
    html[data-page="AZ"] .btnrow { display: flex; gap: 13px; flex-wrap: wrap; }
    html[data-page="AZ"] .btn .arw { transition: transform .35s; }
    html[data-page="AZ"] .btn:hover .arw { transform: translateX(4px); }

    /* Scroll reveal */
    html[data-page="AZ"] .reveal { opacity: 0; transform: translateY(26px); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1); }
    html[data-page="AZ"] .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AZ"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* ---- Split scaffolding (the kiosk signature) ---------------------- */
    /* GLOBAL split grid. Its collapse to one column lives HERE so it wins
       over any scoped per-section rule and stacks every split section. */
    html[data-page="AZ"] .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
    html[data-page="AZ"] .panecopy { padding: 120px 72px; display: flex; flex-direction: column; justify-content: center; min-height: 100vh; }

    /* Sticky art-directed image column — :where() so per-section height
       modifiers (0,2,0) win over the base primitive. */
    html[data-page="AZ"] :where(.stick) { position: sticky; top: 0; height: 100vh; overflow: hidden; background: var(--paper); isolation: isolate; }
    html[data-page="AZ"] :where(.stick) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; }
    html[data-page="AZ"] :where(.stick) .cap {
      position: absolute; left: 32px; bottom: 32px; z-index: 2; font-family: var(--sans);
      font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: var(--accent);
    }
    html[data-page="AZ"] :where(.stick) .cap::before { content: ""; display: block; width: 40px; height: 2px; background: var(--accent); margin-bottom: 12px; }

    /* Centred non-split block (why / faq / credentials). */
    html[data-page="AZ"] .blk { padding: 110px 72px; border-top: 1px solid var(--line); }
    html[data-page="AZ"] .hold { max-width: 780px; margin: 0 auto; }
    html[data-page="AZ"] .blk .eyebrow { display: block; margin-bottom: 14px; }
    html[data-page="AZ"] .blk h2 { font-size: clamp(30px,4vw,54px); margin-bottom: 28px; color: var(--ink); }

    /* Designed photo frame (gallery tiles + map) — :where() so per-section
       height modifiers win. */
    html[data-page="AZ"] :where(.plate) { position: relative; overflow: hidden; background: var(--paper); isolation: isolate; }
    html[data-page="AZ"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; }
    html[data-page="AZ"] :where(.plate) figcaption {
      position: absolute; left: 0; bottom: 0; z-index: 3; width: 100%; padding: 12px 16px;
      font-family: var(--sans); font-size: 10px; letter-spacing: .26em; text-transform: uppercase;
      color: var(--accent); background: linear-gradient(0deg,rgba(var(--paper-rgb),.85),transparent);
    }
    html[data-page="AZ"] :where(.plate) .mark {
      position: absolute; top: 14px; right: 16px; z-index: 3; font-family: var(--sans);
      font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted);
      border: 1px solid var(--line); padding: 3px 7px;
    }

    /* Duotone "scene" fields — the designed fallback painted behind each photo.
       Bone highlights read var(--accent-rgb) + the grain lines read
       var(--ink-rgb) so they recolour with the theme; the dark ground is a
       media stand-in built from the paper tokens. */
    html[data-page="AZ"] .sc1 { background:
      radial-gradient(70% 60% at 38% 36%,rgba(var(--accent-rgb),.55),transparent 60%),
      radial-gradient(60% 60% at 76% 78%,rgba(var(--accent-rgb),.28),transparent 62%),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }
    html[data-page="AZ"] .sc2 { background:
      radial-gradient(55% 65% at 60% 40%,rgba(var(--accent-rgb),.5),transparent 60%),
      repeating-linear-gradient(0deg,rgba(var(--ink-rgb),.05) 0 4px,transparent 4px 20px),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }
    html[data-page="AZ"] .sc3 { background:
      radial-gradient(60% 50% at 50% 60%,rgba(var(--accent-rgb),.36),transparent 62%),
      repeating-linear-gradient(0deg,rgba(var(--ink-rgb),.05) 0 1px,transparent 1px 38px),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }
    html[data-page="AZ"] .sc4 { background:
      conic-gradient(from 190deg at 42% 44%,rgba(var(--accent-rgb),.52),transparent 42%),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }
    html[data-page="AZ"] .sc5 { background:
      radial-gradient(38% 48% at 50% 36%,rgba(var(--ink-rgb),.16),transparent 60%),
      radial-gradient(55% 45% at 50% 74%,rgba(var(--accent-rgb),.46),transparent 64%),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }
    html[data-page="AZ"] .sc6 { background:
      radial-gradient(66% 66% at 44% 42%,rgba(var(--accent-rgb),.48),transparent 62%),
      linear-gradient(160deg,var(--paper-2),var(--paper)); }

    /* skip link */
    html[data-page="AZ"] .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--on-accent); padding: 10px 16px; z-index: 100; }
    html[data-page="AZ"] .skip:focus { left: 8px; top: 8px; }

    /* ------------------------------------------------------------------ */
    /* Mobile-first tuning — shared scaffolding only. The split collapse   */
    /* below is GLOBAL so it wins over any scoped per-section rule: every   */
    /* split stacks to one column, the sticky image becomes a short        */
    /* relative panel, and copy padding refits so nothing overflows 360px. */
    /* ------------------------------------------------------------------ */
    @media (max-width: 860px) {
      html[data-page="AZ"] .split { grid-template-columns: 1fr; min-height: 0; }
      html[data-page="AZ"] :where(.stick) { position: relative; height: 56vh; }
      html[data-page="AZ"] .panecopy { min-height: 0; padding: 92px 26px 64px; }
      html[data-page="AZ"] .blk { padding: 72px 26px; }
    }
    @media (max-width: 760px) {
      html[data-page="AZ"] .panecopy { padding: 88px 22px 56px; }
      html[data-page="AZ"] .blk { padding: 64px 22px; }
      html[data-page="AZ"] :where(.stick) .cap { left: 22px; bottom: 22px; }
      html[data-page="AZ"] .btn { padding: 14px 22px; font-size: 11px; }
    }
    @media (max-width: 380px) {
      html[data-page="AZ"] .panecopy { padding: 82px 16px 48px; }
      html[data-page="AZ"] .blk { padding: 56px 16px; }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAZ layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAZ content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAZ content={content} />}
    {visibility.aboutSection !== false && <AboutAZ content={content} />}
    {visibility.servicesSection !== false && <ServicesAZ content={content} />}
    {visibility.whyUsBlock !== false && <WhyAZ content={content} />}
    {visibility.howItWorksBlock !== false && <HowAZ content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAZ content={content} />}
    {visibility.gallerySection !== false && <GalleryAZ content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAZ content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAZ content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAZ content={content} />}
    {visibility.locationBlock !== false && <LocationAZ content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAZ content={content} layout={layout} />}
  <FooterAZ layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      // layouts-AZ Leaflet boot — accepts (lat, lng, label) from LocationAZ.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAZ calls this with whatever it resolves).
      // The marker reads the live theme tokens so it recolours with the scheme.
      window.__layoutsAZInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var cs = getComputedStyle(document.documentElement);
        var accent = cs.getPropertyValue('--accent').trim() || '#e8e6df';
        var ring = cs.getPropertyValue('--paper').trim() || '#0c0d0f';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/dark_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:18px;height:18px;border-radius:50%;background:' + accent + ';box-shadow:0 0 0 3px ' + ring + ';border:0;"></div>', iconSize: [18, 18], iconAnchor: [9, 9] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
