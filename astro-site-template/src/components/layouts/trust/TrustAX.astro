---
/**
 * layouts / TrustAX — brutalist credibility strip under the ticker: a 4-cell
 * bordered row, each with a mono headline stat and a dim mono label. Mirrors
 * lp-21's "TRUST / brutalist" block.
 *
 * Volatile Google-rating slots have no field in the data model, so a cell whose
 * `num` is "★★★★★" renders via set:html and still styles correctly.
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="grid-sec" aria-label="Trust">
    <div class="trust-b">
      {cells.map((cell, i) => (
        <div class="c reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust-b { display: grid; grid-template-columns: repeat(4,1fr); }
  .trust-b .c { padding: 26px 18px; text-align: center; border-right: 2px solid var(--line); }
  .trust-b .c:last-child { border-right: none; }
  .trust-b .n { font-family: var(--mono); font-size: clamp(18px,2.4vw,22px); color: var(--accent); line-height: 1.1; }
  .trust-b .n :global(.stars) { color: var(--accent); letter-spacing: 2px; }
  .trust-b .t { font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  @media (max-width: 980px) {
    .trust-b { grid-template-columns: repeat(2,1fr); }
    .trust-b .c { border-bottom: 2px solid var(--line); }
    .trust-b .c:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 760px) {
    .trust-b { grid-template-columns: 1fr; }
    .trust-b .c { border-right: none; }
    .trust-b .c:last-child { border-bottom: none; }
  }
</style>
