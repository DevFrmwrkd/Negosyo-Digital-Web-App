---
/**
 * layouts / TrustAZ — the kiosk credibility strip under the hero: a
 * hairline-gridded stat-row where each cell pairs an EB Garamond bone statement
 * over an Outfit uppercase label (lp-24's "Fresh daily · Rated on Google" band).
 * Volatile Google rating slots have no field in the data model, so they render
 * as ordinary trust cells (num renders via set:html so a "★★★★★" cell styles).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust">
    <div class="stat-row">
      {cells.map((cell, i) => (
        <div class="stat reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .stat-row {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px;
    background: var(--line); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .stat { background: var(--card); padding: 30px 40px; }
  .stat .n { font-family: var(--serif); font-size: clamp(24px,3vw,30px); color: var(--accent); line-height: 1.1; }
  .stat .n :global(.stars) { color: var(--accent-light); letter-spacing: 2px; }
  .stat .t { font-family: var(--sans); font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  /* Scoped grid → its mobile override lives here: stack to one column <=760px. */
  @media (max-width: 760px) {
    .stat-row { grid-template-columns: 1fr; }
    .stat { padding: 24px 26px; }
  }
</style>
