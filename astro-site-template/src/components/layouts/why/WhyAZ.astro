---
/**
 * layouts / WhyAZ — the "what sets us apart" kiosk block: a centred column of
 * hairline-ruled reason rows, each led by an italic bone serial (decorative),
 * an EB Garamond title and a muted body line. Reads content.why.items
 * (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="blk why">
    <div class="hold">
      {tag && <span class="eyebrow" data-field="why.tag">{tag}</span>}
      {headline && <h2 data-field="why.headline" set:html={headline}></h2>}
      <div class="why-list">
        {items.map((item, i) => (
          <div class="c reveal">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-list .c { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .why-list .c:first-child { border-top: 1px solid var(--line); }
  .why-list .k { font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--accent); }
  .why-list h3 { font-size: 21px; color: var(--ink); margin: 6px 0 8px; }
  .why-list p { font-size: 14px; color: var(--muted); margin: 0; }
</style>
