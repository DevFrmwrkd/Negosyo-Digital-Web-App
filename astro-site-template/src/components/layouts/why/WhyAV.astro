---
/**
 * layouts / WhyAV — "what sets us apart" bento of reason tiles, each led by an
 * oversized italic cobalt serif index (decorative), a Spectral title and a
 * muted body line. Reads content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why">
    <div class="wrap">
      <div class="grid">
        <div class="sec-tag reveal">
          {tag && <span class="n" data-field="why.tag">{tag}</span>}
          {headline && <h2 data-field="why.headline" set:html={headline}></h2>}
        </div>
        {items.map((item, i) => (
          <div class="tile why-tile reveal">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-tile { grid-column: span 4; }
  .why-tile .k { font-family: var(--serif); font-style: italic; font-size: 38px; color: var(--accent); line-height: 1; }
  .why-tile h3 { font-size: 22px; margin: 10px 0 8px; color: var(--ink); }
  .why-tile p { font-size: 14px; color: var(--muted); margin: 0; }
  @media (max-width: 860px) { .why-tile { grid-column: span 12; } }
</style>
