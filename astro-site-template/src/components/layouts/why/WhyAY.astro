---
/**
 * layouts / WhyAY — "what sets us apart" three-column editorial grid (lp-20's
 * .why3): each column led by an oversized italic plum numeral (decorative), a
 * serif title and a muted body line. Reads content.why.items (canonical `body`,
 * legacy `desc` / `description`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why">
    <div class="wrap">
      {tag && <span class="eyebrow s-eb reveal" data-field="why.tag">{tag}</span>}
      {headline && <h2 class="s-h reveal" data-field="why.headline" set:html={headline}></h2>}
      <div class="why3">
        {items.map((item, i) => (
          <div class="c reveal" data-delay={String((i % 3) + 1)}>
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why { background: var(--paper); }
  .why3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 56px; }
  .why3 .c .k { font-family: var(--serif); font-style: italic; font-size: 44px; color: var(--accent); line-height: 1; }
  .why3 h3 { font-size: 24px; margin: 14px 0 10px; color: var(--ink); }
  .why3 p { color: var(--muted); font-size: 14px; }
  @media (max-width: 800px) { .why3 { grid-template-columns: 1fr; gap: 40px; } }
</style>
