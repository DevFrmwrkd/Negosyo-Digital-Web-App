---
/**
 * layouts / CredentialsAY — "why you can trust us" permits row (lp-20's .creds4):
 * a four-cell band ruled top and bottom with hairline dividers between cells,
 * each cell led by an italic plum numeral (decorative), an uppercase label and a
 * muted note. Reads content.credentials.items (canonical `title`/`desc`, legacy
 * `label`/`detail`); tag + headline render above when set. Collapses 4 → 2 → 1.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title?: string; desc?: string; label?: string; detail?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="creds-head">
          {tag && <span class="eyebrow s-eb reveal" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="s-h reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="creds4 reveal">
        {items.map((item, i) => (
          <div class="c">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            {(item.title ?? item.label) && (
              <h4 data-field={item.title != null ? `credentials.items.${i}.title` : `credentials.items.${i}.label`}>{item.title ?? item.label}</h4>
            )}
            {(item.desc ?? item.detail) && (
              <p data-field={item.desc != null ? `credentials.items.${i}.desc` : `credentials.items.${i}.detail`}>{item.desc ?? item.detail}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--paper); }
  .creds4 { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .creds4 .c { padding: 40px 24px; text-align: center; border-right: 1px solid var(--line); }
  .creds4 .c:last-child { border-right: none; }
  .creds4 .k { font-family: var(--serif); font-style: italic; font-size: 26px; color: var(--accent); margin-bottom: 12px; }
  .creds4 h4 { font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink); margin-bottom: 8px; }
  .creds4 p { font-size: 13px; color: var(--muted); margin: 0; }
  @media (max-width: 900px) {
    .creds4 { grid-template-columns: repeat(2,1fr); }
    .creds4 .c:nth-child(2n) { border-right: none; }
    .creds4 .c:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .creds4 { grid-template-columns: 1fr; }
    .creds4 .c { border-right: none; border-bottom: 1px solid var(--line); }
    .creds4 .c:last-child { border-bottom: none; }
  }
</style>
