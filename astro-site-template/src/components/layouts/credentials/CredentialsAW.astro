---
/**
 * layouts / CredentialsAW — broadsheet "why you can trust us": a four-cell
 * bordered row (italic serif index · uppercase label · muted note), framed like
 * a printed certificate block. Mirrors lp-19's "CREDENTIALS / broadsheet".
 *
 * Reads content.credentials.items (canonical title / desc, legacy label / detail).
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title?: string; desc?: string; label?: string; detail?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="creds-sec" aria-label="Credentials">
    {tag && <div class="sec-lbl" data-field="credentials.tag">{tag}</div>}
    {headline && <h2 class="sec-h" data-field="credentials.headline" set:html={headline}></h2>}
    <div class="creds">
      {items.map((item, i) => (
        <div class="reveal" data-delay={i > 0 ? String(Math.min(i, 3)) : undefined}>
          <span class="cd-n">{String(i + 1).padStart(2, '0')}</span>
          {(item.title || item.label) && <b data-field={`credentials.items.${i}.title`}>{item.title ?? item.label}</b>}
          {(item.desc || item.detail) && <span class="cd-d" data-field={`credentials.items.${i}.desc`}>{item.desc ?? item.detail}</span>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .creds { display: grid; grid-template-columns: repeat(4,1fr); border: 1px solid var(--line); }
  .creds > div { padding: 26px 20px; border-right: 1px solid var(--line); text-align: center; }
  .creds > div:last-child { border-right: none; }
  .cd-n { display: block; font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--accent); margin-bottom: 10px; }
  .creds b { display: block; font-family: var(--label); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px; }
  .creds .cd-d { font-size: 12px; color: var(--muted); }
  @media (max-width: 900px) {
    .creds { grid-template-columns: repeat(2,1fr); }
    .creds > div:nth-child(2n) { border-right: none; }
    .creds > div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .creds { grid-template-columns: 1fr; }
    .creds > div { border-right: none; border-bottom: 1px solid var(--line); }
    .creds > div:last-child { border-bottom: none; }
  }
</style>
