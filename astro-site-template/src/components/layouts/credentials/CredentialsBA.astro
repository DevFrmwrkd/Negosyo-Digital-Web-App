---
/**
 * layouts / CredentialsBA — the "why you can trust us" panel (lp-22
 * CREDENTIALS block). A hairline-gridded set of .c tiles on the card surface,
 * each with a brass serif index numeral (decorative), an uppercase label and a
 * muted note. Reads content.credentials.items (title / desc); tag + headline
 * render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="p-sec" data-component="CREDENTIALS" data-variant="panel">
    <span class="idx" aria-hidden="true">08</span>
    {tag && <span class="eyebrow p-eb" data-field="credentials.tag">{tag}</span>}
    {headline && <h2 class="p-h" data-field="credentials.headline" set:html={headline}></h2>}
    <div class="creds-p">
      {items.map((item, i) => (
        <div class="c reveal">
          <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
          <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
          {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .creds-p { display: grid; grid-template-columns: repeat(2,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .creds-p .c { background: var(--card); padding: 26px 22px; }
  .creds-p .k { font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--accent); margin-bottom: 10px; line-height: 1; }
  .creds-p h4 { font-family: var(--sans); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px; }
  .creds-p p { font-size: 13px; color: var(--muted); margin: 0; }
  @media (max-width: 760px) {
    .creds-p { grid-template-columns: 1fr; }
  }
</style>
