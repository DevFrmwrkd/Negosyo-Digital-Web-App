---
/**
 * layouts / CredentialsAZ — the "why you can trust us" kiosk block: a centred,
 * hairline-gridded set of credential cells, each with an italic bone serif
 * serial (decorative), an uppercase label and a muted note. Reads
 * content.credentials.items (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="blk credentials">
    <div class="hold">
      {tag && <span class="eyebrow" data-field="credentials.tag">{tag}</span>}
      {headline && <h2 data-field="credentials.headline" set:html={headline}></h2>}
      <div class="creds-grid reveal">
        {items.map((item, i) => (
          <div class="c">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds-grid {
    display: grid; grid-template-columns: repeat(2,1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line);
  }
  .creds-grid .c { background: var(--card); padding: 24px 22px; }
  .creds-grid .k { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--accent); margin-bottom: 8px; }
  .creds-grid h4 { font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px; }
  .creds-grid p { font-size: 12px; color: var(--muted); margin: 0; }
  /* Scoped grid → its mobile override lives here: stack to one column <=760px. */
  @media (max-width: 760px) { .creds-grid { grid-template-columns: 1fr; } }
</style>
