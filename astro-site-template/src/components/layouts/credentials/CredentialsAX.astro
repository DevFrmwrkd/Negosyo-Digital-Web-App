---
/**
 * layouts / CredentialsAX — brutalist "why you can trust us": a sec-bar over a
 * four-cell bordered row, each with a bone mono index chip, an uppercase label
 * and a dim note. Mirrors lp-21's "CREDENTIALS / brutalist" block.
 *
 * Reads content.credentials.items (title / desc). Auto-hides when empty.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const headline = cred.headline || 'Why you can trust us';
const idx = cred.idx || '[ CREDENTIALS ]';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="grid-sec" aria-label="Credentials">
    <div class="sec-bar">
      <h2 data-field="credentials.headline" set:html={headline}></h2>
      <span class="idx" data-field="credentials.idx">{idx}</span>
    </div>
    <div class="creds-cells">
      {items.map((item, i) => (
        <div class="cell reveal" data-delay={i}>
          <span class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
          {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .creds-cells { display: grid; grid-template-columns: repeat(4,1fr); }
  .creds-cells .cell { padding: 28px 20px; border-right: 2px solid var(--line); }
  .creds-cells .cell:last-child { border-right: none; }
  .creds-cells .k { font-family: var(--mono); font-size: 13px; background: var(--accent); color: var(--on-accent); padding: 3px 8px; }
  .creds-cells h4 { text-transform: uppercase; font-size: 13px; margin: 12px 0 6px; }
  .creds-cells p { font-size: 12px; color: var(--muted); margin: 0; }
  @media (max-width: 980px) {
    .creds-cells { grid-template-columns: repeat(2,1fr); }
    .creds-cells .cell { border-bottom: 2px solid var(--line); }
    .creds-cells .cell:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 760px) {
    .creds-cells { grid-template-columns: 1fr; }
    .creds-cells .cell { border-right: none; }
    .creds-cells .cell:last-child { border-bottom: none; }
  }
</style>
