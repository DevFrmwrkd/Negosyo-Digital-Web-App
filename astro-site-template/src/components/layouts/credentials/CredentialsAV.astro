---
/**
 * layouts / CredentialsAV — "why you can trust us" bento of centred credential
 * tiles, each with an italic cobalt serif index (decorative), an uppercase
 * label and a muted note. Reads content.credentials.items (title / desc);
 * tag + headline render in the shared .sec-tag above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="credentials">
    <div class="wrap">
      <div class="grid">
        {(tag || headline) && (
          <div class="sec-tag reveal">
            {tag && <span class="n" data-field="credentials.tag">{tag}</span>}
            {headline && <h2 data-field="credentials.headline" set:html={headline}></h2>}
          </div>
        )}
        {items.map((item, i) => (
          <div class="tile cred-tile reveal">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-tile { grid-column: span 3; text-align: center; }
  .cred-tile .k { font-family: var(--serif); font-style: italic; font-size: 24px; color: var(--accent); margin-bottom: 10px; }
  .cred-tile h4 { font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px; }
  .cred-tile p { font-size: 12px; color: var(--muted); margin: 0; }
  @media (max-width: 640px) { .cred-tile { grid-column: span 6; } }
</style>
