---
/**
 * layouts / HeaderAZ — the kiosk fixed nav: a mix-blend-difference bar that
 * inverts against whatever scrolls behind it (lp-24's signature), carrying an
 * EB Garamond serif brand, Outfit uppercase links and a hairline-outlined pill.
 *
 * MOBILE-FIRST: a .nav-burger button collapses the <nav> into a themed
 * full-width dropdown at <=760px, toggled by the inline script below. On mobile
 * the bar drops mix-blend for a solid translucent paper backdrop so the brand +
 * burger stay legible over any section.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAZ actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAZ.
const PAGE_ANCHORS = new Set(['about', 'faq', 'gallery', 'location', 'main', 'reserve', 'reviews', 'services']);
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = (content as any).footer?.brand || layout.businessName || '';
// Nav links come from the same derived list ('#about', '#services', '#why',
// '#work', '#visit'). Resolve each against this page and drop the ones with no
// section to reach — a nav entry that scrolls nowhere is as broken as a dead
// CTA, and its label promises a section this design does not have. The original
// index rides along as .i so the editor's per-link field hooks stay correct.
const navLinks: Array<{ href: string; label: string; i: number }> =
  ((layout.navLinks && layout.navLinks.length) ? layout.navLinks : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href);
// Reuse the hero's primary CTA as the nav action so it stays in sync.
const hero = (content as any).hero || {};
const ctaText = hero.cta1?.text || '';
const ctaHref = onPage(hero.cta1?.href, '#reserve');
---
<header class="nav">
  {brand && <a href="#main" class="brand" data-field="footer.brand">{brand}</a>}
  {(navLinks.length > 0 || ctaText) && (
    <>
      <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-az-menu">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav-links" id="nav-az-menu" aria-label="Primary">
        {navLinks.map((link) => (
          <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
        ))}
        {ctaText && <a href={ctaHref} class="nb" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{ctaText}</a>}
      </nav>
    </>
  )}
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-links');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping any menu link.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: flex; justify-content: space-between; align-items: center;
    padding: 22px 40px; mix-blend-mode: difference;
  }
  .brand { font-family: var(--serif); font-size: 23px; letter-spacing: .04em; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .nav-links { display: flex; gap: 26px; align-items: center; }
  .nav-links a { font-family: var(--sans); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink); }
  .nav-links a:hover { color: var(--accent); }
  .nav-links .nb { border: 1px solid var(--ink); padding: 9px 18px; color: var(--ink); }
  .nav-links .nb:hover { border-color: var(--accent); color: var(--accent); }

  /* Hamburger — hidden on desktop, the mobile trigger below <=760px. */
  .nav-burger { display: none; }

  @media (max-width: 760px) {
    /* Drop mix-blend for a solid translucent bar so the brand + burger
       stay legible over any section that scrolls beneath. */
    header.nav {
      mix-blend-mode: normal; padding: 14px 22px;
      background: rgba(var(--paper-rgb), .9); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    .brand { color: var(--ink); }
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -10px;
      background: transparent; border: 0; cursor: pointer;
    }
    .nav-burger span { display: block; width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .3s ease, opacity .3s ease; }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Links become a themed full-width dropdown beneath the bar. */
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -22px rgba(0,0,0,.6);
      padding: 6px 0 12px; max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-links { max-height: calc(100vh - 64px); overflow-y: auto; opacity: 1; visibility: visible; }
    .nav-links a {
      display: flex; align-items: center; min-height: 48px;
      padding: 6px 22px; font-size: 14px; color: var(--ink-soft);
      border-bottom: 1px solid var(--line);
    }
    .nav-links .nb {
      margin: 14px 22px 4px; padding: 14px 18px; min-height: 48px;
      justify-content: center; border: 1px solid var(--accent);
      background: var(--accent); color: var(--on-accent);
    }
  }
</style>
