---
/**
 * layouts / GalleryAW — broadsheet "a look inside": an editorial mosaic where
 * the first tile spans 2×2 and later tiles break the grid, each an art-directed
 * .plate frame. A cycling .sc-* duotone stands in as the designed fallback until
 * a photo is set. Mirrors lp-19's "GALLERY / broadsheet" block.
 *
 * Reads content.gallery.items (image / caption). Auto-hides when empty.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['sc1', 'sc2', 'sc3', 'sc4', 'sc5', 'sc6'];
const spanFor = (i: number) => (i % 6 === 0 ? 'g1' : i % 6 === 3 ? 'g4' : i % 6 === 5 ? 'g6' : '');
---
{items.length > 0 && (
  <section class="gallery" id="gallery" aria-label="Gallery">
    {tag && <div class="sec-lbl" data-field="gallery.tag">{tag}</div>}
    {headline && <h2 class="sec-h" data-field="gallery.headline" set:html={headline}></h2>}
    <div class="gal reveal">
      {items.map((item, i) => (
        <figure class={`plate ${spanFor(i)}`.trim()}>
          <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');` : ''}></div>
          {item.caption && <figcaption data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          <span class="mark">{String(i + 1).padStart(2, '0')}</span>
        </figure>
      ))}
    </div>
  </section>
)}
<style>
  .gal { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 150px; gap: 12px; }
  .g1 { grid-column: span 2; grid-row: span 2; }
  .g4 { grid-row: span 2; }
  .g6 { grid-column: span 2; }
  @media (max-width: 980px) { .gal { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 760px) {
    .gal { grid-template-columns: 1fr; grid-auto-rows: 210px; }
    .gal .g1, .gal .g4, .gal .g6 { grid-column: auto; grid-row: auto; }
  }
</style>
