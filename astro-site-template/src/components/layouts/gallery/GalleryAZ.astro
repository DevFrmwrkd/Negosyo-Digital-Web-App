---
/**
 * layouts / GalleryAZ — "a look around" editorial mosaic. lp-24 ships no gallery
 * block, so this section is built in the same kiosk identity: art-directed
 * .plate frames (a cycling .sc* duotone "scene" stands in as the designed
 * fallback; a photo layers over it via data-image-field when set), arranged so
 * the first tile spans wide. The section auto-hides when there are no items.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['sc1', 'sc2', 'sc3', 'sc4', 'sc5', 'sc6'];
const spanFor = (i: number) => (i % 6 === 0 ? 'g1' : i % 6 === 1 ? 'g2' : i % 6 === 4 ? 'g5' : '');
---
{items.length > 0 && (
  <section class="gallery" id="gallery">
    <div class="gal-wrap">
      {tag && <span class="eyebrow" data-field="gallery.tag">{tag}</span>}
      {headline && <h2 class="gal-h" data-field="gallery.headline" set:html={headline}></h2>}
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate gal-tile ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} role="img" aria-label="Gallery" data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');` : ''}></div>
            {item.caption && <figcaption data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
            <span class="mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { border-top: 1px solid var(--line); }
  .gal-wrap { max-width: var(--maxw); margin: 0 auto; padding: 110px 72px; }
  .gal-h { font-size: clamp(30px,4vw,54px); color: var(--ink); margin: 14px 0 0; }
  .gal-sub { max-width: 52ch; color: var(--muted); margin: 16px 0 0; font-size: 15px; }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 200px; gap: 14px; margin-top: 32px; }
  .gal-tile { margin: 0; }
  .gal-tile .ph { transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  .gal-tile:hover .ph { transform: scale(1.06); }
  .g1 { grid-column: span 2; grid-row: span 2; }
  .g2 { grid-column: span 2; }
  .g5 { grid-column: span 2; }
  @media (max-width: 860px) {
    .gal-wrap { padding: 72px 26px; }
    .g-grid { grid-template-columns: repeat(2,1fr); }
    .g1 { grid-column: span 2; grid-row: span 1; }
    .g2, .g5 { grid-column: span 2; }
  }
  @media (max-width: 760px) {
    .gal-wrap { padding: 64px 22px; }
    /* One full-width tile per row so nothing overflows on a phone. */
    .g-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; gap: 12px; }
    .g1, .g2, .g5 { grid-column: auto; grid-row: auto; }
  }
  @media (max-width: 380px) { .gal-wrap { padding: 56px 16px; } }
</style>
