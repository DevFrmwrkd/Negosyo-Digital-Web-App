---
/**
 * layouts / CtaBandAZ — the kiosk closer: a full-width centred band with a bone
 * eyebrow, an oversized EB Garamond headline (italic accent via <em>) and up to
 * two hairline CTAs. Anchors #reserve for the hero / nav CTA.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const hasButtons = !!(cta1Text || cta2Text);
---
{(headline || hasButtons) && (
  <section class="cta-k" id="reserve">
    {tag && <span class="eyebrow" data-field="ctaBand.tag">{tag}</span>}
    {headline && <h2 class="cta-h" data-field="ctaBand.headline" set:html={headline}></h2>}
    {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
    {hasButtons && (
      <div class="btnrow" style="justify-content:center;">
        {cta1Text && <a href={cta1Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
        {cta2Text && <a href={cta2Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
      </div>
    )}
  </section>
)}
<style>
  .cta-k { text-align: center; padding: 130px 40px; border-top: 1px solid var(--line); }
  .cta-k .eyebrow { display: inline-block; margin-bottom: 16px; }
  .cta-h { font-size: clamp(38px,6vw,86px); color: var(--ink); margin-bottom: 28px; }
  .cta-sub { color: var(--ink-soft); max-width: 52ch; margin: -14px auto 28px; }
  @media (max-width: 760px) {
    .cta-k { padding: 84px 22px; }
    .cta-h { font-size: clamp(32px,9vw,56px); }
  }
  @media (max-width: 520px) {
    .btnrow { flex-direction: column; align-items: stretch; }
    .btnrow .btn { justify-content: center; }
  }
  @media (max-width: 380px) { .cta-k { padding: 72px 16px; } }
</style>
