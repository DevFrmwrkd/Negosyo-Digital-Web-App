---
/**
 * layouts / CtaBandAY — the centred editorial closer (lp-20's .cta): a plum-paper
 * band with a plum eyebrow, an oversized Instrument Serif headline (italic plum
 * accent) and up to three CTAs. The section anchors #reserve for the hero / nav
 * CTA. Reads content.ctaBand (legacy `closing`), mirroring the AM content model.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || cta.cta?.text || '';
const cta1Href = cta.cta1?.href || cta.cta?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#location';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="cta" id="reserve">
    <div class="wrap">
      {tag && <span class="eyebrow reveal" data-field="ctaBand.tag">{tag}</span>}
      {headline && <h2 class="cta-h reveal" data-delay="1" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub reveal" data-delay="1" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="btnrow reveal" data-delay="2">
          {cta1Text && <a href={cta1Href} class="btn f" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn g" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn g" rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta { background: var(--paper-2); text-align: center; }
  .cta .eyebrow { display: block; }
  .cta-h { font-size: clamp(40px,6.4vw,92px); color: var(--ink); margin: .16em 0 30px; }
  .cta-h :global(em) { font-style: italic; color: var(--accent); }
  .cta-sub { color: var(--ink-soft); max-width: 52ch; margin: 0 auto 30px; }
  .cta .btnrow { justify-content: center; }
  @media (max-width: 760px) { .cta-h { font-size: clamp(32px,9vw,58px); } }
  @media (max-width: 480px) {
    .cta .btnrow { flex-direction: column; align-items: stretch; }
    .cta .btnrow .btn { justify-content: center; }
  }
</style>
