---
/**
 * layouts / CtaBandBA — the centred closer (lp-22 CTA-BAND block). A brass
 * eyebrow, an oversized serif headline (with an optional <em> brass accent)
 * and up to three CTAs. Anchors #book so the sidebar / hero CTA lands here.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#visit';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#visit';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="p-sec cta-p" id="book" data-component="CTA-BAND" data-variant="panel">
    {tag && <span class="eyebrow" data-field="ctaBand.tag">{tag}</span>}
    {headline && <h2 class="cta-h" data-field="ctaBand.headline" set:html={headline}></h2>}
    {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
    {hasButtons && (
      <div class="btnrow" style="justify-content:center">
        {cta1Text && <a class="btn f" href={cta1Href} rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
        {cta2Text && <a class="btn g" href={cta2Href} rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
        {cta3Text && <a class="btn g" href={cta3Href} rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
      </div>
    )}
  </section>
)}
<style>
  .cta-p { text-align: center; }
  .cta-p .eyebrow { display: block; margin-bottom: 14px; }
  .cta-h { font-size: clamp(34px,5.4vw,72px); margin-bottom: 26px; color: var(--ink); }
  .cta-h :global(em) { font-style: italic; color: var(--accent); }
  .cta-sub { color: var(--ink-soft); max-width: 52ch; margin: 0 auto 26px; }
  @media (max-width: 760px) {
    .cta-h { font-size: clamp(28px,8vw,52px); }
    .cta-p .btnrow { flex-direction: column; align-items: stretch; }
    .cta-p .btnrow .btn { justify-content: center; }
  }
</style>
