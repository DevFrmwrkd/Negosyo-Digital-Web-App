---
/**
 * layouts / PageAV — "Spectral Bento" (cobalt editorial bento grid).
 *
 * Ported from Local Business Landing Pages v4 / lp-23-food.html (archetype:
 * "bento"). The signature identity is a 12-column bento of rounded, hairline
 * ruled surface "tiles" on a cool paper ground: Spectral serif display with an
 * italic cobalt accent, Barlow Condensed labels, pill buttons, and art-directed
 * "plate" photo frames whose designed duotone "scene" fields stand in until a
 * photo is set.
 *
 * REUSABLE LAYOUT (business-agnostic): unlike the earlier bespoke hero ports
 * this design does NOT bake a locked palette. lp-23's cobalt/paper colours are
 * extracted into the STANDARD theme vocabulary (--paper / --paper-2 / --card /
 * --ink / --ink-soft / --muted / --line / --accent / --accent-light /
 * --accent-deep + the generic aliases) as DEFAULTS, and every component reads
 * them via var(--token). buildOverrideCss() overrides exactly these tokens, so
 * the design ships looking like its source yet fully recolours when an admin
 * picks a scheme.
 *
 * Design isolation: all tokens + base primitives are scoped to
 * html[data-page="AV"] so no sister design inherits them.
 *
 * CRITICAL specificity note: the size-bearing .plate primitive is written as
 * html[data-page="AV"] :where(.plate) so per-section height modifiers
 * (.hero-img, .about-img, gallery spans, .loc-map-tile …) at (0,2,0) win over
 * the base instead of being squashed to a base floor. Do not remove :where().
 *
 * MOBILE-FIRST: the bento base grid (html[data-page="AV"] .grid) collapses to a
 * single column at <=760px IN THIS GLOBAL BLOCK, so it wins over every scoped
 * per-section span modifier and guarantees clean one-column stacking + no
 * horizontal overflow. HeaderAV ships a hamburger drawer.
 */
import HeaderAV from './header/HeaderAV.astro';
import HeroAV from './hero/HeroAV.astro';
import TrustAV from './trust/TrustAV.astro';
import AboutAV from './about/AboutAV.astro';
import ServicesAV from './services/ServicesAV.astro';
import WhyAV from './why/WhyAV.astro';
import HowAV from './how/HowAV.astro';
import TestimonialsAV from './testimonials/TestimonialsAV.astro';
import GalleryAV from './gallery/GalleryAV.astro';
import FaqAV from './faq/FaqAV.astro';
import AreaAV from './area/AreaAV.astro';
import CredentialsAV from './credentials/CredentialsAV.astro';
import LocationAV from './location/LocationAV.astro';
import CtaBandAV from './ctaBand/CtaBandAV.astro';
import FooterAV from './footer/FooterAV.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AV">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#f3f4f7" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-23 "Spectral Bento" palette + shared base primitives, scoped to
       html[data-page="AV"]. Colours are the SOURCE's defaults, expressed in the
       STANDARD theme vocabulary so buildOverrideCss can recolour cleanly. -->
  <style is:global>
    html[data-page="AV"] {
      /* lp-23 native palette, in standard theme tokens (defaults) */
      --paper: #f3f4f7;        /* page ground */
      --paper-2: #e8eaf1;      /* deeper paper (CTA gradient tail) */
      --card: #eef0f5;         /* tile / nav / footer surface */
      --ink: #141826;          /* primary text */
      --ink-soft: #4b5266;     /* secondary text */
      --muted: #7c8296;        /* dim text / captions */
      --line: #d4d8e4;         /* hairlines / borders */
      --accent: #2f4fd4;       /* cobalt primary */
      --accent-light: #4a68e8; /* cobalt hover */
      --accent-deep: #223a9e;  /* cobalt pressed / deep */
      --plate: #0f1016;        /* photo-frame ground (media — stays dark) */
      --radius: 18px;
      --maxw: 1240px;
      --serif: "Spectral", Georgia, "Times New Roman", serif;
      --sans: "Barlow Condensed", system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible even though components read the design's own tokens. */
      --paper-rgb: 243,244,247; --ink-rgb: 20,24,38; --accent-rgb: 47,79,212;
      --on-accent: #f3f4f7; --on-ink: #f3f4f7; --on-paper: #141826;
    }
    html[data-page="AV"] * { box-sizing: border-box; }
    html[data-page="AV"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AV"] { scroll-behavior: auto; } }
    html[data-page="AV"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 16px; line-height: 1.7;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    }
    html[data-page="AV"] h1, html[data-page="AV"] h2,
    html[data-page="AV"] h3, html[data-page="AV"] h4 {
      font-family: var(--serif); font-weight: 400; line-height: 1.06; margin: 0;
    }
    html[data-page="AV"] p { margin: 0 0 1em; }
    html[data-page="AV"] a { color: var(--accent); text-decoration: none; }
    html[data-page="AV"] a:hover { color: var(--accent-deep); }
    html[data-page="AV"] img { max-width: 100%; display: block; }
    html[data-page="AV"] ::selection { background: var(--accent); color: var(--on-accent); }

    html[data-page="AV"] .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
    html[data-page="AV"] .eyebrow {
      font-family: var(--sans); font-size: 10px; letter-spacing: .34em;
      text-transform: uppercase; color: var(--accent); font-weight: 600;
    }

    /* Pill buttons — cobalt fill / paper ghost (design signature). */
    html[data-page="AV"] .btn {
      display: inline-flex; align-items: center; gap: .5em; font-family: var(--sans);
      font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 500;
      padding: 15px 26px; border-radius: 100px; border: 1px solid var(--accent);
      cursor: pointer; transition: transform .35s, background .35s, color .35s, border-color .35s;
    }
    html[data-page="AV"] .btn--fill { background: var(--accent); color: var(--on-accent); }
    html[data-page="AV"] .btn--fill:hover { background: var(--accent-light); border-color: var(--accent-light); color: var(--on-accent); transform: translateY(-2px); }
    html[data-page="AV"] .btn--ghost { color: var(--ink); border-color: var(--line); background: var(--card); }
    html[data-page="AV"] .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }
    html[data-page="AV"] .btnrow { display: flex; gap: 12px; flex-wrap: wrap; }
    html[data-page="AV"] .btn .arw { transition: transform .35s; }
    html[data-page="AV"] .btn:hover .arw { transform: translateX(4px); }

    /* Scroll reveal */
    html[data-page="AV"] .reveal { opacity: 0; transform: translateY(20px) scale(.99); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
    html[data-page="AV"] .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AV"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* ---- Bento scaffolding -------------------------------------------- */
    html[data-page="AV"] section { position: relative; padding: 30px 0; }
    /* GLOBAL bento grid. Its <=760px collapse lives here so it wins over
       every scoped per-section span modifier and stacks to one column. */
    html[data-page="AV"] .grid { display: grid; grid-template-columns: repeat(12,1fr); gap: 16px; }
    html[data-page="AV"] .tile { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }
    html[data-page="AV"] .sec-tag { grid-column: span 12; display: flex; align-items: baseline; gap: 14px; padding: 24px 6px 4px; flex-wrap: wrap; }
    html[data-page="AV"] .sec-tag h2 { font-size: clamp(24px,3.2vw,40px); color: var(--ink); }
    html[data-page="AV"] .sec-tag h2 em { font-style: italic; color: var(--accent); }
    html[data-page="AV"] .sec-tag .n { font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--accent); }

    /* Designed photo frame — :where() so per-section height modifiers win. */
    html[data-page="AV"] :where(.plate) { position: relative; overflow: hidden; background: var(--plate); border-radius: var(--radius); isolation: isolate; }
    html[data-page="AV"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
    html[data-page="AV"] :where(.plate):hover .ph { transform: scale(1.06); }
    html[data-page="AV"] :where(.plate) figcaption {
      position: absolute; left: 0; bottom: 0; z-index: 3; width: 100%; padding: 12px 15px;
      font-family: var(--sans); font-size: 9px; letter-spacing: .26em; text-transform: uppercase;
      color: #f2eee5; background: linear-gradient(0deg,rgba(6,6,8,.8),transparent);
    }
    html[data-page="AV"] :where(.plate) .mark {
      position: absolute; top: 12px; right: 14px; z-index: 3; font-family: var(--sans);
      font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: rgba(242,238,229,.75);
      border: 1px solid rgba(242,238,229,.35); padding: 3px 7px; border-radius: 4px;
    }

    /* Duotone "scene" fields — the designed fallback painted behind each photo.
       Cobalt highlights read var(--accent-rgb) so they recolour with the theme;
       the neutral charcoal ground is a media stand-in and stays dark. */
    html[data-page="AV"] .sc1 { background:
      radial-gradient(70% 60% at 46% 36%,rgba(var(--accent-rgb),.55),transparent 60%),
      radial-gradient(60% 60% at 76% 78%,rgba(var(--accent-rgb),.28),transparent 62%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AV"] .sc2 { background:
      radial-gradient(55% 65% at 60% 40%,rgba(var(--accent-rgb),.5),transparent 60%),
      repeating-linear-gradient(60deg,rgba(255,255,255,.05) 0 4px,transparent 4px 20px),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AV"] .sc3 { background:
      radial-gradient(60% 50% at 50% 60%,rgba(var(--accent-rgb),.36),transparent 62%),
      repeating-linear-gradient(0deg,rgba(255,255,255,.05) 0 1px,transparent 1px 50px),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AV"] .sc4 { background:
      conic-gradient(from 230deg at 42% 44%,rgba(var(--accent-rgb),.52),transparent 42%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AV"] .sc5 { background:
      radial-gradient(38% 48% at 50% 36%,rgba(255,255,255,.16),transparent 60%),
      radial-gradient(55% 45% at 50% 74%,rgba(var(--accent-rgb),.46),transparent 64%),
      linear-gradient(175deg,#1c1c20,#090909); }
    html[data-page="AV"] .sc6 { background:
      radial-gradient(66% 66% at 44% 42%,rgba(var(--accent-rgb),.48),transparent 62%),
      linear-gradient(175deg,#1c1c20,#090909); }

    /* skip link */
    html[data-page="AV"] .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--on-accent); padding: 10px 16px; z-index: 100; }
    html[data-page="AV"] .skip:focus { left: 8px; top: 8px; }

    /* ------------------------------------------------------------------ */
    /* Mobile-first tuning — shared scaffolding only. The base grid        */
    /* collapse below is GLOBAL so it wins over every scoped span modifier */
    /* and stacks every multi-column section to a single column.          */
    /* ------------------------------------------------------------------ */
    @media (max-width: 760px) {
      html[data-page="AV"] .wrap { padding: 0 18px; }
      html[data-page="AV"] .grid { grid-template-columns: 1fr; gap: 14px; }
      html[data-page="AV"] .tile { padding: 24px; }
      html[data-page="AV"] .sec-tag { padding: 12px 4px 2px; gap: 10px; }
      html[data-page="AV"] .sec-tag h2 { font-size: clamp(22px,6.4vw,34px); }
      html[data-page="AV"] .btn { padding: 13px 22px; }
    }
    @media (max-width: 380px) {
      html[data-page="AV"] .wrap { padding: 0 14px; }
      html[data-page="AV"] .tile { padding: 20px; }
      html[data-page="AV"] .sec-tag h2 { font-size: clamp(20px,7vw,28px); }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAV layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAV content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAV content={content} />}
    {visibility.aboutSection !== false && <AboutAV content={content} />}
    {visibility.servicesSection !== false && <ServicesAV content={content} />}
    {visibility.whyUsBlock !== false && <WhyAV content={content} />}
    {visibility.howItWorksBlock !== false && <HowAV content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAV content={content} />}
    {visibility.gallerySection !== false && <GalleryAV content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAV content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAV content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAV content={content} />}
    {visibility.locationBlock !== false && <LocationAV content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAV content={content} layout={layout} />}
  <FooterAV layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      // layouts-AV Leaflet boot — accepts (lat, lng, label) from LocationAV.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAV calls this with whatever it resolves).
      window.__layoutsAVInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#2f4fd4';
        var ring = getComputedStyle(document.documentElement).getPropertyValue('--card').trim() || '#eef0f5';
        var icon = L.divIcon({ className: '', html: '<div style="width:16px;height:16px;border-radius:50%;background:' + accent + ';box-shadow:0 0 0 3px ' + ring + ';border:0;"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
