---
/**
 * layouts / PageAX — "Brutalist" (bordered-grid industrial archetype).
 *
 * Ported from Local Business Landing Pages v4 / lp-21-food.html. A hard
 * brutalist look: an edge-to-edge (full-bleed) dark ground, bold 2px rules
 * dividing every section into a bordered grid, Space Mono labels + numerals,
 * IBM Plex Sans display, a bone "accent" that fills buttons / brand block /
 * ticker, and a marquee ticker under the split hero.
 *
 * REUSABLE LAYOUT (business-agnostic): unlike the earlier bespoke hero ports,
 * AX is built to RECOLOUR cleanly through the theme engine. lp-21's baked hex
 * palette is lifted into the STANDARD token vocabulary the theme engine already
 * overrides (--paper / --paper-2 / --card / --ink / --ink-soft / --muted /
 * --line / --accent / --accent-light / --accent-deep + generic aliases). Those
 * tokens carry the source colours as DEFAULTS, so AX looks like lp-21 out of the
 * box but fully recolours when buildOverrideCss injects an admin scheme. Every
 * section component reads ONLY var(--token) — no baked hex lives in a component.
 *
 * CRITICAL specificity note: the size-bearing `.plate` primitive is written as
 * `html[data-page="AX"] :where(.plate)` so per-section height / aspect modifiers
 * (.hero-r, .gal-b .plate, .loc-map …) at (0,2,0) win over the base instead of
 * being squashed to a base floor. Do not remove the :where().
 *
 * lockVariant: true — only an EXPLICIT admin colour / font pick recolours; with
 * no pick the brutalist defaults win (we do NOT fall back to the business-type
 * auto map), keeping the archetype visually distinct by default.
 */
import HeaderAX from './header/HeaderAX.astro';
import HeroAX from './hero/HeroAX.astro';
import TrustAX from './trust/TrustAX.astro';
import AboutAX from './about/AboutAX.astro';
import ServicesAX from './services/ServicesAX.astro';
import WhyAX from './why/WhyAX.astro';
import HowAX from './how/HowAX.astro';
import TestimonialsAX from './testimonials/TestimonialsAX.astro';
import GalleryAX from './gallery/GalleryAX.astro';
import FaqAX from './faq/FaqAX.astro';
import AreaAX from './area/AreaAX.astro';
import CredentialsAX from './credentials/CredentialsAX.astro';
import LocationAX from './location/LocationAX.astro';
import CtaBandAX from './ctaBand/CtaBandAX.astro';
import FooterAX from './footer/FooterAX.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#0c0d0f" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-21 "Brutalist" palette lifted into the STANDARD token vocabulary +
       shared base primitives, scoped to html[data-page="AX"] so they never leak
       to sister designs. The hex values are DEFAULTS; the theme engine's
       buildOverrideCss (emitted below) overrides these same token names when an
       admin picks a colour scheme, so the design recolours cleanly. -->
  <style is:global>
    html[data-page="AX"] {
      /* --- lp-21 native palette, as overridable STANDARD tokens --- */
      --paper: #0c0d0f;          /* page ground (near-black) */
      --paper-2: #121316;        /* raised section-bar / panel */
      --card: #17181c;           /* card / plate backing */
      --ink: #eceef1;            /* primary text (near-white) */
      --ink-soft: #a9adb6;       /* secondary text */
      --muted: #74787f;          /* dim / caption text */
      --line: #eceef1;           /* bold structural rules (brutalist signature) */
      --accent: #e8e6df;         /* bone — fills buttons / brand / ticker / numerals */
      --accent-light: #f4f2ec;   /* brighter bone — accent hover */
      --accent-deep: #cfccc2;    /* muted bone — pressed / deep accent */
      /* Subtle hairline derived from the text colour so it ADAPTS with the
         scheme (dark ink → light hairline; light ink → dark hairline). */
      --hair: rgba(var(--ink-rgb),.14);
      /* Plate (designed photo-fallback) grounds — art-direction, not theme-driven.
         Coloured glows read var(--accent-rgb) so they still recolour with the scheme. */
      --plate-1: #211f1d;
      --plate-2: #0b0b0c;
      --on-plate: #eceef1;       /* light text pinned on the dark plate */
      /* --- type (kept from the source) --- */
      --serif: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; /* display alias — theme maps the heading pairing here */
      --sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --label: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      /* --- generic aliases (mirrors PageAM) so inherited + engine rules stay legible --- */
      --paper-rgb: 12,13,15; --ink-rgb: 236,238,241; --accent-rgb: 232,230,223;
      --on-accent: #0c0d0f; --on-ink: #0c0d0f; --on-paper: #eceef1;
    }

    html[data-page="AX"] * { box-sizing: border-box; }
    html[data-page="AX"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AX"] { scroll-behavior: auto; } }
    html[data-page="AX"] body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 15px; line-height: 1.6;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    html[data-page="AX"] h1, html[data-page="AX"] h2,
    html[data-page="AX"] h3, html[data-page="AX"] h4 {
      margin: 0; font-family: var(--serif); font-weight: 600; line-height: 1.02; letter-spacing: -.01em;
    }
    html[data-page="AX"] p { margin: 0 0 1em; }
    html[data-page="AX"] a { color: var(--accent); text-decoration: none; }
    html[data-page="AX"] a:hover { color: var(--ink); }
    html[data-page="AX"] img { max-width: 100%; display: block; }
    html[data-page="AX"] ::selection { background: var(--accent); color: var(--on-accent); }

    /* shared brutalist chrome */
    html[data-page="AX"] .mono { font-family: var(--mono); }
    html[data-page="AX"] .lbl { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }

    /* skip link */
    html[data-page="AX"] .skip { position: absolute; left: -999px; top: 0; }
    html[data-page="AX"] .skip:focus { left: 8px; top: 8px; background: var(--accent); color: var(--on-accent); padding: 10px 14px; z-index: 100; }

    /* letterpress buttons — bone fill / hairline ghost, joined at -2px (signature) */
    html[data-page="AX"] .btn {
      display: inline-block; font-family: var(--mono); font-size: 12px; letter-spacing: .06em;
      text-transform: uppercase; padding: 15px 26px; border: 2px solid var(--line);
      color: var(--ink); background: transparent; transition: .2s; cursor: pointer;
    }
    html[data-page="AX"] .btn.f, html[data-page="AX"] .btn--fill { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
    html[data-page="AX"] .btn.f:hover, html[data-page="AX"] .btn--fill:hover { background: var(--accent-light); border-color: var(--accent-light); color: var(--on-accent); }
    html[data-page="AX"] .btn.g, html[data-page="AX"] .btn--ghost { color: var(--ink); background: transparent; border-color: var(--line); }
    html[data-page="AX"] .btn.g:hover, html[data-page="AX"] .btn--ghost:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    html[data-page="AX"] .btnrow { display: flex; gap: 0; flex-wrap: wrap; }
    html[data-page="AX"] .btnrow .btn + .btn { margin-left: -2px; }

    /* scroll reveal */
    html[data-page="AX"] .reveal { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }
    html[data-page="AX"] .reveal.in { opacity: 1; transform: none; }
    html[data-page="AX"] .reveal[data-delay="1"] { transition-delay: .06s; }
    html[data-page="AX"] .reveal[data-delay="2"] { transition-delay: .12s; }
    html[data-page="AX"] .reveal[data-delay="3"] { transition-delay: .18s; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AX"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* Designed photo frame — :where() so per-section height / aspect modifiers win. */
    html[data-page="AX"] :where(.plate) { position: relative; overflow: hidden; background: var(--card); border: 2px solid var(--line); isolation: isolate; }
    html[data-page="AX"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; }
    html[data-page="AX"] :where(.plate) figcaption, html[data-page="AX"] :where(.plate) .cap {
      position: absolute; left: 0; bottom: 0; z-index: 3; padding: 7px 11px;
      font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase;
      background: var(--accent); color: var(--on-accent);
    }
    html[data-page="AX"] :where(.plate) .mark {
      position: absolute; top: 10px; right: 12px; z-index: 3; font-family: var(--mono); font-size: 9px;
      letter-spacing: .16em; text-transform: uppercase; color: var(--on-plate);
      border: 1px solid rgba(var(--ink-rgb),.4); padding: 3px 6px;
    }

    /* Duotone "scene" fields — the designed fallback painted behind each photo.
       Bone glows read var(--accent-rgb) so they recolour; the dark ground is
       art-direction. (neutral white texture stays literal — it is grain, not palette.) */
    html[data-page="AX"] .sc1 { background: radial-gradient(70% 60% at 38% 36%, rgba(var(--accent-rgb),.55), transparent 60%), radial-gradient(60% 60% at 76% 78%, rgba(var(--accent-rgb),.28), transparent 62%), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AX"] .sc2 { background: radial-gradient(55% 65% at 60% 40%, rgba(var(--accent-rgb),.5), transparent 60%), repeating-linear-gradient(0deg, rgba(var(--ink-rgb),.05) 0 4px, transparent 4px 20px), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AX"] .sc3 { background: radial-gradient(60% 50% at 50% 60%, rgba(var(--accent-rgb),.36), transparent 62%), repeating-linear-gradient(0deg, rgba(var(--ink-rgb),.05) 0 1px, transparent 1px 38px), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AX"] .sc4 { background: conic-gradient(from 190deg at 42% 44%, rgba(var(--accent-rgb),.52), transparent 42%), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AX"] .sc5 { background: radial-gradient(38% 48% at 50% 36%, rgba(var(--ink-rgb),.16), transparent 60%), radial-gradient(55% 45% at 50% 74%, rgba(var(--accent-rgb),.46), transparent 64%), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }
    html[data-page="AX"] .sc6 { background: radial-gradient(66% 66% at 44% 42%, rgba(var(--accent-rgb),.48), transparent 62%), linear-gradient(160deg, var(--plate-1), var(--plate-2)); }

    /* section scaffolding — every block is a bordered brutalist grid cell */
    html[data-page="AX"] section { position: relative; }
    html[data-page="AX"] .grid-sec { border-bottom: 2px solid var(--line); }
    html[data-page="AX"] .sec-bar {
      display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
      padding: 20px 24px; border-bottom: 2px solid var(--line); background: var(--paper-2);
    }
    html[data-page="AX"] .sec-bar h2 { font-size: clamp(22px,3vw,40px); text-transform: uppercase; letter-spacing: -.01em; }
    html[data-page="AX"] .sec-bar .idx { font-family: var(--mono); font-size: 12px; color: var(--accent); white-space: nowrap; }
    html[data-page="AX"] .sec-bar h2 :global(em) { font-style: normal; color: var(--accent); }

    /* ------------------------------------------------------------------ */
    /* Mobile-first tuning — shared scaffolding only. Per-section grids     */
    /* live in each *AX component with their own <=760px stacking. Desktop  */
    /* rules above are untouched; these take effect at phone widths.        */
    /* ------------------------------------------------------------------ */
    @media (max-width: 760px) {
      html[data-page="AX"] .sec-bar { padding: 15px 18px; }
      html[data-page="AX"] .sec-bar h2 { font-size: clamp(20px,6.2vw,32px); }
      html[data-page="AX"] .btn { padding: 13px 20px; }
    }
    @media (max-width: 380px) {
      html[data-page="AX"] .sec-bar { flex-wrap: wrap; gap: 4px 12px; }
      html[data-page="AX"] .sec-bar h2 { font-size: clamp(19px,7vw,27px); }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAX layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAX content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAX content={content} />}
    {visibility.aboutSection !== false && <AboutAX content={content} />}
    {visibility.servicesSection !== false && <ServicesAX content={content} />}
    {visibility.whyUsBlock !== false && <WhyAX content={content} />}
    {visibility.howItWorksBlock !== false && <HowAX content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAX content={content} />}
    {visibility.gallerySection !== false && <GalleryAX content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAX content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAX content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAX content={content} />}
    {visibility.locationBlock !== false && <LocationAX content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAX content={content} layout={layout} />}
  <FooterAX layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden && ('IntersectionObserver' in window)) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }

      // Brutalist Leaflet boot — accepts (lat, lng, label) from LocationAX.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords. Reads --accent / --paper at runtime so the square pin
      // recolours with the active scheme; dark Carto tiles match the dark ground.
      window.__layoutsAXInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var accent = (getComputedStyle(document.documentElement).getPropertyValue('--accent') || '').trim() || '#e8e6df';
        var paper = (getComputedStyle(document.documentElement).getPropertyValue('--paper') || '').trim() || '#0c0d0f';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/dark_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:16px;height:16px;background:' + accent + ';box-shadow:0 0 0 3px ' + paper + ';border:0;"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
