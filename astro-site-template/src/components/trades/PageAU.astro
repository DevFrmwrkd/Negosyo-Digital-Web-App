---
/**
 * trades / PageAU — "Dispatch" (electrical drafting-sheet / schematic landing).
 *
 * Ported from Local Business Landing Pages v4 / lp-09-trades.html. A blueprint
 * dispatch board: a deep-navy sheet under a faint cyan wiring grid, Helvetica
 * ultra-bold uppercase headings with Courier mono annotations, caution-yellow
 * fill CTAs and cyan link accents. The signature is a service-area coverage
 * grid with pulsing dispatch pings — a mobile trade with no storefront — and a
 * giant tap-to-call dispatch number.
 *
 * Design isolation: lp-09's palette tokens + base primitives are scoped to
 * `html[data-page="AU"]` in the global block below so sister trades variants
 * (e.g. AK "Blueprint Cyanotype") never inherit AU's tokens or its bespoke
 * `.plate` / `.scene-*` / `.covmap` / `.ping` primitives (and vice-versa).
 *
 * CRITICAL specificity note: the size-bearing `.plate` primitive is written as
 * `html[data-page="AU"] :where(.plate)` so per-section height modifiers
 * (.about-fig aspect-ratio, the .g-grid rows / .v1 spans, .loc-map) at (0,2,0)
 * win over the base (which would otherwise land at 0,2,1) instead of collapsing
 * every frame to a base floor. Do not remove the :where().
 *
 * The source names its light TEXT token `--paper`; the generic alias contract
 * needs `--paper` to mean the page BACKGROUND. To avoid the collision the light
 * text is carried on the generic `--ink` alias (every ported component reads
 * `var(--ink)` where the source read `var(--paper)`), and `--paper` is aliased
 * to the navy sheet background for the theme-override machinery.
 *
 * lockVariant: true — only an EXPLICIT admin color/font pick recolors; the
 * hand-tuned "Dispatch" palette wins by default.
 */
import HeaderAU from './header/HeaderAU.astro';
import HeroAU from './hero/HeroAU.astro';
import TrustAU from './trust/TrustAU.astro';
import AboutAU from './about/AboutAU.astro';
import ServicesAU from './services/ServicesAU.astro';
import WhyAU from './why/WhyAU.astro';
import HowAU from './how/HowAU.astro';
import TestimonialsAU from './testimonials/TestimonialsAU.astro';
import GalleryAU from './gallery/GalleryAU.astro';
import FaqAU from './faq/FaqAU.astro';
import AreaAU from './area/AreaAU.astro';
import CredentialsAU from './credentials/CredentialsAU.astro';
import LocationAU from './location/LocationAU.astro';
import CtaBandAU from './ctaBand/CtaBandAU.astro';
import FooterAU from './footer/FooterAU.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <meta name="theme-color" content="#0b2143" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- lp-09 "Dispatch" palette tokens + shared base primitives, scoped to
       html[data-page="AU"] so they never leak to sister trades variants. -->
  <style is:global>
    html[data-page="AU"] {
      /* lp-09 native palette */
      --navy: #0b2143; --navy-2: #0f2a54; --navy-d: #071528; --panel: #0e2650; --steel: #20406f;
      --cyan: #63c8ff; --cyan-d: #3a95d8; --blue: #2f6fd0; --yellow: #ffd21e; --muted: #8fa9cc;
      --line: #1e3a63;
      --sans: "Helvetica Neue",Helvetica,Arial,"Liberation Sans",sans-serif;
      --mono: "Courier New",ui-monospace,Consolas,monospace;
      --maxw: 1280px;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible. The source used `--paper` for light TEXT; the generic
         contract needs `--paper` = background, so the light text is carried on
         `--ink` (components read var(--ink) where the source read var(--paper)). */
      --paper: #0b2143; --ink: #e9f1fb; --accent: #ffd21e;
      --serif: "Helvetica Neue",Helvetica,Arial,"Liberation Sans",sans-serif;
      --paper-rgb: 11,33,67; --ink-rgb: 233,241,251; --accent-rgb: 255,210,30;
      --on-accent: #071528; --on-ink: #071528; --on-paper: #e9f1fb;
    }
    html[data-page="AU"] * { box-sizing: border-box; }
    html[data-page="AU"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AU"] { scroll-behavior: auto; } }
    html[data-page="AU"] body {
      margin: 0; background: var(--navy); color: var(--ink);
      font-family: var(--sans); font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased;
      background-image:
        repeating-linear-gradient(0deg,rgba(99,200,255,.05) 0 1px,transparent 1px 40px),
        repeating-linear-gradient(90deg,rgba(99,200,255,.05) 0 1px,transparent 1px 40px);
    }
    html[data-page="AU"] h1, html[data-page="AU"] h2,
    html[data-page="AU"] h3, html[data-page="AU"] h4 {
      margin: 0; font-weight: 800; line-height: 1; letter-spacing: -.01em; text-transform: uppercase;
    }
    html[data-page="AU"] p { margin: 0 0 1em; }
    html[data-page="AU"] a { color: var(--cyan); text-decoration: none; }
    html[data-page="AU"] a:hover { color: var(--yellow); }
    html[data-page="AU"] img { max-width: 100%; display: block; }
    html[data-page="AU"] ::selection { background: var(--cyan); color: var(--navy-d); }

    html[data-page="AU"] .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 30px; }
    html[data-page="AU"] .mono { font-family: var(--mono); }
    html[data-page="AU"] .kicker { font-family: var(--mono); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--cyan); }
    /* Inline headline accents (set:html spans don't receive Astro scoping). */
    html[data-page="AU"] .cy { color: var(--cyan); }
    html[data-page="AU"] .yl { color: var(--yellow); }

    /* Schematic buttons — caution-yellow fill, cyan, and steel-hollow ghost. */
    html[data-page="AU"] .btn {
      font-family: var(--sans); font-weight: 800; font-size: 14px; letter-spacing: .06em; text-transform: uppercase;
      display: inline-flex; align-items: center; gap: .5em; padding: 16px 28px; cursor: pointer;
      border: 2px solid var(--cyan); transition: transform .2s, background .2s, color .2s, box-shadow .2s;
    }
    html[data-page="AU"] .btn--fill { background: var(--yellow); border-color: var(--yellow); color: var(--navy-d); }
    html[data-page="AU"] .btn--fill:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(255,210,30,.6); }
    html[data-page="AU"] .btn--cyan { background: var(--cyan); border-color: var(--cyan); color: var(--navy-d); }
    html[data-page="AU"] .btn--cyan:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(99,200,255,.6); color: var(--navy-d); }
    html[data-page="AU"] .btn--ghost { background: transparent; color: var(--ink); border-color: var(--steel); }
    html[data-page="AU"] .btn--ghost:hover { border-color: var(--cyan); color: var(--cyan); transform: translateY(-2px); }

    /* Scroll reveal (driven by the inline IntersectionObserver below). */
    html[data-page="AU"] .reveal { opacity: 0; transform: translateY(22px); transition: opacity .8s cubic-bezier(.2,.8,.2,1), transform .8s cubic-bezier(.2,.8,.2,1); }
    html[data-page="AU"] .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AU"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

    /* Designed blueprint photo frame — :where() so per-section height modifiers
       win over the base. The .ph layer takes the inline background-image over the
       designed .scene-* gradient fallback. */
    html[data-page="AU"] :where(.plate) { position: relative; overflow: hidden; background: var(--navy-d); isolation: isolate; border: 1px solid var(--line); }
    html[data-page="AU"] :where(.plate) .ph { position: absolute; inset: 0; background-size: cover; background-position: center; }
    html[data-page="AU"] :where(.plate) .grid { position: absolute; inset: 0; background-image: repeating-linear-gradient(0deg,rgba(99,200,255,.12) 0 1px,transparent 1px 22px),repeating-linear-gradient(90deg,rgba(99,200,255,.12) 0 1px,transparent 1px 22px); }
    html[data-page="AU"] :where(.plate) .cap { position: absolute; left: 0; bottom: 0; z-index: 3; width: 100%; padding: 12px 14px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--ink); background: linear-gradient(0deg,rgba(7,21,40,.9),transparent); text-transform: uppercase; }
    html[data-page="AU"] :where(.plate) .tag { position: absolute; top: 10px; left: 10px; z-index: 3; font-family: var(--mono); font-size: 11px; color: var(--navy-d); background: var(--yellow); padding: 3px 8px; letter-spacing: .06em; }

    /* Duotone schematic "scene" fields — the designed fallback painted behind
       each photo slot. */
    html[data-page="AU"] .scene-wire { background: radial-gradient(60% 70% at 42% 40%,rgba(99,200,255,.3),transparent 60%),linear-gradient(160deg,#123059,#071528); }
    html[data-page="AU"] .scene-panel { background: repeating-linear-gradient(90deg,rgba(99,200,255,.12) 0 3px,transparent 3px 20px),radial-gradient(50% 50% at 60% 46%,rgba(255,210,30,.22),transparent 60%),linear-gradient(160deg,#102a52,#071528); }
    html[data-page="AU"] .scene-light { background: radial-gradient(40% 40% at 50% 40%,rgba(255,210,30,.4),transparent 60%),linear-gradient(160deg,#122f58,#071528); }
    html[data-page="AU"] .scene-van { background: radial-gradient(60% 60% at 58% 46%,rgba(99,200,255,.28),transparent 60%),linear-gradient(160deg,#12305a,#071528); }
    html[data-page="AU"] .scene-meter { background: radial-gradient(46% 46% at 50% 50%,rgba(99,200,255,.26),transparent 58%),conic-gradient(from 0deg at 50% 50%,rgba(255,210,30,.2),transparent 30%,rgba(99,200,255,.2),transparent 60%),linear-gradient(160deg,#0f2a52,#071528); }
    html[data-page="AU"] .scene-inspect { background: radial-gradient(60% 60% at 44% 44%,rgba(99,200,255,.28),transparent 60%),radial-gradient(40% 40% at 74% 66%,rgba(255,210,30,.2),transparent 60%),linear-gradient(160deg,#112d55,#071528); }

    /* Signature coverage / dispatch map — shared by the hero and the location
       block. A gridded sheet with a dashed service region and pulsing pings. */
    html[data-page="AU"] .covmap { position: relative; aspect-ratio: 1/1; border: 1px solid var(--line); background:
      repeating-linear-gradient(0deg,rgba(99,200,255,.1) 0 1px,transparent 1px 30px),
      repeating-linear-gradient(90deg,rgba(99,200,255,.1) 0 1px,transparent 1px 30px),
      radial-gradient(70% 70% at 50% 46%,rgba(47,111,208,.25),transparent 70%),var(--navy-d); }
    html[data-page="AU"] .covmap .region { position: absolute; left: 16%; top: 14%; right: 16%; bottom: 14%; border: 1.5px dashed var(--cyan); border-radius: 44% 56% 52% 48%/50% 44% 56% 50%; background: rgba(99,200,255,.06); }
    html[data-page="AU"] .covmap .lbl { position: absolute; top: 12px; left: 14px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--cyan); }
    html[data-page="AU"] .covmap .scale { position: absolute; bottom: 12px; right: 14px; font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--muted); }
    html[data-page="AU"] .ping { position: absolute; transform: translate(-50%,-50%); text-align: center; }
    html[data-page="AU"] .ping .d { width: 11px; height: 11px; border-radius: 50%; background: var(--yellow); margin: 0 auto; position: relative; }
    html[data-page="AU"] .ping .d::after { content: ""; position: absolute; inset: -6px; border: 1.5px solid rgba(255,210,30,.7); border-radius: 50%; animation: ping-au 2.6s ease-out infinite; }
    html[data-page="AU"] .ping.c .d { background: var(--cyan); }
    html[data-page="AU"] .ping.c .d::after { border-color: rgba(99,200,255,.7); }
    html[data-page="AU"] .ping .t { font-family: var(--mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink); margin-top: 5px; white-space: nowrap; }
    html[data-page="AU"] .ping.p2 .d::after { animation-delay: .5s; }
    html[data-page="AU"] .ping.p3 .d::after { animation-delay: 1s; }
    html[data-page="AU"] .ping.p4 .d::after { animation-delay: 1.5s; }
    html[data-page="AU"] .ping.p5 .d::after { animation-delay: .8s; }
    html[data-page="AU"] .ping.p6 .d::after { animation-delay: 1.3s; }
    @media (prefers-reduced-motion: reduce) { html[data-page="AU"] .ping .d::after { animation: none; } }
    @keyframes ping-au { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(3); opacity: 0; } }

    /* section scaffolding shared across blocks */
    html[data-page="AU"] section { position: relative; }
    html[data-page="AU"] .sec { padding: 96px 0; border-bottom: 1px solid var(--line); }
    html[data-page="AU"] .sec-head { display: flex; align-items: flex-end; gap: 18px; margin-bottom: 48px; flex-wrap: wrap; }
    html[data-page="AU"] .sec-head .snum { font-family: var(--mono); font-size: 13px; letter-spacing: .16em; color: var(--cyan); }
    html[data-page="AU"] .sec-head h2 { font-size: clamp(32px,5vw,64px); }

    /* skip link */
    html[data-page="AU"] .skip { position: absolute; left: -999px; top: 0; background: var(--yellow); color: var(--navy-d); padding: 12px 18px; z-index: 100; }
    html[data-page="AU"] .skip:focus { left: 8px; top: 8px; }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <HeaderAU layout={layout} content={content} />
  <main id="main">
    {visibility.heroSection !== false && <HeroAU content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAU content={content} />}
    {visibility.aboutSection !== false && <AboutAU content={content} />}
    {visibility.servicesSection !== false && <ServicesAU content={content} />}
    {visibility.whyUsBlock !== false && <WhyAU content={content} />}
    {visibility.howItWorksBlock !== false && <HowAU content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAU content={content} />}
    {visibility.gallerySection !== false && <GalleryAU content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAU content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAU content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAU content={content} />}
    {visibility.locationBlock !== false && <LocationAU content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAU content={content} layout={layout} />}
  <FooterAU layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      // Hide-on-scroll-down dispatch bar (lp-09 "Dispatch" behaviour).
      var hdr = document.querySelector('header.nav');
      if (hdr) {
        var last = 0;
        window.addEventListener('scroll', function () {
          var y = window.pageYOffset;
          if (y > last && y > 360) { hdr.classList.add('hide'); } else { hdr.classList.remove('hide'); }
          last = y;
        }, { passive: true });
      }
      // Trades-AU Leaflet boot — accepts (lat, lng, label) from LocationAU.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAU calls this with whatever it resolves).
      window.__tradesAUInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/dark_nolabels/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:16px;height:16px;border-radius:50%;background:#ffd21e;box-shadow:0 0 0 3px #071528,0 0 0 5px rgba(255,210,30,.5);border:0;"></div>', iconSize: [16, 16], iconAnchor: [8, 8] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
