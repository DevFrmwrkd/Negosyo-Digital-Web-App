---
/**
 * trades / WhyAK — the "Specification: why Linya" block: a big Space-Grotesk
 * headline left, a numbered spec-list of reasons (blueprint cells) right.
 *
 * The source prefixes each reason with a "§N" clause marker; that numbering is
 * a design flourish with no data home, so it is generated with a CSS counter
 * (content: "§" counter …) rather than baked into the title text. Reads
 * content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <span class="label" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="cell why-item">
            <strong class="why-title" data-field={`why.items.${i}.title`}>{item.title}</strong>
            {(item.body ?? item.desc ?? item.description) && (
              <span class="why-body" data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-h { font-size: clamp(32px, 5vw, 54px); color: var(--white); }
  .why-head .label { margin-bottom: 16px; }
  .why-list { list-style: none; display: grid; gap: 10px; counter-reset: spec; }
  .why-item { counter-increment: spec; }
  .why-title { color: var(--amber); display: block; }
  .why-title::before { content: "§" counter(spec) " "; color: var(--amber); font-weight: 700; }
  .why-body { display: block; color: var(--chalk); font-size: 14px; margin-top: 4px; }

  /* ---- Mobile (<=760): stack heading over the spec list ---- */
  @media (max-width: 760px) {
    .why-sect .grid2 { grid-template-columns: 1fr; gap: 22px; }
    .why-h { font-size: clamp(27px, 6.6vw, 44px); }
  }
  @media (max-width: 520px) {
    .why-h { font-size: clamp(24px, 7.4vw, 36px); }
  }
</style>
