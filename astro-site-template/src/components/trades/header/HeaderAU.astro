---
/**
 * trades / HeaderAU — sticky dispatch bar: the bolt-marked brand left, mono
 * uppercase links, and an outlined "call/quote" CTA right. Hides on scroll-down
 * / reappears on scroll-up (toggled by PageAU's inline scroll handler via
 * header.nav.hide). The bolt glyph is decorative chrome (aria-hidden).
 *
 * The nav CTA reuses the hero's primary CTA (content.hero.cta1) so it stays in
 * sync and editable, mirroring the reference. navLinks render only when the
 * layout supplies them.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const hero = (content as any).hero || {};
const ctaText = hero.cta1?.text || '';
const ctaHref = hero.cta1?.href || '#location';
---
<header class="nav">
  <div class="nav-in wrap">
    <a href="#main" class="brand" aria-label={`${brand} home`} data-field="footer.brand"><span class="bolt" aria-hidden="true"></span><span class="bn">{brand}</span></a>
    {(navLinks.length > 0 || ctaText) && (
      <nav class="nav-links" aria-label="Primary">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
        {ctaText && <a href={ctaHref} class="navcall" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{ctaText}</a>}
      </nav>
    )}
  </div>
</header>
<style>
  header.nav {
    position: sticky; top: 0; z-index: 60; background: rgba(11,33,67,.92);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); transition: transform .3s;
  }
  header.nav.hide { transform: translateY(-100%); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); flex: none; }
  .brand:hover { color: var(--ink); }
  .brand .bolt { width: 26px; height: 26px; background: var(--yellow); clip-path: polygon(42% 0,88% 0,54% 38%,100% 38%,26% 100%,44% 54%,4% 54%); flex: none; }
  .brand .bn { font-weight: 800; font-size: 22px; letter-spacing: -.01em; white-space: nowrap; text-transform: uppercase; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-family: var(--mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .nav-links a:hover { color: var(--cyan); }
  .nav-links .navcall { border: 2px solid var(--yellow); color: var(--yellow); padding: 8px 16px; font-family: var(--sans); font-weight: 800; letter-spacing: .04em; }
  .nav-links .navcall:hover { background: var(--yellow); color: var(--navy-d); }
  @media (max-width: 920px) { .nav-links a:not(.navcall) { display: none; } }
</style>
