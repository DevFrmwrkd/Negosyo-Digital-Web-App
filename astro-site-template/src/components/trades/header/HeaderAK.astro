---
/**
 * trades / HeaderAK — thin blueprint top strip sitting inline above the hero
 * (the design's "LINYA/SERVICES · 0917…" bar). Brand in Space Grotesk with an
 * amber slash-accent when the brand contains "/", a tel link on the right.
 *
 * Not a fixed overlay — the source design keeps this strip in normal flow at
 * the sheet's top edge. navLinks render only when layout supplies them (the
 * source ships none). Class "nav" is kept so PageAK's inert scroll handler has
 * a target; no scrolled styling is applied.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
---
<header class="nav" style="border-bottom:1px solid var(--line)">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" data-field="footer.brand">{brand}</a>
    {navLinks.length > 0 && (
      <nav class="nav-links" id="nav-ak-menu" aria-label="Main">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
      </nav>
    )}
    <div class="nav-actions">
      {phone && (
        <a href={`tel:${phoneDigits}`} class="nav-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
      )}
      {navLinks.length > 0 && (
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-ak-menu">
          <span></span><span></span><span></span>
        </button>
      )}
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    if (!burger) return;
    var setState = function (open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    burger.addEventListener('click', function () {
      setState(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping a link or pressing Escape.
    hdr.querySelectorAll('.nav-links a').forEach(function (a) {
      a.addEventListener('click', function () { setState(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && hdr.classList.contains('open')) setState(false);
    });
  })();
</script>
<style>
  header.nav { position: relative; z-index: 20; }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap; padding-top: 24px; padding-bottom: 4px;
  }
  .brand {
    font-family: var(--display); font-weight: 700; font-size: 20px;
    color: var(--white); letter-spacing: -.01em;
  }
  .brand:hover { color: var(--white); }
  .nav-links { display: flex; gap: 22px; align-items: center; }
  .nav-links a {
    font-family: var(--body); text-transform: uppercase; letter-spacing: .16em;
    font-size: 11.5px; color: var(--chalk); transition: color .2s;
  }
  .nav-links a:hover { color: var(--amber); }
  .nav-phone {
    font-family: var(--display); font-weight: 700; font-size: 14px; color: var(--white);
  }
  .nav-phone:hover { color: var(--amber); }

  /* Actions cluster (phone + burger). Burger is desktop-hidden; the bar keeps
     brand left, links centre, phone right exactly as before on desktop. */
  .nav-actions { display: flex; align-items: center; gap: 16px; }
  .nav-burger { display: none; }

  /* ---- Mobile nav (<=760): burger toggles a full-width drawer below the bar ---- */
  @media (max-width: 760px) {
    .nav-inner { flex-wrap: nowrap; gap: 10px; padding-top: 18px; }
    .nav-actions { gap: 10px; flex: 0 0 auto; }
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 11px; flex: 0 0 auto;
      background: transparent; border: 1px solid var(--chalk); cursor: pointer;
    }
    .nav-burger span {
      display: block; width: 100%; height: 2px; background: var(--white);
      transition: transform .25s ease, opacity .2s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Drawer: absolute, full-width below the header, in the design's own tokens. */
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      display: none; flex-direction: column; align-items: stretch; gap: 0;
      background: var(--sheet-deep); border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line); box-shadow: 0 18px 34px rgba(0,0,0,.45);
      padding: 4px 20px 12px; z-index: 40;
    }
    header.nav.open .nav-links { display: flex; }
    .nav-links a {
      font-size: 13px; letter-spacing: .16em; color: var(--chalk);
      padding: 14px 2px; min-height: 44px; display: flex; align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .nav-links a:last-child { border-bottom: none; }
  }
  @media (max-width: 520px) {
    .brand { font-size: 18px; }
    .nav-phone { font-size: 13px; }
  }
</style>
