---
/**
 * trades / ServicesAK — the "scope of work" spec grid on the deep-sheet band.
 * Each service is a blueprint cell with an amber Space-Grotesk title (the
 * source bakes a work-code prefix like "A-01 · " into the title text) over a
 * mono description. price / duration render only when present in the data.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
type Item = { title: string; desc?: string; price?: string; duration?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
---
{items.length > 0 && (
  <section class="svc-sect">
    <div class="wrap">
      {tag && <span class="label" data-field="services.tag">{tag}</span>}
      {headline && <h2 class="svc-h" data-field="services.headline" set:html={headline}></h2>}
      {sub && <p class="svc-sub" data-field="services.sub">{sub}</p>}
      <div class="svc-grid">
        {items.map((item, i) => (
          <div class="cell svc-card reveal">
            <div class="svc-head">
              <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
              {item.price && <span class="svc-price" data-field={`services.items.${i}.price`}>{item.price}</span>}
            </div>
            {item.desc && <p class="svc-desc" data-field={`services.items.${i}.desc`}>{item.desc}</p>}
            {item.duration && <div class="svc-dur" data-field={`services.items.${i}.duration`}>{item.duration}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .svc-sect { background: var(--sheet-deep); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .svc-h { font-size: clamp(32px, 5vw, 54px); margin: 18px 0 28px; color: var(--white); }
  .svc-sub { max-width: 56ch; color: var(--chalk); margin: -18px 0 28px; }
  .svc-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .svc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .svc-head h3 { font-size: 19px; color: var(--amber); margin-bottom: 8px; }
  .svc-price { font-family: var(--body); font-weight: 700; font-size: 14px; color: var(--white); flex-shrink: 0; }
  .svc-desc { font-size: 14px; color: var(--chalk); }
  .svc-dur { font-family: var(--body); text-transform: uppercase; letter-spacing: .14em; font-size: 11px; color: var(--chalk); margin-top: 10px; opacity: .8; }

  /* ---- Mobile (<=760): single-column spec grid + smaller heading ---- */
  @media (max-width: 760px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc-h { font-size: clamp(27px, 6.6vw, 44px); margin: 14px 0 22px; }
    .svc-sub { margin: -10px 0 22px; }
  }
  @media (max-width: 520px) {
    .svc-h { font-size: clamp(24px, 7.4vw, 36px); }
  }
</style>
