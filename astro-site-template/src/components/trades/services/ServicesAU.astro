---
/**
 * trades / ServicesAU — "what we do" schematic grid on the navy sheet. Each
 * .svc cell is a hairline-ruled tile with a mono spec code (decorative index),
 * a cyan line-icon (decorative, cycled from the design's set), a sans title and
 * a muted description. Reads content.services.items (title / desc); tag +
 * headline render above. The section auto-hides when there are no items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
// Decorative schematic line-icons, cycled by index (design chrome).
const icons = [
  '<path d="M4 8h10l-2 4h6M4 16h8"/>',
  '<path d="M5 4h14v16H5z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  '<path d="M9 18h6M10 21h4M12 3a6 6 0 00-4 10c1 1 1 2 1 3h6c0-1 0-2 1-3a6 6 0 00-4-10z"/>',
  '<path d="M12 3v6m0 0l-3 3m3-3l3 3M5 21h14"/><circle cx="12" cy="16" r="2"/>',
  '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/>',
  '<path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
];
---
{items.length > 0 && (
  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="services.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="services.headline" set:html={headline}></h2>}
      </div>
      <div class="svc-grid">
        {items.map((item, i) => (
          <article class="svc reveal">
            <div class="code">{`SVC/${String(i + 1).padStart(2, '0')}`}</div>
            <div class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[i % icons.length]}></svg></div>
            <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
            {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .svc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }
  .svc { background: var(--navy); padding: 32px 28px; position: relative; overflow: hidden; transition: background .25s; }
  .svc:hover { background: var(--navy-2); }
  .svc .code { font-family: var(--mono); font-size: 12px; color: var(--cyan); letter-spacing: .06em; }
  .svc .ic { width: 44px; height: 44px; border: 1.5px solid var(--cyan); color: var(--cyan); display: flex; align-items: center; justify-content: center; margin: 14px 0; }
  .svc .ic svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 1.7; }
  .svc h3 { font-size: 21px; margin-bottom: 8px; }
  .svc p { color: var(--muted); font-size: 15px; margin: 0; text-transform: none; }
</style>
