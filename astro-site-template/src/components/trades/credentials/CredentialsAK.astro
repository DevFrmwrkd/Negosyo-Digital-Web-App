---
/**
 * trades / CredentialsAK — a thin permits/registration row (amber "▸" markers
 * over chalk labels), matching the source's DTI / permit / license strip.
 * Optional tag / headline render above when provided; the source ships a bare
 * row of ▸ items. desc is an optional per-item field, hidden when unset.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <span class="label" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <div class="cred-item">
            <span class="marker" aria-hidden="true">▸</span>
            <span class="cred-copy">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 28px 0; border-top: 1px solid var(--line); }
  .cred-head { margin-bottom: 20px; }
  .cred-h { font-size: clamp(26px, 4vw, 44px); color: var(--white); margin-top: 12px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 16px 24px; color: var(--chalk); font-size: 13px; }
  .cred-item { display: flex; gap: 8px; align-items: baseline; }
  .marker { color: var(--amber); }
  .cred-copy { display: inline-flex; flex-direction: column; }
  .cred-desc { color: var(--chalk); opacity: .72; font-size: 12px; margin-top: 2px; }
</style>
