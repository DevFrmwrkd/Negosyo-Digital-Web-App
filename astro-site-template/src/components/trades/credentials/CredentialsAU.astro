---
/**
 * trades / CredentialsAU — "licensed & accountable" row on the navy sheet: a
 * hairline-gridded set of .cred tiles, each with a yellow line-badge
 * (decorative, cycled from the design's set), an uppercase title and a muted
 * note. Reads content.credentials.items (title / desc); tag + headline render
 * above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
// Decorative badge glyphs, cycled by index (design chrome).
const badges = [
  '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/>',
  '<path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/>',
];
---
{items.length > 0 && (
  <section class="sec">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="snum" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="bdg" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={badges[i % badges.length]}></svg></div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { background: var(--navy); padding: 30px 24px; }
  .cred .bdg { width: 40px; height: 40px; border: 1.5px solid var(--yellow); color: var(--yellow); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .cred .bdg svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.7; }
  .cred h4 { font-size: 15px; margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--muted); margin: 0; text-transform: none; }
</style>
