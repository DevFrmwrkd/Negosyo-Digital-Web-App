---
/**
 * trades / TestimonialsAK — "Field reports": customer quotes as blueprint cells
 * on the deep-sheet band, amber attribution (who · role). Reads
 * content.testimonials.items (canonical `who` + `role`, legacy `author` /
 * `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="test-sect" id="reviews">
    <div class="wrap">
      {tag && <span class="label" data-field="testimonials.tag">{tag}</span>}
      {headline && <h2 class="test-h" data-field="testimonials.headline" set:html={headline}></h2>}
      <div class="test-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <blockquote class="cell test-card reveal">
              <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
              {(who || role) && (
                <footer>
                  {who && <span data-field={`testimonials.items.${i}.who`}>{who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </footer>
              )}
            </blockquote>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .test-sect { background: var(--sheet-deep); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .test-h { font-size: clamp(32px, 5vw, 54px); margin: 18px 0 24px; color: var(--white); }
  .test-grid { display: grid; gap: 16px; margin-top: 8px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .test-card p { font-size: 14px; margin-bottom: 12px; color: var(--white); }
  .test-card footer { color: var(--amber); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }

  /* ---- Mobile (<=760): single-column field reports ---- */
  @media (max-width: 760px) {
    .test-grid { grid-template-columns: 1fr; }
    .test-h { font-size: clamp(27px, 6.6vw, 44px); }
  }
  @media (max-width: 520px) {
    .test-h { font-size: clamp(24px, 7.4vw, 36px); }
  }
</style>
