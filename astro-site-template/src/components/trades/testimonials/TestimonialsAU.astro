---
/**
 * trades / TestimonialsAU — "client logs" on the navy sheet: cyan-ruled .quote
 * cards on the panel background, each opened by a yellow star row (decorative),
 * the quote in sans, and a mono attribution line. Reads
 * content.testimonials.items (canonical `who` + `role`, legacy
 * `author` / `name` / `context`). tag + headline render above.
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string; rating?: number | string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
// A star row is a rating claim, not decoration — it puts a score in a named
// customer's mouth. Render only the score the customer actually gave.
const starsOf = (it: Item) => {
  const n = Math.round(Number(it.rating));
  return n >= 1 && n <= 5 ? '★'.repeat(n) : '';
};
---
{items.length > 0 && (
  <section class="sec" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          const stars = starsOf(item);
          return (
            <figure class="quote reveal">
              {stars && <div class="stars" aria-hidden="true">{stars}</div>}
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .quotes-grid { grid-template-columns: 1fr; gap: 14px; } }
  .quote { background: var(--panel); border: 1px solid var(--line); border-left: 4px solid var(--cyan); padding: 28px 26px; }
  @media (max-width: 760px) { .quote { padding: 24px 20px; } .quote p { font-size: 17px; } }
  .quote .stars { color: var(--yellow); font-size: 15px; }
  .quote p { font-size: 18px; line-height: 1.5; color: var(--ink); margin: 12px 0; text-transform: none; }
  .quote .who { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
</style>
