---
/**
 * trades / FooterAU — deep-navy dispatch footer (bolt-marked brand, cyan column
 * headers, muted links) plus lp-09's floating "quote" pill. Every column
 * auto-hides when empty, collapsing to the design's minimal footer.
 *
 * The floating message pill reuses the footer's own CTA (content.footer.cta) —
 * the same "request a quote / message" action — so it stays editable and in
 * sync; it renders only when that CTA (or the CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAU actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAU.
const PAGE_ANCHORS = new Set(['about', 'coverage', 'faq', 'gallery', 'location', 'main', 'reserve', 'reviews', 'services']);
const ANCHOR_ALIAS: Record<string, string> = { area: 'coverage', visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const f = (content as any).footer || {};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = f.brand || layout.businessName || '';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || (content as any).location?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating message pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
// The footer's OWN button. footer.cta.* wins; left blank — as it is on every
// site built before the field existed — it still borrows the hero's primary
// CTA, then the CTA-band's, so no live footer loses its pill. The hooks below
// point at footer.cta.*, so the owner's first edit lands there and this
// button's label, link and colour part company with the hero's from then on.
const msgHref = onPage(f.cta?.href || hero.cta1?.href || cband.cta1?.href, '');
// No default label: "Quote" asserts a quoting service the trade may not
// offer.
// No CTA text from the owner => no pill.
const msgText = f.cta?.text || hero.cta1?.text || cband.cta1?.text || '';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="fcol">
        {brand && <div class="brand" data-field="footer.brand"><span class="bolt" aria-hidden="true"></span><span class="bn">{brand}</span></div>}
        {blurb && <p data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="fcol">
          <div class="fh">Contact</div>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <p><a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a></p>
              : <p data-field={`footer.visit.lines.${i}`}>{line}</p>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="fcol">
          <div class="fh">Get in touch</div>
          {explore.map((l, i) => (
            <p><a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a></p>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-btm">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && msgText && (
  <a class="msgr" href={msgHref} rel="noopener" aria-label={msgText} data-field="footer.cta.text" data-href-field="footer.cta.href">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.3 2 2 6.2 2 11.6c0 3 1.4 5.6 3.7 7.3v3.6l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.5S17.7 2 12 2zm1 12.3l-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8z"/></svg>
    {msgText}
  </a>
)}
<style>
  footer { background: var(--navy-d); color: var(--ink); padding: 66px 0 28px; }
  @media (max-width: 760px) { footer { padding: 44px 0 24px; } }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; padding-bottom: 38px; border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 26px; } }
  footer .brand { margin-bottom: 12px; display: flex; align-items: center; gap: 10px; color: var(--ink); }
  footer .brand .bolt { display: inline-block; width: 26px; height: 26px; background: var(--yellow); clip-path: polygon(42% 0,88% 0,54% 38%,100% 38%,26% 100%,44% 54%,4% 54%); flex: none; }
  footer .brand .bn { font-weight: 800; font-size: 22px; letter-spacing: -.01em; text-transform: uppercase; }
  footer .fh { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--cyan); margin-bottom: 12px; }
  footer p { font-size: 15px; color: var(--muted); margin: 0 0 7px; }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--cyan); }
  .foot-social { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
  .foot-social a { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--line); padding: 6px 12px; transition: color .2s, border-color .2s; }
  .foot-social a:hover { color: var(--cyan); border-color: var(--cyan); }
  .foot-btm { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding-top: 22px; font-family: var(--mono); font-size: 12px; color: var(--steel); text-transform: uppercase; }

  .msgr {
    position: fixed; right: 18px; bottom: 18px; z-index: 70; display: inline-flex; align-items: center; gap: 9px;
    background: var(--yellow); color: var(--navy-d); padding: 13px 20px;
    font-family: var(--sans); font-weight: 800; font-size: 13px; letter-spacing: .04em; text-transform: uppercase;
    box-shadow: 0 12px 30px -10px rgba(255,210,30,.5); transition: transform .2s;
  }
  .msgr:hover { transform: translateY(-3px); color: var(--navy-d); }
  .msgr svg { width: 18px; height: 18px; fill: currentColor; }
</style>
