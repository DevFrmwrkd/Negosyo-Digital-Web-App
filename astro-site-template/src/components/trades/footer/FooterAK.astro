---
/**
 * trades / FooterAK — deep-sheet footer (Space-Grotesk brand, amber-warm links)
 * plus the source's fixed "click-to-message" quote pill. Every column auto-hides
 * when empty, so with just a brand + dispatch line + service-area notes it
 * collapses to the source's minimal three-line footer.
 *
 * The floating pill reuses the hero's primary CTA (content.hero.cta1) — the same
 * "get a quote / dispatch" action — so it stays editable and in sync; it renders
 * only when that CTA (or the CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const f = (content as any).footer || {};
const brand = f.brand || layout.businessName || 'Your Business';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const hoursRows: Array<{ day: string; time: string }> = Array.isArray(f.hours) ? f.hours : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating quote pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
const msgHref = hero.cta1?.href || cband.cta1?.href || '';
const msgText = hero.cta1?.text || cband.cta1?.text || 'Free quote';
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="brand" data-field="footer.brand">{brand}</div>
        {blurb && <p data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="foot-col">
          <h4>Dispatch</h4>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a>
              : <span class="li" data-field={`footer.visit.lines.${i}`}>{line}</span>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="foot-col">
          <h4>Explore</h4>
          {explore.map((l, i) => (
            <a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a>
          ))}
        </div>
      )}
      {hoursRows.length > 0 && (
        <div class="foot-col foot-hours">
          <h4>Hours</h4>
          {hoursRows.map((row, i) => (
            <div class="hrow">
              <span data-field={`footer.hours.${i}.day`}>{row.day}</span>
              <span data-field={`footer.hours.${i}.time`}>{row.time}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-bottom">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && (
  <div class="c2m">
    <a href={msgHref} aria-label="Message us for a free quote" data-field="hero.cta1.text" data-href-field="hero.cta1.href">
      <span aria-hidden="true">✉</span> {msgText}
    </a>
  </div>
)}
<style>
  .foot { background: var(--sheet-deep); padding: 44px 0; border-top: 1px solid var(--line); }
  .foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
  .foot-brand .brand { font-family: var(--display); font-weight: 700; font-size: 19px; color: var(--white); }
  .foot-brand p { color: var(--chalk); font-size: 13px; max-width: 34ch; margin: 12px 0 0; }
  .foot-social { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .foot-social a {
    font-family: var(--body); font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--chalk); border: 1px solid var(--chalk); padding: 6px 12px;
    transition: color .2s, border-color .2s;
  }
  .foot-social a:hover { color: var(--amber); border-color: var(--amber); }
  .foot-col h4 { font-family: var(--body); text-transform: uppercase; letter-spacing: .2em; font-size: 11px; color: var(--amber); margin: 0 0 14px; font-weight: 700; }
  .foot-col a, .foot-col .li { display: block; color: var(--chalk); font-size: 13px; padding: 4px 0; }
  .foot-col a:hover { color: var(--white); }
  .foot-hours .hrow { display: flex; justify-content: space-between; max-width: 260px; padding: 2px 0; font-size: 13px; color: var(--chalk); gap: 16px; }
  .foot-bottom { border-top: 1px solid var(--line); margin-top: 36px; padding: 22px 0 0; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--chalk); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }

  .c2m { position: fixed; right: 16px; bottom: 16px; z-index: 60; }
  .c2m a {
    display: flex; align-items: center; gap: 8px; background: var(--amber);
    color: var(--sheet-deep); font-family: var(--body); font-weight: 700;
    padding: 14px 18px; box-shadow: 0 6px 20px rgba(0,0,0,.4); min-height: 48px; font-size: 14px;
  }
  .c2m a:hover { background: var(--white); color: var(--sheet-deep); }
</style>
