---
/**
 * trades / AreaAU — the "we cover" service-area strip (lp-09's SERVICE-AREA
 * block, lifted out of the FAQ column into its own section per the reference
 * model). A cyan mono eyebrow over mono coverage tags that light cyan on hover.
 * Reads content.area.places (legacy `items`); optional headline / sub / body
 * render above the tags when provided. Anchors #coverage for the hero CTA.
 */
interface Props { content: any; }
const { content } = Astro.props;
const area = content.area || {};
const tag = area.tag || '';
const headline = area.headline || '';
const sub = area.sub || '';
const body = area.body || '';
const places: string[] = Array.isArray(area.places) ? area.places : (Array.isArray(area.items) ? area.items : []);
---
{places.length > 0 && (
  <section class="sec area" id="coverage">
    <div class="wrap">
      {(headline || sub) && (
        <div class="area-head reveal">
          {headline && <h2 class="area-h" data-field="area.headline" set:html={headline}></h2>}
          {sub && <p class="area-sub" data-field="area.sub">{sub}</p>}
        </div>
      )}
      <div class="areas reveal">
        {tag && <div class="kicker" data-field="area.tag">{tag}</div>}
        <div class="area-tags">
          {places.map((place, i) => (
            <span data-field={`area.places.${i}`}>{place}</span>
          ))}
        </div>
      </div>
      {body && <p class="area-body" data-field="area.body">{body}</p>}
    </div>
  </section>
)}
<style>
  .area-head { margin-bottom: 20px; }
  .area-h { font-size: clamp(28px,4vw,54px); }
  .area-sub { color: var(--muted); margin-top: 10px; max-width: 52ch; }
  .areas { margin-top: 6px; }
  .areas .kicker { margin: 0 0 4px; }
  .area-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .area-tags span { font-family: var(--mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; border: 1px solid var(--line); padding: 7px 12px; color: var(--muted); transition: .2s; }
  .area-tags span:hover { border-color: var(--cyan); color: var(--cyan); }
  .area-body { color: var(--muted); margin-top: 16px; max-width: 60ch; text-transform: none; }
</style>
