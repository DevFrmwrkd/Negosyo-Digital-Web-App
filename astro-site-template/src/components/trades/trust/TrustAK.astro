---
/**
 * trades / TrustAK — thin credibility strip on the deep-sheet band under the
 * hero (the source's "8+ years · 6 cities · uniformed crews · licensed
 * electrician" row). Renders content.trust.cells as num (Space Grotesk) over
 * label. Volatile Google rating / today's-dispatch-hours slots have no field in
 * the data model, so they are expressed as ordinary trust cells (num + label).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust-sect">
    <div class="wrap trust-bar">
      {cells.map((cell, i) => (
        <div class="trust-cell reveal">
          {cell.num && <div class="num" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="lbl" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust-sect { padding: 24px 0; background: var(--sheet-deep); border-bottom: 1px solid var(--line); }
  .trust-bar { display: flex; flex-wrap: wrap; gap: 18px 24px; justify-content: space-between; align-items: center; }
  .trust-cell { min-width: 150px; }
  .trust-cell .num { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--white); line-height: 1.15; }
  .trust-cell .lbl { font-family: var(--body); font-size: 13px; color: var(--chalk); margin-top: 4px; }

  /* ---- Mobile: let the credibility cells wrap comfortably (two-up, then one) ---- */
  @media (max-width: 520px) {
    .trust-sect { padding: 20px 0; }
    .trust-bar { gap: 14px 18px; }
    .trust-cell { min-width: 130px; flex: 1 1 40%; }
  }
</style>
