---
/**
 * trades / CtaBandAU — the full-width caution-yellow closer, centred: a mono
 * eyebrow, an oversized navy headline, the giant tap-to-call dispatch number,
 * and up to two CTAs (navy fill + navy-outline ghost, recoloured for the yellow
 * band below). The callnum is the canonical phone (content.location.phone /
 * layout.contact.phone). Reads content.ctaBand (legacy content.closing).
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const loc = content.location || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const phone = loc.phone || layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || (phoneDigits ? `tel:${phoneDigits}` : '#location');
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || '#coverage';
const hasButtons = !!(cta1Text || cta2Text);
---
{(headline || hasButtons || phone) && (
  <section class="sec cta-band" id="reserve">
    <div class="wrap">
      {tag && <div class="kicker" data-field="ctaBand.tag">{tag}</div>}
      {headline && <h2 data-field="ctaBand.headline" set:html={headline}></h2>}
      {phone && <a href={`tel:${phoneDigits}`} class="callnum" aria-label={`Call ${phone}`} data-field="location.phone">{phone}</a>}
      {hasButtons && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { background: var(--yellow); color: var(--navy-d); text-align: center; }
  .cta-band .wrap { display: block; }
  .cta-band h2 { font-size: clamp(36px,6vw,88px); color: var(--navy-d); margin-bottom: 14px; }
  @media (max-width: 760px) { .cta-band h2 { font-size: clamp(28px,8vw,50px); line-height: 1.04; overflow-wrap: break-word; } }
  @media (max-width: 520px) { .cta-band h2 { font-size: clamp(24px,9vw,40px); } }
  .cta-band .kicker { color: #6b5300; }
  .cta-band .callnum { font-weight: 800; font-size: clamp(30px,5vw,56px); color: var(--navy-d); letter-spacing: .01em; display: inline-block; margin: 6px 0 22px; }
  @media (max-width: 520px) { .cta-band .callnum { font-size: clamp(24px,7vw,40px); } }
  .cta-band .callnum:hover { color: #071528; }
  .cta-band .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta-band .btn--fill { background: var(--navy-d); border-color: var(--navy-d); color: var(--yellow); }
  .cta-band .btn--fill:hover { background: #071528; }
  .cta-band .btn--ghost { border-color: var(--navy-d); color: var(--navy-d); }
  .cta-band .btn--ghost:hover { border-color: var(--navy-d); background: rgba(7,21,40,.08); color: var(--navy-d); }
</style>
