---
/**
 * trades / HowAU — "from call to clear" process steps on the navy sheet. Each
 * .step sits under a yellow top-rule with an oversized cyan numeral
 * (decorative), a sans title and a muted body line. Reads content.how.steps
 * (canonical `body`, legacy `desc`). tag + headline render above.
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="how.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="how.headline" set:html={headline}></h2>}
      </div>
      <div class="steps">
        {steps.map((step, i) => (
          <div class="step reveal">
            <div class="sn" aria-hidden="true">{i + 1}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
  @media (max-width: 820px) { .steps { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
  .step { padding: 26px 22px; border: 1px solid var(--line); border-top: 4px solid var(--yellow); }
  .step .sn { font-weight: 800; font-size: 42px; color: var(--cyan); }
  .step h3 { font-size: 19px; margin: 8px 0 6px; }
  .step p { font-size: 14px; color: var(--muted); text-transform: none; }
</style>
