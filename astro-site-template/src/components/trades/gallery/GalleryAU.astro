---
/**
 * trades / GalleryAU — "work log" schematic mosaic on the navy sheet. Tiles are
 * art-directed blueprint .plate frames (a cycling .scene-* duotone stands in as
 * the designed fallback; a photo layers over it via data-image-field when set),
 * arranged in lp-09's mosaic where the first tile spans 2×2 and two mid tiles
 * span 2 wide. A yellow spec chip carries the decorative index; item.caption
 * renders in the plate footer. The section auto-hides when there are no items.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-panel', 'scene-wire', 'scene-light', 'scene-meter', 'scene-inspect', 'scene-van'];
const spanFor = (i: number) => (i % 6 === 0 ? 'v1' : i % 6 === 3 ? 'v4' : i % 6 === 5 ? 'v6' : '');
---
{items.length > 0 && (
  <section class="sec" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
      </div>
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            <div class="grid" aria-hidden="true"></div>
            <span class="tag">{String(i + 1).padStart(2, '0')}</span>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 180px; gap: 12px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate .ph { transition: transform .5s; }
  .g-grid .plate:hover .ph { transform: scale(1.06); }
  .v1 { grid-column: span 2; grid-row: span 2; }
  .v4 { grid-column: span 2; }
  .v6 { grid-column: span 2; }
  /* Single column on phones: drop the mosaic spans so no tile requests a second
     track (which would overflow the viewport). */
  @media (max-width: 760px) {
    .g-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; gap: 10px; }
    .g-grid .v1, .g-grid .v4, .g-grid .v6 { grid-column: auto; grid-row: auto; }
    .g-grid .v1 { grid-row: span 2; }
  }
</style>
