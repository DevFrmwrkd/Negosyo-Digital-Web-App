---
/**
 * hospitality / CredentialsBI — "Palm Hour"'s on-record strip: DOT accreditation,
 * business permit, host verification — a terracotta-topped cell per entry, a small
 * mono label over a Fraunces detail line. Reads content.credentials.items
 * ({title, desc}); title rides the label, desc the detail. Mirrors CredentialsAS /
 * CredentialsBB's contract, including the alias chain (the sidebar form writes rows
 * as {title, body} and normalizeBlock aliases body→desc, so read desc ?? detail).
 *
 * Editable hooks: credentials.tag · credentials.headline ·
 * credentials.items.${i}.title · credentials.items.${i}.desc
 *
 * R2 — SECOND-HIGHEST-RISK BAND. content.credentials has NO derived fallback
 * (astro-builder passes `c.credentials ?? undefined`), so nothing exists unless the
 * owner put it on record. Consequences, all deliberate:
 *   · with no items the ENTIRE section is omitted — no heading, no eyebrow, no
 *     rules, no padding. astro-builder also forces visibility.credentialsBlock
 *     false when the array is empty; this gate is the belt to that brace.
 *   · label and detail are guarded independently, so a row carrying only a title
 *     prints only the label instead of an empty cell.
 *   · NO seal, shield, ribbon, stamp, tick or drawn glyph of any kind lives in
 *     this section — a drawn badge is a visual claim of certification. The
 *     wrapper's .tick primitive is available and is deliberately NOT used here.
 *     The only ornament is a 2px terracotta rule.
 *   · the left half of .sec-head is a design literal describing the TEMPLATE
 *     ("On record"); the right half is the only data slot and comes solely from
 *     credentials.tag. A hardcoded right-hand line is a fabrication.
 * No id: nothing links here.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title?: string; desc?: string; label?: string; detail?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(cred) ? cred : []);
---
{items.length > 0 && (
  <section class="creds">
    <div class="wrap">
      <div class="sec-head">
        <span class="sh-l">On record</span>
        <span class="sh-rule" aria-hidden="true"></span>
        {tag && <span class="sh-r" data-field="credentials.tag">{tag}</span>}
      </div>
      {headline && <h2 class="h2 reveal" data-field="credentials.headline" set:html={headline}></h2>}
      <div class="cred-grid reveal">
        {items.map((item, i) => {
          const labelText = item.title ?? item.label ?? '';
          const detailText = item.desc ?? item.detail ?? '';
          return (
            <div class="cred rowrule">
              {labelText && <p class="mono c-label" data-field={`credentials.items.${i}.title`}>{labelText}</p>}
              {detailText && <p class="c-detail" data-field={`credentials.items.${i}.desc`}>{detailText}</p>}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  /* No band class: this strip sits on the default plaster --paper ground. Colour is
     tokens only — .mono supplies the label colour, --ink the detail, --accent the
     rule. No hex in this file. */
  .creds { padding: clamp(52px,6vw,84px) 0; }
  /* auto-fit rather than a fixed 4-up: three permits read as three, and a partial
     last row leaves no inked gap because the rule is per-cell (.rowrule), not a
     gap over an inked container. */
  .cred-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(210px,1fr)); gap: clamp(18px,2.5vw,36px); margin-top: clamp(10px,2vw,22px); }
  /* Restates only the width and colour of the shared .rowrule hairline. */
  .cred { padding-top: 16px; border-top-width: 2px; border-top-color: var(--accent); }
  .c-label { margin: 0 0 8px; font-size: 9.5px; letter-spacing: .18em; }
  .c-detail {
    margin: 0; font-family: var(--disp); font-weight: 700; font-size: clamp(17px,1.6vw,19px);
    line-height: 1.16; color: var(--ink); overflow-wrap: anywhere;
  }

  @media (max-width: 760px) { .cred-grid { grid-template-columns: 1fr 1fr; gap: 20px; } }
  @media (max-width: 520px) {
    /* Deliberately STAYS 2-up (R5 permits it): at 360px each cell is ~150px, which
       fits a mono label and a 16px detail because .c-detail carries
       overflow-wrap:anywhere. */
    .c-detail { font-size: 16px; }
    .cred { padding-top: 12px; }
  }
</style>
