---
/**
 * hospitality / CredentialsBJ — "THE PROMISES" (Kubo Stays / BJ).
 *
 * ROLE: the three cards the design nests in the host block's right-hand column —
 * one price said once, photos from this month, dates held while you decide. Each
 * card is opened by an italic serif numeral, then a title and a short body.
 * These are the owner's undertakings to a guest, which is why they live on the
 * credentials.* prefix: this family's "on record" band.
 *
 * WHY A SIBLING SECTION AND NOT THE HOST'S RIGHT COLUMN (the one deliberate
 * layout deviation from the design): editorBridge resolves a Blocks visibility
 * toggle by counting a prefix's hooks inside each <section> and hiding the
 * richest one, so a section carrying both about.* and credentials.* would be
 * hidden by EITHER toggle. One <section>, one content prefix. This band
 * therefore sits directly under AboutBJ on the SAME ground with a reduced top
 * pad and no rule, so the two still read as one block — and a 3-up card row
 * stacks better at 360px than a nested column would.
 *
 * EDITABLE HOOKS (every one schema-owned, so v3 focuses a real field):
 *   credentials.tag              — eyebrow
 *   credentials.headline         — h2 (set:html)
 *   credentials.items.${i}.title — the promise
 *   credentials.items.${i}.body  — the sentence under it. CANONICAL key: the
 *                                  sidebar writes rows as {title, body} and
 *                                  astro-builder's normalizeBlock COPIES body
 *                                  into desc, so the value can be read from
 *                                  either — but the hook must spell `body`,
 *                                  which is what genericContentSchema declares.
 *                                  The BI sibling spells `desc` here and that
 *                                  hook is dead; do not copy it.
 *
 * The eyebrow and headline are rendered GUARDED even though the design has
 * neither: nothing derives credentials.*, so on a first build they simply draw
 * nothing — but an owner who types in those two sidebar boxes must see the page
 * change. A schema field no component renders is the mirror of a dead hook.
 *
 * R2 — HIGHEST-RISK BAND IN THE TEMPLATE. content.credentials has NO derived
 * fallback (astro-builder passes `c.credentials ?? undefined`), so nothing here
 * exists unless the owner put it on record. Consequences, all deliberate:
 *   · with no filled row the ENTIRE section is omitted — no eyebrow, no
 *     headline, no cards, no padding.
 *   · title and body are guarded independently, so a half-filled row prints
 *     only what was typed.
 *   · NO seal, shield, ribbon, stamp or tick of any kind. A drawn badge is a
 *     visual claim of certification. The only ornaments are the numeral and the
 *     card hairline.
 *   · the numeral is DERIVED from the DISPLAY index (01, 02, 03 with no gaps),
 *     aria-hidden, and carries no data-field — it is chrome, not content, so it
 *     is never stored and dropping a blank row can never leave a hole in the
 *     sequence or misdirect an edit. Same rule as HowBJ's steps.
 *
 * ANCHOR: id="promises", one of PageBJ's PAGE_ANCHORS.
 *
 * THEMING (R3): no baked hex — only --card --line --ink --ink-soft --accent
 * --disp --sans. The numeral leans on the decorative allowance: it is
 * aria-hidden and removing it removes nothing a reader needs.
 */
// layout is accepted but unused: PageBJ passes it to every section uniformly,
// and this block reads nothing outside content.*.
interface Props { content: any; layout?: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
// The eyebrow is credentials.tag ONLY — criterion A admits no design literal.
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title?: string; body?: string; desc?: string; detail?: string; description?: string; label?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : (Array.isArray(cred) ? cred : []);
const titleOf = (it: Item): string => it.title ?? it.label ?? '';
const bodyOf = (it: Item): string => it.body ?? it.desc ?? it.detail ?? it.description ?? '';
// A row the owner added but never filled would otherwise render a card, a
// numeral and 24px of padding over nothing. Drop the blanks (whitespace counts
// as blank), but carry the ORIGINAL index so every data-field still writes to
// the real array slot — removing promise 2 must never redirect an edit to
// promise 3.
const rows = items
  .map((it, i: number) => ({ ...it, i }))
  .filter((r) => Boolean(titleOf(r).trim() || bodyOf(r).trim()));
---
{rows.length > 0 && (
  <section class="promises" id="promises">
    <div class="wrap">
      {tag && <span class="kick" data-field="credentials.tag">{tag}</span>}
      {headline && <h2 class="h2 pr-h reveal" data-field="credentials.headline" set:html={headline}></h2>}
      <div class:list={['pr-grid', (tag || headline) && 'has-head']}>
        {rows.map((it, k: number) => (
          <div class="pr-card reveal" data-delay={String(k % 3)}>
            {/* DISPLAY index, so the cards always read 01, 02, 03 however many
                blank rows were dropped; data-field below carries the ORIGINAL
                index. aria-hidden: it is a counter, not information. */}
            <span class="pr-n" aria-hidden="true">{String(k + 1).padStart(2, '0')}</span>
            {titleOf(it) && <h3 class="pr-t" data-field={`credentials.items.${it.i}.title`}>{titleOf(it)}</h3>}
            {bodyOf(it) && <p class="pr-p" data-field={`credentials.items.${it.i}.body`}>{bodyOf(it)}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  /* Continues the host block: same ground, no top rule, and a much smaller top
     pad than the wrapper's default section rhythm so the promises read as part
     of the same idea. `.promises` scoped is (0,2,0) and beats PageBJ's
     `html[data-page="BJ"] section` at (0,1,1). */
  .promises { padding-top: clamp(20px, 3vw, 40px); }

  /* The eyebrow is the wrapper's shared .kick primitive — 10px tracked caps in
     --accent (the AA-darkened terracotta, 5.06:1 on paper, which 10px text
     needs). Restating it here would fork it from the rest of the template. */

  /* Instrument Serif ships ONE weight — 400; asking for 700 synthesises a faux
     bold, so both display sizes pin it. The <em> emphasis rule is GLOBAL in
     PageBJ on purpose: Astro's scoped styles cannot reach elements created by
     set:html, so an italic rule written here would never apply. */
  .pr-h {
    font-family: var(--disp); font-weight: 400;
    font-size: clamp(28px, 3.4vw, 46px); line-height: 1.06; letter-spacing: -.01em;
    margin: .24em 0 .34em; color: var(--ink); max-width: 20ch; overflow-wrap: anywhere;
  }

  /* auto-fit rather than a fixed 3-up: two promises read as two, and a partial
     last row leaves no hole because each card carries its own border. */
  .pr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  /* Only when a head was actually rendered — with none, the cards must not
     inherit a gap from a heading that is not there. */
  .pr-grid.has-head { margin-top: clamp(14px, 2vw, 24px); }

  .pr-card { background-color: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px 26px; min-width: 0; }
  .pr-n { display: block; font-family: var(--disp); font-style: italic; font-size: 22px; line-height: 1; color: var(--ink-soft); margin-bottom: 10px; }
  .pr-t { font-family: var(--disp); font-weight: 400; font-size: 21px; line-height: 1.14; margin: 0 0 7px; color: var(--ink); overflow-wrap: anywhere; }
  /* PageBJ's `:where(p){margin:0 0 1em}` is (0,1,1); the parent class puts this
     at (0,2,0) so the zero margin actually lands. */
  .pr-card .pr-p { margin: 0; font-size: 14px; line-height: 1.7; color: var(--ink-soft); overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    .pr-grid { grid-template-columns: 1fr 1fr; }
    .pr-h { max-width: none; }
  }

  /* ── 520: one column. At 360px a 2-up track is ~150px, which is too narrow for
        a 21px display title over a 14px body. */
  @media (max-width: 520px) {
    .pr-grid { grid-template-columns: 1fr; }
    .pr-card { padding: 20px 20px; }
    .pr-h { font-size: clamp(25px, 7.8vw, 32px); }
  }
</style>
