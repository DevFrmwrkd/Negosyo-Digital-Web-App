---
/**
 * hospitality / PageBK — "Villa Marindu" (a whole private villa, let one
 * booking at a time).
 *
 * Night & brass: Prata display over Figtree body on a near-black green-black
 * ground, with a brass accent, hairline rules and SHARP 2–3px corners. The
 * signature is the ITALIC BRASS EMPHASIS inside a headline — the hero's last
 * phrase, and any <em> an owner types into a section h2.
 *
 * THE DESIGN IS THE SPECIFICATION. Every value below is lifted verbatim from
 * "Villa Marindu Landing.dc.html". Nothing is re-derived, darkened, lightened
 * or "made portable". The one axis the design itself exposes as configurable is
 * its accent — its own data-props offers #B99552 / #9C8F6E / #A8763C / #7F9A86 —
 * so the accent is the ONLY token the theme engine is allowed to move.
 *
 * WHY THE GROUNDS ARE NOT --paper / --ink. buildOverrideCss rewrites
 * --paper --paper-2 --card --ink --ink-soft --line with !important, and on a
 * light scheme it would set --paper white and --ink near-black. This design is
 * a dark one; flipping it produces a different design, which is exactly the
 * mistake that had to be undone on the Kubo Stays template. So the design's
 * fixed world lives in tokens the engine does not know:
 *
 *     --night --night-2 --night-3 --well --bone --bone-hi --grey --grey-2
 *     --muted --faint --rule --rule-soft --scrim-rgb --bone-rgb
 *
 * The engine's own vocabulary is still DECLARED below, so any inherited rule
 * that reads --paper finds something sane, but no selector in this template
 * uses it. An admin colour pick therefore recolours the brass and leaves the
 * night alone.
 *
 * ROLE OF THIS FILE: the wrapper emits the WHOLE document (doctype, head,
 * tokens, fonts, Leaflet boot, skip link, scroll-reveal). It does NOT compose
 * with BaseLayout. It is the only file in the variant that touches `siteData`;
 * the 15 section components receive only `layout` + `content`.
 *
 * EDITABLE HOOKS OWNED BY THIS FILE: none. PageBK renders no editable text of
 * its own — it only READS layout.businessName / layout.tagline (<title>),
 * content.description (<meta name="description">), layout.favicon and
 * layout.ogImage || layout.favicon. Every data-field / data-image-field /
 * data-href-field hook lives in a section component.
 *
 * THE ONE HARDCODED VISIBLE STRING in the whole template is the skip link's
 * "Skip to content" below. It is an a11y affordance, visible on focus only.
 *
 * VERIFIED CONTRAST (sRGB relative luminance, the design's palette):
 *   bone-hi/night 16.5 · bone/night 15.0 · grey/night 8.30 · grey-2/night 11.1
 *   brass/night 6.62 (eyebrows, numerals, rules) · night on a brass fill 6.62
 *   muted/night 4.34 · muted/night-2 4.13 · faint/night-3 3.16
 * BELOW AA, the design's own choices, accepted rather than silently altered:
 *   --muted at 13px and 10px (4.34 / 4.13) and --faint in the colophon (3.16).
 *   Both carry only text the heading beside them repeats. Lifting --muted to
 *   #8E948E clears AA and is a one-line change — it is the owner's palette and
 *   the owner's call, so the file ships the design's value.
 *
 * FORBIDDEN CLASS NAMES in this template (read lib/genericThemeOverrides.ts
 * before adding a button anywhere):
 *   .btn-primary .btn-ghost .btn-yellow .btn-light .nav-cta .nav-right
 *   .testi .cta-band .trust, and `.hero` on a <section>.
 * The engine pins labels on those with !important for every state. Buttons here
 * are .btn--fill / .btn--line / .linkc (double dash), which it does not touch.
 *
 * FONT-PAIRING SENTINEL (two lines, wrapper-local, touches no shared file):
 * lib/astro-builder.ts defaults `layout.fontPairing` to the literal 'modern',
 * and resolveTheme's `lockVariant` only blanks ''/'auto'/'default' — so without
 * the sentinel buildOverrideCss force-swaps Prata + Figtree with !important on
 * ~every real site and the design's faces never reach a visitor. We treat
 * astro-builder's DEFAULT as unset; a deliberate admin pick still applies.
 *
 * RENDER ORDER, exactly as the design draws it: Header, Hero, Trust, About
 * (the villa), Services (what is included), Why (book direct), Gallery, How,
 * Testimonials, Credentials, Location, Area (what is nearby), Faq, CtaBand,
 * Footer.
 *
 * BANDS: a section that wants the raised panel ground carries `band-panel`
 * alongside its own class. There is no inverted band in this design — the whole
 * page is already the dark one — so `band-panel` only lifts a section from
 * --night to --night-2 and gives it hairline edges.
 *
 * Leaflet: this wrapper LOADS leaflet.css + leaflet.js and defines
 * window.__hospitalityBKInitMap (family-unique, because a preview harness can
 * render two wrappers in one document and a shared name cross-wires the maps).
 * LocationBK calls that exact string. Keep `el.innerHTML = ''` in the boot — it
 * is what erases the drawn fallback map-face — and keep id="map" literal.
 * The first cut of this file defined the boot but shipped neither tag, so
 * window.L was never defined and every villa's map silently stayed on the drawn
 * fallback. check-template-blocks.mjs now fails that combination.
 */
import HeaderBK from './header/HeaderBK.astro';
import HeroBK from './hero/HeroBK.astro';
import TrustBK from './trust/TrustBK.astro';
import AboutBK from './about/AboutBK.astro';
import ServicesBK from './services/ServicesBK.astro';
import WhyBK from './why/WhyBK.astro';
import GalleryBK from './gallery/GalleryBK.astro';
import HowBK from './how/HowBK.astro';
import TestimonialsBK from './testimonials/TestimonialsBK.astro';
import CredentialsBK from './credentials/CredentialsBK.astro';
import LocationBK from './location/LocationBK.astro';
import AreaBK from './area/AreaBK.astro';
import FaqBK from './faq/FaqBK.astro';
import CtaBandBK from './ctaBand/CtaBandBK.astro';
import FooterBK from './footer/FooterBK.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __resolvedPairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
// FONT-PAIRING SENTINEL — see the note in the frontmatter.
const __pairing = (layout.fontPairing === 'modern' && !layout.fontPairingExplicit) ? '' : __resolvedPairing;
const __fontHref = buildFontHref(__pairing);
const __overrideCss = buildOverrideCss(__themeScheme, __pairing);
const __desc = (content as any).description || '';
const __favicon = layout.favicon || '';
const __og = layout.ogImage || layout.favicon || '';
---
<!DOCTYPE html>
<html lang="en-PH" data-page="BK">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{__desc && <meta name="description" content={__desc} />}
<meta name="theme-color" content="#101413" />
<meta property="og:title" content={title} />
{__desc && <meta property="og:description" content={__desc} />}
{__og && <meta property="og:image" content={__og} />}
{__favicon && <link rel="icon" href={__favicon} />}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Prata&family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet" />
{__fontHref && <link href={__fontHref} rel="stylesheet" />}
<!-- Leaflet. BOTH tags are load-bearing: without the stylesheet the tiles
     render as a stack of unpositioned images, and without the script window.L
     never exists, the boot below returns immediately, and LocationBK's drawn
     fallback face is all an owner ever sees however many coordinates they
     type. scripts/check-template-blocks.mjs now fails a wrapper that defines a
     map boot without loading both. -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
       Every selector is prefixed html[data-page="BK"], including the reset,
       body, img, a and ::selection, so nothing leaks into a sister wrapper
       built in the same run — and nothing leaks in.

       (Never write a literal end-style-tag inside this block, comments
        included — it is an HTML raw-text element, so the parser would end the
        stylesheet right there.)
       ═══════════════════════════════════════════════════════════════════════ */

    html[data-page="BK"] {
      /* ── THE DESIGN'S FIXED WORLD. The override engine does not know these
            names, which is the point: an admin colour pick recolours the brass
            and leaves the night alone. ───────────────────────────────────── */
      --night: #101413;
      --night-2: #141A18;
      --night-3: #0C100F;
      --well: #1A211E;
      --bone: #EFEAE0;
      --bone-hi: #F4F1EA;
      --grey: #A9AFA9;
      --grey-2: #C3C8C1;
      --muted: #767C76;
      --faint: #5E645E;
      --rule: #262E2B;
      --rule-soft: #212926;
      --scrim-rgb: 11,14,13;
      --bone-rgb: 239,234,224;

      /* ── THE ONE MOVING PART. The design's own data-props exposes the accent
            as configurable (#B99552 / #9C8F6E / #A8763C / #7F9A86), so this is
            the token the engine is welcome to remap. ──────────────────────── */
      --accent: #B99552;
      --accent-light: #D2B173;
      --accent-deep: #8F7040;
      --accent-rgb: 185,149,82;
      --on-accent: #101413;

      /* ── The engine's own vocabulary, declared so any inherited rule finds
            something sane. NO SELECTOR IN THIS TEMPLATE USES THEM. ───────── */
      --paper: #101413;
      --paper-2: #141A18;
      --card: #141A18;
      --ink: #EFEAE0;
      --ink-soft: #A9AFA9;
      --line: #262E2B;
      --paper-rgb: 16,20,19;
      --ink-rgb: 239,234,224;
      --on-ink: #101413;
      --on-paper: #EFEAE0;
      --on-primary: #101413;

      /* ── type + metrics ─────────────────────────────────────────────────── */
      --disp: "Prata", Georgia, "Times New Roman", serif;
      --serif: "Prata", Georgia, "Times New Roman", serif;
      --sans: "Figtree", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      /* This design has no monospace: its tracked caps are Figtree 600. */
      --mono: "Figtree", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --maxw: 1280px;
      /* Sharp, not rounded. 2px on controls, 3px on plates — the design never
         draws a pill, and a rounded corner here reads as a different template. */
      --r-ctl: 2px;
      --r-lg: 3px;
    }

    /* ── reset + document ─────────────────────────────────────────────────── */
    html[data-page="BK"] *,
    html[data-page="BK"] *::before,
    html[data-page="BK"] *::after { box-sizing: border-box; }
    html[data-page="BK"] {
      -webkit-text-size-adjust: 100%; scroll-behavior: smooth;
      /* The header is sticky and ~78px tall; without this every in-page anchor
         lands with the top of its section underneath it. On the root rather than
         per-section so it also covers FAQ rows and the map node, and keeps
         keyboard focus out from under the rail. */
      scroll-padding-top: 92px;
    }
    @media (prefers-reduced-motion: reduce) { html[data-page="BK"] { scroll-behavior: auto; } }
    html[data-page="BK"] body {
      margin: 0; padding: 0;
      background-color: var(--night); color: var(--bone);
      font-family: var(--sans); font-size: 16.5px; line-height: 1.7;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    html[data-page="BK"] img { max-width: 100%; display: block; }
    html[data-page="BK"] a { color: inherit; text-decoration: none; }
    html[data-page="BK"] ::selection { background: var(--accent); color: var(--on-accent); }
    /* text-transform is DECLARED, not defaulted. A property a template never
       states is a property another template's is:global block can reach — and
       two of them shipped an unscoped h1,h2,h3,h4{text-transform:uppercase}
       that turned this design's mixed-case serif into capitals on every built
       page. Those are scoped now; this line means it cannot happen again from
       any future one. */
    html[data-page="BK"] :where(h1,h2,h3,h4) {
      margin: 0; font-family: var(--disp); font-weight: 400; color: var(--bone-hi);
      letter-spacing: 0; line-height: 1.1; text-transform: none;
    }
    /* This bare-element paragraph reset is (0,1,1): always qualify a section's
       own paragraph rules with a parent class (.villa-copy p) so they win. */
    html[data-page="BK"] :where(p) { margin: 0 0 1em; }

    /* ── layout scaffolding ───────────────────────────────────────────────── */
    html[data-page="BK"] :where(.wrap) { width: min(var(--maxw), 92vw); margin-inline: auto; }
    html[data-page="BK"] section { padding: clamp(60px,8vw,100px) 0; position: relative; }

    /* ── the ONE band. No inverted ground in this design: the page is already
          the dark one, so a "band" only lifts a section onto the panel tone and
          gives it hairline edges. ─────────────────────────────────────────── */
    html[data-page="BK"] :where(.band-panel) {
      background-color: var(--night-2);
      border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    }

    /* ── .kick — the eyebrow. 10px caps, very wide tracking, brass (6.62:1). */
    html[data-page="BK"] :where(.kick) {
      display: inline-block;
      font-family: var(--sans); font-weight: 600; font-size: 10px;
      letter-spacing: .44em; text-transform: uppercase; color: var(--accent);
    }

    /* ── display headline + the ITALIC BRASS EMPHASIS (the design's signature).
          Prata ships ONE weight (400) and NO italic, so `font-style: italic`
          synthesises an oblique — which is what the design does too. Sections
          feed the h2 with set:html so an owner can place the emphasis anywhere
          in their own sentence. */
    html[data-page="BK"] :where(.h2) {
      font-family: var(--disp); font-weight: 400;
      font-size: clamp(31px,4vw,54px); line-height: 1.1; letter-spacing: 0;
      margin: 0 0 .3em; color: var(--bone-hi); max-width: 24ch;
    }
    html[data-page="BK"] :where(.h2 em),
    html[data-page="BK"] :where(.h2 .em),
    html[data-page="BK"] :where(.em) { font-style: italic; color: var(--accent); }
    html[data-page="BK"] :where(.lede) {
      color: var(--grey); font-size: clamp(15.5px,1.5vw,16.5px); line-height: 1.85;
      max-width: 52ch; margin: 0;
    }
    html[data-page="BK"] :where(.body) {
      color: var(--grey); font-size: clamp(14.5px,1.3vw,15px); line-height: 1.75;
    }
    /* ── .mono — small tracked caps. --muted is the design's value; see the
          contrast note in the frontmatter. */
    html[data-page="BK"] :where(.mono) {
      font-family: var(--sans); font-weight: 500; font-size: 10px;
      letter-spacing: .22em; text-transform: uppercase; color: var(--muted);
    }
    /* ── .fig — the serif brass figure (rates, proof numbers, numerals). */
    html[data-page="BK"] :where(.fig) {
      font-family: var(--disp); font-weight: 400; color: var(--accent);
      font-variant-numeric: tabular-nums lining-nums; line-height: 1;
    }

    /* ── BUTTONS ────────────────────────────────────────────────────────────
       Straight from the design's own renderVals():
         .btn--fill   btnNav/btnLg/btnBrass — brass fill, --on-accent label, 2px
         .btn--line   the outlined secondary — bone label inside a bone hairline
       Both hovers DARKEN the same fill and keep the same label colour: never
       lighter, never transparent, never a hue change. That is what stranded the
       Ironwood label, and the same trap is live here because buildOverrideCss
       pins some labels with !important. */
    html[data-page="BK"] :where(.btn) {
      /* DECLARED, not left to chance. A button with no background of its own
         is filled by whatever rule lands last, and index.astro bundles every
         template's is:global CSS onto every page — so an unscoped
         `.btn { background: var(--ink) }` from another family was painting
         this family's outline controls. The variants below each set their
         own fill; this is what the ones that want none actually get. */
      background-color: transparent;
      display: inline-flex; align-items: center; justify-content: center; gap: .55em;
      padding: 17px 32px; min-height: 48px;
      border-radius: var(--r-ctl); border: 1px solid transparent;
      font-family: var(--sans); font-weight: 600; font-size: 12px;
      letter-spacing: .16em; text-transform: uppercase; text-decoration: none;
      cursor: pointer; white-space: nowrap;
      transition: background-color .18s ease, box-shadow .18s ease, transform .18s ease, border-color .18s ease;
    }
    html[data-page="BK"] :where(.btn--fill) {
      background-color: var(--accent); color: var(--on-accent); border-color: var(--accent);
    }
    html[data-page="BK"] :where(.btn--fill:hover) {
      background-color: var(--accent); color: var(--on-accent); border-color: var(--accent);
      box-shadow: inset 0 0 0 999px rgba(0,0,0,.16), 0 0 0 4px rgba(var(--accent-rgb),.22);
      transform: translateY(-2px);
    }
    html[data-page="BK"] :where(.btn--fill:active) { transform: translateY(0); }
    /* The design's secondary: no fill at all, a bone hairline and a bone label. */
    html[data-page="BK"] :where(.btn--line) {
      background-color: transparent; color: var(--bone);
      border-color: rgba(var(--bone-rgb),.4);
    }
    html[data-page="BK"] :where(.btn--line:hover) {
      background-color: rgba(var(--bone-rgb),.10); color: var(--bone);
      border-color: var(--bone); transform: translateY(-2px);
    }
    html[data-page="BK"] :where(.btn--line:active) { transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) {
      html[data-page="BK"] .btn { transition: none; }
      html[data-page="BK"] .btn--fill:hover,
      html[data-page="BK"] .btn--line:hover { transform: none; }
    }

    /* ── .linkc — quiet text-link action (the footer's "Contact us →"). Its
          colour never changes on hover, only the rule under it, so it cannot
          fail a contrast check mid-interaction. */
    html[data-page="BK"] :where(.linkc) {
      display: inline-flex; align-items: center; gap: .5em; min-height: 44px;
      font-family: var(--sans); font-weight: 600; font-size: 13px;
      letter-spacing: .02em; color: var(--accent);
      border-bottom: 1px solid transparent; padding-bottom: 2px;
      transition: border-bottom-color .18s ease, transform .18s ease;
    }
    html[data-page="BK"] :where(.linkc:hover) {
      color: var(--accent); border-bottom-color: var(--accent); transform: translateY(-1px);
    }
    @media (prefers-reduced-motion: reduce) { html[data-page="BK"] .linkc { transition: none; } }

    /* ── FOCUS · one DUO ring for everything: a 3px night outline INSIDE a brass
          halo, so it reads on the night ground, on a brass fill and over a
          photograph alike. */
    html[data-page="BK"] :where(a,button,summary,[tabindex]):focus-visible {
      outline: 3px solid var(--night); outline-offset: 0;
      box-shadow: 0 0 0 6px var(--accent);
      border-radius: var(--r-ctl);
    }

    /* ── .plate / .ph — the image frame and its empty state. The design's wells
          are flat --well; the two faint washes only exist so an unfilled slot
          reads as a deliberate surface rather than a broken image. */
    html[data-page="BK"] :where(.plate) {
      position: relative; overflow: hidden; min-height: 180px;
      border-radius: var(--r-lg);
      background-color: var(--well); isolation: isolate;
    }
    html[data-page="BK"] :where(.plate) .ph {
      position: absolute; inset: 0; z-index: 1;
      background-color: var(--well);
      background-size: cover; background-position: center; background-repeat: no-repeat;
      background-image:
        radial-gradient(78% 64% at 22% 14%, rgba(var(--accent-rgb),.16), transparent 62%),
        radial-gradient(66% 60% at 84% 90%, rgba(var(--bone-rgb),.05), transparent 60%);
      transition: transform .5s ease;
    }
    /* Caption on an OPAQUE brass pill, never a gradient scrim: --on-accent on
       brass holds 6.62:1 over ANY owner photo, however dark or blown out. */
    html[data-page="BK"] :where(.plate) .cap {
      position: absolute; left: 12px; bottom: 12px; z-index: 3;
      max-width: calc(100% - 24px);
      background-color: var(--accent); color: var(--on-accent);
      font-family: var(--sans); font-weight: 600; font-size: 9px;
      letter-spacing: .2em; text-transform: uppercase;
      padding: 6px 12px; border-radius: var(--r-ctl);
      overflow-wrap: anywhere;
    }
    @media (prefers-reduced-motion: reduce) { html[data-page="BK"] :where(.plate) .ph { transition: none; } }

    /* ── .rowrule — the label/value hairline row used by the spec ledger, the
          house rules and the nearby list. One declaration, three sections. */
    html[data-page="BK"] :where(.rowrule) {
      display: flex; align-items: baseline; gap: 12px;
      padding: 12px 0; border-bottom: 1px solid var(--rule-soft);
      min-width: 0;
    }

    /* ── scroll reveal ─────────────────────────────────────────────────────── */
    html[data-page="BK"] :where(.reveal) {
      opacity: 0; transform: translateY(14px);
      transition: opacity .6s ease, transform .6s ease;
    }
    html[data-page="BK"] :where(.reveal.in) { opacity: 1; transform: none; }
    html[data-page="BK"] :where(.reveal[data-delay="1"]) { transition-delay: .08s; }
    html[data-page="BK"] :where(.reveal[data-delay="2"]) { transition-delay: .16s; }
    html[data-page="BK"] :where(.reveal[data-delay="3"]) { transition-delay: .24s; }
    @media (prefers-reduced-motion: reduce) {
      html[data-page="BK"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    /* ── skip link ─────────────────────────────────────────────────────────── */
    html[data-page="BK"] :where(.skip) {
      position: absolute; left: -999px; top: 0; z-index: 100;
      background-color: var(--accent); color: var(--on-accent);
      padding: 12px 18px; border-radius: 0 0 var(--r-ctl) 0;
      font-family: var(--sans); font-weight: 600; font-size: 11.5px;
      letter-spacing: .14em; text-transform: uppercase;
    }
    html[data-page="BK"] :where(.skip:focus) { left: 0; top: 0; }

    /* ── SHARED MOBILE PASS · 760px ────────────────────────────────────────── */
    @media (max-width: 760px) {
      /* The MAX is the BASE clamp's own value at 760px (31.00px), not a round
         number. Anything higher and the headline GROWS as the viewport narrows
         past 761 — base clamp(31px,4vw,54px) bottoms out around there, so a max of 38-42
         was landing ABOVE where the curve arrived from. It is a jump no
         screenshot at 1440 or 375 can show you: it lives in the one pixel
         either side of the boundary. The vw term is untouched, so the steeper
         small-screen curve this breakpoint exists for still happens. */
      html[data-page="BK"] :where(.h2) { font-size: clamp(27px,7.2vw,31px); max-width: none; overflow-wrap: anywhere; }
      html[data-page="BK"] :where(.lede) { max-width: none; }
    }
    @media (max-width: 520px) {
      html[data-page="BK"] :where(.kick) { font-size: 9.5px; letter-spacing: .3em; }
      html[data-page="BK"] :where(.btn) { padding: 15px 24px; }
    }
</style>

<style is:inline set:html={__overrideCss}></style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{visibility.headerSection !== false && <HeaderBK content={content} layout={layout} />}
<main id="main">
  {visibility.heroSection !== false && <HeroBK content={content} layout={layout} />}
  {visibility.trustBlock !== false && <TrustBK content={content} layout={layout} />}
  {visibility.aboutSection !== false && <AboutBK content={content} layout={layout} />}
  {visibility.servicesSection !== false && <ServicesBK content={content} layout={layout} />}
  {visibility.whyUsBlock !== false && <WhyBK content={content} layout={layout} />}
