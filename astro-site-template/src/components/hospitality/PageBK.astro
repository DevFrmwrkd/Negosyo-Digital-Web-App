<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  (function () {
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    els.forEach(function (el) { io.observe(el); });
  })();

  // Family-unique name — LocationBK calls this exact string. The innerHTML wipe
  // is what erases the drawn fallback map-face before Leaflet paints.
  //
  // The script tag above is in the same document, so window.L is normally there
  // by the time LocationBK's bounded retry finds this function. The short retry
  // here covers the other order — a slow or blocked CDN — and gives up rather
  // than spinning, because the drawn fallback face IS the design and is a
  // perfectly good thing to be left with.
  window.__hospitalityBKInitMap = function (lat, lng, label) {
    var tries = 0;
    (function go() {
      var el = document.getElementById('map');
      if (!el) return;
      if (typeof window.L === 'undefined') {
        if (tries++ < 25) setTimeout(go, 80);
        return;
      }
      el.innerHTML = '';
      var map = window.L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 15);
      // dark_all, not dark_nolabels: a guest orienting to a barangay, pier or
      // highway needs the place names, and the dark basemap is the only one of
      // the CARTO set that sits inside this design rather than on top of it.
      window.L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '&copy; OpenStreetMap &copy; CARTO',
      }).addTo(map);
      // The default Leaflet pin is a blue PNG and would be the only thing on the
      // page that is not night, bone or brass. Colours are READ from the live
      // tokens rather than baked, so an explicit admin colour pick recolours the
      // pin too — buildOverrideCss sets them on html:root, which is this element.
      var cs = window.getComputedStyle(document.documentElement);
      var accent = (cs.getPropertyValue('--accent') || '').trim() || '#B99552';
      var night = (cs.getPropertyValue('--night') || '').trim() || '#101413';
      var icon = window.L.divIcon({
        className: '',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
        html: '<span style="display:block;width:16px;height:16px;border-radius:50%;background:' +
              accent + ';border:3px solid ' + night + ';box-shadow:0 0 0 1px ' + accent + '"></span>',
      });
      var marker = window.L.marker([lat, lng], { icon: icon }).addTo(map);
      if (label) marker.bindPopup(label);
    })();
  };
</script>
</body>
</html>
