---
/**
 * hospitality / HeroBI — "Palm Hour"'s arrival shot. A mono kicker, an oversized
 * Fraunces headline on bare plaster, then a lower row pairing two layered
 * photographic prints (left: a 16/10 main plate with an overlapping square mat
 * print, warmed by a decorative sun arc) against the front-desk .slab (right),
 * which carries the lede and BOTH booking actions — so the primary action is
 * reachable in the first screenful on a phone as well as on a desktop.
 *
 * Editable hooks: hero.kicker · hero.headlineLines.${i} · hero.sub · hero.tag ·
 * hero.cta1.text + hero.cta1.href · hero.cta2.text + hero.cta2.href ·
 * data-image-field hero.image · data-image-field hero.photos.1
 *
 * Mirrors HeroAS / HeroBB's content contract exactly (hero.headlineLines / sub /
 * cta1 / cta2 / image) so derived defaults and admin edits feed it unchanged.
 *
 * CLASS-NAME LAW (not inferable, do not "tidy"): the section is .arrival, NOT
 * .hero — buildOverrideCss force-paints `.hero .btn-ghost` white-on-transparent
 * with !important, which would strand a white label on this light band. The
 * buttons are .btn--fill / .btn--line (double dash) for the same reason: they
 * dodge the engine's `.btn-primary{color:<on-primary>!important}` pin, which is
 * sub-AA in 6 of the 13 schemes. Never use .btn-primary / .btn-ghost / .nav-cta
 * / .btn-light / .btn-yellow anywhere in this family.
 *
 * The photo tag renders ONLY from hero.tag. It used to be a hardcoded CSS
 * ::after ("SINCE 2013", "OPEN 24 HOURS") — a claim about a property that never
 * supplied it — so an unset tag now draws nothing rather than inventing one.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageBI actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageBI — and with the byte-identical copies in
// HeaderBI, CtaBandBI and FooterBI. This design renames the service menu to
// #rooms and the why block to #amenities, and adds #nearby, so the alias table
// is larger than the filipino one.
const PAGE_ANCHORS = new Set(['about', 'amenities', 'book', 'faq', 'gallery', 'how', 'location', 'main', 'nearby', 'reviews', 'rooms']);
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', contact: 'location', services: 'rooms', why: 'amenities', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const hero = content.hero || {};
const heroImage = hero.image || (hero.photos && hero.photos[0]) || (content.photos && content.photos[0]) || '';
// Second print. Optional by design: with one photo the stage is a single plate
// and reserves no space for a frame that will never arrive. Guarded against
// echoing the main print, which reads as a broken layout rather than a diptych.
const secondRaw = (hero.photos && hero.photos[1]) || (content.photos && content.photos[1]) || '';
const heroImage2 = secondRaw && secondRaw !== heroImage ? secondRaw : '';
const kicker = hero.kicker || hero.locality || '';
const photoTag = hero.tag || '';
const headlineLines: string[] = Array.isArray(hero.headlineLines) && hero.headlineLines.length > 0
  ? hero.headlineLines
  : (hero.headline ? [hero.headline] : []);
const sub = hero.sub || '';
const cta1Text = hero.cta1?.text || '';
const cta1Href = onPage(hero.cta1?.href, '#book');
const cta2Text = hero.cta2?.text || '';
const cta2Href = onPage(hero.cta2?.href, (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '#rooms'));
---
<section class="arrival" aria-label="Hero">
  <div class="wrap">
    {kicker && <div class="kick a-kick" data-field="hero.kicker">{kicker}</div>}
    {headlineLines.length > 0 && (
      <h1 class="a-h1">
        {headlineLines.map((line: string, i: number) => (
          <span class="ln" data-field={`hero.headlineLines.${i}`} set:html={line}></span>
        ))}
      </h1>
    )}
    <div class="a-lower">
      <div class="a-stage">
        <span class="sun" aria-hidden="true"></span>
        <div class="plate stage-main" style="aspect-ratio:16/10;min-height:0">
          {/* The .ph slot is a designed gradient until the owner uploads a photo, but
            it announced itself to screen readers as role="img" + "Property photo"
            either way — a picture of a property that does not exist, asserted to
            exactly the users who cannot see that it is a flat gradient. With an
            image it is a real image and keeps its role + label; with none it is
            decoration and is hidden. Astro drops attributes whose value is
            undefined. */}
          <div
            class="ph"
            data-image-field="hero.image"
            role={heroImage ? 'img' : undefined}
            aria-label={heroImage ? 'Property photo' : undefined}
            aria-hidden={heroImage ? undefined : 'true'}
            style={heroImage ? `background-image:url('${heroImage}');` : ''}
          ></div>
          {photoTag && <span class="cap" data-field="hero.tag">{photoTag}</span>}
        </div>
        {heroImage2 && (
          <div class="plate mat stage-inset" style="aspect-ratio:1/1;min-height:0">
            <div
              class="ph"
              data-image-field="hero.photos.1"
              role="img"
              aria-label="Property photo"
              style={`background-image:url('${heroImage2}');`}
            ></div>
          </div>
        )}
      </div>
      <div class="a-right">
        {(sub || cta1Text || cta2Text) && (
          <div class="slab weave deskcard reveal" data-delay="1">
            {sub && <p class="lede" data-field="hero.sub">{sub}</p>}
            {(cta1Text || cta2Text) && (
              <div class="a-ctas">
                {cta1Text && <a class="btn btn--fill" href={cta1Href} data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
                {cta2Text && <a class="btn btn--line" href={cta2Href} data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
<style>
  /* Colour comes only from the wrapper's token vocabulary and the named
     primitives .kick .plate .mat .sun .slab .weave .lede .btn--fill .btn--line.
     There is no hex in this file. */
  .arrival { padding: clamp(26px,4vw,54px) 0 clamp(64px,8vw,110px); }
  .a-kick { margin-bottom: 18px; }
  .a-h1 {
    font-family: var(--disp); font-weight: 800; font-size: clamp(44px,7.4vw,104px);
    line-height: .95; letter-spacing: -.03em; max-width: 19ch; margin: 18px 0 34px;
  }
  .a-h1 .ln { display: block; }
  /* Emphasis inside a set:html line is an UNDERLINE, never a colour swap: accent
     as text measures 4.11 native and collapses to 1.29 under the maroon scheme.
     :global() because Astro cannot scope markup that arrived through set:html. */
  .a-h1 :global(.em),
  .a-h1 :global(.em2) {
    font-style: normal; color: inherit;
    background-image: linear-gradient(rgba(var(--accent-rgb),.55), rgba(var(--accent-rgb),.55));
    background-repeat: no-repeat; background-position: 0 92%;
  }
  .a-h1 :global(.em) { background-size: 100% .16em; }
  .a-h1 :global(.em2) { background-size: 100% .10em; }

  .a-lower { display: grid; grid-template-columns: 1.18fr .82fr; gap: clamp(28px,4vw,56px); align-items: end; }
  .a-stage { position: relative; }
  .a-stage .sun { width: clamp(200px,26vw,340px); height: clamp(200px,26vw,340px); top: -9%; right: -6%; }
  .stage-main { position: relative; z-index: 1; }
  /* Three classes so this beats the base `html[data-page="BI"] :where(.plate) .cap`
     (0,2,1) — an Astro-scoped two-class rule is only (0,3,0) after the scope
     attribute, which it needs to be. */
  .a-stage .stage-main .cap { left: 16px; top: 16px; bottom: auto; }
  .stage-inset { position: absolute; width: 34%; left: -4%; bottom: -11%; z-index: 2; border-radius: var(--r-md); }

  /* The front-desk card. .slab supplies the woven ground, border and lift; only
     the ink top rule and the padding are local. */
  .deskcard { border-top-width: 3px; border-top-color: var(--ink); padding: clamp(22px,2.6vw,32px); }
  .a-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }

  @media (max-width: 820px) {
    .a-lower { grid-template-columns: 1fr; }
    /* The plate's ratio is set INLINE (belt-and-braces against R6), so it cannot
       be overridden by a selector. A definite height makes aspect-ratio inert
       instead — same result, no !important. */
    .stage-main { aspect-ratio: auto; height: clamp(220px,56vw,330px); }
    /* Once the grid is ONE column the inset's overhang eats the ROW gap, whose
       clamp floor is 28px — while a percentage `bottom` is measured against the
       stage (up to 36px at 330px), so between 761 and 820px the matted print
       landed on the front-desk slab. A fixed offset can never outgrow the gap. */
    .stage-inset { bottom: -14px; }
  }
  @media (max-width: 760px) {
    .a-h1 { font-size: clamp(34px,9vw,52px); overflow-wrap: anywhere; max-width: none; }
    .a-stage .sun { width: 180px; height: 180px; right: -14%; }
    .stage-inset { width: 40%; left: -2%; }  /* bottom stays -14px from the 820 block */
  }
  @media (max-width: 520px) {
    /* Every negative offset is removed before 360px: the overlap becomes a stack,
       so the inset print can never clip or push the row wide. Height rather than
       aspect-ratio for the same inline-style reason as above (~16/9 at 360px). */
    .stage-inset { position: static; width: 100%; margin-top: 12px; height: clamp(160px,52vw,210px); }
    .a-stage .stage-main .cap { left: 10px; top: 10px; font-size: 9px; }
    /* The CTAs go full width from the wrapper's shared 520 pass. */
    .a-ctas { gap: 10px; }
  }
</style>
