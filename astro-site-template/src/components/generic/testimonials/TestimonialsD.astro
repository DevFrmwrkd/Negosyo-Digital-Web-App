---
/**
 * generic / TestimonialsD — Northpoint IT reviews band: one featured
 * pull-quote beside a column of shorter ones.
 *
 * Every quote, name and source line here is owner-supplied or absent. A
 * fabricated quote ships as a named stranger endorsing a real business and
 * cannot be taken back once published; an empty band costs nothing, so the
 * whole section hides when there is nothing real to show.
 */
interface Props { content: any; }
const { content } = Astro.props;
const t = content.testimonials || {};
const tag = t.tag || 'client_reviews';
const headline = t.headline || '';
// Never assert a review source (Google, etc.) the business may not have.
const source = t.source || '';
const bigQuote = t.bigQuote || '';
const bigWho = t.bigWho || '';
const small: Array<{ quote: string; who: string }> = Array.isArray(t.items) && t.items.length > 0 ? t.items : [];
const hasQuotes = Boolean(bigQuote) || small.length > 0;
---
{hasQuotes && (
<section class="sec testi-sec" id="reviews">
  <div class="wrap">
    <p class="sec-tag reveal" data-field="testimonials.tag">{tag}</p>
    {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
    <div class={`testi-grid${bigQuote ? '' : ' no-feature'}`}>
      {bigQuote && (
        <div class="tbig reveal">
          <p data-field="testimonials.bigQuote" set:html={bigQuote}></p>
          {bigWho && <div class="who" data-field="testimonials.bigWho">{bigWho}</div>}
        </div>
      )}
      <div class="tcol">
        {small.map((it: any, i: number) => (
          <div class="tsm reveal" style={i > 0 ? `transition-delay:.${i}s;` : ''}>
            <p data-field={`testimonials.items.${i}.quote`} set:html={it.quote}></p>
            <div class="who" data-field={`testimonials.items.${i}.who`}>{it.who}</div>
          </div>
        ))}
      </div>
    </div>
    {source && <p class="tsrc" data-field="testimonials.source">{source}</p>}
  </div>
</section>
)}
<style>
  .testi-sec { background: var(--bg-2); }
  .testi-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 22px; margin-top: 50px; }
  /* With no featured pull-quote the short quotes take the full width and
     tile, rather than hugging a narrow column beside empty space. */
  .testi-grid.no-feature { grid-template-columns: 1fr; }
  .testi-grid.no-feature .tcol { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .tbig { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 42px; display: flex; flex-direction: column; justify-content: center; }
  .tbig p { font-family: var(--disp); font-size: clamp(24px, 2.6vw, 34px); font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .tbig .who { margin-top: 22px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .tcol { display: flex; flex-direction: column; gap: 22px; }
  .tsm { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 28px; }
  .tsm p { font-size: 17px; line-height: 1.5; }
  .tsm .who { margin-top: 14px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .tsrc { margin-top: 28px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  @media (max-width: 820px) { .testi-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .testi-grid { margin-top: 34px; gap: 16px; }
    .tbig { padding: 28px; }
    .tbig p { font-size: clamp(21px, 6vw, 28px); }
    .tcol { gap: 16px; }
    .tsm { padding: 22px; }
  }
</style>
