---
/**
 * generic / TestimonialsB — two-column quote cards.
 *
 * Quotes, attributions and the source line are owner-supplied or absent —
 * never invented, and the section hides outright with no real quotes. An
 * empty band costs nothing; a fabricated one puts a stranger's endorsement
 * on a real business's live site.
 */
interface Props { content: any; }
const { content } = Astro.props;
const t = content.testimonials || {};
const tag = t.tag || 'In their words';
// "What students say" names a clientele (a school's) that most businesses
// using this template do not have. Owner data or nothing.
const headline = t.headline || '';
// Never assert a review source (Google, etc.) the business may not have.
const source = t.source || '';
const items = Array.isArray(t.items) && t.items.length ? t.items : [];
---
{items.length > 0 && (
<section class="sec testi-sec" id="reviews">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-tag reveal" data-field="testimonials.tag">{tag}</p>
      {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
    </div>
    <div class="tcards">
      {items.map((it: any, i: number) => (
        <div class="tcard reveal">
          <p data-field={`testimonials.items.${i}.quote`} set:html={it.quote}></p>
          <div class="who" data-field={`testimonials.items.${i}.who`}>{it.who || it.name || ''}</div>
        </div>
      ))}
    </div>
    {source && <p class="tsrc" data-field="testimonials.source">{source}</p>}
  </div>
</section>
)}
<style>
  .testi-sec { background: var(--card); }
  .tcards { columns: 2; column-gap: 28px; margin-top: 56px; }
  .tcard { break-inside: avoid; margin-bottom: 28px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 24px; padding: 32px 34px; }
  .tcard p { font-family: var(--serif); font-size: 26px; line-height: 1.32; }
  .tcard .who { margin-top: 16px; font-size: 13px; color: var(--ink-soft); }
  .tsrc { text-align: center; margin-top: 34px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); }
  @media (max-width: 760px) { .tcards { columns: 1; } }
  @media (max-width: 520px) {
    .tcards { margin-top: 40px; }
    .tcard { padding: 26px 24px; margin-bottom: 20px; }
    .tcard p { font-size: 22px; }
  }
</style>
