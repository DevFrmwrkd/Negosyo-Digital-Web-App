---
interface Props { layout: any; content: any; }
const { layout, content: _content } = Astro.props;
const brand = layout.businessName || 'Your Business';
const navLinks = (layout.navLinks && layout.navLinks.length) ? layout.navLinks : [];
const status = layout.statusLabel || 'systems operational';
const ctaText = layout.ctaText || 'Get support';
const ctaHref = layout.ctaHref || '#visit';
---
<header class="nav">
  <div class="wrap nav-in">
    <a href="#top" class="brand"><span class="mk"></span><span data-field="nav.brand">{brand}</span></a>
    <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-d-menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-collapse" id="nav-d-menu">
      <div class="nav-links">
        {navLinks.map((link: any, i: number) => (
          <a href={link.href} data-field={`nav.links.${i}.label`} data-href-field={`nav.links.${i}.href`}>{link.label}</a>
        ))}
      </div>
      <div class="nav-right">
        <span class="nav-status"><span class="d"></span><span data-field="nav.status">{status}</span></span>
        <a href={ctaHref} class="btn btn-primary" data-field="nav.cta.text" data-href-field="nav.cta.href">{ctaText}</a>
      </div>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-collapse');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping any link or the CTA.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav { position: sticky; top: 0; z-index: 1000; background: rgba(var(--bg-rgb), .82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 74px; }
  .brand { font-family: var(--disp); font-size: 23px; font-weight: 700; display: flex; align-items: center; gap: 10px; letter-spacing: -.02em; }
  .brand .mk { width: 16px; height: 16px; background: var(--lime); border-radius: 4px; transform: rotate(45deg); flex: none; }
  /* On desktop the collapse wrapper is transparent to layout so brand |
     nav-links | nav-right stay exactly as before. */
  .nav-collapse { display: contents; }
  .nav-links { display: flex; gap: 26px; font-family: var(--mono); font-size: 13px; }
  .nav-links a { position: relative; color: var(--muted); padding: 4px 0; }
  .nav-links a::after { content: ""; position: absolute; left: 0; bottom: 0; height: 1.5px; width: 0; background: var(--lime); transition: .25s; }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a:hover::after { width: 100%; }
  .nav-right { display: flex; align-items: center; gap: 16px; }
  .nav-status { font-family: var(--mono); font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 7px; }
  .nav-status .d { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 0 rgba(var(--accent-rgb), .6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), .5); } 70% { box-shadow: 0 0 0 8px rgba(var(--accent-rgb), 0); } 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0); } }

  /* Hamburger trigger — hidden until phone / small-tablet widths. */
  .nav-burger { display: none; }

  /* Tablet zone (761–980px): the desktop nav stays, but drop the decorative
     status pill so links + CTA never crowd/overflow the bar before the
     hamburger takes over at 760. Original hid links here too; keeping links
     visible is the mobile-first improvement. */
  @media (max-width: 980px) { .nav-status { display: none; } }

  @media (max-width: 760px) {
    .nav-in { height: 64px; }
    /* 44px tap target with three lime-on-ink bars matching the mark. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -10px;
      background: transparent; border: 0; cursor: pointer;
    }
    .nav-burger span {
      display: block; width: 24px; height: 2px; background: var(--ink);
      border-radius: 2px; transition: transform .3s ease, opacity .3s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* nav-links + nav-right collapse into one full-width dark drawer,
       in the design's own bg/line/lime tokens. */
    .nav-collapse {
      display: block; position: absolute; left: 0; right: 0; top: 100%;
      background: rgba(var(--bg-rgb), .97); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 44px -22px rgba(0, 0, 0, .85);
      max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-collapse { max-height: calc(100vh - 64px); overflow-y: auto; opacity: 1; visibility: visible; }
    .nav-links { flex-direction: column; align-items: stretch; gap: 0; font-size: 15px; padding: 6px 0; }
    .nav-links a { display: flex; align-items: center; min-height: 48px; padding: 6px 24px; color: var(--ink); border-bottom: 1px solid var(--line); }
    .nav-links a::after { display: none !important; }
    .nav-right { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px 24px 22px; }
    /* Status pill returns inside the open drawer (hidden on the bar since 980). */
    .nav-status { display: flex; justify-content: center; font-size: 12px; }
    .nav-right .btn { width: 100%; justify-content: center; min-height: 48px; }
  }
</style>
