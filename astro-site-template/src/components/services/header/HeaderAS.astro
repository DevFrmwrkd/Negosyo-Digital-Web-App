---
/**
 * services / HeaderAS — sticky bone-card nav with a blue square "mark" beside
 * the Courier brand, dot-matrix uppercase links, and an outlined "book" CTA.
 * Hides on scroll-down / reappears on scroll-up (toggled by PageAS's inline
 * scroll handler via header.nav.hide). Mirrors the lp-07 receipt header.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAS actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAS.
const PAGE_ANCHORS = new Set(['about', 'book', 'faq', 'gallery', 'how', 'location', 'main', 'reviews', 'services']);
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = (content as any).footer?.brand || layout.businessName || '';
// The mark chip is derived from the real name, never from a stand-in initial:
// an 'L' belongs to somebody else's business. Empty brand => the whole tile hides.
const mark = String(brand).trim().charAt(0).toUpperCase();
// Nav links come from the same derived list ('#about', '#services', '#why',
// '#work', '#visit'). Resolve each against this page and drop the ones with no
// section to reach — a nav entry that scrolls nowhere is as broken as a dead
// CTA, and its label promises a section this design does not have. The original
// index rides along as .i so the editor's per-link field hooks stay correct.
const navLinks: Array<{ href: string; label: string; i: number }> =
  ((layout.navLinks && layout.navLinks.length) ? layout.navLinks : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href);
// Reuse the hero's primary CTA as the nav "book" action so it stays in sync.
const hero = (content as any).hero || {};
const ctaText = hero.cta1?.text || '';
const ctaHref = onPage(hero.cta1?.href, '#book');
---
<header class="nav">
  <div class="nav-in">
    {brand && <a href="#main" class="brand" aria-label={`${brand} home`}><span class="mk" aria-hidden="true">{mark}</span><span class="bn" data-field="footer.brand">{brand}</span></a>}
    {(navLinks.length > 0 || ctaText) && (
      <Fragment>
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-primary-AS">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
        <nav class="nav-links" id="nav-primary-AS" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
          ))}
          {ctaText && <a href={ctaHref} class="navc" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{ctaText}</a>}
        </nav>
      </Fragment>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var btn = hdr.querySelector('.nav-burger');
    if (!btn) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Tapping any link (or the CTA) closes the drawer.
    hdr.querySelectorAll('.nav-links a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav { position: sticky; top: 0; z-index: 60; background: var(--card); border-bottom: 2px dashed var(--line); transition: transform .3s; }
  header.nav.hide { transform: translateY(-100%); }
  header.nav.open { transform: none; }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; max-width: var(--maxw); margin: 0 auto; }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand .mk { width: 30px; height: 30px; background: var(--blue); color: var(--card); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-weight: 700; border-radius: 6px; flex-shrink: 0; }
  .brand .bn { font-family: var(--mono); font-weight: 700; font-size: 22px; letter-spacing: -.01em; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-family: var(--mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink2); }
  .nav-links a:hover { color: var(--blue-d); }
  .nav-links .navc { border: 2px solid var(--ink); padding: 8px 16px; color: var(--ink); }
  .nav-links .navc:hover { background: var(--blue); border-color: var(--blue); color: var(--card); }

  /* Hamburger — desktop-hidden, revealed <=760px as the design's ink-bordered
     ghost square whose Courier-ink bars fold into an × when the drawer opens. */
  .nav-burger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 46px; height: 44px; padding: 11px 10px; box-sizing: border-box; margin-left: 12px; flex-shrink: 0;
    background: transparent; border: 2px solid var(--ink); border-radius: 6px; cursor: pointer;
  }
  .nav-burger span { display: block; width: 100%; height: 2px; background: var(--ink); transition: transform .25s ease, opacity .2s ease; }
  header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
  header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) { .nav-burger span { transition: none; } }

  /* Tablet: the inline text links overflow the bar, so hide them; brand + CTA stay. */
  @media (max-width: 880px) { .nav-links a:not(.navc) { display: none; } }

  /* Phone: brand + burger stay in the bar; the link list (incl. CTA) drops to a
     full-width drawer below the header, painted in the design's bone-card tokens. */
  @media (max-width: 760px) {
    .nav-in { padding: 13px 20px; }
    .brand .bn { font-size: 20px; }
    .nav-burger { display: flex; }
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      display: none; flex-direction: column; align-items: stretch; gap: 0;
      background: var(--card); border-top: 2px dashed var(--line); border-bottom: 2px solid var(--ink);
      box-shadow: 0 12px 24px rgba(33, 31, 24, .14); padding: 6px 0 12px; max-height: 78vh; overflow-y: auto;
    }
    header.nav.open .nav-links { display: flex; }
    .nav-links a:not(.navc) {
      display: flex; align-items: center; min-height: 44px;
      padding: 12px 20px; font-size: 15px; color: var(--ink2); border-bottom: 1px dotted var(--line);
    }
    .nav-links a:not(.navc):hover { background: var(--paper2); color: var(--blue-d); }
    .nav-links .navc {
      display: flex; align-items: center; justify-content: center;
      margin: 12px 20px 2px; min-height: 48px; padding: 12px 16px;
      background: var(--blue); border-color: var(--blue); color: var(--card);
    }
    .nav-links .navc:hover { background: var(--blue-d); border-color: var(--blue-d); color: var(--card); }
  }
</style>
