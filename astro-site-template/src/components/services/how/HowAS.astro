---
/**
 * services / HowAS — "how it works" steps on the card band. A bordered four-up
 * grid of .step cells, each with an oversized blue Courier numeral (decorative),
 * a mono title and a muted body line. Reads content.how.steps (canonical `body`,
 * legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const headline = how.headline || '';
const tag = how.tag || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="sec how" id="how">
    <div class="wrap">
      <div class="sec-head">
        <span class="snum" aria-hidden="true">SEC 04</span>
        {headline && <h2 class="reveal" data-field="how.headline" set:html={headline}></h2>}
        {tag && <span class="lbl" style="margin-left:auto;" data-field="how.tag">{tag}</span>}
      </div>
      <div class="steps">
        {steps.map((step, i) => (
          <div class="step reveal" data-delay={String(Math.min(i, 3))}>
            <div class="sn" aria-hidden="true">{i + 1}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .how { background: var(--card); }
  .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; border: 2px solid var(--ink); }
  @media (max-width: 820px) { .steps { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
  .step { padding: 28px 22px; border-right: 2px dashed var(--line); }
  .step:last-child { border-right: none; }
  @media (max-width: 820px) { .step:nth-child(2n) { border-right: none; } }
  @media (max-width: 480px) { .step { border-right: none; } }
  .step .sn { font-family: var(--mono); font-weight: 700; font-size: 40px; color: var(--blue); }
  .step h3 { font-family: var(--mono); font-size: 18px; margin: 8px 0 6px; color: var(--ink); }
  .step p { font-size: 14px; color: var(--muted); font-family: var(--sans); }
</style>
