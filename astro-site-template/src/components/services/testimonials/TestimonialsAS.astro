---
/**
 * services / TestimonialsAS — "customer receipts": a three-up grid of bordered
 * .quote cards, each opened by a gold star row (decorative), the quote in
 * Courier, and an uppercase attribution line. Reads content.testimonials.items
 * (canonical `who` + `role`, legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const headline = test.headline || '';
const tag = test.tag || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string; rating?: number | string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
// A star row is a rating claim, not decoration — it puts a score in a named
// customer's mouth. Render only the score the customer actually gave.
const starsOf = (it: Item) => {
  const n = Math.round(Number(it.rating));
  return n >= 1 && n <= 5 ? '★'.repeat(n) : '';
};
---
{items.length > 0 && (
  <section class="sec" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        <span class="snum" aria-hidden="true">SEC 05</span>
        {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
        {tag && <span class="lbl" style="margin-left:auto;" data-field="testimonials.tag">{tag}</span>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          const stars = starsOf(item);
          return (
            <figure class="quote reveal" data-delay={String(i % 3)}>
              {stars && <div class="stars" aria-hidden="true">{stars}</div>}
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<div class="wrap"><div class="perf"></div></div>
<style>
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  .quote { background: var(--card); border: 2px solid var(--ink); padding: 26px 24px; }
  .quote .stars { font-size: 15px; color: #e0a92e; letter-spacing: 2px; }
  .quote p { font-family: var(--mono); font-size: 16px; line-height: 1.5; color: var(--ink); margin: 12px 0; }
  .quote .who { font-family: var(--mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .quotes-grid { grid-template-columns: 1fr; gap: 16px; } .quote { padding: 22px 20px; } }
</style>
