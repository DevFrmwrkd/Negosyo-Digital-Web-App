---
/**
 * services / CredentialsAS — "registered & careful" permits row on the paper
 * band: a set of bordered .cred tiles, each with a blue-ringed badge
 * (decorative), a mono label and a muted note. Reads content.credentials.items
 * (title / desc); tag + headline render above when set. Carries the perforated
 * seam that closes the FAQ / service-area group above it.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
const badges = ['✓', '✓', '♻', '✚'];
---
{items.length > 0 && (
  <>
    <div class="wrap"><div class="perf"></div></div>
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="snum" aria-hidden="true">SEC 08</span>
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
          {tag && <span class="lbl" style="margin-left:auto;" data-field="credentials.tag">{tag}</span>}
        </div>
        <div class="cred-row">
          {items.map((item, i) => (
            <div class="cred reveal" data-delay={String(i % 4)}>
              <div class="bdg" aria-hidden="true">{badges[i % badges.length]}</div>
              <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
              {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  </>
)}
<style>
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { background: var(--card); border: 2px solid var(--ink); padding: 26px 22px; }
  .cred .bdg { width: 36px; height: 36px; border: 2px solid var(--blue); color: var(--blue); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-weight: 700; margin-bottom: 14px; border-radius: 6px; }
  .cred h4 { font-family: var(--mono); font-size: 15px; margin-bottom: 6px; color: var(--ink); }
  .cred p { font-size: 14px; color: var(--muted); margin: 0; font-family: var(--sans); }
</style>
