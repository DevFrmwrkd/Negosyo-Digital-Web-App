---
/**
 * services / CtaBandAS — full-width dark-ink closer, centred: "book a pickup".
 * Ink ground with a pale-blue mono eyebrow, an oversized Courier headline and up
 * to three CTAs (blue fill + two paper ghosts, recoloured for the dark band).
 * cta3 is the optional third action. The section anchors #book for the hero /
 * nav CTA.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#location';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="sec cta-band" id="book">
    <div class="wrap">
      {tag && <div class="lbl" data-field="ctaBand.tag">{tag}</div>}
      {headline && <h2 class="cta-h" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { background: var(--ink); color: var(--paper); text-align: center; }
  .cta-band .lbl { color: #9ec3ef; }
  .cta-h { font-family: var(--mono); font-size: clamp(32px,5.4vw,64px); color: var(--paper); margin: .18em 0 16px; }
  .cta-sub { color: var(--paper); opacity: .85; max-width: 52ch; margin: 0 auto 22px; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .cta-band .btn--fill { background: var(--blue); border-color: var(--blue); }
  .cta-band .btn--fill:hover { background: var(--blue-d); border-color: var(--blue-d); }
  .cta-band .btn--ghost { border-color: var(--paper); color: var(--paper); }
  .cta-band .btn--ghost:hover { background: var(--paper); color: var(--ink); }
</style>
