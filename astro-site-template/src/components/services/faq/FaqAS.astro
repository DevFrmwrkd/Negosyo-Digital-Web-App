---
/**
 * services / FaqAS — "questions" accordion on the card band, laid across two
 * columns. Courier summaries with a blue "+" that rotates to "×" on open; muted
 * answer copy. The first item opens by default (lp-07's designed state).
 * Reads content.faq.items (q / a). The lp-07 service-area block that lived in
 * this section's second column is lifted out into AreaAS (per the AM model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const mid = Math.ceil(items.length / 2);
const col1 = items.slice(0, mid);
const col2 = items.slice(mid);
---
{items.length > 0 && (
  <section class="sec faq" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <span class="snum" aria-hidden="true">SEC 07</span>
        {headline && <h2 class="reveal" data-field="faq.headline" set:html={headline}></h2>}
        {tag && <span class="lbl" style="margin-left:auto;" data-field="faq.tag">{tag}</span>}
      </div>
      <div class="faq-grid">
        <div>
          {col1.map((item, i) => (
            <details class="reveal" open={i === 0}>
              <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
        <div>
          {col2.map((item, j) => (
            <details class="reveal">
              <summary><span data-field={`faq.items.${mid + j}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${mid + j}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
<style>
  .faq { background: var(--card); }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: 4px; } }
  details { border-bottom: 2px dashed var(--line); }
  summary { list-style: none; cursor: pointer; padding: 18px 0; font-family: var(--mono); font-weight: 700; font-size: 17px; color: var(--ink); display: flex; justify-content: space-between; gap: 14px; }
  summary::-webkit-details-marker { display: none; }
  summary .pm { color: var(--blue); font-size: 20px; transition: transform .3s; }
  details[open] summary .pm { transform: rotate(45deg); }
  details .a { padding: 0 0 18px; color: var(--muted); font-size: 15px; max-width: 60ch; font-family: var(--sans); }
</style>
