---
/**
 * services / AboutAS — "the shop" split: dot-matrix copy left (the first
 * paragraph carries the mono emphasis), an art-directed .plate figure right.
 * The figure keeps its scene-shop duotone as the designed fallback until
 * about.image is set. about.tag rides on the plate's blue ticket tag;
 * about.imageCaption, about.quote and about.signature are optional extras that
 * stay hidden when unset (mirrors the AM content model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="sec" id="about">
  <div class="wrap">
    <div class="sec-head">
      <span class="snum" aria-hidden="true">SEC 01</span>
      {headline && <h2 class="reveal" data-field="about.headline" set:html={headline}></h2>}
    </div>
    <div class="about-grid">
      <div class="about-copy reveal">
        {paragraphs.map((p: string, i: number) => (
          <p data-field={`about.paragraphs.${i}`} set:html={p}></p>
        ))}
        {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
        {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
      </div>
      <figure class="about-fig plate reveal" data-delay="1">
        <div class="ph scene-shop" role="img" data-image-field="about.image" style={image ? `background-image:url('${image}');background-size:cover;background-position:center;` : ''}></div>
        {tag && <span class="tk" data-field="about.tag">{tag}</span>}
        {imageCaption && <figcaption class="cap" data-field="about.imageCaption">{imageCaption}</figcaption>}
      </figure>
    </div>
  </div>
</section>
<div class="wrap"><div class="perf"></div></div>
<style>
  .about-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 52px; align-items: center; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; gap: 26px; } .about-copy p:first-of-type { font-size: 18px; } }
  .about-copy p:first-of-type { font-family: var(--mono); font-size: 20px; line-height: 1.5; color: var(--ink); }
  .about-copy p { color: var(--ink2); }
  .about-quote { font-family: var(--mono); font-size: clamp(18px,2.2vw,24px); line-height: 1.3; color: var(--blue-d); margin: 24px 0 0; padding-left: 16px; border-left: 3px solid var(--blue); }
  .about-sign { margin-top: 16px; font-style: italic; color: var(--muted); }
  .about-fig { aspect-ratio: 5/4; }
</style>
