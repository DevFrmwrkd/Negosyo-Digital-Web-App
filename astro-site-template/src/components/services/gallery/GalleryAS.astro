---
/**
 * services / GalleryAS — "inside the shop" mosaic on the paper band. Tiles are
 * art-directed .plate frames (a cycling scene-* duotone stands in as the
 * designed fallback; a photo layers over it via data-image-field when set),
 * arranged in lp-07's ticket mosaic where the first tile spans 2×2. The section
 * auto-hides only when there are no items at all.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-fold', 'scene-drum', 'scene-press', 'scene-shelf', 'scene-rider', 'scene-shop'];
const spanFor = (i: number) => (i % 6 === 0 ? 'l1' : i % 6 === 3 ? 'l4' : i % 6 === 5 ? 'l6' : '');
---
{items.length > 0 && (
  <section class="sec" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        <span class="snum" aria-hidden="true">SEC 06</span>
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
        {tag && <span class="lbl" style="margin-left:auto;" data-field="gallery.tag">{tag}</span>}
      </div>
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            <span class="tk" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gal-sub { max-width: 52ch; color: var(--muted); margin: -28px 0 28px; font-size: 16px; }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 170px; gap: 12px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate .ph { transition: transform .5s; }
  .g-grid .plate:hover .ph { transform: scale(1.05); }
  .l1 { grid-column: span 2; grid-row: span 2; }
  .l4 { grid-column: span 2; }
  .l6 { grid-column: span 2; }
</style>
