---
/**
 * medical / ServicesAQ — lp-05 "Clear Water" SERVICES grid on the soft mint
 * ground. A sec-head (eyebrow, headline, calm subtitle) over a three-up grid of
 * white .svc cards, each with a rounded mint icon tile (decorative, cycled from
 * the design set), a title and a short description. Reads content.services.items
 * (title / desc); the section auto-hides when there are no items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
const icons = [
  '<svg viewBox="0 0 24 24"><path d="M12 3c2 0 3 1.4 4.5 1.4S19 3.6 20 5c1.2 1.8.4 5-1 9-1 2.8-2 5-3.4 5-1.2 0-1.3-2-3.6-2s-2.4 2-3.6 2C7 19 6 16.8 5 14 3.6 10 2.8 6.8 4 5c1-1.4 2-1 3.5-.6S10 3 12 3z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 4l2 4 4 .5-3 3 .8 4.2L12 17l-3.8 2.7L9 15.5l-3-3 4-.5z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M4 8h16M7 8v9M17 8v9M4 17h16"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6l7-3z"/></svg>',
  '<svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="4"/><circle cx="16" cy="15" r="4"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 2v6M5 8l3 3M19 8l-3 3M4 20a8 8 0 0116 0z"/></svg>',
];
---
{items.length > 0 && (
  <section class="sec services" id="services">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="services.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="services.headline" set:html={headline}></h2>}
        {sub && <p class="reveal" data-field="services.sub">{sub}</p>}
      </div>
      <div class="svc-grid">
        {items.map((item, i) => (
          <article class="svc reveal">
            <div class="ic" aria-hidden="true" set:html={icons[i % icons.length]}></div>
            <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
            {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .services { background: var(--mint-2); }
  .svc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 760px) { .svc-grid { grid-template-columns: 1fr; } }
  .svc { background: #fff; border-radius: 20px; padding: 32px 28px; border: 1px solid var(--line); transition: transform .35s, box-shadow .35s; }
  .svc:hover { transform: translateY(-6px); box-shadow: 0 24px 44px -26px rgba(10,52,48,.4); }
  .svc .ic { width: 52px; height: 52px; border-radius: 14px; background: var(--mint); display: flex; align-items: center; justify-content: center; color: var(--teal); margin-bottom: 18px; }
  .svc .ic svg { width: 26px; height: 26px; stroke: currentColor; fill: none; stroke-width: 1.7; }
  .svc h3 { font-size: 22px; margin-bottom: 8px; color: var(--ink); font-weight: 600; letter-spacing: -.01em; }
  .svc p { color: var(--muted); font-size: 15px; margin: 0; }
</style>
