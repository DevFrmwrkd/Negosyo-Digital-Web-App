---
/**
 * medical / HeaderAQ — sticky near-white nav bar (lp-05 "Clear Water" NAV): a
 * rounded teal monogram beside the serif-weight brand, quiet ink links, and a
 * filled teal "book a visit" pill that reuses the hero's primary CTA so it stays
 * in sync. Stays put on scroll (the design's nav does not hide).
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const monogram = (brand || 'B').trim().charAt(0).toUpperCase();
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
// Reuse the hero's primary CTA as the nav "book" action so it stays in sync.
const hero = (content as any).hero || {};
const ctaText = hero.cta1?.text || '';
const ctaHref = hero.cta1?.href || '#book';
---
<header class="nav">
  <div class="nav-in">
    <a href="#main" class="brand" aria-label={`${brand} home`} data-field="footer.brand"><span class="mk" aria-hidden="true">{monogram}</span><span class="bn">{brand}</span></a>
    {(navLinks.length > 0 || ctaText) && (
      <nav id="aq-nav" class="nav-links" aria-label="Primary">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
        {ctaText && <a href={ctaHref} class="navbook" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{ctaText}</a>}
      </nav>
    )}
    {(navLinks.length > 0 || ctaText) && (
      <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="aq-nav">
        <span></span><span></span><span></span>
      </button>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('header.nav');
    if (!header) return;
    var burger = header.querySelector('.nav-burger');
    var drawer = header.querySelector('.nav-links');
    if (!burger || !drawer) return;
    function setOpen(open) {
      header.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!header.classList.contains('open'));
    });
    // Close the drawer after a link is tapped.
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && header.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });
  })();
</script>
<style>
  header.nav {
    position: sticky; top: 0; z-index: 60; background: rgba(251,253,252,.86);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); transition: padding .3s;
  }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding: 16px 30px; max-width: var(--maxw); margin: 0 auto; }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); flex: none; }
  .brand:hover { color: var(--ink); }
  .brand .mk {
    width: 30px; height: 30px; border-radius: 9px; background: var(--teal); display: flex;
    align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 16px; flex: none;
  }
  .brand .bn { font-size: 22px; font-weight: 600; letter-spacing: -.01em; white-space: nowrap; }
  .nav-links { display: flex; gap: 28px; align-items: center; }
  .nav-links a { font-size: 15px; color: var(--ink2); font-weight: 500; }
  .nav-links a:hover { color: var(--teal); }
  .nav-links .navbook { background: var(--teal); color: #fff; padding: 10px 20px; border-radius: 100px; font-weight: 600; font-size: 14px; }
  .nav-links .navbook:hover { background: var(--teal-d); color: #fff; }

  /* Hamburger button — hidden on desktop, revealed on mobile/tablet. */
  .nav-burger {
    display: none; width: 44px; height: 44px; flex: none; padding: 0; margin: -4px -6px -4px 0;
    border: 0; background: transparent; cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
  }
  .nav-burger span { display: block; width: 24px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform .3s, opacity .3s; }
  header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
  header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) { .nav-burger span { transition: none; } }

  /* Mobile: the primary nav becomes a full-width drawer under the bar, painted
     with the design's own paper + line tokens so it matches "Clear Water". */
  @media (max-width: 880px) {
    .nav-burger { display: inline-flex; }
    /* Let a long brand name shrink/ellipsis so the burger stays on-screen. */
    .brand { flex: 1 1 auto; min-width: 0; }
    .brand .bn { overflow: hidden; text-overflow: ellipsis; }
    .nav-links {
      position: absolute; top: 100%; left: 0; right: 0;
      display: none; flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--line);
      box-shadow: 0 26px 44px -26px rgba(10,52,48,.5);
      padding: 6px 20px 16px;
    }
    header.nav.open .nav-links { display: flex; }
    .nav-links a {
      font-size: 17px; color: var(--ink); font-weight: 500;
      min-height: 44px; display: flex; align-items: center;
      padding: 12px 4px; border-bottom: 1px solid var(--line);
    }
    .nav-links a:hover { color: var(--teal); }
    .nav-links .navbook {
      justify-content: center; margin-top: 14px; padding: 15px 22px;
      font-size: 15px; border-bottom: 0; min-height: 48px;
    }
  }
</style>
