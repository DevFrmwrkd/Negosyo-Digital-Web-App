---
/**
 * medical / WhyAH — split grid: a quiet Cormorant headline left, a definition
 * list of reasons right (bold term + muted description). Reads content.why.items
 * (canonical `body`, legacy `desc`). The optional eyebrow renders when provided;
 * the design ships headline-only.
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <p class="eyebrow" data-field="why.tag">{tag}</p>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <dl class="why-list reveal">
        {items.map((item, i) => (
          <div class="why-item">
            <dt data-field={`why.items.${i}.title`}>{item.title}</dt>
            {(item.body ?? item.desc ?? item.description) && (
              <dd data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</dd>
            )}
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
<style>
  .why-h { font-size: clamp(34px, 5vw, 54px); color: var(--ink); }
  .why-head .eyebrow { margin-bottom: 14px; }
  .why-list { display: grid; gap: 24px; }
  .why-item dt { font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .why-item dd { color: var(--muted); }
</style>
