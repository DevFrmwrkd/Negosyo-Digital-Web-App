---
/**
 * medical / WhyAQ — lp-05 "Clear Water" WHY block on the paper ground: a
 * sec-head over a three-up grid of .why-cell tiles, each led by a teal top-rule,
 * a title and a calm body line. Reads content.why.items (canonical `body`,
 * legacy `desc`); auto-hides when there are no items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="sec why">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-grid">
        {items.map((item, i) => (
          <div class="why-cell reveal">
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 44px; }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; gap: 30px; } }
  .why-cell { border-top: 2px solid var(--teal); padding-top: 22px; }
  .why-cell h3 { font-size: 23px; color: var(--ink); margin-bottom: 10px; font-weight: 600; }
  .why-cell p { color: var(--muted); font-size: 16px; }
</style>
