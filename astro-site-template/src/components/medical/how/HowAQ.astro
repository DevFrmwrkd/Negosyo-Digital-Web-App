---
/**
 * medical / HowAQ — lp-05 "Clear Water" HOW block on the teal band: a calm
 * numbered progress track (a hairline connector links the step dots) with a
 * light sec-head. Each .how-step carries a light circular numeral (decorative),
 * a title and a short body line. Reads content.how.steps (canonical `body`,
 * legacy `desc`); auto-hides when there are no steps.
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="sec how">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="how.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="how.headline" set:html={headline}></h2>}
      </div>
      <div class="how-track">
        {steps.map((step, i) => (
          <div class="how-step reveal">
            <div class="dot" aria-hidden="true">{i + 1}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .how { background: var(--teal); color: #eafaf5; }
  .how .sec-head h2, .how .sec-head p { color: #eafaf5; }
  .how .sec-head .eyebrow { color: #a9e0d5; }
  .how-track { position: relative; display: grid; grid-template-columns: repeat(4,1fr); gap: 28px; }
  @media (max-width: 820px) { .how-track { grid-template-columns: 1fr; gap: 26px; } }
  .how-track::before { content: ""; position: absolute; top: 22px; left: 6%; right: 6%; height: 2px; background: rgba(234,250,245,.25); }
  @media (max-width: 820px) { .how-track::before { display: none; } }
  .how-step { position: relative; }
  .how-step .dot { width: 46px; height: 46px; border-radius: 50%; background: #eafaf5; color: var(--teal-d); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; position: relative; z-index: 2; }
  .how-step h3 { color: #fff; font-size: 20px; margin: 20px 0 8px; font-weight: 600; }
  .how-step p { color: #cdeee6; font-size: 15px; }
</style>
