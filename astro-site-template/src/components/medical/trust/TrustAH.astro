---
/**
 * medical / TrustAH — thin credibility strip framed top and bottom by hairline
 * rules (the design's editorial trust bar). Renders content.trust.cells as a
 * flowing row of statements (num = the statement, label = optional aside).
 *
 * Volatile Google rating / today's-hours slots have no field in the data model,
 * so they are expressed as ordinary trust cells (num + label) like the reference.
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust-sect">
    <div class="wrap">
      <hr class="rule" />
      <div class="trust-bar">
        {cells.map((cell, i) => (
          <div class="trust-cell reveal">
            {cell.num && <span class="num" data-field={`trust.cells.${i}.num`} set:html={cell.num}></span>}
            {cell.label && <span class="lbl" data-field={`trust.cells.${i}.label`}> {cell.label}</span>}
          </div>
        ))}
      </div>
      <hr class="rule" />
    </div>
  </section>
)}
<style>
  .trust-sect { padding: 0 0 20px; }
  .trust-bar {
    display: flex; flex-wrap: wrap; gap: 12px 28px;
    justify-content: space-between; align-items: baseline;
    padding: 22px 0; font-size: 14px; color: var(--muted);
  }
  .trust-cell .num { color: var(--ink); font-weight: 600; }
  .trust-cell .lbl { color: var(--muted); }
</style>
