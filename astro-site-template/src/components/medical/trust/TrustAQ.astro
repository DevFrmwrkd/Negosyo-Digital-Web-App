---
/**
 * medical / TrustAQ — lp-05 "Clear Water" TRUST band on the soft mint ground: a
 * row of four cells, each a large teal stat/word over a muted caption. The
 * Google-served rating slot is an ordinary cell whose `num` renders via set:html
 * so a star string ("★★★★★") still styles as the design intends.
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust">
    <div class="wrap">
      {cells.map((cell, i) => (
        <div class="c reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust { background: var(--mint-2); padding: 72px 0; }
  .trust .wrap { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; }
  @media (max-width: 760px) { .trust .wrap { grid-template-columns: repeat(2,1fr); gap: 32px 24px; } }
  .c { text-align: left; }
  .c .n { font-size: clamp(34px,4vw,50px); color: var(--teal); font-weight: 400; letter-spacing: -.03em; line-height: 1; }
  .c .t { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .c :global(.stars) { color: var(--gold); letter-spacing: 2px; font-size: 22px; }
</style>
