---
/**
 * medical / AboutAQ — lp-05 "Clear Water" ABOUT split: calm copy left (eyebrow,
 * an optional headline, a lead serif paragraph then body paragraphs), an
 * art-directed .plate figure right that keeps its scene-room gradient as the
 * designed fallback until about.image is set.
 *
 * about.headline, about.imageCaption, about.quote and about.signature are
 * optional extras that stay hidden when unset (mirrors the AM content model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="sec about" id="about">
  <div class="wrap about-grid">
    <div class="about-copy reveal">
      {tag && <span class="eyebrow" data-field="about.tag">{tag}</span>}
      {headline && <h2 class="about-h" data-field="about.headline" set:html={headline}></h2>}
      {paragraphs.map((p: string, i: number) => (
        <p data-field={`about.paragraphs.${i}`} set:html={p}></p>
      ))}
      {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
      {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
    </div>
    <figure class="about-fig plate reveal">
      <div class="ph scene-room" data-image-field="about.image" style={image ? `background-image:url('${image}');background-size:cover;background-position:center;` : ''}></div>
      {imageCaption && <figcaption class="cap" data-field="about.imageCaption">{imageCaption}</figcaption>}
    </figure>
  </div>
</section>
<style>
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 36px; } }
  .about-copy .eyebrow { display: block; margin-bottom: 16px; }
  .about-h { font-size: clamp(28px,3.6vw,44px); color: var(--ink); margin: 0 0 20px; }
  .about-copy p:first-of-type { font-family: var(--serif); font-size: 25px; line-height: 1.45; color: var(--ink); }
  .about-copy p { color: var(--ink2); }
  .about-quote { font-family: var(--serif); font-size: clamp(20px,2.2vw,26px); line-height: 1.3; color: var(--teal-d); margin: 24px 0 0; padding-left: 18px; border-left: 3px solid var(--teal); }
  .about-sign { margin-top: 18px; font-style: italic; color: var(--muted); }
  .about-fig { aspect-ratio: 5/4; }
</style>
