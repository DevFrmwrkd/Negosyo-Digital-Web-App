---
/**
 * medical / AboutAH — split editorial grid: copy left, an art-directed seafoam
 * plate (founding-dentist portrait) right. The plate keeps its seafoam gradient
 * as the designed fallback when no photo is set.
 *
 * about.imageCaption is an optional extra field (the design's "The studio's
 * founding dentist" plate caption). about.quote / about.signature render only
 * when provided.
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="about-sect">
  <div class="wrap grid2">
    <div class="about-copy reveal">
      {tag && <p class="eyebrow" data-field="about.tag">{tag}</p>}
      {headline && <h2 class="about-h" data-field="about.headline" set:html={headline}></h2>}
      {paragraphs.map((p: string, i: number) => (
        <p class="about-p" data-field={`about.paragraphs.${i}`} set:html={p}></p>
      ))}
      {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
      {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
    </div>
    <figure class="plate about-plate reveal">
      {image && <div class="photo" data-image-field="about.image" style={`background-image:url('${image}');`}></div>}
      {imageCaption && <figcaption data-field="about.imageCaption">{imageCaption}</figcaption>}
    </figure>
  </div>
</section>
<style>
  .about-h { font-size: clamp(34px, 5vw, 54px); margin: 16px 0 22px; color: var(--ink); }
  .about-p { margin-bottom: 16px; color: var(--muted); }
  .about-p:first-of-type { color: var(--ink); }
  .about-quote {
    font-family: var(--display); font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.25; color: var(--seafoam-deep); margin: 24px 0 0;
    padding-left: 18px; border-left: 2px solid var(--seafoam);
  }
  .about-sign { margin-top: 16px; font-style: italic; color: var(--muted); }
  .about-plate { min-height: 440px; }
  @media (max-width: 799px) { .about-plate { min-height: 320px; } }
</style>
