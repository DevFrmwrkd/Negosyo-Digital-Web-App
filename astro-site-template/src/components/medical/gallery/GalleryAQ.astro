---
/**
 * medical / GalleryAQ — lp-05 "Clear Water" "a look around" mosaic on the soft
 * mint ground. Tiles are art-directed .plate frames (a cycling .scene-* gradient
 * stands in as the designed fallback; a photo layers over it via
 * data-image-field when set) in lp-05's mosaic where the first tile spans 2×2
 * and two others span 2 wide. Reads content.gallery.items (image / caption);
 * auto-hides when there are no items.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-reception', 'scene-chair', 'scene-tools', 'scene-kid', 'scene-smile', 'scene-exterior'];
const spanFor = (i: number) => (i % 6 === 0 ? 'm1' : i % 6 === 3 ? 'm4' : i % 6 === 5 ? 'm6' : '');
---
{items.length > 0 && (
  <section class="sec gallery" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="eyebrow" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
        {sub && <p class="reveal" data-field="gallery.sub">{sub}</p>}
      </div>
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            <span class="chip">{String(i + 1).padStart(2, '0')}</span>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { background: var(--mint-2); }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 190px; gap: 16px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate .ph { transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  .g-grid .plate:hover .ph { transform: scale(1.06); }
  .m1 { grid-column: span 2; grid-row: span 2; }
  .m4 { grid-column: span 2; }
  .m6 { grid-column: span 2; }
</style>
