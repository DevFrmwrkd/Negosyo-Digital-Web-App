---
/**
 * medical / CredentialsAH — thin hairline-topped permits/registration row,
 * dot-separated muted labels (the design ships a bare row of memberships and
 * compliance notes). Optional tag / headline render above when provided; each
 * item's `desc` renders small beside its title when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <p class="eyebrow" data-field="credentials.tag">{tag}</p>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <>
            {i > 0 && <span class="cred-sep" aria-hidden="true">·</span>}
            <span class="cred-item">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}> — {item.desc}</span>}
            </span>
          </>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 30px 0; border-top: 1px solid var(--rule); }
  .cred-head { margin-bottom: 18px; }
  .cred-h { font-size: clamp(28px, 4vw, 44px); color: var(--ink); margin-top: 10px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: baseline; font-size: 14px; color: var(--muted); }
  .cred-sep { color: var(--rule); }
  .cred-desc { opacity: .78; font-size: 12.5px; }
</style>
