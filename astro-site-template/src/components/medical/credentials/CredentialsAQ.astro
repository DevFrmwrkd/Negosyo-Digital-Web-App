---
/**
 * medical / CredentialsAQ — lp-05 "Clear Water" CREDENTIALS row on the warm sand
 * band: a sec-head over a four-up row of white .cred tiles, each with a rounded
 * mint badge (decorative, cycled from the design set), an uppercase-weight label
 * and a short note. Reads content.credentials.items (title / desc); tag +
 * headline render above when set. Auto-hides when there are no items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
const badges = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M6 21c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12h4l2-6 3 12 2-6h4"/></svg>',
];
---
{items.length > 0 && (
  <section class="sec creds" id="credentials">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="eyebrow" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="bdg" aria-hidden="true" set:html={badges[i % badges.length]}></div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--sand); }
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { background: #fff; border-radius: 18px; padding: 28px 24px; border: 1px solid var(--line); }
  .cred .bdg { width: 44px; height: 44px; border-radius: 12px; background: var(--mint); display: flex; align-items: center; justify-content: center; color: var(--teal); margin-bottom: 14px; }
  .cred .bdg svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 1.7; }
  .cred h4 { font-size: 16px; color: var(--ink); margin-bottom: 6px; font-weight: 600; }
  .cred p { font-size: 14px; color: var(--muted); margin: 0; }
</style>
