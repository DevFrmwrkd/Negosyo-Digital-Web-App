---
/**
 * medical / CtaBandAH — quiet centered closer on the porcelain ground
 * ("Been putting it off?"). Cormorant headline, a muted line, and the primary
 * booking CTA. cta2 renders as an outline line-button only when provided (the
 * design ships a single CTA).
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const hasButtons = !!(cta1Text || cta2Text);
---
{(headline || hasButtons) && (
  <section class="cta-band">
    <div class="wrap cta-inner reveal">
      {tag && <p class="eyebrow cta-tag" data-field="ctaBand.tag">{tag}</p>}
      {headline && <h2 class="cta-h" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="cta-actions">
          {cta1Text && <a class="btn" href={cta1Href} data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a class="btn line" href={cta2Href} data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { text-align: center; padding: 80px 0; }
  .cta-inner { max-width: 640px; }
  .cta-tag { margin-bottom: 12px; }
  .cta-h { font-size: clamp(32px, 5vw, 52px); margin-bottom: 14px; color: var(--ink); }
  .cta-sub { color: var(--muted); margin-bottom: 28px; }
  .cta-actions { display: inline-flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
</style>
