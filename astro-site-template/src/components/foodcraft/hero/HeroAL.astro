---
/**
 * foodcraft / HeroAL — the deco bakery hero: eyebrow + stacked Marcellus
 * headline + sub + two CTAs on the left, an arched window frame on the right
 * holding the hero loaf. The design's signature detail — three ribbons of steam
 * rising off the loaf — layers over the frame as aria-hidden chrome. A scallop
 * lace edge closes the shell block into the cream page below.
 *
 * hero.image layers over the arched terracotta gradient, which stays as the
 * designed fallback when no photo is set. hero.tag carries the frame caption
 * (the design's "First tray, 4:45 in the morning").
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAL actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAL.
const PAGE_ANCHORS = new Set(['gallery', 'location', 'reviews', 'top']);
// No alias for '#services': PageAL renders no services id at all (the design's
// product showcase is #gallery), and 'breads' was in the set above without ever
// being an id on the page — so '#services' resolved to a '#breads' that scrolls
// nowhere and the header kept the dead nav link because the target 'existed'.
// An unresolvable anchor must fall through to the fallback (headers drop it).
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const hero = content.hero || {};
const heroImage = hero.image || (hero.photos && hero.photos[0]) || (content.photos && content.photos[0]) || '';
const kicker = hero.kicker || hero.locality || '';
const headlineLines: string[] = Array.isArray(hero.headlineLines) && hero.headlineLines.length > 0
  ? hero.headlineLines
  : (hero.headline ? [hero.headline] : []);
const sub = hero.sub || '';
const cta1Text = hero.cta1?.text || '';
const cta1Href = onPage(hero.cta1?.href, '#location');
const cta2Text = hero.cta2?.text || '';
// '#breads' matched no section in this family (foodcraft ships no id="breads"),
// so the fallback CTA jumped nowhere. #gallery is the real product showcase.
const cta2Href = onPage(hero.cta2?.href, '#gallery');
const tagText = hero.tag || '';
---
<header class="hero-al">
  <div class="wrap grid2 hero-inner">
    <div class="hero-copy reveal">
      {kicker && <p class="eyebrow" data-field="hero.kicker">{kicker}</p>}
      {headlineLines.length > 0 && (
        <h1 class="hero-h">
          {headlineLines.map((line: string, i: number) => (
            <span class="hl-line" data-field={`hero.headlineLines.${i}`} set:html={line}></span>
          ))}
        </h1>
      )}
      {sub && <p class="hero-sub" data-field="hero.sub">{sub}</p>}
      {(cta1Text || cta2Text) && (
        <div class="hero-cta">
          {cta1Text && <a class="btn" href={cta1Href} data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
          {cta2Text && <a class="btn line" href={cta2Href} data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
        </div>
      )}
    </div>
    <figure class="arch hero-arch reveal">
      {heroImage && <div class="photo" data-image-field="hero.image" style={`background-image:url('${heroImage}');`}></div>}
      <span class="steam" style="left:38%" aria-hidden="true"></span>
      <span class="steam" style="left:50%;animation-delay:1.1s" aria-hidden="true"></span>
      <span class="steam" style="left:61%;animation-delay:2.2s" aria-hidden="true"></span>
      {tagText && <figcaption data-field="hero.tag">{tagText}</figcaption>}
    </figure>
  </div>
  <div class="scallop" style="background-color:var(--cream)"></div>
</header>
<style>
  .hero-al { background: var(--shell); }
  .hero-inner { padding: 50px 22px 70px; align-items: center; }
  .hero-h { font-size: clamp(42px, 7.5vw, 80px); margin: 18px 0 22px; color: var(--cocoa); }
  .hero-h .hl-line { display: block; }
  .hero-h :global(em) { font-style: normal; color: var(--terra-deep); }
  .hero-sub { color: var(--muted-ink); max-width: 44ch; margin-bottom: 30px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-arch { min-height: 420px; }

  /* Signature: rising steam off the hero loaf. */
  .steam {
    position: absolute; bottom: 58%; width: 3px; height: 56px; border-radius: 999px;
    background: linear-gradient(to top, rgba(250,243,231,0), rgba(250,243,231,.85), rgba(250,243,231,0));
    filter: blur(2px); animation: rise-al 3.4s infinite ease-in-out; z-index: 1;
  }
  @keyframes rise-al {
    0% { transform: translateY(24px) scaleY(.6); opacity: 0; }
    35% { opacity: .9; }
    100% { transform: translateY(-44px) scaleY(1.15) translateX(6px); opacity: 0; }
  }

  @media (max-width: 799px) { .hero-arch { min-height: 340px; } }
  @media (max-width: 760px) {
    .hero-inner { padding: 30px 22px 50px; }
    .hero-h { font-size: clamp(34px, 8vw, 58px); margin: 14px 0 18px; }
    .hero-sub { margin-bottom: 24px; }
  }
  @media (max-width: 520px) {
    .hero-inner { padding: 24px 18px 44px; }
    .hero-h { font-size: clamp(28px, 8.5vw, 40px); line-height: 1.08; }
    .hero-arch { min-height: 280px; }
    .hero-cta { gap: 10px; }
    .hero-cta .btn { flex: 1 1 auto; }
  }
</style>
