---
/**
 * foodcraft / CredentialsAL — thin permits / registration row (deco ✳ marks
 * over muted labels). Optional tag / headline render above when provided; the
 * design ships a bare row of ✳-marked items. Reads content.credentials.items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <p class="eyebrow" data-field="credentials.tag">{tag}</p>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <div class="cred-item">
            <span class="mark" aria-hidden="true">✳</span>
            <span class="cred-copy">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 28px 0; border-top: 2px solid var(--shell); }
  .cred-head { margin-bottom: 20px; }
  .cred-h { font-size: clamp(26px, 4vw, 44px); color: var(--cocoa); margin-top: 10px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 16px 24px; color: var(--muted-ink); font-size: 14px; }
  .cred-item { display: flex; gap: 8px; align-items: baseline; }
  .mark { color: var(--terra); font-weight: 700; }
  .cred-copy { display: inline-flex; flex-direction: column; }
  .cred-desc { color: var(--muted-ink); opacity: .72; font-size: 12.5px; margin-top: 2px; }
</style>
