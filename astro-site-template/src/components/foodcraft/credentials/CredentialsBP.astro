---
/**
 * foodcraft / CredentialsBP — "Tahanan Cafe · Split"'s standards.
 *
 * ROLE. The first CONTAINED block on the page — no photograph, no split, just
 * a 1180px measure on the #FBF8F5 wash. From the element carrying
 * data-component="CREDENTIALS" in "Tahanan Cafe Landing v4.dc.html": a baseline
 * head (eyebrow and headline 16px apart on one line, wrapping when they run
 * out of room), then four columns, each opened by a full INK rule with a
 * tracked-caps walnut title under it and a 13.5px body beneath that.
 *
 * THE INK RULE OVER A CELL is the second and last ink border on this page —
 * the other is the menu's group heading. Everywhere else the rules are
 * hairlines. Softening this one to --line is the quickest way to make the
 * section stop reading as a set of certificates.
 *
 * THERE IS NO NUMERAL HERE. The sibling templates in this family number their
 * credentials 01, 02, 03; this design does not, and one is not invented.
 *
 * EDITABLE HOOKS:
 *   credentials.tag                 — the eyebrow
 *   credentials.headline            — set:html, so an owner em takes the italic
 *   credentials.items.${i}.title    — a cell's title
 *   credentials.items.${i}.body     — its body
 *
 * DERIVED, never stored: the number of tracks, which follows the data up to the
 * design's four.
 *
 * BOTH CONTENT SHAPES ARE TOLERATED: the schema's { items: [...] } and the
 * plain array some older records still store under content.credentials. Four
 * spellings of the body field are read (body / desc / detail / description)
 * because four generations of extraction have written it.
 *
 * A CELL WITH NEITHER A TITLE NOR A BODY IS NOT DRAWN, so an emptied row takes
 * its ink rule with it rather than leaving a stub of border over nothing.
 */
interface Props { content: any; layout?: any; }
const { content } = Astro.props;

const cred = content.credentials || {};

const str = (v: unknown): string =>
  typeof v === 'string' ? v : typeof v === 'number' && Number.isFinite(v) ? String(v) : '';

const tag = str(cred.tag).trim();
const headline = str(cred.headline).trim();

type Item = {
  title?: unknown; label?: unknown;
  body?: unknown; desc?: unknown; detail?: unknown; description?: unknown;
};
const items: Item[] = Array.isArray(cred.items)
  ? cred.items
  : (Array.isArray(cred) ? cred : []);

const titleOf = (it: Item): string => (str(it.title).trim() || str(it.label).trim());
const bodyOf = (it: Item): string =>
  (str(it.body).trim() || str(it.desc).trim() || str(it.detail).trim() || str(it.description).trim());

// The ORIGINAL index rides along in `i`, so dropping an empty cell cannot shift
// the editor hooks of the ones after it.
const rows = items
  .map((it, i: number) => ({ i, title: titleOf(it), body: bodyOf(it) }))
  .filter((r) => Boolean(r.title || r.body));

// Follow the data, but never widen past the design's four tracks. Anything
// beyond four wraps to a second row and gets its own ink rule.
const cols = String(Math.min(Math.max(rows.length, 1), 4));
const hasHead = Boolean(tag || headline);
---
{rows.length > 0 && (
  <section class="thv-creds band-tint">
    <div class="wrap">
      {hasHead && (
        <div class="thv-creds-head reveal">
          {tag && <span class="kick" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="h2 thv-creds-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="thv-creds-grid" style={`--cols:${cols}`}>
        {rows.map((it, k) => (
          <div class="thv-creds-cell reveal" data-delay={String(k % 4)}>
            {it.title && (
              <h3 class="thv-creds-t" data-field={`credentials.items.${it.i}.title`}>{it.title}</h3>
            )}
            {it.body && (
              <p class="thv-creds-p" data-field={`credentials.items.${it.i}.body`}>{it.body}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  /* Colour, type and metrics come only from PageBP's token vocabulary
     (--ink --ink-soft --accent --line --tint --sans) and from its shared primitives
     (.wrap .band-tint .kick .h2). There is no literal hex in this file. */

  /* Design: padding 54px 30px, and a hairline under the section, which is the
     same rule every split section closes with. The 30px is .wrap's job. */
  .thv-creds {
    padding-block: clamp(40px, 5.2vw, 54px);
    border-bottom: 1px solid var(--line);
  }

  /* Design: display flex; align-items baseline; gap 16px; flex-wrap wrap;
     margin-bottom 26px. The eyebrow and the headline share ONE baseline here,
     which is this design's container-block head and is used again on Service
     area, FAQ and (borrowed) Gallery. */
  .thv-creds-head {
    display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .thv-creds-head .kick { max-width: 100%; overflow-wrap: anywhere; }
  /* Design: clamp(24px,3vw,38px)/1.14 with NO margin — the head's flex gap
     does the spacing, so the shared .h2's .24em/.32em would double it. */
  .thv-creds-h {
    margin: 0;
    font-size: clamp(24px, 3vw, 38px); line-height: 1.14;
    overflow-wrap: anywhere;
  }

  /* Design: grid-template-columns:repeat(4,minmax(0,1fr)); gap:0 26px. */
  .thv-creds-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    gap: 0 26px;
  }
  /* THE INK RULE. Design: border-top:1px solid the ink; padding-top:14px. */
  .thv-creds-cell {
    min-width: 0;
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }
  /* A fifth cell and beyond wraps to a second row; the design caps at four, so
     this is only reachable on a record that predates that cap. The 22px keeps
     the second row's ink rules off the first row's descenders. */
  .thv-creds-cell:nth-child(n + 5) { margin-top: 22px; }

  /* Design: 10.5px at .18em caps in walnut, 700, 8px beneath. NOT the shared
     .mono, which is 10px in the muted grey — this title is the walnut and is
     the only coloured thing in the cell. */
  .thv-creds-cell .thv-creds-t {
    margin: 0 0 8px;
    font-family: var(--sans); font-weight: 700; font-size: 10.5px;
    letter-spacing: .18em; text-transform: uppercase; line-height: 1.4;
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  /* Design: 13.5px/1.76 in the soft ink, no margin. */
  .thv-creds-cell .thv-creds-p {
    margin: 0;
    font-size: 13.5px; line-height: 1.76; color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  /* ── R8 · this section's OWN responsive pass. Nothing here uses a clamp
        whose floor could outgrow a later cap; the two headline values are the
        wrapper's shared ladder and this file only narrows the grid. */
  @media (max-width: 900px) {
    /* Two up. A 10.5px title at .18em tracking cannot hold a ~270px quarter
       column without splitting mid-word. */
    .thv-creds-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .thv-creds-cell:nth-child(n + 3) { margin-top: 22px; }
  }
  @media (max-width: 520px) {
    .thv-creds-grid { grid-template-columns: minmax(0, 1fr); }
    .thv-creds-cell:nth-child(n + 2) { margin-top: 20px; }
    .thv-creds-head { gap: 10px; margin-bottom: 20px; }
  }
</style>
