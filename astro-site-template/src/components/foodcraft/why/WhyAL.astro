---
/**
 * foodcraft / WhyAL — split grid: big deco headline left, a deco-asterisk
 * reason list right. Reads content.why.items (canonical `body`, legacy `desc`).
 * The design ships no eyebrow, so why.tag stays gated.
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <p class="eyebrow" data-field="why.tag">{tag}</p>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="why-item">
            <span class="why-mark" aria-hidden="true">✳</span>
            <span class="why-copy">
              <strong data-field={`why.items.${i}.title`}>{item.title}</strong>
              {(item.body ?? item.desc ?? item.description) && (
                <span class="why-body" data-field={`why.items.${i}.body`}> {item.body ?? item.desc ?? item.description}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-h { font-size: clamp(32px, 5vw, 52px); color: var(--cocoa); }
  .why-list { list-style: none; display: grid; gap: 20px; }
  .why-item { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  .why-mark { font-family: var(--display); font-size: 28px; color: var(--terra); line-height: 1; }
  .why-copy strong { color: var(--cocoa); }
  .why-body { color: var(--muted-ink); }
</style>
