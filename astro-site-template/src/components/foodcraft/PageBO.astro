---
/**
 * foodcraft / PageBO — "Sipsip Tea Bar" (a milk-tea and brew bar).
 *
 * Blush & ultraviolet: Baloo 2 — a rounded display face — over Nunito Sans on
 * a warm blush-cream ground, with 100px pills on every control and generous
 * radii on every card. It is the softest template in this family and the only
 * one with a MULTI-HUE palette: purple leads, pink and sage answer it.
 *
 * THE THREE HUES ARE NOT INTERCHANGEABLE, which is the thing to get right.
 *   --accent  (purple) is the brand: kickers, links, the primary fill.
 *   --pink    is a GROUND, never text — a card wash and a button fill whose
 *             label is the deep plum, never the purple.
 *   --sage    is the second ground, used once, and its own deep green is the
 *             only thing legible on it.
 * Putting purple text on the pink, or the sage green on the blush, is how this
 * design goes wrong. Each pairing below is declared with its own on-colour so
 * a section never has to guess.
 *
 * THE DESIGN IS THE SPECIFICATION. Every value is lifted verbatim from
 * "Sipsip Tea Bar Landing.dc.html".
 *
 * TOKEN NAMING IS CHECKED AGAINST THE ENGINE, NOT ASSUMED. buildOverrideCss
 * owns gold peach amber lime blue mint yellow teal forest olive brass plus
 * paper, paper-2, card, ink, ink-soft, line, muted, the rgb triplets, and
 * EXACTLY these ten of the accent/on families and no others:
 *   --accent --accent-deep --accent-light --accent-soft --accent-rgb
 *   --on-accent --on-primary --on-ink --on-paper --on-brass
 * It wins each with !important. The list is exact on purpose — an earlier draft
 * wrote "accent-any, on-any", which claims --on-pink and --on-sage below are
 * engine-owned when the engine has never heard of them, and would have had a
 * reader move two tokens that did not need moving. A sibling template shipped a token called --amber with
 * a comment claiming the engine did not know it; it does, and every scheme pick
 * would have repainted a band. --pink --lilac --sage --plum below were each
 * grepped against that file before use and are absent from it. That matters
 * more here than anywhere: this palette's whole character is the three hues
 * holding their relationship, and two of them must not move.
 *
 *   OWNED, deliberately: --paper --card --ink --ink-soft --line --muted
 *   --accent --accent-deep and the rgb triplets. Note --muted is remapped to
 *   palette.inkSoft, so the figure below is native and not a guarantee.
 *   INVISIBLE, verified: --tint --well --pink --pink-2 --lilac --sage
 *   --on-sage --plum --plum-2 --on-pink --on-cream. THREE of the pairings this
 *   file draws are ASYMMETRIC — one side engine-owned, the other not — so those
 *   three figures are NATIVE-palette values and not a guarantee once a scheme is
 *   picked: .chip is --accent on --lilac (4.77, the least headroom anywhere on
 *   this page), .band-lilac is --ink on --lilac (13.51), and .btn--cream is
 *   --on-cream on --paper (10.81), where the engine repaints --paper and never
 *   touches --on-cream. Every other pairing here moves on both sides or on
 *   neither.
 *
 * ROLE OF THIS FILE: emits the WHOLE document. Does NOT compose with
 * BaseLayout. Only file here that touches `siteData`.
 *
 * EDITABLE HOOKS OWNED BY THIS FILE: none.
 *
 * THE ONE HARDCODED VISIBLE STRING is the skip link's "Skip to content".
 *
 * VERIFIED CONTRAST — COMPUTED from the hexes declared below (sRGB relative
 * luminance, WCAG 2.x), not estimated. An earlier draft of this table stated
 * several pairs HIGHER than the palette gives, which is the dangerous
 * direction: it can wave through a pair that is under the bar. Re-run the
 * arithmetic if you touch a hex.
 *   ink/paper 15.92 · ink/card 16.86 · ink-soft/paper 7.13 · muted/paper 5.68
 *   accent/paper 5.63 (kickers, links) · paper on an accent fill 5.63
 *   on-pink/pink 9.96 (plum on the pink fill) · on-sage/sage 6.40
 *   ink/lilac 13.51. Nothing in this design sits below AA.
 *   THE PAIR THAT FAILS, and the reason --on-pink exists: --accent on --pink is
 *   3.93 — under the 4.5 floor. Never put the purple on the pink.
 *
 * FORBIDDEN CLASS NAMES here: .btn-primary .btn-ghost .btn-yellow .btn-light
 * .nav-cta .nav-right .testi .cta-band .trust, and `.hero` on a <section>.
 * Buttons here are .btn--fill / .btn--pink / .btn--cream / .btn--line.
 *
 * FONT-PAIRING SENTINEL (wrapper-local): astro-builder defaults
 * layout.fontPairing to 'modern' and lockVariant only blanks
 * ''/'auto'/'default', so without this buildOverrideCss force-swaps Baloo 2 +
 * Nunito Sans with !important on ~every real site.
 *
 * RENDER ORDER, exactly as the design draws it: Header, Hero, Trust, About,
 * Services (the menu), Why, Gallery, How, Testimonials, Credentials, Location
 * (visit), Area, Faq, CtaBand, Footer.
 *
 * Leaflet: LOADS leaflet.css + leaflet.js and defines
 * window.__foodcraftBOInitMap. LocationBO calls that exact string. Keep
 * `el.innerHTML = ''` in the boot and keep id="map" literal.
 */
import HeaderBO from './header/HeaderBO.astro';
import HeroBO from './hero/HeroBO.astro';
import TrustBO from './trust/TrustBO.astro';
import AboutBO from './about/AboutBO.astro';
import ServicesBO from './services/ServicesBO.astro';
import WhyBO from './why/WhyBO.astro';
import GalleryBO from './gallery/GalleryBO.astro';
import HowBO from './how/HowBO.astro';
import TestimonialsBO from './testimonials/TestimonialsBO.astro';
import CredentialsBO from './credentials/CredentialsBO.astro';
import LocationBO from './location/LocationBO.astro';
import AreaBO from './area/AreaBO.astro';
import FaqBO from './faq/FaqBO.astro';
import CtaBandBO from './ctaBand/CtaBandBO.astro';
import FooterBO from './footer/FooterBO.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __resolvedPairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __pairing = (layout.fontPairing === 'modern' && !layout.fontPairingExplicit) ? '' : __resolvedPairing;
const __fontHref = buildFontHref(__pairing);
const __overrideCss = buildOverrideCss(__themeScheme, __pairing);
const __desc = (content as any).description || '';
const __favicon = layout.favicon || '';
const __og = layout.ogImage || layout.favicon || '';
---
<!DOCTYPE html>
<html lang="en-PH" data-page="BO">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{__desc && <meta name="description" content={__desc} />}
<meta name="theme-color" content="#FFF7F2" />
<meta property="og:title" content={title} />
{__desc && <meta property="og:description" content={__desc} />}
{__og && <meta property="og:image" content={__og} />}
{__favicon && <link rel="icon" href={__favicon} />}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700&family=Nunito+Sans:opsz,wght@6..12,300;6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet" />
{__fontHref && <link href={__fontHref} rel="stylesheet" />}
<!-- Leaflet. BOTH tags are load-bearing: without the stylesheet the tiles
     render unpositioned, and without the script window.L never exists and
     LocationBO's drawn fallback map-face is all an owner ever sees.
     check-template-blocks.mjs fails that combination. -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
       Every selector is prefixed html[data-page="BO"]. An unscoped rule here
       reaches all 66 templates. (Never write a literal end-style-tag inside
       this block, comments included — it is an HTML raw-text element.)
       ═══════════════════════════════════════════════════════════════════════ */

    html[data-page="BO"] {
      --paper: #FFF7F2;
      --card: #FFFFFF;
      --tint: #FFF7F2;
      --well: #EEE2F5;

      --ink: #241A22;
      --ink-soft: #5D5158;
      --muted: #6B6067;
      --line: #EEE2F5;

      --accent: #7B4FA8;
      --accent-deep: #5C3580;
      --accent-rgb: 123,79,168;

      /* ── the two answering hues. Each carries its own on-colour, because the
            whole risk in this palette is using the wrong text on the wrong
            ground. --pink and --sage are GROUNDS; they are never text. */
      --pink: #F2C6DA;
      --pink-2: #F7DCE7;
      --on-pink: #3D1B2C;
      --sage: #E3EFDC;
      --on-sage: #3C5C2A;
      --lilac: #EEE2F5;
      --plum: #5C2A45;
      --plum-2: #3D1B2C;
      --on-cream: #4A2A6B;

      --ink-rgb: 36,26,34;
      --paper-rgb: 255,247,242;
      --on-ink: #FFF7F2;
      --on-paper: #241A22;
      --on-accent: #FFF7F2;
      --on-primary: #FFF7F2;

      --disp: "Baloo 2", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --serif: "Baloo 2", system-ui, Helvetica, Arial, sans-serif;
      --sans: "Nunito Sans", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --mono: "Nunito Sans", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --maxw: 1200px;
      /* SOFT. Pills on controls, generous radii on cards — this design has no
         sharp corner anywhere. */
      --r-pill: 100px;
      --r-lg: 26px;
      --r-md: 18px;
    }

    html[data-page="BO"] *,
    html[data-page="BO"] *::before,
    html[data-page="BO"] *::after { box-sizing: border-box; }
    html[data-page="BO"] { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 92px; }
    @media (prefers-reduced-motion: reduce) { html[data-page="BO"] { scroll-behavior: auto; } }
    html[data-page="BO"] body {
      margin: 0; padding: 0;
      background-color: var(--paper); color: var(--ink);
      font-family: var(--sans); font-size: 16.5px; line-height: 1.72;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    html[data-page="BO"] img { max-width: 100%; display: block; }
    html[data-page="BO"] a { color: inherit; text-decoration: none; }
    html[data-page="BO"] ::selection { background: var(--accent); color: var(--on-accent); }
    /* Baloo 2 is a DISPLAY face with a tall x-height; 700 is its headline
       weight here, and text-transform is declared none so nothing leaking from
       another template's global block can shout it. */
    html[data-page="BO"] :where(h1,h2,h3,h4) {
      margin: 0; font-family: var(--disp); font-weight: 700; color: var(--ink);
      letter-spacing: -.01em; line-height: 1.12; text-transform: none;
    }
    html[data-page="BO"] :where(p) { margin: 0 0 1em; }

    html[data-page="BO"] :where(.wrap) { width: min(var(--maxw), 92vw); margin-inline: auto; }
    html[data-page="BO"] section { padding: clamp(48px,6.4vw,80px) 0; position: relative; }

    /* ── THE ANSWERING GROUNDS. A section opts into one; each brings its own
          text colour so nothing has to guess. */
    html[data-page="BO"] :where(.band-pink) { background-color: var(--pink); color: var(--on-pink); }
    html[data-page="BO"] :where(.band-pink) .h2,
    html[data-page="BO"] :where(.band-pink) .kick { color: var(--on-pink); }
    html[data-page="BO"] :where(.band-pink) .body,
    html[data-page="BO"] :where(.band-pink) .lede { color: var(--plum); }
    html[data-page="BO"] :where(.band-sage) { background-color: var(--sage); color: var(--on-sage); }
    html[data-page="BO"] :where(.band-sage) .h2,
    html[data-page="BO"] :where(.band-sage) .kick { color: var(--on-sage); }
    html[data-page="BO"] :where(.band-sage) .body,
    html[data-page="BO"] :where(.band-sage) .lede { color: var(--on-sage); }
    html[data-page="BO"] :where(.band-lilac) { background-color: var(--lilac); color: var(--ink); }

    html[data-page="BO"] :where(.kick) {
      /* line-height pinned TIGHT for the same reason as .btn. NOTE: this
         eyebrow carries no rule under it — an earlier draft of this comment was
         copied from the sibling template whose eyebrow IS underlined by a
         border-bottom, and said so here where there is no border to speak of.
         What a loose line box actually costs on this design is the gap: the
         eyebrow's own box inflates and pushes the headline below it further
         down than the design draws it. */
      line-height: 1.1;
      display: inline-block;
      font-family: var(--sans); font-weight: 700; font-size: 11px;
      letter-spacing: .18em; text-transform: uppercase; color: var(--accent);
    }
    html[data-page="BO"] :where(.h2) {
      font-family: var(--disp); font-weight: 700;
      font-size: clamp(28px,3.9vw,52px); line-height: 1.12; letter-spacing: -.01em;
      margin: 0 0 .3em; color: var(--ink); max-width: 22ch;
    }
    /* The emphasis is a COLOUR change. Baloo 2 has no italic — asking for one
       synthesises an oblique that fights its rounded terminals. */
    html[data-page="BO"] :where(.h2 em),
    html[data-page="BO"] :where(.h2 .em),
    html[data-page="BO"] :where(.em) { font-style: normal; color: var(--accent); }
    html[data-page="BO"] :where(.lede) {
      color: var(--ink-soft); font-size: clamp(15.5px,1.5vw,17.5px); line-height: 1.72;
      max-width: 46ch; margin: 0;
    }
    html[data-page="BO"] :where(.body) {
      color: var(--ink-soft); font-size: clamp(14.5px,1.3vw,15.5px); line-height: 1.72;
    }
    html[data-page="BO"] :where(.mono) {
      font-family: var(--sans); font-weight: 700; font-size: 11px;
      letter-spacing: .16em; text-transform: uppercase; color: var(--muted);
    }
    html[data-page="BO"] :where(.fig) {
      font-family: var(--disp); font-weight: 700; color: var(--accent);
      font-variant-numeric: tabular-nums lining-nums; line-height: 1;
    }
    /* ── .chip — the rounded label this design uses everywhere. */
    html[data-page="BO"] :where(.chip) {
      display: inline-flex; align-items: center;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      color: var(--accent); background-color: var(--lilac);
      border-radius: var(--r-pill); padding: 7px 15px;
    }

    /* ── BUTTONS. The design's own three, all pills at 13px/700. */
    html[data-page="BO"] :where(.btn) {
      /* line-height is DECLARED. The design sets none on its buttons, so they
         render at the browser normal; inheriting body's 1.72 instead inflated
         every control by ~6px. (An earlier draft added "and pushed the eyebrow's
         underline off its text" — true of the sibling template, not of this one,
         whose eyebrow has no underline.) A label is one line: 1 is what a button
         wants. */
      line-height: 1;
      display: inline-flex; align-items: center; justify-content: center; gap: .5em;
      padding: 16px 30px; min-height: 48px;
      border-radius: var(--r-pill); border: 1px solid transparent;
      font-family: var(--sans); font-weight: 700; font-size: 13px;
      letter-spacing: 0; text-decoration: none; cursor: pointer; white-space: nowrap;
      transition: background-color .18s ease, box-shadow .18s ease, transform .18s ease, border-color .18s ease;
    }
    html[data-page="BO"] :where(.btn--fill) { background-color: var(--accent); color: var(--on-accent); border-color: var(--accent); }
    html[data-page="BO"] :where(.btn--fill:hover) { background-color: var(--accent-deep); color: var(--on-accent); border-color: var(--accent-deep); transform: translateY(-2px); }
    /* The pink button's label is the PLUM, never the purple: purple on pink is
       3.93:1 — under AA — and is the single easiest way to break this palette. */
    html[data-page="BO"] :where(.btn--pink) { background-color: var(--pink); color: var(--on-pink); border-color: var(--pink); }
    html[data-page="BO"] :where(.btn--pink:hover) { background-color: var(--pink); color: var(--on-pink); border-color: var(--pink); box-shadow: inset 0 0 0 999px rgba(0,0,0,.06); transform: translateY(-2px); }
    html[data-page="BO"] :where(.btn--cream) { background-color: var(--paper); color: var(--on-cream); border-color: var(--paper); }
    html[data-page="BO"] :where(.btn--cream:hover) { background-color: var(--paper); color: var(--on-cream); border-color: var(--paper); box-shadow: inset 0 0 0 999px rgba(0,0,0,.05); transform: translateY(-2px); }
    html[data-page="BO"] :where(.btn--line) { background-color: transparent; color: var(--accent); border-color: var(--accent); }
    html[data-page="BO"] :where(.btn--line:hover) { background-color: var(--accent); color: var(--on-accent); border-color: var(--accent); transform: translateY(-2px); }
    html[data-page="BO"] :where(.btn:active) { transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) {
      html[data-page="BO"] .btn { transition: none; }
      html[data-page="BO"] .btn:hover { transform: none; }
    }

    html[data-page="BO"] :where(.linkc) {
      display: inline-flex; align-items: center; gap: .5em; min-height: 44px;
      font-family: var(--sans); font-weight: 700; font-size: 14px; color: var(--accent);
      border-bottom: 2px solid transparent; padding-bottom: 2px;
      transition: border-bottom-color .18s ease, transform .18s ease;
    }
    html[data-page="BO"] :where(.linkc:hover) { color: var(--accent); border-bottom-color: var(--accent); transform: translateY(-1px); }
    @media (prefers-reduced-motion: reduce) { html[data-page="BO"] .linkc { transition: none; } }

    html[data-page="BO"] :where(a,button,summary,[tabindex]):focus-visible {
      outline: 3px solid var(--paper); outline-offset: 0;
      box-shadow: 0 0 0 6px var(--accent); border-radius: var(--r-pill);
    }
    html[data-page="BO"] :where(.band-pink) :where(a,button,summary,[tabindex]):focus-visible {
      outline-color: var(--pink); box-shadow: 0 0 0 6px var(--on-pink);
    }

    html[data-page="BO"] :where(.plate) {
      position: relative; overflow: hidden; min-height: 180px;
      border-radius: var(--r-lg); background-color: var(--well); isolation: isolate;
    }
    html[data-page="BO"] :where(.plate) .ph {
      position: absolute; inset: 0; z-index: 1;
      background-color: var(--well);
      background-size: cover; background-position: center; background-repeat: no-repeat;
      background-image:
        radial-gradient(78% 64% at 22% 14%, rgba(var(--accent-rgb),.14), transparent 62%),
        radial-gradient(66% 60% at 84% 90%, rgba(var(--ink-rgb),.06), transparent 60%);
      transition: transform .5s ease;
    }
    /* Caption on an OPAQUE ink pill: --on-ink on --ink holds 15.92:1 over ANY
       owner photo. */
    html[data-page="BO"] :where(.plate) .cap {
      position: absolute; left: 12px; bottom: 12px; z-index: 3;
      max-width: calc(100% - 24px);
      background-color: var(--ink); color: var(--on-ink);
      font-family: var(--sans); font-weight: 700; font-size: 11px;
      padding: 7px 14px; border-radius: var(--r-pill); overflow-wrap: anywhere;
    }
    @media (prefers-reduced-motion: reduce) { html[data-page="BO"] :where(.plate) .ph { transition: none; } }

    html[data-page="BO"] :where(.rowrule) {
      display: flex; align-items: baseline; gap: 12px;
      padding: 13px 0; border-bottom: 1px solid var(--line); min-width: 0;
    }

    html[data-page="BO"] :where(.reveal) { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }
    html[data-page="BO"] :where(.reveal.in) { opacity: 1; transform: none; }
    html[data-page="BO"] :where(.reveal[data-delay="1"]) { transition-delay: .08s; }
    html[data-page="BO"] :where(.reveal[data-delay="2"]) { transition-delay: .16s; }
    html[data-page="BO"] :where(.reveal[data-delay="3"]) { transition-delay: .24s; }
    @media (prefers-reduced-motion: reduce) {
      html[data-page="BO"] .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    html[data-page="BO"] :where(.skip) {
      position: absolute; left: -999px; top: 0; z-index: 100;
      background-color: var(--accent); color: var(--on-accent);
      padding: 12px 18px; border-radius: 0 0 var(--r-md) 0;
      font-family: var(--sans); font-weight: 700; font-size: 12px;
    }
    html[data-page="BO"] :where(.skip:focus) { left: 0; top: 0; }

    @media (max-width: 760px) {
      /* The MAX is 29px, pinned just UNDER the base clamp's own value where
         this query takes over: 3.9vw is 29.68px at 761px and 29.64px at 760px,
         so the step across the boundary runs DOWNWARD. Anything higher and the
         headline GROWS as the viewport narrows past 761 — a max of 38-42 was
         landing ABOVE where the curve arrived from. It is a jump no
         screenshot at 1440 or 375 can show you: it lives in the one pixel
         either side of the boundary. The vw term is untouched, so the steeper
         small-screen curve this breakpoint exists for still happens. */
      html[data-page="BO"] :where(.h2) { font-size: clamp(26px,7vw,29px); max-width: none; overflow-wrap: anywhere; }
      html[data-page="BO"] :where(.lede) { max-width: none; }
    }
    @media (max-width: 520px) {
      html[data-page="BO"] :where(.kick) { font-size: 10.5px; letter-spacing: .14em; }
      html[data-page="BO"] :where(.btn) { padding: 15px 24px; }
    }
</style>

<style is:inline set:html={__overrideCss}></style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{visibility.headerSection !== false && <HeaderBO content={content} layout={layout} />}
<main id="main">
  {visibility.heroSection !== false && <HeroBO content={content} layout={layout} />}
  {visibility.trustBlock !== false && <TrustBO content={content} layout={layout} />}
  {visibility.aboutSection !== false && <AboutBO content={content} layout={layout} />}
  {visibility.servicesSection !== false && <ServicesBO content={content} layout={layout} />}
  {visibility.whyUsBlock !== false && <WhyBO content={content} layout={layout} />}
  {visibility.gallerySection !== false && <GalleryBO content={content} layout={layout} />}
  {visibility.howItWorksBlock !== false && <HowBO content={content} layout={layout} />}
  {visibility.testimonialsBlock !== false && <TestimonialsBO content={content} layout={layout} />}
  {visibility.credentialsBlock !== false && <CredentialsBO content={content} layout={layout} />}
  {visibility.locationBlock !== false && <LocationBO content={content} layout={layout} />}
  {visibility.serviceAreaBlock !== false && <AreaBO content={content} layout={layout} />}
  {visibility.faqBlock !== false && <FaqBO content={content} layout={layout} />}
  {visibility.ctaBandBlock !== false && <CtaBandBO content={content} layout={layout} />}
</main>
{visibility.footerSection !== false && <FooterBO content={content} layout={layout} />}

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  (function () {
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    els.forEach(function (el) { io.observe(el); });
  })();

  window.__foodcraftBOInitMap = function (lat, lng, label) {
    var tries = 0;
    (function go() {
      var el = document.getElementById('map');
      if (!el) return;
      if (typeof window.L === 'undefined') { if (tries++ < 25) setTimeout(go, 80); return; }
      el.innerHTML = '';
      var map = window.L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 16);
      window.L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19, subdomains: 'abcd', attribution: '&copy; OpenStreetMap &copy; CARTO',
      }).addTo(map);
      var cs = window.getComputedStyle(document.documentElement);
      var accent = (cs.getPropertyValue('--accent') || '').trim() || '#7B4FA8';
      var paper = (cs.getPropertyValue('--paper') || '').trim() || '#FFF7F2';
      var icon = window.L.divIcon({
        className: '', iconSize: [16, 16], iconAnchor: [8, 8],
        html: '<span style="display:block;width:16px;height:16px;border-radius:50%;background:' +
              accent + ';border:3px solid ' + paper + ';box-shadow:0 0 0 1px ' + accent + '"></span>',
      });
      var marker = window.L.marker([lat, lng], { icon: icon }).addTo(map);
      if (label) marker.bindPopup(label);
    })();
  };
</script>
</body>
</html>
