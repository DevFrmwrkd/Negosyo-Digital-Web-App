     would render as a 180px strip in every state where the copy beside it is
     short and in every stacked state below. Same reason in the 900 query below. */
  .pcw-ab-split .pcw-ab-plate { min-height: 440px; }

  /* THE LEDGER — three equal tracks under BOTH halves, edge to edge, opened by
     the design's border-top. No gap: the cells' own borders are the grid. */
  .pcw-ab-specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
