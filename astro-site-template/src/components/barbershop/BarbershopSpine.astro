---
/**
 * Barbershop spine — shared base CSS injected once per page.
 *
 * The 6 Forge variants (PageF…PageJ, PageBP) each set their own palette
 * + font tokens scoped to `html[data-page="<L>"]`, so this spine
 * references those tokens via `var(--brass)`, `var(--paper)`, etc. and
 * works for every variant without bleed.
 *
 * Variant-specific overrides (e.g. PageG's oversized .h-sect) live in
 * the per-letter wrapper, ALSO scoped to `html[data-page="<L>"]` to
 * stop them leaking into sister wrappers when Vite hoists styles.
 *
 * SCOPING — index.astro imports all 68 Page*.astro wrappers, so every
 * `is:global` block in the codebase is bundled into ONE stylesheet that
 * ships on EVERY generated page. An unanchored `.btn` or `body` here
 * therefore paints all 68 templates. Every selector below is anchored to
 * the six wrappers that render this spine: PageF…PageJ and PageBP, i.e.
 * data-page F / G / H / I / J / BP. `:is(…)` carries the specificity of
 * its most specific argument, so the anchor adds exactly (0,1,1) — the
 * same weight a wrapper's own `html[data-page="X"]` prefix adds — which
 * keeps each rule's relative weight inside its own template unchanged.
 */
---
<style is:global>
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) * { box-sizing: border-box; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) { scroll-behavior: smooth; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) img { max-width: 100%; display: block; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) a { color: inherit; text-decoration: none; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) section { position: relative; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .wrap { max-width: var(--maxw); margin: 0 auto; padding-inline: var(--pad); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .pad-y { padding-block: clamp(72px, 9vw, 140px); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .ink-sect { background: var(--ink); color: var(--paper); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .ink-sect .h-sect { color: var(--paper); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .ink-sect .kicker { color: var(--muted-light); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .eyebrow {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(20px,2.2vw,28px); color: var(--brass);
    line-height: 1; margin: 0 0 18px;
  }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .kicker {
    font-family: var(--cond); text-transform: uppercase;
    letter-spacing: .32em; font-weight: 600; font-size: 12px;
    color: var(--muted); display: inline-flex; align-items: center; gap: 12px;
  }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .kicker::before { content: ""; width: 34px; height: 1px; background: var(--brass); display: inline-block; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .kicker.on-dark { color: var(--muted-light); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .h-sect {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(40px,6vw,86px); line-height: .94;
    letter-spacing: .01em; text-transform: uppercase; margin: 18px 0 0;
  }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .lead { font-size: clamp(17px,1.4vw,20px); color: var(--muted); max-width: 54ch; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .on-dark .lead,
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .lead.on-dark { color: var(--muted-light); }
  /* Buttons read background & text from contrast-paired tokens.
     `--on-ink` / `--on-brass` / `--on-paper` are luminance-aware
     in every variant + the override CSS, so picking a black or
     neon-yellow scheme can never produce white-on-white. */
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn {
    font-family: var(--cond); text-transform: uppercase;
    letter-spacing: .16em; font-weight: 600; font-size: 13px;
    padding: 16px 30px; display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid var(--ink); background: var(--ink); color: var(--on-ink, var(--paper));
    cursor: pointer; transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease;
    white-space: nowrap;
  }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn:hover { background: var(--brass); border-color: var(--brass); color: var(--on-brass, var(--ink)); transform: translateY(-2px); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--brass { background: var(--brass); border-color: var(--brass); color: var(--on-brass, var(--ink)); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--brass:hover { background: var(--ink); border-color: var(--ink); color: var(--on-ink, var(--paper)); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--ghost { background: transparent; color: var(--on-paper, var(--ink)); border-color: var(--on-paper, var(--ink)); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--ghost:hover { background: var(--ink); color: var(--on-ink, var(--paper)); border-color: var(--ink); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--ghost.on-dark { color: var(--on-ink, var(--paper)); border-color: var(--on-ink, var(--paper)); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn--ghost.on-dark:hover { background: var(--on-ink, var(--paper)); color: var(--ink); border-color: var(--on-ink, var(--paper)); }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .sect-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; flex-wrap: wrap; margin-bottom: 54px; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .sect-head .lead { margin: 14px 0 0; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
  :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .reveal { opacity: 1; transform: none; transition: none; }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) * { animation: none !important; }
  }

  /* ------------------------------------------------------------------ */
  /* Mobile-first tuning — SHARED scaffolding only (grid stacking lives  */
  /* in each *F section's own scoped block so it out-specifies the       */
  /* component base). These global primitives are used by every variant; */
  /* PageF reads them directly, while G/H/I/J/BP override .h-sect /      */
  /* .pad-y later in the bundle (EQUAL specificity - a wrapper's own     */
  /* html[data-page=X] prefix weighs the same (0,1,1) as this anchor, so */
  /* the wrapper wins on source order, not weight) and carry their own   */
  /* mobile reductions.                                                  */
  /* ------------------------------------------------------------------ */
  @media (max-width: 760px) {
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .pad-y { padding-block: clamp(52px, 8vw, 84px); }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .sect-head { margin-bottom: 34px; gap: 8px 24px; }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .h-sect { font-size: clamp(34px, 8.5vw, 60px); }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .lead { font-size: clamp(15px, 3.6vw, 18px); }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .btn { padding: 14px 24px; }
  }
  @media (max-width: 520px) {
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .pad-y { padding-block: 46px; }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .sect-head { margin-bottom: 28px; }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .h-sect { font-size: clamp(30px, 9vw, 44px); }
    /* Full-width, stacked primary CTAs across every action row. */
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .hero-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroC-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroK-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroS-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroM-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroBP-actions,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .cta-actions { width: 100%; }
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .hero-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroC-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroK-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroS-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroM-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .heroBP-actions > .btn,
    :is(html[data-page="F"],html[data-page="G"],html[data-page="H"],html[data-page="I"],html[data-page="J"],html[data-page="BP"]) .cta-actions > .btn {
      flex: 1 1 100%; justify-content: center;
    }
  }
</style>
