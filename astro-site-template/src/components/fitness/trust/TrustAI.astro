---
/**
 * fitness / TrustAI — thin ink credibility band under the hero (paper type on
 * ink), the design's "Est. on Mango Ave. — 9 years · rating · hours · coaches"
 * strip. Renders content.trust.cells as num/label blocks across a flex row.
 * Volatile Google rating / today's-hours slots have no field in the data model,
 * so they are expressed as ordinary trust cells (num + label).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust-sect">
    <div class="wrap trust-bar">
      {cells.map((cell, i) => (
        <div class="trust-cell reveal">
          {cell.num && <span class="num" data-field={`trust.cells.${i}.num`} set:html={cell.num}></span>}
          {cell.label && <span class="lbl" data-field={`trust.cells.${i}.label`}>{cell.label}</span>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust-sect { padding: 26px 0; background: var(--ink); color: var(--paper); }
  .trust-bar {
    display: flex; flex-wrap: wrap; gap: 18px 22px;
    justify-content: space-between; align-items: center;
    font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
  }
  .trust-cell { display: inline-flex; align-items: baseline; gap: 8px; }
  .trust-cell .num {
    font-family: var(--display); font-size: 17px; text-transform: uppercase; color: var(--paper);
  }
  .trust-cell .lbl { font-family: var(--body); color: var(--tape); }
</style>
