---
/**
 * fitness / CredentialsAR — "coached by pros" row: a hairline-gridded set of
 * .cred tiles, each with a lime hexagon "shield" badge (decorative), an
 * Arial-Black label and an ash note. Reads content.credentials.items
 * (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
const badges = ['✓', '✚', '✓', '★', '✓', '✚'];
---
{items.length > 0 && (
  <section class="sec creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="snum" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal" data-delay={i % 4}>
            <div class="bdg" aria-hidden="true">{badges[i % badges.length]}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; border-top: 3px solid var(--line); border-left: 3px solid var(--line); }
  @media (max-width: 900px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  /* Phone: one column — Arial-Black titles get the full width so long labels
     never overflow a narrow 2-col cell; the border scaffolding frames the stack. */
  @media (max-width: 760px) { .cred-row { grid-template-columns: 1fr; } }
  .cred { padding: 30px 24px; border-right: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .cred .bdg { width: 38px; height: 38px; background: var(--lime); color: #000; display: flex; align-items: center; justify-content: center; font-family: var(--disp); font-size: 18px; margin-bottom: 14px; clip-path: polygon(50% 0,100% 22%,100% 66%,50% 100%,0 66%,0 22%); }
  .cred h4 { font-family: var(--disp); font-size: 16px; letter-spacing: .01em; margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--ash); margin: 0; }
</style>
