---
/**
 * fitness / CredentialsAI — thin ink-ruled permits/registration row (blood ★
 * over the labels). Optional tag / headline render above when provided; the
 * source ships a bare row of ★ items (DTI-registered, city permit, etc.).
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <span class="stamp" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <div class="cred-item">
            <span class="star" aria-hidden="true">★</span>
            <span class="cred-copy">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 30px 0; border-top: 3px solid var(--ink); }
  .cred-head { margin-bottom: 20px; }
  .cred-h { font-size: clamp(28px, 4vw, 46px); color: var(--ink); margin-top: 10px; overflow-wrap: break-word; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 16px 24px; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; }
  .cred-item { display: flex; gap: 8px; align-items: baseline; }
  .star { color: var(--blood); }
  .cred-copy { display: inline-flex; flex-direction: column; }
  .cred-desc { color: var(--ink-soft); font-size: 12px; margin-top: 2px; letter-spacing: .02em; }
</style>
