---
/**
 * fitness / FooterAR — near-black footer (Arial-Black brand with the lime
 * hexagon "shield" mark, lime-warm links) plus lp-06's floating Messenger
 * pill. Every column auto-hides when empty, collapsing to the design's minimal
 * three-line footer.
 *
 * The floating message pill reuses the hero's primary CTA (content.hero.cta1) —
 * the same "message for a trial" action — so it stays editable and in sync; it
 * renders only when that CTA (or the CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAR actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAR.
const PAGE_ANCHORS = new Set(['about', 'faq', 'gallery', 'location', 'main', 'programs', 'reviews', 'trial']);
const ANCHOR_ALIAS: Record<string, string> = { services: 'programs', visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const f = (content as any).footer || {};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = f.brand || layout.businessName || '';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const hoursRows: Array<{ day: string; time: string }> = Array.isArray(f.hours) ? f.hours : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating message pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
const msgHref = onPage(hero.cta1?.href || cband.cta1?.href, '');
// No default label: "Trial" is an offer, and a gym that runs no trial would be
// advertising one it does not honour. No CTA text => no pill.
const msgText = hero.cta1?.text || cband.cta1?.text || '';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="fcol">
        {brand && <div class="brand" data-field="footer.brand"><span class="sh" aria-hidden="true"></span><span class="bn">{brand}</span></div>}
        {blurb && <p data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="fcol">
          <div class="fh">Visit</div>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <p><a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a></p>
              : <p data-field={`footer.visit.lines.${i}`}>{line}</p>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="fcol">
          <div class="fh">Start</div>
          {explore.map((l, i) => (
            <p><a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a></p>
          ))}
        </div>
      )}
      {hoursRows.length > 0 && (
        <div class="fcol foot-hours">
          <div class="fh">Hours</div>
          {hoursRows.map((row, i) => (
            <div class="hrow">
              <span data-field={`footer.hours.${i}.day`}>{row.day}</span>
              <span data-field={`footer.hours.${i}.time`}>{row.time}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-btm">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && msgText && (
  <a class="msgr" href={msgHref} rel="noopener" aria-label={msgText} data-field="hero.cta1.text" data-href-field="hero.cta1.href">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.3 2 2 6.2 2 11.6c0 3 1.4 5.6 3.7 7.3v3.6l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.5S17.7 2 12 2zm1 12.3l-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8z"/></svg>
    {msgText}
  </a>
)}
<style>
  footer { background: var(--black); color: var(--chalk); padding: 66px 0 28px; }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 28px; } }
  footer .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; color: var(--chalk); }
  footer .brand .sh { display: inline-block; width: 24px; height: 28px; background: var(--lime); clip-path: polygon(50% 0,100% 22%,100% 66%,50% 100%,0 66%,0 22%); flex-shrink: 0; }
  footer .brand .bn { font-family: var(--disp); font-size: 24px; letter-spacing: -.01em; text-transform: uppercase; }
  footer .fh { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--lime); margin-bottom: 12px; }
  footer p { font-size: 15px; color: var(--ash); margin: 0 0 7px; }
  footer a { color: var(--ash); }
  footer a:hover { color: var(--lime); }
  .foot-social { margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap; }
  .foot-social a { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; border: 2px solid var(--line); padding: 6px 12px; transition: color .2s, border-color .2s; }
  .foot-social a:hover { color: var(--lime); border-color: var(--lime); }
  .foot-hours .hrow { display: flex; justify-content: space-between; gap: 16px; max-width: 260px; font-size: 15px; color: var(--ash); padding: 2px 0; }
  .foot-btm { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding-top: 22px; font-family: var(--mono); font-size: 12px; letter-spacing: .06em; color: var(--steel); }

  .msgr {
    position: fixed; right: 18px; bottom: 18px; z-index: 70; display: inline-flex; align-items: center; gap: 9px;
    background: var(--lime); color: #000; padding: 13px 22px; font-family: var(--disp); font-size: 15px; letter-spacing: .02em;
    text-transform: uppercase; box-shadow: 5px 5px 0 #000; transition: transform .2s;
  }
  .msgr:hover { transform: translate(-2px,-2px); color: #000; }
  .msgr svg { width: 18px; height: 18px; fill: currentColor; }
  @media (max-width: 760px) {
    footer { padding: 48px 0 24px; }
    .foot-hours .hrow { max-width: 100%; }
    .msgr { right: 14px; bottom: 14px; padding: 11px 16px; font-size: 14px; box-shadow: 4px 4px 0 #000; }
  }
</style>
