---
/**
 * fitness / HeroAR — viewport-filling kinetic "type slam" hero. A designed
 * .scene-floor duotone field sits at low opacity behind the Arial-Black
 * headline (a photo layers over it via data-image-field when hero.image is
 * set), a radial scrim keeps the type legible, and the signature running
 * class marquee is rendered as a full-width band directly under the hero.
 *
 * The marquee mirrors what the gym trains — sourced from content.services
 * items when present, else a strength/conditioning default so it always reads
 * as designed. It is aria-hidden decorative chrome, so it carries no editable
 * field. hero.cta3 is an optional third CTA.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const hero = content.hero || {};
const heroImage = hero.image || (hero.photos && hero.photos[0]) || (content.photos && content.photos[0]) || '';
const kicker = hero.kicker || hero.tag || hero.locality || '';
const headlineLines: string[] = Array.isArray(hero.headlineLines) && hero.headlineLines.length > 0
  ? hero.headlineLines
  : (hero.headline ? [hero.headline] : []);
const sub = hero.sub || '';
const cta1Text = hero.cta1?.text || '';
const cta1Href = hero.cta1?.href || '#trial';
const cta2Text = hero.cta2?.text || '';
const cta2Href = hero.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '#programs');
const cta3Text = hero.cta3?.text || '';
const cta3Href = hero.cta3?.href || '#programs';

// Marquee labels: what the gym trains (services titles), else a strength &
// conditioning default so the marquee always reads as designed.
const services = content.services || {};
const svcItems: Array<{ title?: string }> = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
const marqFromServices = svcItems.map((s) => s && s.title).filter(Boolean) as string[];
const marqItems = marqFromServices.length > 0
  ? marqFromServices
  : ['Barbell Strength', 'Conditioning', 'Boxing', 'Personal Coaching', 'Mobility', 'Open Gym'];
---
<section class="hero" aria-label="Hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="ph scene-floor" data-image-field="hero.image" style={heroImage ? `background-image:url('${heroImage}');background-size:cover;background-position:center;` : ''}></div>
  </div>
  <div class="hero-in">
    <div class="wrap">
      {kicker && <span class="tag" data-field="hero.kicker">{kicker}</span>}
      {headlineLines.length > 0 && (
        <h1>
          {headlineLines.map((line: string, i: number) => (
            <span class="ln"><span data-field={`hero.headlineLines.${i}`} set:html={line}></span></span>
          ))}
        </h1>
      )}
      {sub && (
        <div class="sub">
          <p data-field="hero.sub">{sub}</p>
        </div>
      )}
      {(cta1Text || cta2Text || cta3Text) && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost" data-field="hero.cta3.text" data-href-field="hero.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </div>
</section>
<div class="marq" aria-label="What we train">
  <div class="marq-track" aria-hidden="true">
    {marqItems.map((t) => (<span>{t}</span>))}
    {marqItems.map((t) => (<span>{t}</span>))}
  </div>
</div>
<style>
  .hero { position: relative; min-height: 92vh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; border-bottom: 3px solid var(--lime); }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-bg .ph { position: absolute; inset: 0; opacity: .22; filter: grayscale(.5); background-size: cover; background-position: center; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: 1; background: radial-gradient(120% 90% at 30% 20%,transparent,rgba(12,13,10,.85) 70%); }
  .hero-in { position: relative; z-index: 2; padding: 60px 0 40px; }
  .hero .tag { display: inline-block; opacity: 0; animation: hf .7s ease .2s forwards; }
  .hero h1 { font-size: clamp(64px,15.5vw,260px); line-height: .82; margin: .08em 0 .12em; }
  .hero h1 .ln { display: block; overflow: hidden; }
  .hero h1 .ln > span { display: block; transform: translateY(103%); animation: slam .7s cubic-bezier(.2,1,.3,1) forwards; }
  .hero h1 .ln:nth-child(2) > span { animation-delay: .1s; }
  @keyframes slam { to { transform: none; } }
  @keyframes hf { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hero .tag { opacity: 1; animation: none; } .hero h1 .ln > span { transform: none; animation: none; } }
  .hero .sub { display: flex; gap: 26px; align-items: flex-start; flex-wrap: wrap; max-width: 820px; margin-top: 8px; opacity: 0; animation: hf .8s ease .5s forwards; }
  @media (prefers-reduced-motion: reduce) { .hero .sub { opacity: 1; animation: none; } }
  .hero .sub p { color: var(--ash); font-size: 19px; max-width: 44ch; margin: 0; }
  .hero .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; opacity: 0; animation: hf .8s ease .62s forwards; }
  @media (prefers-reduced-motion: reduce) { .hero .cta-row { opacity: 1; animation: none; } }

  /* class marquee (signature) */
  .marq { background: var(--lime); color: #000; border-top: 3px solid #000; border-bottom: 3px solid #000; overflow: hidden; white-space: nowrap; }
  .marq-track { display: inline-flex; align-items: center; padding: 12px 0; animation: march-ar 26s linear infinite; }
  .marq:hover .marq-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marq-track { animation: none; } }
  @keyframes march-ar { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marq-track span { font-family: var(--disp); font-size: 22px; letter-spacing: .02em; text-transform: uppercase; padding: 0 22px; display: inline-flex; align-items: center; gap: 22px; }
  .marq-track span::after { content: "\2726"; font-size: 13px; }
</style>
