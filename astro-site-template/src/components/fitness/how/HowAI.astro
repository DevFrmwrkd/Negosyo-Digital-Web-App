---
/**
 * fitness / HowAI — "your first session" numbered card grid. Each step is an
 * ink-ruled paper card led by a giant blood-red Archivo Black numeral. Reads
 * content.how.steps (canonical `body`, legacy `desc`). The design pins the
 * heading tight to the section above via padding-top:0.
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="how-sect">
    <div class="wrap">
      {tag && <span class="stamp" data-field="how.tag">{tag}</span>}
      {headline && <h2 class="how-h" data-field="how.headline" set:html={headline}></h2>}
      <ol class="how-list">
        {steps.map((step, i) => (
          <li class="how-step reveal">
            <span class="how-num">{i + 1}</span>
            <p class="how-copy">
              <strong data-field={`how.steps.${i}.title`}>{step.title}</strong>
              {(step.body ?? step.desc ?? step.description) && (
                <span class="how-body" data-field={`how.steps.${i}.body`}> {step.body ?? step.desc ?? step.description}</span>
              )}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
<style>
  .how-sect { padding-top: 0; }
  .how-h { font-size: clamp(36px, 6vw, 64px); margin: 20px 0 28px; color: var(--ink); }
  .how-list { list-style: none; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .how-step { border: 3px solid var(--ink); padding: 20px; background: var(--paper); }
  .how-num { font-family: var(--display); font-size: 44px; color: var(--blood); line-height: 1; display: block; }
  .how-copy { font-size: 14px; font-weight: 500; margin-top: 6px; }
  .how-copy strong { color: var(--ink); }
  .how-body { color: var(--ink-soft); font-weight: 400; }
</style>
