---
/**
 * fitness / CtaBandAR — full-width lime closer, centred: "come train." A lime
 * ground with a dark mono eyebrow, an oversized Arial-Black headline and up to
 * three CTAs (black fill + ghosts, recoloured for the lime band in PageAR's
 * global block). The section anchors #trial for the hero / nav CTA.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#location';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="sec cta-band" id="trial">
    <div class="wrap">
      {tag && <div class="tag reveal" data-field="ctaBand.tag">{tag}</div>}
      {headline && <h2 class="cta-h reveal" data-delay="1" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub reveal" data-delay="1" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="cta-row reveal" data-delay="2">
          {cta1Text && <a href={cta1Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost" rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { background: var(--lime); color: #000; text-align: center; border-bottom: none; }
  .cta-band .tag { display: inline-block; }
  .cta-h { font-size: clamp(50px,10vw,150px); color: #000; margin-bottom: 16px; }
  .cta-sub { color: #14210a; max-width: 52ch; margin: 0 auto 22px; font-size: 17px; }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 6px; }
  @media (max-width: 760px) {
    .cta-h { font-size: clamp(34px, 11vw, 72px); }
    .cta-sub { font-size: 16px; }
  }
  @media (max-width: 520px) {
    .cta-h { font-size: clamp(30px, 12vw, 54px); }
  }
</style>
