---
/**
 * fitness / WhyAI — split grid: giant Archivo Black headline left, ink-boxed
 * reason list right (the design's stacked "Why Bakal hits different" cards).
 * Reads content.why.items (canonical `body`, legacy `desc`). why.tag renders as
 * a stamp above the headline only when provided (the source ships none).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <span class="stamp" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="why-item">
            <strong data-field={`why.items.${i}.title`}>{item.title}</strong>
            {(item.body ?? item.desc ?? item.description) && (
              <span class="why-body" data-field={`why.items.${i}.body`}> {item.body ?? item.desc ?? item.description}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-head .stamp { margin-bottom: 18px; }
  .why-h { font-size: clamp(36px, 6vw, 64px); color: var(--ink); }
  .why-list { list-style: none; display: grid; gap: 16px; font-size: 16px; }
  .why-item { border: 3px solid var(--ink); padding: 18px; background: var(--paper); }
  .why-item strong { color: var(--ink); }
  .why-body { color: var(--ink-soft); }
  @media (max-width: 760px) {
    .why-h { font-size: clamp(30px, 8.5vw, 52px); overflow-wrap: break-word; }
  }
</style>
