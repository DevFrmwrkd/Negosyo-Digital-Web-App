---
/**
 * fitness / WhyAR — "why train here" reasons in a hairline-gridded set of
 * .why-cell tiles, each led by an oversized fight-night-red letter key
 * (decorative), a display title and an ash body line. Reads content.why.items
 * (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
const keys = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
---
{items.length > 0 && (
  <section class="sec why">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-grid">
        {items.map((item, i) => (
          <div class="why-cell reveal" data-delay={i % 2}>
            <div class="k" aria-hidden="true">{keys[i] || String(i + 1)}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 0; border-top: 3px solid var(--line); border-left: 3px solid var(--line); }
  @media (max-width: 760px) { .why-grid { grid-template-columns: 1fr; } }
  .why-cell { padding: 38px 32px; border-right: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .why-cell .k { font-family: var(--disp); font-size: 34px; color: var(--red); }
  .why-cell h3 { font-size: 24px; margin: 12px 0 8px; }
  .why-cell p { color: var(--ash); font-size: 15px; }
</style>
