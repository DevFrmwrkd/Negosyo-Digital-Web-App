---
/**
 * fitness / HeaderAR — sticky near-black nav bar with a lime hazard underline,
 * a hexagon "shield" mark beside the Arial-Black brand, mono uppercase links
 * and an outlined lime "free trial" CTA. Hides on scroll-down / reappears on
 * scroll-up (toggled by PageAR's inline scroll handler via header.nav.hide).
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAR actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAR.
const PAGE_ANCHORS = new Set(['about', 'faq', 'gallery', 'location', 'main', 'programs', 'reviews', 'trial']);
const ANCHOR_ALIAS: Record<string, string> = { services: 'programs', visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = (content as any).footer?.brand || layout.businessName || '';
// Nav links come from the same derived list ('#about', '#services', '#why',
// '#work', '#visit'). Resolve each against this page and drop the ones with no
// section to reach — a nav entry that scrolls nowhere is as broken as a dead
// CTA, and its label promises a section this design does not have. The original
// index rides along as .i so the editor's per-link field hooks stay correct.
const navLinks: Array<{ href: string; label: string; i: number }> =
  ((layout.navLinks && layout.navLinks.length) ? layout.navLinks : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href);
// The header's OWN button. navCtaText / navCtaHref is the top bar's own CTA
// field, so retyping it no longer retypes the hero's button, and roleColors
// keys the `headerCta` role to these two hooks — the pill is colourable on its
// own axis. Falls back to the hero's primary CTA so a site that never set the
// header's field keeps the button, and the label, it renders today.
const hero = (content as any).hero || {};
const ctaText = (content as any).navCtaText || hero.cta1?.text || '';
const ctaHref = onPage((content as any).navCtaHref || hero.cta1?.href, '#trial');
---
<header class="nav">
  <div class="nav-in">
    {brand && <a href="#main" class="brand" data-field="footer.brand" aria-label={`${brand} home`}><span class="sh" aria-hidden="true"></span><span class="bn">{brand}</span></a>}
    {(navLinks.length > 0 || ctaText) && (
      <Fragment>
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-links-ar">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
        <nav class="nav-links" id="nav-links-ar" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
          ))}
          {ctaText && <a href={ctaHref} class="navt" data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>}
        </nav>
      </Fragment>
    )}
  </div>
</header>
<style>
  header.nav {
    position: sticky; top: 0; z-index: 60; background: rgba(12,13,10,.94);
    backdrop-filter: blur(6px); border-bottom: 3px solid var(--lime); transition: transform .3s;
  }
  header.nav.hide { transform: translateY(-100%); }
  header.nav.open { transform: none; }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding: 15px 28px; max-width: var(--maxw); margin: 0 auto; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--chalk); }
  .brand:hover { color: var(--chalk); }
  .brand .sh { width: 24px; height: 28px; background: var(--lime); clip-path: polygon(50% 0,100% 22%,100% 66%,50% 100%,0 66%,0 22%); flex-shrink: 0; }
  .brand .bn { font-family: var(--disp); font-size: 24px; letter-spacing: -.01em; text-transform: uppercase; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-family: var(--mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--ash); }
  .nav-links a:hover { color: var(--chalk); }
  .nav-links .navt { border: 2px solid var(--lime); color: var(--lime); padding: 9px 16px; font-family: var(--disp); letter-spacing: .02em; }
  .nav-links .navt:hover { background: var(--lime); color: #000; }

  /* Hamburger — desktop-hidden, revealed <=760px (design's steel-bordered
     ghost square with chalk bars that fold into an × when the drawer opens). */
  .nav-burger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 46px; height: 44px; padding: 11px; margin-left: 12px; flex-shrink: 0;
    background: transparent; border: 2px solid var(--steel); cursor: pointer;
  }
  .nav-burger span { display: block; width: 100%; height: 3px; background: var(--chalk); transition: transform .25s, opacity .2s; }
  header.nav.open .nav-burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
  header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) { .nav-burger span { transition: none; } }

  @media (max-width: 900px) { .nav-links a:not(.navt) { display: none; } }

  /* Phone: brand + burger stay in the bar; the link list drops to a full-width
     drawer below the header, painted in the design's own black/lime tokens. */
  @media (max-width: 760px) {
    .nav-in { padding: 13px 20px; }
    .brand .bn { font-size: 20px; }
    .nav-burger { display: flex; }
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      display: none; flex-direction: column; align-items: stretch; gap: 0;
      background: var(--black); border-bottom: 3px solid var(--lime);
      box-shadow: 0 20px 44px rgba(0,0,0,.55); padding: 4px 0 14px;
    }
    header.nav.open .nav-links { display: flex; }
    .nav-links a:not(.navt) {
      display: flex; align-items: center; min-height: 48px;
      padding: 12px 20px; font-size: 14px; color: var(--chalk);
      border-bottom: 1px solid var(--line);
    }
    .nav-links a:not(.navt):hover { color: var(--lime); }
    .nav-links .navt {
      display: flex; align-items: center; justify-content: center;
      margin: 14px 20px 2px; min-height: 48px;
      font-size: 16px; padding: 12px 16px;
    }
  }
</style>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var btn = hdr.querySelector('.nav-burger');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var open = hdr.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    // Tapping any link (or the CTA) closes the drawer.
    hdr.querySelectorAll('.nav-links a').forEach(function (a) {
      a.addEventListener('click', function () {
        hdr.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
