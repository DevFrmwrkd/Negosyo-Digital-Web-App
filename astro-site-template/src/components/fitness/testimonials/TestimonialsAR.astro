---
/**
 * fitness / TestimonialsAR — "member logs": a hairline-gridded set of .quote
 * cards, each opened by a lime star row (decorative), the quote in chalk, and
 * a mono uppercase attribution line. Reads content.testimonials.items
 * (canonical `who` + `role`, legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="sec quotes" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal" data-delay={i % 3}>
              <div class="stars" aria-hidden="true">★★★★★</div>
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border-top: 3px solid var(--line); border-left: 3px solid var(--line); }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .quotes-grid { grid-template-columns: 1fr; } .quote { padding: 26px 22px; } .quote p { font-size: 17px; } }
  .quote { padding: 32px 28px; border-right: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .quote .stars { color: var(--lime); font-size: 15px; letter-spacing: 1px; }
  .quote p { font-size: 19px; line-height: 1.45; color: var(--chalk); margin: 12px 0; }
  .quote .who { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--ash); }
</style>
