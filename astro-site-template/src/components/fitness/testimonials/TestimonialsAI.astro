---
/**
 * fitness / TestimonialsAI — "from the corner" quote grid on the ink band
 * (paper type). Blood-ruled blockquotes with tape-colored attribution. Reads
 * content.testimonials.items (canonical `who` + `role`, legacy `author` /
 * `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="test-sect" id="reviews">
    <div class="wrap">
      {tag && <span class="stamp test-stamp" data-field="testimonials.tag">{tag}</span>}
      {headline && <h2 class="test-h" data-field="testimonials.headline" set:html={headline}></h2>}
      <div class="test-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <blockquote class="test-card reveal">
              <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
              {(who || role) && (
                <footer>
                  {who && <span data-field={`testimonials.items.${i}.who`}>{who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </footer>
              )}
            </blockquote>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .test-sect { background: var(--ink); color: var(--paper); }
  .test-stamp { border-color: var(--blood); color: var(--paper); }
  .test-h { font-size: clamp(36px, 6vw, 64px); margin: 20px 0 26px; color: var(--paper); }
  .test-grid { display: grid; gap: 26px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .test-card { border-left: 6px solid var(--blood); padding-left: 20px; }
  .test-card p { font-size: 17px; margin-bottom: 12px; color: var(--paper); }
  .test-card footer { color: var(--tape); font-size: 13px; text-transform: uppercase; letter-spacing: .1em; }
</style>
