---
/**
 * fitness / GalleryAR — "on the floor" mosaic: art-directed .plate frames (a
 * cycling .scene-* duotone stands in as the designed fallback; a photo layers
 * over it via data-image-field when set), arranged in lp-06's grid where the
 * first tile spans 2×2 and two later tiles span 2 wide. The section auto-hides
 * only when there are no items at all.
 *
 * Per-tile height comes from the .g-grid grid rows + span modifiers (.k1/.k4/
 * .k6) — the base .plate is written with :where() in PageAR so these win.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-lift', 'scene-rack', 'scene-box', 'scene-coach', 'scene-kb', 'scene-floor'];
const spanFor = (i: number) => (i % 6 === 0 ? 'k1' : i % 6 === 3 ? 'k4' : i % 6 === 5 ? 'k6' : '');
---
{items.length > 0 && (
  <section class="sec gallery" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
      </div>
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''} role="img" aria-label={item.caption || `Gallery image ${i + 1}`}></div>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 180px; gap: 12px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  /* Phone: single column, uniform tiles — drop the 2×2 / 2-wide spans so the
     mosaic doesn't leave gaps or overflow. */
  @media (max-width: 760px) {
    .g-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; gap: 10px; }
    .g-grid .k1, .g-grid .k4, .g-grid .k6 { grid-column: auto; grid-row: auto; }
  }
  .g-grid .plate { border: 3px solid var(--line); }
  .g-grid .plate .ph { transition: transform .5s; }
  .g-grid .plate:hover .ph { transform: scale(1.08); }
  .k1 { grid-column: span 2; grid-row: span 2; }
  .k4 { grid-column: span 2; }
  .k6 { grid-column: span 2; }
</style>
