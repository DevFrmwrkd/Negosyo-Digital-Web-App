---
/**
 * restaurant / GalleryAM — "a look around" editorial mosaic on the paper band.
 * Tiles are art-directed .plate frames (a cycling .scene-* duotone stands in as
 * the designed fallback; a photo layers over it via data-image-field when set),
 * arranged in lp-01's ken-mosaic where the first tile spans 2×2. The section
 * auto-hides only when there are no items at all.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-adobo', 'scene-room', 'scene-kape', 'scene-bread', 'scene-market', 'scene-hands'];
const spanFor = (i: number) => (i % 6 === 0 ? 'g1' : i % 6 === 1 ? 'g2' : i % 6 === 4 ? 'g5' : '');
---
{items.length > 0 && (
  <section class="gallery sec-pad" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
      </div>
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate grain ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
            <span class="mark">{String(i + 1).padStart(2, '0')}</span>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { background: var(--paper); }
  .gal-sub { max-width: 52ch; color: var(--smoke); margin: -32px 0 32px; font-size: 16px; }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 200px; gap: 14px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate { border-radius: 2px; }
  .g-grid .plate .ph { transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  .g-grid .plate:hover .ph { transform: scale(1.06); }
  .g1 { grid-column: span 2; grid-row: span 2; }
  .g2 { grid-column: span 2; }
  .g5 { grid-column: span 2; }
  @media (max-width: 760px) {
    /* One full-width tile per row; drop the mosaic spans so nothing
       overflows and every photo reads clearly on a phone. */
    .g-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; gap: 12px; }
    .g-grid .g1, .g-grid .g2, .g-grid .g5 { grid-column: auto; grid-row: auto; }
  }
</style>
