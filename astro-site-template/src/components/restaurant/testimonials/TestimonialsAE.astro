---
/**
 * restaurant / TestimonialsAE — "the neighbors talk" quote stack. Ash-outlined
 * blockquotes, ember attribution. Reads content.testimonials.items (canonical
 * `who` + `role`, legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="test-sect" id="reviews">
    <div class="wrap">
      {tag && <p class="kick" data-field="testimonials.tag">{tag}</p>}
      {headline && <h2 class="test-h" data-field="testimonials.headline" set:html={headline}></h2>}
      <div class="test-stack">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <blockquote class="test-card reveal">
              <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
              {(who || role) && (
                <footer>
                  {who && <span data-field={`testimonials.items.${i}.who`}>{who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}> · {role}</span>}
                </footer>
              )}
            </blockquote>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .test-h { font-size: clamp(34px, 5vw, 56px); margin: 12px 0 32px; color: var(--bone); }
  .test-stack { display: grid; gap: 20px; }
  .test-card { border: 1px solid var(--ash); padding: 26px; }
  .test-card p { font-size: 18px; margin-bottom: 14px; color: var(--bone); }
  .test-card footer { color: var(--ember); font-weight: 700; }
</style>
