---
/**
 * restaurant / TestimonialsAM — "what the neighbourhood says" on the deep clay
 * band. Bone-ruled .quote cards, each opened by a gold serif quote mark
 * (decorative), the quote in warm serif, and an uppercase attribution line.
 * Reads content.testimonials.items (canonical `who` + `role`, legacy
 * `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="quotes sec-pad" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" style="color:var(--bone);opacity:.6;" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="reveal" style="color:var(--paper);" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal">
              <div class="mk" aria-hidden="true">“</div>
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes { background: var(--clay-deep); color: var(--bone); }
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 32px; }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; gap: 24px; } }
  .quote { border-top: 1px solid rgba(242,232,215,.35); padding-top: 24px; }
  .quote .mk { font-family: var(--serif); font-size: 60px; line-height: .5; color: var(--gold); }
  .quote p { font-family: var(--serif); font-size: 21px; line-height: 1.45; color: var(--paper); }
  .quote .who { font-family: var(--label); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; opacity: .85; }
</style>
