---
/**
 * restaurant / AboutAE — split "the story" grid: copy left, art-directed
 * charcoal plate (family photo) right. The plate keeps its ember/charcoal
 * gradient as the designed fallback when no photo is set.
 *
 * about.imageCaption is an optional extra field (the design's "The original
 * half-drum · Bayan-Bayanan Ave." plate caption); it stays hidden when unset.
 * about.quote / about.signature render only when provided.
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="about-sect">
  <div class="wrap grid2">
    <div class="about-copy reveal">
      {tag && <p class="kick" data-field="about.tag">{tag}</p>}
      {headline && <h2 class="about-h" data-field="about.headline" set:html={headline}></h2>}
      {paragraphs.map((p: string, i: number) => (
        <p class="about-p" data-field={`about.paragraphs.${i}`} set:html={p}></p>
      ))}
      {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
      {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
    </div>
    <figure class="plate about-plate reveal">
      {image && <div class="photo" data-image-field="about.image" style={`background-image:url('${image}');`}></div>}
      {imageCaption && <figcaption data-field="about.imageCaption">{imageCaption}</figcaption>}
    </figure>
  </div>
</section>
<style>
  .about-h { font-size: clamp(34px, 5vw, 56px); margin: 12px 0 20px; color: var(--bone); }
  .about-p { margin-bottom: 16px; color: var(--bone-dim); }
  .about-p:first-of-type { color: var(--bone); }
  .about-quote {
    font-family: var(--display); font-size: clamp(20px, 2.4vw, 28px);
    text-transform: uppercase; line-height: 1.1; color: var(--flame);
    margin: 24px 0 0; padding-left: 18px; border-left: 3px solid var(--ember);
  }
  .about-sign { margin-top: 18px; font-style: italic; color: var(--bone-dim); }
  .about-plate { min-height: 380px; }
  @media (max-width: 759px) { .about-plate { min-height: 300px; } }
</style>
