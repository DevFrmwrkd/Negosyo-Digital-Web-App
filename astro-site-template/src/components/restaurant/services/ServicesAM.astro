---
/**
 * restaurant / ServicesAM — "the kitchen" menu list on the bone band. Each row
 * is a numbered .m-item (clay index, serif title, smoke description, an
 * outlined category chip) with a clay wipe on hover. services.sub renders as
 * the closing "the full menu lives at the counter" note.
 *
 * services.items[i].tag is the design's optional category chip; price renders
 * only when present (mirrors the AE content model).
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
type Item = { title: string; desc?: string; price?: string; duration?: string; tag?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
---
{items.length > 0 && (
  <section class="menu sec-pad" id="menu">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" data-field="services.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="services.headline" set:html={headline}></h2>}
      </div>
      <div class="menu-list">
        {items.map((item, i) => (
          <article class="m-item reveal">
            <div class="no">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
              {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
            </div>
            {(item.tag ?? item.duration ?? item.price) && (
              <div class="tag" data-field={`services.items.${i}.tag`}>{item.tag ?? item.duration ?? item.price}</div>
            )}
          </article>
        ))}
      </div>
      {sub && <p class="menu-note" data-field="services.sub">{sub}</p>}
    </div>
  </section>
)}
<style>
  .menu { background: var(--bone); }
  .menu-list { border-top: 1px solid var(--line); }
  .m-item {
    display: grid; grid-template-columns: 64px 1fr auto; gap: 24px; align-items: baseline;
    padding: 30px 8px; border-bottom: 1px solid var(--line);
    transition: background .4s, padding .4s; position: relative; overflow: hidden;
  }
  .m-item::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--clay); transition: width .4s; opacity: .08; }
  .m-item:hover { padding-left: 22px; background: var(--paper-2); }
  .m-item:hover::before { width: 100%; }
  .m-item .no { font-family: var(--label); font-size: 13px; letter-spacing: .1em; color: var(--clay); position: relative; }
  .m-item h3 { font-size: clamp(24px,3vw,34px); position: relative; }
  .m-item p { color: var(--smoke); font-size: 16px; margin: .4em 0 0; max-width: 56ch; position: relative; }
  .m-item .tag {
    font-family: var(--label); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--smoke);
    border: 1px solid var(--line); padding: 5px 10px; border-radius: 100px; white-space: nowrap; position: relative; background: var(--paper);
  }
  .menu-note { margin-top: 20px; color: var(--smoke); font-size: 15px; font-family: var(--label); letter-spacing: .04em; }
  @media (max-width: 760px) {
    /* Drop the fixed chip column; let the tag wrap under the title so a
       long dish name + chip never forces horizontal overflow. */
    .m-item { grid-template-columns: 38px 1fr; gap: 4px 16px; padding: 22px 4px; }
    .m-item:hover { padding-left: 4px; }
    .m-item h3 { font-size: clamp(21px,5.6vw,30px); }
    .m-item .tag { grid-column: 2; justify-self: start; margin-top: 10px; }
  }
</style>
