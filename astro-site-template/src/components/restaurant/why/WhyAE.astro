---
/**
 * restaurant / WhyAE — split grid: big Anton headline left, ember-ruled reason
 * list right. Reads content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <p class="kick" data-field="why.tag">{tag}</p>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="why-item">
            <strong data-field={`why.items.${i}.title`}>{item.title}</strong>
            {(item.body ?? item.desc ?? item.description) && (
              <span class="why-body" data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-h { font-size: clamp(34px, 5vw, 56px); color: var(--bone); }
  .why-list { list-style: none; display: grid; gap: 22px; }
  .why-item { border-left: 3px solid var(--ember); padding-left: 18px; }
  .why-item strong { color: var(--bone); }
  .why-body { display: block; color: var(--bone-dim); margin-top: 2px; }
</style>
