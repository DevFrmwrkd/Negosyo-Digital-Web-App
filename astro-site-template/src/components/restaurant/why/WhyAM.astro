---
/**
 * restaurant / WhyAM — "why the regulars come back" reasons on the dark ink
 * band: a hairline-gridded set of .why-cell tiles, each led by an ember serif
 * roman numeral (decorative), a bone serif title and a dimmed body line.
 * Reads content.why.items (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x'];
---
{items.length > 0 && (
  <section class="why sec-pad">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" style="color:var(--bone);opacity:.6;" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="reveal" style="color:var(--paper);" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-grid">
        {items.map((item, i) => (
          <div class="why-cell reveal">
            <div class="k" aria-hidden="true">{roman[i] || String(i + 1)}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why { background: var(--ink); color: var(--bone); }
  .why-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; background: rgba(242,232,215,.14); border: 1px solid rgba(242,232,215,.14); }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; } }
  .why-cell { background: var(--ink); padding: 40px 34px; transition: background .4s; }
  .why-cell:hover { background: var(--ink-soft); }
  .why-cell .k { font-family: var(--serif); font-size: 44px; color: var(--ember); line-height: 1; }
  .why-cell h3 { font-size: 23px; margin: 16px 0 10px; color: var(--paper); }
  .why-cell p { color: var(--bone); opacity: .82; font-size: 16px; }
</style>
