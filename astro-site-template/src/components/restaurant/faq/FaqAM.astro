---
/**
 * restaurant / FaqAM — "visiting" accordion on the bone band, laid across two
 * columns. Serif summaries with a clay "+" that rotates to "×" on open; smoke
 * answer copy. The first item opens by default (lp-01's designed state).
 * Reads content.faq.items (q / a).
 */
interface Props { content: any; }
const { content } = Astro.props;
const faq = content.faq || {};
const tag = faq.tag || '';
const headline = faq.headline || '';
type Item = { q: string; a: string };
const items: Item[] = Array.isArray(faq.items) ? faq.items : (Array.isArray(faq) ? faq : []);
const mid = Math.ceil(items.length / 2);
const col1 = items.slice(0, mid);
const col2 = items.slice(mid);
---
{items.length > 0 && (
  <section class="faq sec-pad" id="faq">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" data-field="faq.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="faq.headline" set:html={headline}></h2>}
      </div>
      <div class="faq-grid">
        <div>
          {col1.map((item, i) => (
            <details class="reveal" open={i === 0}>
              <summary><span data-field={`faq.items.${i}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${i}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
        <div>
          {col2.map((item, j) => (
            <details class="reveal">
              <summary><span data-field={`faq.items.${mid + j}.q`}>{item.q}</span> <span class="pm" aria-hidden="true">+</span></summary>
              <div class="a" data-field={`faq.items.${mid + j}.a`} set:html={item.a}></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
<style>
  .faq { background: var(--bone); }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: 20px; } }
  details { border-bottom: 1px solid var(--line); padding: 8px 0; }
  details summary {
    list-style: none; cursor: pointer; padding: 16px 0; font-family: var(--serif); font-size: 21px; color: var(--ink);
    display: flex; justify-content: space-between; gap: 20px; align-items: center;
  }
  details summary::-webkit-details-marker { display: none; }
  details summary .pm { font-family: var(--label); font-size: 24px; color: var(--clay); transition: transform .3s; line-height: 1; }
  details[open] summary .pm { transform: rotate(45deg); }
  details .a { padding: 0 0 18px; color: var(--smoke); font-size: 17px; max-width: 60ch; }
  @media (max-width: 760px) {
    .faq-grid { grid-template-columns: 1fr; gap: 4px; }
    details summary { font-size: 19px; }
  }
</style>
