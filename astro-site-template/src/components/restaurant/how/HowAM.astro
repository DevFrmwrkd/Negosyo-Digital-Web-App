---
/**
 * restaurant / HowAM — "ways to eat with us" steps on the warm paper-2 band.
 * Each .step sits under an ink top-rule with an oversized bone serif numeral
 * (decorative), a serif title and a smoke body line. Reads content.how.steps
 * (canonical `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="how sec-pad">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="idx" data-field="how.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="how.headline" set:html={headline}></h2>}
      </div>
      <div class="steps">
        {steps.map((step, i) => (
          <div class="step reveal">
            <div class="sn" aria-hidden="true">{i + 1}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .how { background: var(--paper-2); }
  .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 28px; }
  @media (max-width: 820px) { .steps { grid-template-columns: repeat(2,1fr); gap: 34px; } }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
  .step { position: relative; padding-top: 26px; border-top: 2px solid var(--ink); }
  .step .sn { position: absolute; top: -20px; right: 0; font-family: var(--serif); font-size: 64px; color: var(--line); line-height: 1; }
  .step h3 { font-size: 22px; margin-bottom: 8px; }
  .step p { font-size: 15px; color: var(--smoke); }
</style>
