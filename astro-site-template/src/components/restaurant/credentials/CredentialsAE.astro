---
/**
 * restaurant / CredentialsAE — thin permits/registration row (ember checks over
 * bone-dim labels). Optional tag / headline render above when provided; the
 * design ships a bare row of ✓ items.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <p class="kick" data-field="credentials.tag">{tag}</p>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <div class="cred-item">
            <span class="check" aria-hidden="true">✓</span>
            <span class="cred-copy">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 40px 0; }
  .cred-head { margin-bottom: 22px; }
  .cred-h { font-size: clamp(28px, 4vw, 46px); color: var(--bone); margin-top: 10px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 20px 32px; color: var(--bone-dim); font-size: 14px; }
  .cred-item { display: flex; gap: 10px; align-items: baseline; }
  .check { color: var(--ember); font-weight: 700; }
  .cred-copy { display: inline-flex; flex-direction: column; }
  .cred-desc { color: var(--bone-dim); opacity: .72; font-size: 12.5px; margin-top: 2px; }
</style>
