---
/**
 * restaurant / CredentialsAM — "kept to standard" permits row on the dark ink
 * band: a hairline-gridded set of .cred tiles, each with a gold-ringed badge
 * (decorative), an uppercase label and a dimmed note. Reads
 * content.credentials.items (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="creds sec-pad">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="idx" style="color:var(--bone);opacity:.6;" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" style="color:var(--paper);" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="badge" aria-hidden="true">{i === items.length - 1 ? '✦' : '✓'}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--ink); color: var(--bone); }
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; background: rgba(242,232,215,.14); border: 1px solid rgba(242,232,215,.14); }
  @media (max-width: 760px) { .cred-row { grid-template-columns: 1fr; } }
  .cred { background: var(--ink); padding: 30px 26px; }
  .cred .badge { width: 38px; height: 38px; border: 1px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold); font-family: var(--serif); font-size: 17px; margin-bottom: 14px; }
  .cred h4 { font-family: var(--label); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--paper); margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--bone); opacity: .78; margin: 0; }
</style>
