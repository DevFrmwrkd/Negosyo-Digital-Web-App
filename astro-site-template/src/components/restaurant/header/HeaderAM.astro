---
/**
 * restaurant / HeaderAM — sticky bone-paper nav bar with a warm ember "fire"
 * dot beside the serif brand, letterpress uppercase links, and an outlined
 * "reserve" CTA. Hides on scroll-down / reappears on scroll-up (toggled by
 * PageAM's inline scroll handler via header.nav.hide).
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAM actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAM.
const PAGE_ANCHORS = new Set(['about', 'faq', 'gallery', 'location', 'main', 'menu', 'reserve', 'reviews']);
const ANCHOR_ALIAS: Record<string, string> = { services: 'menu', visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = (content as any).footer?.brand || layout.businessName || '';
// Nav links come from the same derived list ('#about', '#services', '#why',
// '#work', '#visit'). Resolve each against this page and drop the ones with no
// section to reach — a nav entry that scrolls nowhere is as broken as a dead
// CTA, and its label promises a section this design does not have. The original
// index rides along as .i so the editor's per-link field hooks stay correct.
const navLinks: Array<{ href: string; label: string; i: number }> =
  ((layout.navLinks && layout.navLinks.length) ? layout.navLinks : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href);
// The header's OWN button. navCtaText / navCtaHref is the top bar's own CTA
// field, so retyping it no longer retypes the hero's button, and roleColors
// keys the `headerCta` role to these two hooks — the pill is colourable on its
// own axis. Falls back to the hero's primary CTA so a site that never set the
// header's field keeps the button, and the label, it renders today.
const hero = (content as any).hero || {};
const ctaText = (content as any).navCtaText || hero.cta1?.text || '';
const ctaHref = onPage((content as any).navCtaHref || hero.cta1?.href, '#reserve');
---
<header class="nav">
  <div class="wrap nav-in">
    {brand && <a href="#main" class="brand" data-field="footer.brand"><span class="fire" aria-hidden="true"></span>{brand}</a>}
    {(navLinks.length > 0 || ctaText) && (
      <>
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-am-menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav-links" id="nav-am-menu" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
          ))}
          {ctaText && <a href={ctaHref} class="nav-cta" data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>}
        </nav>
      </>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-links');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('open'));
    });
    // Close the drawer after tapping any menu link.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.nav {
    position: sticky; top: 0; z-index: 50; background: rgba(251,246,236,.86);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
    transition: transform .4s;
  }
  header.nav.hide { transform: translateY(-100%); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; height: 66px; }
  .brand { font-family: var(--serif); font-size: 24px; letter-spacing: .02em; display: flex; align-items: center; gap: 10px; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand .fire { width: 11px; height: 11px; border-radius: 50%; background: var(--clay); box-shadow: 0 0 12px 2px rgba(180,71,43,.6); flex-shrink: 0; }
  .nav-links { display: flex; gap: 30px; align-items: center; }
  .nav-links a { font-family: var(--label); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); position: relative; }
  .nav-links a::after { content: ""; position: absolute; left: 0; bottom: -5px; height: 1px; width: 0; background: var(--clay); transition: width .3s; }
  .nav-links a:hover::after { width: 100%; }
  .nav-links a:hover { color: var(--ink); }
  .nav-cta { padding: 9px 18px; border: 1px solid var(--ink); border-radius: 2px; }
  .nav-cta:hover { background: var(--ink); color: var(--paper) !important; }
  .nav-cta::after { display: none !important; }

  /* Hamburger button — hidden on desktop, revealed as the mobile trigger. */
  .nav-burger { display: none; }

  @media (max-width: 760px) {
    /* Trigger: a 44px tap target with three letterpress-ink bars. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -10px;
      background: transparent; border: 0; cursor: pointer;
    }
    .nav-burger span {
      display: block; width: 24px; height: 2px; background: var(--ink);
      border-radius: 2px; transition: transform .3s ease, opacity .3s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Link list becomes a full-width drawer beneath the bar, in the
       design's own paper + line tokens so it matches the letterpress look. */
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -22px rgba(32,25,20,.5);
      padding: 6px 0 12px;
      max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-links {
      max-height: calc(100vh - 66px); overflow-y: auto; opacity: 1; visibility: visible;
    }
    .nav-links a {
      display: flex; align-items: center; min-height: 48px;
      padding: 6px 20px; font-size: 15px; color: var(--ink-soft);
      border-bottom: 1px solid var(--line);
    }
    .nav-links a::after { display: none !important; }
    .nav-cta {
      margin: 14px 20px 4px; padding: 14px 18px; min-height: 48px;
      justify-content: center; border-color: var(--ink);
      background: var(--ink); color: var(--paper) !important; border-bottom: 1px solid var(--ink);
    }
    /* Keep the bar (and its open drawer) visible even mid scroll-down-hide. */
    header.nav.open.hide { transform: none; }
  }
</style>
