---
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Restaurant';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const ctaText = (content as any).navCtaText || 'Reservations';
const ctaHref = (content as any).navCtaHref || '#visit';
---
<header class="nav">
  <div class="nav-in">
    <a href="#top" class="brand" data-field="footer.brand">{brand}</a>
    {(navLinks.length > 0 || ctaText) && (
      <>
        <nav class="nav-links" id="nav-u-menu" aria-label="Primary">
          {navLinks.map((link, i) => (
            <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
          ))}
          {ctaText && <a class="nav-resv-drawer" href={ctaHref} data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>}
        </nav>
        <div class="nav-right">
          {ctaText && <a class="nav-resv" href={ctaHref} data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>}
        </div>
        <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-u-menu">
          <span></span><span></span><span></span>
        </button>
      </>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.nav');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var menu = hdr.querySelector('.nav-links');
    if (!burger || !menu) return;
    function setOpen(open) {
      hdr.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () { setOpen(!hdr.classList.contains('open')); });
    // Close the drawer after tapping any menu link or the reserve CTA.
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  })();
</script>
<style>
  header.nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    transition: background .5s, border-color .5s, padding .5s;
    border-bottom: 1px solid transparent;
  }
  header.nav.scrolled {
    background: rgba(var(--paper-rgb), .94);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  header.nav.scrolled .nav-in { padding-block: 15px; }
  .nav-in {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; max-width: var(--maxw); margin: 0 auto;
    padding: 24px var(--pad); transition: padding .5s;
  }
  .brand {
    font-family: var(--serif); font-weight: 400; font-size: 27px;
    letter-spacing: .42em; text-transform: uppercase; padding-left: .42em;
    color: var(--ink);
  }
  .nav-links {
    display: flex; gap: 36px; align-items: center;
    font-family: var(--sans); font-weight: 600; font-size: 12px;
    letter-spacing: .16em; text-transform: uppercase;
  }
  .nav-links :global(a) { position: relative; padding: 3px 0; color: var(--ink); }
  .nav-links :global(a::after) {
    content: ""; position: absolute; left: 0; bottom: -3px;
    width: 0; height: 1px; background: var(--accent); transition: width .4s;
  }
  .nav-links :global(a:hover::after) { width: 100%; }
  .nav-right { display: flex; align-items: center; gap: 24px; }
  .nav-resv {
    font-family: var(--sans); font-weight: 600; font-size: 11px;
    letter-spacing: .2em; text-transform: uppercase;
    border: 1px solid var(--ink); padding: 12px 22px; color: var(--ink);
    transition: background .45s, color .45s;
  }
  .nav-resv:hover { background: var(--ink); color: var(--paper); }

  /* Hamburger + drawer reserve are desktop-hidden; revealed as the mobile UI. */
  .nav-burger { display: none; }
  .nav-resv-drawer { display: none; }

  @media (max-width: 760px) {
    .nav-in { padding-block: 18px; gap: 12px; }
    header.nav.scrolled .nav-in { padding-block: 14px; }
    /* Tighten the letterpress brand so long names never crowd the burger. */
    .brand { font-size: 21px; letter-spacing: .26em; padding-left: .26em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Trigger — a 44px tap target with three bars in the design's ink. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; margin-right: -8px;
      background: transparent; border: 0; cursor: pointer; z-index: 60;
    }
    .nav-burger span {
      display: block; width: 24px; height: 2px; background: var(--ink);
      border-radius: 2px; transition: transform .3s ease, opacity .3s ease;
    }
    header.nav.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.nav.open .nav-burger span:nth-child(2) { opacity: 0; }
    header.nav.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Keep the bar opaque behind the open drawer even at the top of the page. */
    header.nav.open {
      background: rgba(var(--paper-rgb), .97); backdrop-filter: blur(12px);
      border-bottom-color: var(--line);
    }

    /* Desktop inline links + pill give way to a full-width paper drawer. */
    .nav-right { display: none; }
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: rgba(var(--paper-rgb), .98); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(var(--ink-rgb), .5);
      padding: 6px 0 12px;
      max-height: 0; overflow: hidden; opacity: 0; visibility: hidden;
      transition: max-height .35s ease, opacity .25s ease, visibility .35s;
    }
    header.nav.open .nav-links {
      max-height: calc(100vh - 64px); overflow-y: auto; opacity: 1; visibility: visible;
    }
    .nav-links :global(a) {
      display: flex; align-items: center; min-height: 50px;
      padding: 6px var(--pad); font-size: 14px; letter-spacing: .16em;
      color: var(--ink); border-bottom: 1px solid var(--line);
    }
    .nav-links :global(a::after) { display: none; }
    /* Full-width reserve CTA at the base of the drawer — design's own ink fill. */
    .nav-links a.nav-resv-drawer {
      display: flex; justify-content: center; align-items: center; min-height: 52px;
      margin: 14px var(--pad) 2px; padding: 14px 22px;
      border: 1px solid var(--ink); background: var(--ink); color: var(--paper);
      font-family: var(--sans); font-weight: 600; font-size: 11px;
      letter-spacing: .2em; text-transform: uppercase; border-bottom: 1px solid var(--ink);
      transition: background .45s, color .45s, border-color .45s;
    }
    .nav-links a.nav-resv-drawer:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  }
</style>
