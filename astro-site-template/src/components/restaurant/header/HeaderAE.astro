---
/**
 * restaurant / HeaderAE — transparent charcoal nav overlaying the hero,
 * gaining a solid charcoal ground once scrolled (toggled by PageAE's inline
 * scroll handler via header.nav.scrolled). Brand in Anton, ember-warm links.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Business';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" data-field="footer.brand">{brand}</a>
    {navLinks.length > 0 && (
      <nav class="nav-links" aria-label="Main">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
      </nav>
    )}
    <div class="nav-cta">
      {phone && (
        <a href={`tel:${phoneDigits}`} class="nav-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
      )}
      <a href="#location" class="find">Find us ↓</a>
    </div>
  </div>
</header>
<style>
  header.nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    transition: background .3s ease, border-color .3s ease;
    border-bottom: 1px solid transparent;
  }
  header.nav.scrolled {
    background: rgba(var(--char-rgb), .92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--ash);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding-block: 18px;
  }
  .brand {
    font-family: var(--display); font-size: 20px; letter-spacing: .06em;
    color: var(--bone); text-transform: uppercase;
  }
  .brand:hover { color: var(--bone); }
  .nav-links { display: flex; gap: 26px; align-items: center; }
  .nav-links a {
    font-family: var(--body); text-transform: uppercase; letter-spacing: .18em;
    font-size: 11.5px; color: var(--bone); opacity: .78; transition: opacity .2s, color .2s;
  }
  .nav-links a:hover { opacity: 1; color: var(--ember); }
  .nav-cta { display: flex; align-items: center; gap: 18px; }
  .nav-phone {
    font-family: var(--body); letter-spacing: .04em; font-size: 13.5px;
    color: var(--bone);
  }
  .nav-phone:hover { color: var(--ember); }
  .find {
    font-family: var(--body); font-size: 13px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--bone);
  }
  .find:hover { color: var(--ember); }
  @media (max-width: 860px) { .nav-links { display: none; } }
  @media (max-width: 520px) { .nav-phone { display: none; } }
</style>
