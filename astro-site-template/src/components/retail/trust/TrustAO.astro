---
/**
 * retail / TrustAO — lp-03's yellow credibility strip under the index band: a
 * ruled row of Arial-Black stat/statement cells (the "3 generations · rating ·
 * 6 departments · in-store" band).
 *
 * Volatile Google rating / review slots have no dedicated field in the data
 * model, so they are expressed as ordinary trust cells (num renders via set:html
 * so a cell whose num is "★★★★★" still styles correctly).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust">
    <div class="wrap">
      {cells.map((cell, i) => (
        <div class="c reveal">
          {cell.num && <div class="n" data-field={`trust.cells.${i}.num`} set:html={cell.num}></div>}
          {cell.label && <div class="t" data-field={`trust.cells.${i}.label`}>{cell.label}</div>}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .trust { background: var(--yellow); color: var(--ink); border-bottom: 2px solid var(--ink); }
  .trust .wrap { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; }
  @media (max-width: 760px) { .trust .wrap { grid-template-columns: repeat(2,1fr); } }
  .trust .c { padding: 34px 24px; border-right: 2px solid var(--ink); }
  .trust .c:last-child { border-right: none; }
  @media (max-width: 760px) { .trust .c:nth-child(2n) { border-right: none; } .trust .c:nth-child(-n+2) { border-bottom: 2px solid var(--ink); } }
  .trust .c .n { font-family: var(--num); font-size: clamp(34px,4.5vw,54px); line-height: .9; }
  .trust .c .t { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; margin-top: 10px; }
  .trust .c :global(.stars) { letter-spacing: 2px; font-size: 22px; color: var(--red); }
</style>
