---
/**
 * retail / TrustAG — the double-ruled credibility strip under the masthead.
 * Renders content.trust.cells as an Oswald row of statements (the design's
 * "Serving builders since… · Google rating · today's hours" line). Volatile
 * Google rating / today's-hours slots have no dedicated field in the data
 * model, so they are expressed as ordinary trust cells (num + label).
 */
interface Props { content: any; }
const { content } = Astro.props;
const trust = content.trust || {};
const cells: Array<{ num: string; label: string }> = Array.isArray(trust.cells) ? trust.cells : (Array.isArray(trust) ? trust : []);
---
{cells.length > 0 && (
  <section class="trust-sect">
    <div class="wrap">
      <div class="dbl trust-bar">
        {cells.map((cell, i) => (
          <span class="trust-cell reveal">
            {cell.num && <span class="t-num" data-field={`trust.cells.${i}.num`} set:html={cell.num}></span>}
            {cell.label && <span class="t-lbl" data-field={`trust.cells.${i}.label`}>{cell.label}</span>}
          </span>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .trust-sect { padding: 0; }
  .trust-bar {
    border-bottom: 1px solid var(--ink);
    display: flex; flex-wrap: wrap; gap: 12px 28px;
    justify-content: space-between; align-items: center; padding: 16px 0;
    font-family: var(--label); font-size: 13px; text-transform: uppercase; letter-spacing: .1em;
  }
  .trust-cell { display: inline-flex; align-items: baseline; gap: 8px; }
  .trust-cell:first-child .t-num { color: var(--red); font-weight: 600; }
  .t-num { color: var(--ink); font-weight: 600; }
  .t-lbl { color: var(--faded); font-weight: 500; }
  @media (max-width: 520px) {
    .trust-bar { justify-content: flex-start; gap: 10px 20px; font-size: 12px; }
  }
</style>
