---
/**
 * retail / TestimonialsAO — lp-03's "What builders say" on the deep red band
 * under the oversized §06 index head (snum flips to yellow, rule + h2 to light).
 * Yellow-ruled .quote cards, each a bold statement over an uppercase Courier
 * attribution line. Reads content.testimonials.items (canonical `who` + `role`,
 * legacy `author` / `name` / `context`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const headline = test.headline || 'What builders say';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="sec quotes" id="reviews">
    <div class="wrap">
      <div class="sec-head" style="border-color:rgba(243,239,228,.35);">
        <div class="snum" aria-hidden="true" style="color:var(--yellow);">06</div>
        <h2 class="reveal" style="color:var(--paper);" data-field="testimonials.headline" set:html={headline}></h2>
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal">
              <p data-field={`testimonials.items.${i}.quote`}>“{item.quote}”</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes { background: var(--red); color: var(--paper); }
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 34px; }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; gap: 24px; } }
  .quote { border-top: 2px solid var(--yellow); padding-top: 20px; }
  .quote p { font-size: 19px; font-weight: 600; line-height: 1.5; }
  .quote .who { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; opacity: .9; }
</style>
