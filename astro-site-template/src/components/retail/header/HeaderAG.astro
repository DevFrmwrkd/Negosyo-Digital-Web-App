---
/**
 * retail / HeaderAG — thin broadsheet "dateline" strip above the masthead.
 *
 * The Broadsheet Catalog mockup has NO nav chrome — it opens straight on the
 * centered masthead. So this bar is additive: it renders ONLY when the site
 * supplies navLinks (or a phone), and stays out of the way as a slim, static,
 * double-ruled edition line. With no nav data it emits nothing, leaving the
 * pure masthead-first design intact.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || '';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const show = navLinks.length > 0;
---
{show && (
  <header class="dateline">
    <div class="wrap dateline-inner">
      <a href="#top" class="edition" data-field="footer.brand">{brand}</a>
      <nav class="dateline-nav" aria-label="Main">
        {navLinks.map((link, i) => (
          <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
        ))}
        {phone && (
          <a href={`tel:${phoneDigits}`} class="dateline-phone" data-field="contact.phone" data-href-field="contact.phone.href">{phone}</a>
        )}
      </nav>
    </div>
  </header>
)}
<style>
  .dateline {
    border-bottom: 4px double var(--ink);
    background: var(--news);
  }
  .dateline-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 20px; padding: 8px 20px; flex-wrap: wrap;
  }
  .edition {
    font-family: var(--label); font-size: 12px; letter-spacing: .22em;
    text-transform: uppercase; color: var(--ink); font-weight: 600;
  }
  .edition:hover { color: var(--red); }
  .dateline-nav { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .dateline-nav a {
    font-family: var(--label); font-size: 11px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--faded); font-weight: 500;
  }
  .dateline-nav a:hover { color: var(--red); }
  .dateline-phone { color: var(--ink) !important; }
  @media (max-width: 560px) { .dateline-phone { display: none; } }
</style>
