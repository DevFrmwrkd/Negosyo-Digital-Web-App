---
/**
 * retail / GalleryAG — "Photo section: the aisles". A grid of sepia halftone
 * plates. Like the reference, tiles are NOT filtered by image: every item keeps
 * its red/ink plate as the designed fallback and a photo layers over it via
 * data-image-field when set. The section auto-hides only when there are no
 * items at all. Leads with a double newsprint rule.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
---
{items.length > 0 && (
  <section class="gal-sect" id="gallery">
    <div class="wrap">
      {tag && <p class="rubric" data-field="gallery.tag">{tag}</p>}
      {headline && <h2 class="gal-h" data-field="gallery.headline" set:html={headline}></h2>}
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="gal-grid reveal">
        {items.map((item, i) => (
          <figure class="plate gal-tile">
            {item.image && <div class="photo" data-image-field={`gallery.items.${i}.image`} style={`background-image:url('${item.image}');`}></div>}
            {item.caption && <figcaption data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gal-sect { border-top: 4px double var(--ink); padding-top: 56px; }
  .gal-h { font-size: clamp(32px, 5vw, 54px); margin: 14px 0 26px; color: var(--ink); }
  .gal-sub { max-width: 52ch; color: var(--faded); margin: -14px 0 26px; }
  .gal-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .gal-tile { min-height: 250px; }
</style>
