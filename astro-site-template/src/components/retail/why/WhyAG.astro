---
/**
 * retail / WhyAG — the inverted ink band ("Why builders pass two malls to get
 * here"). Big Playfair headline left, ruled reason list right in Oswald caps
 * heads over newsprint-cream body. Reads content.why.items (canonical `body`,
 * legacy `desc`). headline uses set:html so authored <br> line breaks survive.
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <p class="rubric why-rubric" data-field="why.tag">{tag}</p>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-list reveal">
        {items.map((item, i) => (
          <div class="why-item">
            <strong class="why-title" data-field={`why.items.${i}.title`}>{item.title}</strong>
            {(item.body ?? item.desc ?? item.description) && (
              <p class="why-body" data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-sect { background: var(--ink); color: var(--news); }
  .why-rubric { color: #e8b6ae; }
  .why-h { font-size: clamp(32px, 5vw, 54px); color: var(--news); margin-top: 10px; }
  .why-list { display: grid; gap: 20px; }
  .why-item { border-bottom: 1px solid rgba(244,239,227,.25); padding-bottom: 16px; }
  .why-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .why-title {
    font-family: var(--label); text-transform: uppercase; letter-spacing: .06em;
    color: #e8b6ae; font-weight: 600; display: block;
  }
  .why-body { color: #c9c3b2; font-size: 15px; margin-top: 4px; }
  @media (max-width: 760px) {
    .why-h { font-size: clamp(28px, 6.4vw, 44px); }
    .why-list { gap: 16px; }
  }
</style>
