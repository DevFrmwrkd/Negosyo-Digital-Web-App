---
/**
 * retail / CredentialsAG — thin hairline-ruled registrations line, the
 * ◆-separated row of permits the design ships ("DTI-registered ◆ business
 * permit ◆ …"). Optional tag / headline render above when provided. Each item's
 * optional `desc` renders as a muted sub-note beneath its title.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="cred-sect">
    <div class="wrap">
      {(tag || headline) && (
        <div class="cred-head reveal">
          {tag && <p class="rubric" data-field="credentials.tag">{tag}</p>}
          {headline && <h2 class="cred-h" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row reveal">
        {items.map((item, i) => (
          <>
            {i > 0 && <span class="cred-sep" aria-hidden="true">◆</span>}
            <span class="cred-item">
              <span class="cred-title" data-field={`credentials.items.${i}.title`}>{item.title}</span>
              {item.desc && <span class="cred-desc" data-field={`credentials.items.${i}.desc`}>{item.desc}</span>}
            </span>
          </>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-sect { padding: 26px 0; border-top: 1px solid var(--rule); }
  .cred-head { margin-bottom: 18px; }
  .cred-h { font-size: clamp(26px, 4vw, 44px); color: var(--ink); margin-top: 10px; }
  .cred-row { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: baseline; font-size: 14px; color: var(--faded); }
  .cred-item { display: inline-flex; flex-direction: column; }
  .cred-sep { color: var(--red); }
  .cred-desc { color: var(--faded); opacity: .72; font-size: 12.5px; margin-top: 2px; }
  @media (max-width: 520px) {
    .cred-h { font-size: clamp(22px, 6vw, 34px); }
  }
</style>
