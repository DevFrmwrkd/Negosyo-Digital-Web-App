---
/**
 * retail / CredentialsAO — lp-03's "Registered & recognised" permits row on the
 * paper band under the oversized §09 index head. A ruled 4-up set of .cred tiles,
 * each with a red-outlined badge (decorative), an uppercase Courier label and a
 * short note. Reads content.credentials.items (title / desc); headline renders
 * in the index head.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const headline = cred.headline || 'Registered & recognised';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="sec creds">
    <div class="wrap">
      <div class="sec-head">
        <div class="snum" aria-hidden="true">09</div>
        <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>
      </div>
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="bdg" aria-hidden="true">{i === items.length - 1 ? '✦' : '✓'}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .creds { background: var(--paper); }
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; border: 2px solid var(--ink); }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { padding: 30px 24px; border-right: 2px solid var(--ink); }
  .cred:nth-child(4n) { border-right: none; }
  @media (max-width: 760px) { .cred:nth-child(2n) { border-right: none; } .cred:nth-child(-n+2) { border-bottom: 2px solid var(--ink); } }
  .cred .bdg { width: 36px; height: 36px; border: 2px solid var(--red); display: flex; align-items: center; justify-content: center; color: var(--red); font-weight: 800; margin-bottom: 14px; }
  .cred h4 { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--ink2); margin: 0; }
</style>
