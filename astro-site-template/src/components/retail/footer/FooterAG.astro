---
/**
 * retail / FooterAG — double-ruled broadsheet colophon (Playfair brand, red
 * links) plus the design's fixed "click-to-message" pill. Every column
 * auto-hides when empty, so with just a brand + address it collapses to the
 * design's minimal three-line footer.
 *
 * The floating message pill reuses the footer's own CTA (content.footer.cta)
 * so it stays editable and in sync; it renders only when that CTA (or the
 * CTA-band's) has a link.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAG actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAG.
const PAGE_ANCHORS = new Set(['gallery', 'location', 'reviews', 'top']);
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
const f = (content as any).footer || {};
// No "Your Business" stand-in: a placeholder wordmark ships as the customer's
// own name. The brand line hides instead of rendering an empty slot.
const brand = f.brand || layout.businessName || '';
const blurb = f.blurb || f.brand_blurb || '';
const visitLines: string[] = Array.isArray(f.visit?.lines) && f.visit.lines.length
  ? f.visit.lines
  : ([layout.contact?.address, layout.contact?.phone].filter(Boolean) as string[]);
const explore: Array<{ text: string; href: string }> = Array.isArray(f.explore?.links) && f.explore.links.length
  ? f.explore.links
  : [];
const hoursRows: Array<{ day: string; time: string }> = Array.isArray(f.hours) ? f.hours : [];
const social: Array<{ platform: string; url: string }> = Array.isArray(f.social) && f.social.length
  ? f.social
  : (Array.isArray(layout.socialLinks) ? layout.socialLinks : []);
const notes: string[] = Array.isArray(f.notes) && f.notes.length ? f.notes : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');

// Floating message pill — reuse the hero's primary CTA (falls back to CTA-band).
const hero = (content as any).hero || {};
const cband = (content as any).ctaBand || {};
// The footer's OWN button. footer.cta.* wins; left blank — as it is on every
// site built before the field existed — it still borrows the hero's primary
// CTA, then the CTA-band's, so no live footer loses its pill. The hooks below
// point at footer.cta.*, so the owner's first edit lands there and this
// button's label, link and colour part company with the hero's from then on.
const msgHref = onPage(f.cta?.href || hero.cta1?.href || cband.cta1?.href, '');
// Neutral affordance only. "Send your list" implied a quote-by-materials-list
// service model that most retailers on this template do not run; the sibling
// footers (AO / AN) already default to a plain message verb.
// No default label: "Message us" asserts a messaging channel the store may
// not run.
// No CTA text from the owner => no pill.
const msgText = f.cta?.text || hero.cta1?.text || cband.cta1?.text || '';
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        {brand && <div class="brand" data-field="footer.brand">{brand}</div>}
        {blurb && <p class="foot-blurb" data-field="footer.blurb">{blurb}</p>}
        {social.length > 0 && (
          <div class="foot-social">
            {social.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 data-field={`footer.social.${i}.platform`}
                 data-href-field={`footer.social.${i}.url`}>{s.platform}</a>
            ))}
          </div>
        )}
      </div>
      {visitLines.length > 0 && (
        <div class="foot-col">
          <h4>Visit</h4>
          {visitLines.map((line, i) => (
            line === phone && phone
              ? <a href={`tel:${phoneDigits}`} data-field={`footer.visit.lines.${i}`}>{line}</a>
              : <span class="li" data-field={`footer.visit.lines.${i}`}>{line}</span>
          ))}
        </div>
      )}
      {explore.length > 0 && (
        <div class="foot-col">
          <h4>Explore</h4>
          {explore.map((l, i) => (
            <a href={l.href}
               data-field={`footer.explore.links.${i}.text`}
               data-href-field={`footer.explore.links.${i}.href`}>{l.text}</a>
          ))}
        </div>
      )}
      {hoursRows.length > 0 && (
        <div class="foot-col foot-hours">
          <h4>Hours</h4>
          {hoursRows.map((row, i) => (
            <div class="hrow">
              <span data-field={`footer.hours.${i}.day`}>{row.day}</span>
              <span data-field={`footer.hours.${i}.time`}>{row.time}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    {notes.length > 0 && (
      <div class="foot-bottom">
        {notes.map((n, i) => (<span data-field={`footer.notes.${i}`}>{n}</span>))}
      </div>
    )}
  </div>
</footer>
{msgHref && msgText && (
  <div class="c2m">
    <a href={msgHref} aria-label={msgText} data-field="footer.cta.text" data-href-field="footer.cta.href">
      <span aria-hidden="true">✉</span> {msgText}
    </a>
  </div>
)}
<style>
  .foot { padding: 40px 0; border-top: 4px double var(--ink); }
  .foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
  .foot-brand .brand { font-family: var(--display); font-weight: 900; font-size: 20px; color: var(--ink); }
  .foot-blurb { color: var(--faded); font-size: 14px; max-width: 34ch; margin: 12px 0 0; }
  .foot-social { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
  .foot-social a {
    font-family: var(--label); font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--faded); border: 1px solid var(--rule); padding: 6px 12px;
    transition: color .2s, border-color .2s;
  }
  .foot-social a:hover { color: var(--red); border-color: var(--red); }
  .foot-col h4 { font-family: var(--label); text-transform: uppercase; letter-spacing: .18em; font-size: 11px; color: var(--red); margin: 0 0 14px; font-weight: 600; }
  .foot-col a, .foot-col .li { display: block; color: var(--faded); font-size: 14px; padding: 5px 0; }
  .foot-col a:hover { color: var(--ink); }
  .foot-hours .hrow { display: flex; justify-content: space-between; max-width: 260px; padding: 2px 0; font-size: 14px; color: var(--faded); gap: 16px; }
  .foot-bottom { border-top: 1px solid var(--rule); margin-top: 36px; padding: 22px 0 0; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--faded); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 28px; } }

  .c2m { position: fixed; right: 16px; bottom: 16px; z-index: 60; }
  .c2m a {
    display: flex; align-items: center; gap: 8px; background: var(--ink);
    color: var(--news); font-family: var(--label); font-weight: 600;
    font-size: 13px; text-transform: uppercase; letter-spacing: .08em;
    padding: 14px 18px; box-shadow: 0 6px 18px rgba(32,32,28,.35); min-height: 48px;
  }
  .c2m a:hover { background: var(--red); color: var(--news); }
  @media (max-width: 520px) {
    .foot { padding: 32px 0; }
    .foot-grid { gap: 26px; }
    .foot-bottom { margin-top: 26px; }
    .c2m { right: 12px; bottom: 12px; }
    .c2m a { padding: 12px 14px; font-size: 12px; }
  }
</style>
