---
/**
 * retail / ServicesAO — lp-03's signature horizontal scroll-snap catalog rail
 * under the oversized §02 index head. Each department is a numbered .dept card
 * (Arial-Black index, uppercase title, description, an optional wrap of Courier
 * feature chips). The cards carry the #dept-N anchors the hero's index band
 * links to.
 *
 * Folded in below the rail is lp-03's COUNTER-SERVICES block (§03 "At the
 * counter") — a three-up grid of counter services. It reads the optional
 * content.services.counter[] array and stays hidden until populated, so it never
 * fabricates an offering. Core rail items follow the AM services model
 * (title / desc); features[] is an optional per-item extra.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const headline = services.headline || 'The departments';
type Item = { title: string; desc?: string; features?: string[]; tag?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
type Counter = { title: string; desc?: string };
const counter: Counter[] = Array.isArray(services.counter) ? services.counter : [];
const counterHeadline = services.counterHeadline || 'At the counter';
---
{items.length > 0 && (
  <section class="sec depts" id="departments">
    <div class="wrap">
      <div class="sec-head">
        <div class="snum" aria-hidden="true">02</div>
        <h2 class="reveal" data-field="services.headline" set:html={headline}></h2>
      </div>
      <div class="rail-hint reveal" aria-hidden="true"><span>Scroll the catalog</span><span class="ln"></span><span>→</span></div>
      <div class="rail reveal" tabindex="0" aria-label="Departments, scroll horizontally">
        {items.map((item, i) => {
          const feats: string[] = Array.isArray(item.features) ? item.features : [];
          return (
            <article class="dept" id={`dept-${i + 1}`}>
              <div class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
              {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
              {feats.length > 0 && (
                <ul>
                  {feats.map((f, j) => (<li data-field={`services.items.${i}.features.${j}`}>{f}</li>))}
                </ul>
              )}
            </article>
          );
        })}
      </div>

      {counter.length > 0 && (
        <div class="counter-block">
          <div class="sec-head counter-head">
            <div class="snum" aria-hidden="true">03</div>
            <h2 class="reveal" data-field="services.counterHeadline" set:html={counterHeadline}></h2>
          </div>
          <div class="counter-grid">
            {counter.map((c, i) => (
              <div class="cserv reveal">
                <div class="k" aria-hidden="true">SVC/{String(i + 1).padStart(2, '0')}</div>
                <h3 data-field={`services.counter.${i}.title`}>{c.title}</h3>
                {c.desc && <p data-field={`services.counter.${i}.desc`}>{c.desc}</p>}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
<style>
  .depts { background: var(--paper2); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .rail-hint { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--steel); display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
  .rail-hint .ln { flex: 1; height: 1px; background: var(--line); }
  .rail { display: flex; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; border: 2px solid var(--ink); -webkit-overflow-scrolling: touch; }
  .rail::-webkit-scrollbar { height: 10px; }
  .rail::-webkit-scrollbar-thumb { background: var(--ink); }
  .rail::-webkit-scrollbar-track { background: var(--paper); }
  .dept { min-width: 340px; flex: 0 0 340px; scroll-snap-align: start; border-right: 2px solid var(--ink); padding: 28px 26px 30px; background: var(--paper); transition: background .3s; }
  .dept:last-child { border-right: none; }
  .dept:hover { background: #fff; }
  @media (max-width: 520px) { .dept { min-width: 82vw; flex-basis: 82vw; } }
  .dept .no { font-family: var(--num); font-size: 64px; line-height: .8; color: var(--red); }
  .dept h3 { font-size: 24px; text-transform: uppercase; margin: 14px 0 8px; }
  .dept p { color: var(--ink2); font-size: 15px; }
  .dept ul { list-style: none; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 6px; }
  .dept ul li { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; border: 1px solid var(--line); padding: 5px 9px; color: var(--ink2); }

  /* Folded COUNTER-SERVICES (§03). */
  .counter-block { margin-top: 72px; }
  .counter-head { margin-bottom: 40px; }
  .counter-head h2 { text-transform: uppercase; }
  .counter-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; background: var(--ink); border: 2px solid var(--ink); }
  @media (max-width: 820px) { .counter-grid { grid-template-columns: 1fr; } }
  .cserv { background: var(--paper); padding: 32px 28px; transition: background .3s; }
  .cserv:hover { background: var(--yellow); }
  .cserv .k { font-family: var(--mono); font-size: 12px; color: var(--red); letter-spacing: .1em; }
  .cserv h3 { font-size: 22px; text-transform: uppercase; margin: 12px 0 8px; }
  .cserv p { color: var(--ink2); font-size: 15px; margin: 0; }
  @media (max-width: 760px) {
    .counter-grid { grid-template-columns: 1fr; }
    .counter-block { margin-top: 52px; }
    .counter-head { margin-bottom: 28px; }
    .dept { min-width: 300px; flex-basis: 300px; }
    .dept .no { font-size: 54px; }
  }
</style>
