---
/**
 * retail / CtaBandAO — lp-03's full-width ink closer, centred, capped by a
 * yellow top rule: "Come by, or just call." A red Courier kicker over an
 * oversized uppercase headline and up to three CTAs (yellow / red-fill / ghost).
 * The ghost is recoloured for the dark band here. cta3 is the optional
 * click-to-message action (lp-03 ships three). Anchors #reserve for parity with
 * the nav / hero CTA targets.
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const cta = content.ctaBand || content.closing || {};
const tag = cta.tag || '';
const headline = cta.headline || '';
const sub = cta.sub || '';
const cta1Text = cta.cta1?.text || '';
const cta1Href = cta.cta1?.href || '#location';
const cta2Text = cta.cta2?.text || '';
const cta2Href = cta.cta2?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '');
const cta3Text = cta.cta3?.text || '';
const cta3Href = cta.cta3?.href || '#location';
const hasButtons = !!(cta1Text || cta2Text || cta3Text);
---
{(headline || hasButtons) && (
  <section class="sec cta-band" id="reserve">
    <div class="wrap">
      {tag && <div class="kicker" style="color:var(--yellow);" data-field="ctaBand.tag">{tag}</div>}
      {headline && <h2 class="reveal" data-field="ctaBand.headline" set:html={headline}></h2>}
      {sub && <p class="cta-sub" data-field="ctaBand.sub">{sub}</p>}
      {hasButtons && (
        <div class="cta-row">
          {cta1Text && <a href={cta1Href} class="btn btn--yellow" rel="noopener" data-field="ctaBand.cta1.text" data-href-field="ctaBand.cta1.href">{cta1Text}</a>}
          {cta2Text && <a href={cta2Href} class="btn btn--fill" rel="noopener" data-field="ctaBand.cta2.text" data-href-field="ctaBand.cta2.href">{cta2Text}</a>}
          {cta3Text && <a href={cta3Href} class="btn btn--ghost cta-ghost" rel="noopener" data-field="ctaBand.cta3.text" data-href-field="ctaBand.cta3.href">{cta3Text}</a>}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .cta-band { background: var(--ink); color: var(--paper); text-align: center; border-top: 3px solid var(--yellow); }
  .cta-band h2 { font-size: clamp(38px,6vw,84px); text-transform: uppercase; margin: 12px 0 20px; color: var(--paper); }
  .cta-band h2 :global(.yel) { color: var(--yellow); }
  .cta-sub { color: var(--paper2); opacity: .9; max-width: 52ch; margin: 0 auto 22px; }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta-ghost { color: var(--paper); border-color: var(--paper); }
  .cta-ghost:hover { box-shadow: 4px 4px 0 var(--yellow); }
</style>
