---
/**
 * autoshop / ServicesAP — "what we handle": a hairline-gridded set of .svc
 * cards on the panel band, each with a mono SVC/nn index, a condensed title,
 * a concrete description, an amber top-wipe on hover and an oversized ghost
 * numeral (decorative). The index + ghost numeral are decorative chrome; the
 * title/desc read from content.services.items (canonical `desc`).
 *
 * services.items[i].tag renders as an optional category note when present.
 * services.sub renders as a closing note when present.
 */
interface Props { content: any; }
const { content } = Astro.props;
const services = content.services || {};
const tag = services.tag || '';
const headline = services.headline || '';
const sub = services.sub || '';
type Item = { title: string; desc?: string; price?: string; duration?: string; tag?: string };
const items: Item[] = Array.isArray(services.items) ? services.items : (Array.isArray(services) ? services : []);
---
{items.length > 0 && (
  <section class="sec seamtop rev services" id="services">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="services.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="services.headline" set:html={headline}></h2>}
      </div>
      <div class="svc-grid">
        {items.map((item, i) => (
          <article class="svc reveal">
            <div class="no">SVC/{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`services.items.${i}.title`}>{item.title}</h3>
            {item.desc && <p data-field={`services.items.${i}.desc`}>{item.desc}</p>}
            {(item.tag ?? item.duration ?? item.price) && (
              <div class="svc-tag" data-field={`services.items.${i}.tag`}>{item.tag ?? item.duration ?? item.price}</div>
            )}
            <span class="spd" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </article>
        ))}
      </div>
      {sub && <p class="svc-note" data-field="services.sub">{sub}</p>}
    </div>
  </section>
)}
<style>
  .services { background: var(--panel); }
  .svc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 760px) { .svc-grid { grid-template-columns: 1fr; } .svc { padding: 28px 22px; } }
  .svc { background: var(--panel2); padding: 34px 30px; position: relative; overflow: hidden; transition: background .3s; }
  .svc::before { content: ""; position: absolute; left: 0; top: 0; height: 3px; width: 0; background: var(--amber); transition: width .4s; }
  .svc:hover { background: #22262c; }
  .svc:hover::before { width: 100%; }
  .svc .no { font-family: var(--mono); font-size: 12px; color: var(--amber); letter-spacing: .1em; }
  .svc h3 { font-size: 26px; margin: 14px 0 10px; }
  .svc p { color: var(--concrete); font-size: 15px; margin: 0; position: relative; }
  .svc-tag { margin-top: 12px; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--concrete); border: 1px solid var(--line); padding: 5px 10px; display: inline-block; position: relative; }
  .svc .spd { position: absolute; right: -40px; bottom: 14px; font-family: var(--big); font-size: 70px; color: rgba(255,106,0,.06); transition: right .4s; }
  .svc:hover .spd { right: 10px; }
  .svc-note { margin-top: 20px; color: var(--concrete); font-size: 15px; font-family: var(--mono); letter-spacing: .04em; }
</style>
