---
/**
 * autoshop / HowAP — "how it works" steps on the panel band. Each .step sits
 * behind an amber left-rule with an oversized stencil numeral (decorative), a
 * condensed title and a concrete body line. Reads content.how.steps (canonical
 * `body`, legacy `desc`). how.tag drives the "// 04" snum.
 */
interface Props { content: any; }
const { content } = Astro.props;
const how = content.how || {};
const tag = how.tag || '';
const headline = how.headline || '';
type Step = { title: string; body?: string; desc?: string; description?: string };
const steps: Step[] = Array.isArray(how.steps) ? how.steps : (Array.isArray(how.items) ? how.items : []);
---
{steps.length > 0 && (
  <section class="sec seamtop rev how">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="how.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="how.headline" set:html={headline}></h2>}
      </div>
      <div class="steps">
        {steps.map((step, i) => (
          <div class="step reveal">
            <div class="sn" aria-hidden="true">{i + 1}</div>
            <h3 data-field={`how.steps.${i}.title`}>{step.title}</h3>
            {(step.body ?? step.desc ?? step.description) && (
              <p data-field={`how.steps.${i}.body`}>{step.body ?? step.desc ?? step.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .how { background: var(--panel); }
  .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
  @media (max-width: 820px) { .steps { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
  .step { padding: 26px 24px; background: var(--panel2); border-left: 3px solid var(--amber); }
  .step .sn { font-family: var(--big); font-size: 44px; color: var(--amber); line-height: .9; }
  .step h3 { font-size: 20px; margin: 10px 0 6px; }
  .step p { font-size: 14px; color: var(--concrete); }
</style>
