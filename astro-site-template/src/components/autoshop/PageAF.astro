---
/**
 * autoshop / PageAF — "Job-Sheet Industrial" (art-directed repair-shop page).
 *
 * A workshop-stencil design: hazard-yellow-and-black chevrons, IBM Plex Mono
 * job-sheet labels, Saira Condensed stencil display, engineering graph-paper
 * ground, and hard-shadowed "sheet" panels that read like the shop's own
 * paperwork. Signature interactions preserved from the source mockup:
 *   - hazard chevron SWEEP inside every .btn on hover (.btn::before)
 *   - hazard chevron STRIPS (.chev) framing the hero + footer
 *   - offset hard shadow on .sheet panels, tilted hero plate
 *
 * Design isolation: the hazard/ink palette + base primitives (.btn / .sheet /
 * .plate / .chev / details) are scoped to `html[data-page="AF"]` in the global
 * block below so the sister autoshop variants (P–T) never inherit this
 * variant's tokens or its bespoke primitives (and vice-versa). Because this
 * design's vocabulary (mono body, stencil display, graph-paper ground) is so
 * far from AutoshopSpine's concrete base, the base CSS is inlined here instead
 * of importing AutoshopSpine.
 *
 * lockVariant: true — only an EXPLICIT admin color/font pick recolors; the
 * hand-tuned hazard palette wins by default.
 */
import HeaderAF from './header/HeaderAF.astro';
import HeroAF from './hero/HeroAF.astro';
import TrustAF from './trust/TrustAF.astro';
import AboutAF from './about/AboutAF.astro';
import ServicesAF from './services/ServicesAF.astro';
import WhyAF from './why/WhyAF.astro';
import HowAF from './how/HowAF.astro';
import TestimonialsAF from './testimonials/TestimonialsAF.astro';
import GalleryAF from './gallery/GalleryAF.astro';
import FaqAF from './faq/FaqAF.astro';
import AreaAF from './area/AreaAF.astro';
import CredentialsAF from './credentials/CredentialsAF.astro';
import LocationAF from './location/LocationAF.astro';
import CtaBandAF from './ctaBand/CtaBandAF.astro';
import FooterAF from './footer/FooterAF.astro';
import { resolveTheme, buildFontHref, buildOverrideCss } from '../../lib/genericThemeOverrides';

interface Props { siteData: any; }
const { siteData } = Astro.props;
const layout = siteData.layout ?? {};
const content = siteData.content ?? {};
const visibility = siteData.visibility ?? {};
const title = layout.businessName
  ? `${layout.businessName}${layout.tagline ? ' — ' + layout.tagline : ''}`
  : 'Welcome';
const { scheme: __themeScheme, pairing: __themePairing } = resolveTheme(layout, (content as any).business_type, { lockVariant: true });
const __overrideCss = buildOverrideCss(__themeScheme, __themePairing);
const __fontHref = buildFontHref(__themePairing);
---

<!DOCTYPE html>
<html lang="en" data-page="AF">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {content.description && <meta name="description" content={content.description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;800&family=IBM+Plex+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  {layout.favicon && <link rel="icon" href={layout.favicon} />}
  {(layout.ogImage || layout.favicon) && <meta property="og:image" content={layout.ogImage || layout.favicon} />}

  <!-- Palette tokens + shared base primitives, scoped to html[data-page="AF"]
       so they never leak to sister autoshop variants (P–T). -->
  <style is:global>
    html[data-page="AF"] {
      --ink: #15181b; --steel: #2a2f34; --steel-2: #31363b;
      --paper: #eef0ee; --paper-2: #ffffff; --line: #c9cec7;
      --haz: #f5c518; --haz-dark: #caa000; --red: #d0342c;
      --ink-soft: #3d4348;
      --ink-rgb: 21,24,27; --paper-rgb: 238,240,238; --haz-rgb: 245,197,24; --red-rgb: 208,52,44;
      --display: "Saira Condensed", Impact, sans-serif;
      --body: "IBM Plex Mono", ui-monospace, monospace;
      --pad: clamp(20px, 5vw, 60px); --maxw: 1080px;
      /* Generic aliases so the theme-override machinery + any inherited rule
         stay legible even though components read the design's own tokens. */
      --accent: #f5c518; --accent-rgb: 245,197,24;
      --sans: "IBM Plex Mono", ui-monospace, monospace;
      --serif: "Saira Condensed", Impact, sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, monospace;
      --muted: rgba(21,24,27,.62);
      --on-accent: #15181b; --on-ink: #eef0ee; --on-paper: #15181b;
    }
    html[data-page="AF"] * { margin: 0; padding: 0; box-sizing: border-box; }
    html[data-page="AF"] { scroll-behavior: smooth; }
    html[data-page="AF"] body {
      background: var(--paper); color: var(--ink);
      font-family: var(--body); font-size: 15px; line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      background-image:
        linear-gradient(var(--line) 1px, transparent 1px),
        linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 32px 32px;
    }
    html[data-page="AF"] a { color: var(--ink); text-decoration: none; }
    html[data-page="AF"] a:hover { color: var(--red); }
    html[data-page="AF"] img { max-width: 100%; display: block; }
    html[data-page="AF"] h1,
    html[data-page="AF"] h2,
    html[data-page="AF"] h3 {
      font-family: var(--display); font-weight: 800; text-transform: uppercase;
      line-height: .92; letter-spacing: -.01em;
    }
    html[data-page="AF"] section { padding: 68px 0; position: relative; }

    html[data-page="AF"] .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }

    /* Job-sheet tag pill — ink ground, hazard mono label. */
    html[data-page="AF"] .tag {
      display: inline-block; background: var(--ink); color: var(--haz);
      font-size: 11px; letter-spacing: .24em; text-transform: uppercase;
      padding: 5px 12px; font-weight: 700; font-family: var(--body);
    }

    /* Hazard chevron strip (design signature, frames hero + footer). */
    html[data-page="AF"] .chev {
      height: 14px;
      background: repeating-linear-gradient(-45deg, var(--haz) 0 14px, var(--ink) 14px 28px);
    }

    /* Buttons — ink fill, hazard stencil type, with the signature chevron
       SWEEP that wipes across on hover (design signature). */
    html[data-page="AF"] .btn {
      position: relative; overflow: hidden; display: inline-flex; align-items: center;
      min-height: 52px; padding: 14px 30px; background: var(--ink); color: var(--haz);
      font-family: var(--display); font-weight: 800; font-size: 18px;
      text-transform: uppercase; letter-spacing: .06em; text-decoration: none;
      border: 3px solid var(--ink); cursor: pointer;
    }
    html[data-page="AF"] .btn::before {
      content: ""; position: absolute; inset: 0;
      background: repeating-linear-gradient(-45deg, var(--haz) 0 14px, transparent 14px 28px);
      transform: translateX(-101%); transition: transform .35s cubic-bezier(.2,.8,.2,1); opacity: .35;
    }
    html[data-page="AF"] .btn:hover::before { transform: translateX(0); }
    html[data-page="AF"] .btn:hover { color: var(--haz); }
    html[data-page="AF"] .btn.alt { background: var(--paper); color: var(--ink); border-color: var(--ink); }
    html[data-page="AF"] .btn.alt:hover { color: var(--ink); }

    /* Job-sheet panel — white card, ink border, offset hard shadow. */
    html[data-page="AF"] .sheet { background: #fff; border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }

    /* Art-directed "plate" — brushed-steel gradient that stays as the designed
       fallback background of every data-image-field photo slot. */
    html[data-page="AF"] .plate {
      position: relative; overflow: hidden;
      background:
        linear-gradient(135deg, rgba(21,24,27,.85), rgba(42,47,52,.6)),
        repeating-linear-gradient(0deg, #31363b 0 4px, #2a2f34 4px 9px);
      border: 2px solid var(--ink); min-height: 220px; display: flex; align-items: flex-end;
    }
    html[data-page="AF"] .plate .photo { position: absolute; inset: 0; background-size: cover; background-position: center; }
    html[data-page="AF"] .plate figcaption {
      position: relative; width: 100%; background: var(--haz); color: var(--ink);
      font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
      padding: 8px 12px; border-top: 2px solid var(--ink);
    }

    /* FAQ accordion — white sheet rows, red ▸ that rotates to ▾ on open. */
    html[data-page="AF"] details { background: #fff; border: 2px solid var(--ink); margin-bottom: 10px; }
    html[data-page="AF"] summary {
      cursor: pointer; padding: 16px 18px; font-weight: 700; list-style: none;
      display: flex; justify-content: space-between; gap: 14px; min-height: 44px;
      align-items: center; font-size: 14px;
    }
    html[data-page="AF"] summary::-webkit-details-marker { display: none; }
    html[data-page="AF"] summary::after { content: "\25B8"; color: var(--red); transition: transform .2s; }
    html[data-page="AF"] details[open] summary::after { transform: rotate(90deg); }
    html[data-page="AF"] details .faq-a { padding: 0 18px 16px; font-size: 14px; color: var(--ink-soft); }

    /* Scroll-reveal (driven by the inline IntersectionObserver below). */
    html[data-page="AF"] .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
    html[data-page="AF"] .reveal.in { opacity: 1; transform: none; }

    html[data-page="AF"] .grid2 { display: grid; gap: 36px; }
    @media (min-width: 780px) {
      html[data-page="AF"] .grid2 { grid-template-columns: 1fr 1fr; align-items: start; }
    }
    @media (prefers-reduced-motion: reduce) {
      html[data-page="AF"] .reveal { opacity: 1; transform: none; transition: none; }
      html[data-page="AF"] * { animation: none !important; }
    }
  </style>

  {__fontHref && <link href={__fontHref} rel="stylesheet" />}
  <style is:global set:html={__overrideCss}></style>
</head>
<body>
  <HeaderAF layout={layout} content={content} />
  <main id="top">
    {visibility.heroSection !== false && <HeroAF content={content} layout={layout} />}
    {visibility.trustBlock !== false && <TrustAF content={content} />}
    {visibility.aboutSection !== false && <AboutAF content={content} />}
    {visibility.servicesSection !== false && <ServicesAF content={content} />}
    {visibility.whyUsBlock !== false && <WhyAF content={content} />}
    {visibility.howItWorksBlock !== false && <HowAF content={content} />}
    {visibility.testimonialsBlock !== false && <TestimonialsAF content={content} />}
    {visibility.gallerySection !== false && <GalleryAF content={content} layout={layout} />}
    {visibility.faqBlock !== false && <FaqAF content={content} />}
    {visibility.serviceAreaBlock !== false && <AreaAF content={content} />}
    {visibility.credentialsBlock !== false && <CredentialsAF content={content} />}
    {visibility.locationBlock !== false && <LocationAF content={content} layout={layout} />}
  </main>
  {visibility.ctaBandBlock !== false && <CtaBandAF content={content} layout={layout} />}
  <FooterAF layout={layout} content={content} />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !document.hidden) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
      var hdr = document.querySelector('header.site');
      if (hdr) {
        var onScroll = function () { if (window.scrollY > 16) hdr.classList.add('scrolled'); else hdr.classList.remove('scrolled'); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
      // Autoshop-AF Leaflet boot — accepts (lat, lng, label) from LocationAF.
      // Works for both build-time-geocoded coords AND client-side Nominatim
      // fallback coords (LocationAF calls this with whatever it resolves).
      window.__autoshopAFInitMap = function (lat, lng, label) {
        if (!window.L) return;
        var el = document.getElementById('map'); if (!el) return;
        el.innerHTML = '';
        var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 15);
        L.tileLayer('https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19, subdomains: 'abcd' }).addTo(map);
        var icon = L.divIcon({ className: '', html: '<div style="width:20px;height:20px;background:#f5c518;border:3px solid #15181b;box-shadow:0 3px 8px rgba(0,0,0,.35);"></div>', iconSize: [20, 20], iconAnchor: [10, 20] });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup('<b>' + label + '</b>');
      };
    })();
  </script>
</body>
</html>
