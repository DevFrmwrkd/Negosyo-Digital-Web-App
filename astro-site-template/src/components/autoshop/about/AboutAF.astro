---
/**
 * autoshop / AboutAF — "shop history" split: a hard-shadowed job-sheet panel of
 * copy left, an art-directed brushed-steel plate (shop photo) right. The plate
 * keeps its steel gradient as the designed fallback when no photo is set.
 *
 * about.imageCaption is an optional extra field (the design's "Five bays ·
 * aircon waiting area behind glass" plate caption); it stays hidden when unset.
 * about.quote / about.signature render only when provided.
 */
interface Props { content: any; }
const { content } = Astro.props;
const about = content.about || {};
const tag = about.tag || '';
const headline = about.headline || '';
const paragraphs: string[] = Array.isArray(about.paragraphs) ? about.paragraphs : (about.body ? [about.body] : []);
const image = about.image || (Array.isArray(about.images) && about.images[0]) || '';
const imageCaption = about.imageCaption || '';
const quote = about.quote || '';
const signature = about.signature || '';
---
<section class="about-sect">
  <div class="wrap grid2">
    <div class="sheet about-copy reveal">
      {tag && <span class="tag" data-field="about.tag">{tag}</span>}
      {headline && <h2 class="about-h" data-field="about.headline" set:html={headline}></h2>}
      {paragraphs.map((p: string, i: number) => (
        <p class="about-p" data-field={`about.paragraphs.${i}`} set:html={p}></p>
      ))}
      {quote && <blockquote class="about-quote" data-field="about.quote">“{quote}”</blockquote>}
      {signature && <p class="about-sign" data-field="about.signature">{signature}</p>}
    </div>
    <figure class="plate about-plate reveal">
      {image && <div class="photo" data-image-field="about.image" style={`background-image:url('${image}');`}></div>}
      {imageCaption && <figcaption data-field="about.imageCaption">{imageCaption}</figcaption>}
    </figure>
  </div>
</section>
<style>
  .about-copy { padding: 30px; }
  .about-h { font-size: clamp(32px, 4.5vw, 52px); margin: 14px 0 18px; color: var(--ink); }
  .about-p { margin-bottom: 14px; color: var(--ink-soft); }
  .about-p:first-of-type { color: var(--ink); }
  .about-quote {
    font-family: var(--display); font-weight: 800; font-size: clamp(20px, 2.4vw, 26px);
    text-transform: uppercase; line-height: 1.05; color: var(--ink);
    margin: 20px 0 0; padding-left: 16px; border-left: 4px solid var(--haz);
  }
  .about-sign { margin-top: 16px; font-style: italic; color: var(--ink-soft); }
  .about-plate { min-height: 420px; }
  @media (max-width: 779px) { .about-plate { min-height: 300px; } }
</style>
