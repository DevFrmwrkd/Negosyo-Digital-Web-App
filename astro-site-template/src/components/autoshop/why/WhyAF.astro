---
/**
 * autoshop / WhyAF — "why owners skip the casa" split: big stencil headline
 * left, a stacked list of reasons right rendered as ink-ruled paper rows
 * (title in bold + supporting line). Reads content.why.items (canonical
 * `body`, legacy `desc`).
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="why-sect">
    <div class="wrap grid2">
      <div class="why-head reveal">
        {tag && <span class="tag" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="why-h" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <ul class="why-list reveal">
        {items.map((item, i) => (
          <li class="why-item">
            <strong data-field={`why.items.${i}.title`}>{item.title}</strong>
            {(item.body ?? item.desc ?? item.description) && (
              <span class="why-body" data-field={`why.items.${i}.body`}> {item.body ?? item.desc ?? item.description}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .why-head .tag { margin-bottom: 14px; }
  .why-h { font-size: clamp(32px, 4.5vw, 52px); color: var(--ink); }
  .why-list { list-style: none; display: grid; gap: 2px; background: var(--ink); border: 2px solid var(--ink); }
  .why-item { background: var(--paper); padding: 20px; }
  .why-item strong { color: var(--ink); }
  .why-body { color: var(--ink-soft); }
  @media (max-width: 760px) {
    .grid2 { grid-template-columns: 1fr; }
    .why-head .tag { margin-bottom: 12px; }
  }
</style>
