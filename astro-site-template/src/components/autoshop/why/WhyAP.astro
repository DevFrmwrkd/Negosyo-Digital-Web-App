---
/**
 * autoshop / WhyAP — "why us" reasons in a hairline-boxed 2-column grid. Each
 * .why-cell is led by an amber stencil numeral (decorative), a condensed title
 * and a concrete body line. Reads content.why.items (canonical `body`, legacy
 * `desc`). why.tag drives the "// 03" snum.
 */
interface Props { content: any; }
const { content } = Astro.props;
const why = content.why || {};
const tag = why.tag || '';
const headline = why.headline || '';
const items: Array<{ title: string; body?: string; desc?: string; description?: string }> =
  Array.isArray(why.items) ? why.items : [];
---
{items.length > 0 && (
  <section class="sec seamtop why">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="why.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="why.headline" set:html={headline}></h2>}
      </div>
      <div class="why-grid">
        {items.map((item, i) => (
          <div class="why-cell reveal">
            <div class="k" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3 data-field={`why.items.${i}.title`}>{item.title}</h3>
            {(item.body ?? item.desc ?? item.description) && (
              <p data-field={`why.items.${i}.body`}>{item.body ?? item.desc ?? item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 0; border: 1px solid var(--line); }
  @media (max-width: 760px) { .why-grid { grid-template-columns: 1fr; } }
  .why-cell { padding: 38px 34px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .why-cell:nth-child(2n) { border-right: none; }
  .why-cell:nth-last-child(-n+2) { border-bottom: none; }
  @media (max-width: 760px) { .why-cell { border-right: none; } .why-cell:nth-last-child(2) { border-bottom: 1px solid var(--line); } }
  .why-cell .k { font-family: var(--big); font-size: 32px; color: var(--amber); }
  .why-cell h3 { font-size: 23px; margin: 12px 0 8px; }
  .why-cell p { color: var(--concrete); font-size: 15px; }
</style>
