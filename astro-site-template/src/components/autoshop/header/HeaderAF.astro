---
/**
 * autoshop / HeaderAF — job-sheet brand bar. A hazard chevron strip over a
 * sticky paper bar carrying the stencil brand (with the design's red ■ mark),
 * optional nav links, and the shop phone. Gains a hard ink underline once
 * scrolled (toggled by PageAF's inline handler via header.site.scrolled).
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
// Anchor guard. The content layer (lib/derive-content-defaults.ts) hard-codes
// '#visit' for hero.cta1 / navCtaHref / ctaBand.cta, '#services' for hero.cta2
// and nav links to '#why' / '#work' — ids most designs never render, so those
// links scrolled nowhere and the page's primary button did nothing. Resolve
// every in-page href against what PageAF actually renders: keep it if the id
// exists, remap it when this design carries the same section under another id,
// otherwise fall back to the target this design was built around (headers drop
// the link instead). Off-page hrefs (tel:, mailto:, http) pass through.
// Keep PAGE_ANCHORS in step with PageAF.
const PAGE_ANCHORS = new Set(['gallery', 'location', 'reviews', 'top']);
const ANCHOR_ALIAS: Record<string, string> = { visit: 'location', work: 'gallery' };
const onPage = (href: string | undefined, fallback: string): string => {
  if (!href) return fallback;
  if (!href.startsWith('#')) return href;
  const alias = ANCHOR_ALIAS[href.slice(1)];
  if (PAGE_ANCHORS.has(href.slice(1))) return href;
  return alias && PAGE_ANCHORS.has(alias) ? `#${alias}` : fallback;
};
// 'Your Business' was a placeholder name rendering as the customer's wordmark.
// With no name supplied the mark is omitted instead of inventing one.
const brand = (content as any).footer?.brand || layout.businessName || '';
// Nav links come from the same derived list ('#about', '#services', '#why',
// '#work', '#visit'). Resolve each against this page and drop the ones with no
// section to reach — a nav entry that scrolls nowhere is as broken as a dead
// CTA, and its label promises a section this design does not have. The original
// index rides along as .i so the editor's per-link field hooks stay correct.
const navLinks: Array<{ href: string; label: string; i: number }> =
  ((layout.navLinks && layout.navLinks.length) ? layout.navLinks : [])
    .map((l: any, i: number) => ({ ...l, href: onPage(l.href, ''), i }))
    .filter((l: any) => l.href);
const phone = layout.contact?.phone || (content as any).contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
---
<header class="site">
  <div class="chev"></div>
  <div class="wrap bar">
    {brand && <a href="#top" class="brand" data-field="footer.brand"><span class="mark" aria-hidden="true"></span>{brand}</a>}
    {navLinks.length > 0 && (
      <nav class="nav-links" id="af-primary-nav" aria-label="Main">
        {navLinks.map((link) => (
          <a href={link.href} data-field={`navbar_links.${link.i}.label`} data-href-field={`navbar_links.${link.i}.href`}>{link.label}</a>
        ))}
      </nav>
    )}
    {phone && (
      <a href={`tel:${phoneDigits}`} class="phone" data-field="contact.phone" data-href-field="contact.phone.href">☎ {phone}</a>
    )}
    {navLinks.length > 0 && (
      <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="af-primary-nav">
        <span></span><span></span><span></span>
      </button>
    )}
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.site');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var nav = hdr.querySelector('.nav-links');
    if (!burger) return;
    burger.addEventListener('click', function () {
      var open = hdr.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    // Tap a link → close the drawer.
    if (nav) {
      nav.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('a')) {
          hdr.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
<style>
  header.site {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: 2px solid transparent;
    transition: box-shadow .25s ease, border-color .25s ease;
  }
  header.site.scrolled {
    border-bottom-color: var(--ink);
    box-shadow: 0 4px 0 rgba(var(--ink-rgb), .08);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding-block: 16px;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--display); font-weight: 800; font-size: 22px;
    text-transform: uppercase; letter-spacing: .01em; color: var(--ink);
  }
  .brand:hover { color: var(--ink); }
  .brand .mark { width: 11px; height: 11px; background: var(--red); flex: none; }
  .nav-links { display: flex; gap: 22px; align-items: center; }
  .nav-links a {
    font-family: var(--body); text-transform: uppercase; letter-spacing: .14em;
    font-size: 11.5px; font-weight: 500; color: var(--ink); opacity: .78;
    transition: opacity .2s, color .2s;
  }
  .nav-links a:hover { opacity: 1; color: var(--red); }
  .phone { font-family: var(--body); font-weight: 700; font-size: 14px; color: var(--ink); white-space: nowrap; }
  .phone:hover { color: var(--red); }

  /* Hamburger — hidden on desktop, a hard-edged ink-bordered box that matches
     the job-sheet aesthetic. Bars collapse into an X when the drawer is open. */
  .nav-burger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 44px; height: 44px; padding: 10px; flex: none;
    background: var(--paper); border: 2px solid var(--ink); cursor: pointer;
  }
  .nav-burger span {
    display: block; height: 2px; width: 100%; background: var(--ink);
    transition: transform .25s ease, opacity .2s ease;
  }
  header.site.open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  header.site.open .nav-burger span:nth-child(2) { opacity: 0; }
  header.site.open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile: brand stays in the bar, phone + burger group to the right, and the
     nav link list drops to a full-width drawer below the header, styled with the
     design's own paper + ink tokens. Triggers at the design's existing header
     breakpoint (860px) so there is never a "no-nav" gap and desktop is untouched. */
  @media (max-width: 860px) {
    .bar { gap: 12px; }
    .brand { margin-right: auto; }
    .nav-burger { display: flex; }
    .nav-links {
      position: absolute; left: 0; right: 0; top: 100%;
      display: none; flex-direction: column; gap: 0; align-items: stretch;
      background: var(--paper); border-top: 2px solid var(--ink);
      border-bottom: 3px solid var(--ink);
      box-shadow: 0 12px 0 rgba(var(--ink-rgb), .06);
      padding: 2px 0; z-index: 55;
    }
    header.site.open .nav-links { display: flex; }
    .nav-links a {
      display: flex; align-items: center; min-height: 48px;
      padding: 12px 20px; opacity: 1; font-size: 13px;
      border-top: 1px solid var(--line);
    }
    .nav-links a:first-child { border-top: 0; }
    .nav-links a:hover { opacity: 1; background: var(--ink); color: var(--haz); }
  }
</style>
