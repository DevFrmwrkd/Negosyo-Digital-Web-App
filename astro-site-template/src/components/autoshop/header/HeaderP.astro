---
/**
 * Autoshop / HeaderP — Foundry sticky nav. Hard-bordered industrial bar with
 * an accent logo mark, underline-on-hover links, a mono phone number, and an
 * accent Book CTA. Reads layout.navLinks + content.footer.brand so it stays
 * portable across P–T. On phones/tablets (<=860px, the family's reflow point)
 * a proper animated hamburger opens a full-width drawer of the links + phone +
 * CTA, styled in the design's own paper/ink/accent tokens with >=44px tap
 * targets. Desktop appearance is unchanged.
 */
interface Props { layout: any; content: any; }
const { layout, content } = Astro.props;
const brand = (content as any).footer?.brand || layout.businessName || 'Your Shop';
const navLinks: Array<{ href: string; label: string }> = (layout.navLinks && layout.navLinks.length)
  ? layout.navLinks
  : [];
const phone = layout.contact?.phone || '';
const phoneDigits = phone.replace(/[^0-9+]/g, '');
const ctaText = (content as any).navCtaText || 'Book Service';
const ctaHref = (content as any).navCtaHref || '#book';
---
<header class="site">
  <div class="wrap nav">
    <a class="logo" href="#top" data-field="footer.brand"><span class="mark">▲</span> {brand}</a>
    <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="hdrP-menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-drawer" id="hdrP-menu">
      {navLinks.length > 0 && (
        <nav class="nav-links" aria-label="Primary">
          {navLinks.map((link, i) => (
            <a href={link.href} data-field={`navbar_links.${i}.label`} data-href-field={`navbar_links.${i}.href`}>{link.label}</a>
          ))}
        </nav>
      )}
      <div class="nav-cta">
        {phone && <a class="nav-phone" href={`tel:${phoneDigits}`} data-field="location.phone">{phone}</a>}
        <a class="btn btn--accent" href={ctaHref} data-field="navCtaText" data-href-field="navCtaHref">{ctaText}</a>
      </div>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var hdr = document.querySelector('header.site');
    if (!hdr) return;
    var burger = hdr.querySelector('.nav-burger');
    var drawer = hdr.querySelector('.nav-drawer');
    if (!burger || !drawer) return;
    function setOpen(open) {
      hdr.classList.toggle('nav-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    burger.addEventListener('click', function () {
      setOpen(!hdr.classList.contains('nav-open'));
    });
    // Close the drawer after tapping any link or the CTA/phone.
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    // Close on Escape for keyboard users.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
<style>
  header.site { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 2px solid var(--ink); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 72px; }
  .logo { display: flex; align-items: center; gap: 12px; font-family: var(--display); font-weight: 900; font-size: 20px; text-transform: uppercase; letter-spacing: -.02em; }
  .logo .mark { width: 34px; height: 34px; background: var(--accent); border: 2px solid var(--ink); display: grid; place-items: center; font-size: 18px; color: var(--on-accent, var(--ink)); flex: none; }
  /* Drawer wrapper is transparent on desktop (display:contents) so the links
     and CTA participate directly in the bar's flex — bar layout is unchanged. */
  .nav-drawer { display: contents; }
  .nav-links { display: flex; gap: 28px; align-items: center; }
  .nav-links :global(a) { font-weight: 600; font-size: 15px; position: relative; padding: 4px 0; }
  .nav-links :global(a::after) { content: ""; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: var(--accent); transition: width .2s ease; }
  .nav-links :global(a:hover::after) { width: 100%; }
  .nav-cta { display: flex; align-items: center; gap: 16px; }
  .nav-phone { font-family: var(--mono); font-weight: 600; font-size: 15px; white-space: nowrap; }

  /* Hamburger — hidden on desktop, revealed as the mobile trigger. */
  .nav-burger { display: none; }

  @media (max-width: 860px) {
    /* 44px tap target with three hard ink bars → animate to an X when open. */
    .nav-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; flex: none;
      background: transparent; border: 2px solid var(--ink); cursor: pointer;
    }
    .nav-burger span { display: block; width: 100%; height: 2px; background: var(--ink); transition: transform .25s ease, opacity .2s ease; }
    header.site.nav-open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    header.site.nav-open .nav-burger span:nth-child(2) { opacity: 0; }
    header.site.nav-open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Full-width drawer beneath the bar, in the design's own paper/ink tokens. */
    .nav-drawer {
      display: block; position: absolute; left: 0; right: 0; top: 100%;
      background: var(--paper); border-bottom: 2px solid var(--ink);
      box-shadow: 0 22px 30px -24px rgba(var(--ink-rgb), .55);
      max-height: 0; overflow: hidden; visibility: hidden;
      transition: max-height .3s ease, visibility .3s ease;
    }
    header.site.nav-open .nav-drawer { max-height: calc(100vh - 72px); overflow-y: auto; visibility: visible; }
    .nav-links { flex-direction: column; align-items: stretch; gap: 0; padding: 6px var(--pad) 4px; }
    .nav-links :global(a) { display: flex; align-items: center; min-height: 52px; padding: 6px 0; font-size: 16px; border-bottom: 1px solid rgba(var(--ink-rgb), .14); }
    .nav-links :global(a::after) { display: none; }
    .nav-cta { flex-direction: column; align-items: stretch; gap: 12px; padding: 16px var(--pad) 20px; }
    .nav-phone { display: flex; align-items: center; justify-content: center; min-height: 48px; border: 2px solid var(--ink); font-size: 16px; }
    .nav-cta .btn { width: 100%; justify-content: center; min-height: 52px; }
  }
</style>
