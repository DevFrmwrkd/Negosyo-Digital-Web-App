---
/**
 * autoshop / HeroAF — torn-work-order hero. Job-sheet tag, big Saira Condensed
 * headline (the design outlines the LAST line in ink stroke), a mono deck, two
 * chevron-sweep CTAs, and a tilted brushed-steel plate carrying the hero photo.
 * A hazard chevron strip closes the block into the trust bar.
 *
 * The photo (hero.image) layers over the art-directed steel texture, which
 * stays as the designed fallback when no photo is set. hero.imageCaption is an
 * optional extra field (the design's "Bay 1 · Km 38 National Highway" caption).
 */
interface Props { content: any; layout: any; }
const { content, layout } = Astro.props;
const hero = content.hero || {};
const heroImage = hero.image || (hero.photos && hero.photos[0]) || (content.photos && content.photos[0]) || '';
const tagText = hero.tag || '';
const headlineLines: string[] = Array.isArray(hero.headlineLines) && hero.headlineLines.length > 0
  ? hero.headlineLines
  : (hero.headline ? [hero.headline] : []);
const sub = hero.sub || '';
const cta1Text = hero.cta1?.text || '';
const cta1Href = hero.cta1?.href || (layout.contact?.phone ? `tel:${String(layout.contact.phone).replace(/[^0-9+]/g, '')}` : '#location');
const cta2Text = hero.cta2?.text || '';
const cta2Href = hero.cta2?.href || '#location';
const imageCaption = hero.imageCaption || '';
---
<header class="hero-af">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      {tagText && <span class="tag" data-field="hero.tag">{tagText}</span>}
      {headlineLines.length > 0 && (
        <h1 class="hero-h">
          {headlineLines.map((line: string, i: number) => (
            <span class="hl-line" data-field={`hero.headlineLines.${i}`} set:html={line}></span>
          ))}
        </h1>
      )}
      {sub && <p class="hero-sub" data-field="hero.sub">{sub}</p>}
      {(cta1Text || cta2Text) && (
        <div class="hero-cta">
          {cta1Text && <a class="btn" href={cta1Href} data-field="hero.cta1.text" data-href-field="hero.cta1.href">{cta1Text}</a>}
          {cta2Text && <a class="btn alt" href={cta2Href} data-field="hero.cta2.text" data-href-field="hero.cta2.href">{cta2Text}</a>}
        </div>
      )}
    </div>
    <figure class="plate hero-plate">
      {heroImage && <div class="photo" data-image-field="hero.image" style={`background-image:url('${heroImage}');`}></div>}
      {imageCaption && <figcaption data-field="hero.imageCaption">{imageCaption}</figcaption>}
    </figure>
  </div>
  <div class="chev"></div>
</header>
<style>
  .hero-af { position: relative; overflow: hidden; }
  .hero-inner {
    display: grid; gap: 44px; align-items: center;
    padding-top: 48px; padding-bottom: 60px;
  }
  .hero-h { font-size: clamp(48px, 10vw, 118px); margin: 18px 0 8px; color: var(--ink); }
  .hero-h .hl-line { display: block; }
  /* Design signature: the final headline line is drawn as an ink outline
     (only when there are 2+ lines, so a lone headline stays solid + legible). */
  .hero-h .hl-line:last-child:not(:first-child) { color: transparent; -webkit-text-stroke: 2px var(--ink); }
  .hero-sub { max-width: 52ch; margin: 18px 0 28px; color: var(--ink-soft); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-plate { min-height: 300px; transform: rotate(-1deg); }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.15fr .85fr; }
  }
  @media (max-width: 899px) {
    .hero-plate { transform: none; min-height: 260px; }
  }
</style>
