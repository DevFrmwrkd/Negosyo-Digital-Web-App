---
/**
 * autoshop / TestimonialsAP — "driver reviews" as amber-topped .quote cards on
 * the panel2 ground. Each card carries the review copy and an uppercase mono
 * attribution line. Reads content.testimonials.items (canonical `who` + `role`,
 * legacy `author` / `name` / `context`). testimonials.tag drives the "// 05" snum.
 */
interface Props { content: any; }
const { content } = Astro.props;
const test = content.testimonials || {};
const tag = test.tag || '';
const headline = test.headline || '';
type Item = { quote: string; who?: string; role?: string; author?: string; name?: string; context?: string };
const items: Item[] = Array.isArray(test.items) ? test.items : (Array.isArray(test) ? test : []);
---
{items.length > 0 && (
  <section class="sec seamtop testimonials" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="testimonials.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="testimonials.headline" set:html={headline}></h2>}
      </div>
      <div class="quotes-grid">
        {items.map((item, i) => {
          const who = item.who ?? item.author ?? item.name;
          const role = item.role ?? item.context;
          return (
            <figure class="quote reveal">
              <p data-field={`testimonials.items.${i}.quote`}>{item.quote}</p>
              {(who || role) && (
                <figcaption class="who">
                  {who && <span data-field={`testimonials.items.${i}.who`}>— {who}</span>}
                  {role && <span data-field={`testimonials.items.${i}.role`}>, {role}</span>}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
<style>
  .quotes-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  @media (max-width: 900px) { .quotes-grid { grid-template-columns: 1fr; } }
  .quote { background: var(--panel2); padding: 30px 28px; border-top: 3px solid var(--amber); }
  .quote p { font-size: 18px; line-height: 1.5; color: var(--off); }
  .quote .who { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; color: var(--concrete); text-transform: uppercase; }
</style>
