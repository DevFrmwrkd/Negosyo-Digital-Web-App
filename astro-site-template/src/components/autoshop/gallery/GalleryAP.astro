---
/**
 * autoshop / GalleryAP — "in the bay" mosaic. Tiles are art-directed .plate
 * frames (a cycling .scene-* duotone stands in as the designed fallback; a
 * photo layers over it via data-image-field when set), arranged in lp-04's
 * mosaic where the first tile spans 2×2 and tiles 4 + 6 span two columns. The
 * amber corner mark is decorative frame chrome; the .cap caption is editable.
 * The section auto-hides only when there are no items at all.
 */
interface Props { content: any; layout: any; }
const { content } = Astro.props;
const gallery = content.gallery || {};
const tag = gallery.tag || '';
const headline = gallery.headline || '';
const sub = gallery.sub || '';
type Tile = { image?: string; caption?: string };
const items: Tile[] = Array.isArray(gallery.items) ? gallery.items : (Array.isArray(content.gallery) ? content.gallery : []);
const scenes = ['scene-engine', 'scene-tyre', 'scene-aircon', 'scene-detail', 'scene-bay', 'scene-shop'];
const spanFor = (i: number) => (i % 6 === 0 ? 'b1' : i % 6 === 3 ? 'b4' : i % 6 === 5 ? 'b6' : '');
---
{items.length > 0 && (
  <section class="sec seamtop rev gallery" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        {tag && <span class="snum" data-field="gallery.tag">{tag}</span>}
        {headline && <h2 class="reveal" data-field="gallery.headline" set:html={headline}></h2>}
      </div>
      {sub && <p class="gal-sub" data-field="gallery.sub">{sub}</p>}
      <div class="g-grid reveal">
        {items.map((item, i) => (
          <figure class={`plate ${spanFor(i)}`.trim()}>
            <div class={`ph ${scenes[i % scenes.length]}`} data-image-field={`gallery.items.${i}.image`} style={item.image ? `background-image:url('${item.image}');background-size:cover;background-position:center;` : ''}></div>
            <span class="tag" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {item.caption && <figcaption class="cap" data-field={`gallery.items.${i}.caption`}>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gal-sub { max-width: 52ch; color: var(--concrete); margin: -32px 0 32px; font-size: 15px; }
  .g-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-auto-rows: 180px; gap: 12px; }
  @media (max-width: 820px) { .g-grid { grid-template-columns: repeat(2,1fr); } }
  .g-grid .plate .ph { transition: transform .6s; }
  .g-grid .plate:hover .ph { transform: scale(1.07); }
  .b1 { grid-column: span 2; grid-row: span 2; }
  .b4 { grid-column: span 2; }
  .b6 { grid-column: span 2; }
</style>
