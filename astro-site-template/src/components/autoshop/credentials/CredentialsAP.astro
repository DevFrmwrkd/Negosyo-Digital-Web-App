---
/**
 * autoshop / CredentialsAP — "credentials" permits row: a hairline-gridded set
 * of .cred tiles on the panel2 ground, each with a chevron-clipped amber badge
 * (decorative), a condensed uppercase label and a concrete note. Reads
 * content.credentials.items (title / desc); tag + headline render above when set.
 */
interface Props { content: any; }
const { content } = Astro.props;
const cred = content.credentials || {};
const tag = cred.tag || '';
const headline = cred.headline || '';
type Item = { title: string; desc?: string };
const items: Item[] = Array.isArray(cred.items) ? cred.items : [];
---
{items.length > 0 && (
  <section class="sec seamtop rev creds">
    <div class="wrap">
      {(tag || headline) && (
        <div class="sec-head">
          {tag && <span class="snum" data-field="credentials.tag">{tag}</span>}
          {headline && <h2 class="reveal" data-field="credentials.headline" set:html={headline}></h2>}
        </div>
      )}
      <div class="cred-row">
        {items.map((item, i) => (
          <div class="cred reveal">
            <div class="bdg" aria-hidden="true">{i === items.length - 1 ? '✦' : '✓'}</div>
            <h4 data-field={`credentials.items.${i}.title`}>{item.title}</h4>
            {item.desc && <p data-field={`credentials.items.${i}.desc`}>{item.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cred-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 760px) { .cred-row { grid-template-columns: repeat(2,1fr); } }
  .cred { background: var(--panel2); padding: 30px 26px; }
  .cred .bdg { width: 36px; height: 36px; border: 1px solid var(--amber); display: flex; align-items: center; justify-content: center; color: var(--amber); margin-bottom: 14px; clip-path: polygon(8px 0,100% 0,calc(100% - 8px) 100%,0 100%); }
  .cred h4 { font-family: var(--cond); font-weight: bold; font-size: 16px; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px; }
  .cred p { font-size: 14px; color: var(--concrete); margin: 0; }
  @media (max-width: 760px) { .cred { padding: 24px 20px; } }
  @media (max-width: 520px) { .cred-row { grid-template-columns: 1fr; } }
</style>
